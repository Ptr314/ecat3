// ДВК-3 с контроллером НГМД двойной плотности MY (КМД 3.057.136) и
// пультовым монитором 279: в нём есть загрузка с MY (команда B MY) и DW.
// Винчестер DW тоже есть, образ вставляется из меню.
// Дискеты MY - 80 дорожек, две стороны, 10 секторов по 512 байт, 800 КБ.
// Контроллер - плата со своим процессором и прошивкой, как настоящая: на
// ней проходят заводской тест TESTMY и форматирование.
@extends dvk/DVK-3.cfg
@version ДВК-3 (МС1201.02, ПЗУ 279, КСМ, КГД, MX, MY, DW)
@protected

monitor:image = 279.rom

// Прерывания идут цепочкой: DW, MY, потом терминальный интерфейс
cpu:~virq = dw.virq
cpu:~vector = dw.vector

@before mapper

// Контроллер MY (КМД 3.057.136), 172140/172142, вектор 170. Это плата со
// своим процессором: К1801ВМ1 на 4 МГц, прошивка 092 (КР1801РЕ2), 4 КБ ОЗУ
// (две КР537РУ8) и контроллер дисковода К1801ВП1-128. Чтение, запись,
// форматирование - всё делает прошивка; с машиной плату связывают её
// регистры и прямой доступ к памяти через окно 40000-77777.
// Циклы прямого доступа не несут SEL процессора: память плата видит так,
// как её видит программа, а не пультовый монитор - через свою карту.
// Разряды адреса 16-21 перемычки S1-S6 на шину не выводят
my : dvk-kmd {
	host_mapper = dma-mapper
	address_bits = _16
	~virq_in = tt.virq
	~vector_in = tt.vector
	~iako = cpu.iako
	~init = cpu.init
}

// Процессор платы. Пуск - по адресу из старшего байта 177716 платы (010000):
// прошивка там гасит прерывания и переходит на 0. INIT машины - IRQ2
// платы (вектор 100), АИП/АСП - общие с машиной
kmd-cpu : 1801vm1 {
	clock = _4000000
	start_address = 010000
	mapper = kmd-mapper
	~irq2 = !my.local_init
	~dclo = panel.aip
	~aclo = panel.asp
}

// Прошивка 092; другая версия - kmd091.rom
kmd-rom : rom {
	size = _8k
	image = kmd092.rom
	files = "ПЗУ КМД (*.rom *.bin);;Все файлы (*.*)"
}

kmd-ram : ram {
	clock_source = kmd-cpu
	size = _4k
}

kmd-fdc : bk-fdc {
	clock_source = kmd-cpu
	drives = my0|my1
}

my0 : fdd {
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 0
	image = rt11-my.dsk
	files = "Образы дискет MY (*.dsk *.img);;Все файлы (*.*)"
	~select = kmd-fdc.select
	~motor_on = kmd-fdc.motor_on
}

my1 : fdd {
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 1
	files = "Образы дискет MY (*.dsk *.img);;Все файлы (*.*)"
	~select = kmd-fdc.select
	~motor_on = kmd-fdc.motor_on
}

// Адреса процессора платы. 177716 - регистр режима (переключатели SA1 в
// разрядах 0-1, адрес пуска в старшем байте), 177760 прошивка пишет при
// пуске, плата его не читает
kmd-mapper : memory-mapper {
	@memory[000000-017777] = kmd-rom {mode = r}
	@memory[020000-027777] = kmd-ram
	@memory[040000-077777] = my[0400000]
	@memory[177100-177103] = my[0100]
	@memory[177130-177133] = kmd-fdc
	@memory[177716-177717] = my[0110]
	@memory[177760-177761] = my[0120]
}

// Контроллер винчестера DW (КЗД 3.057.316), 174000-174020, вектор 300.
// Образ в гнездо не вставлен: файл на 5 МБ возят отдельно от машины. RT-11 на
// винчестере - software/dvk/rt11-dw.dsk, вставить из меню и загрузить B DW
dw : dvk-dw {
	files = "Образы винчестера DW (*.dsk *.img);;Все файлы (*.*)"
	~virq_in = my.virq
	~vector_in = my.vector
	~iako = cpu.iako
	~init = cpu.init
}

// Карта прямого доступа: то же, что у процессора вне пульта
dma-mapper : memory-mapper {
	portstomemory = 1
	@memory[000000-157777] = ram
	@memory[172140-172143] = my
	@memory[176640-176647] = kgd
	@memory[177130-177133] = mx
	@memory[177560-177567] = tt
}

mapper:@memory[0:1][172140-172143] = my
mapper:@memory[0:1][174000-174037] = dw
