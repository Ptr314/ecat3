// Клавиши МС7004 - то, что нарисовано на ms7004_keyboard.svg. Слева имя
// клавиши (оно же элемент рисунка), справа КОД КЛАВИШИ LK201, который
// клавиатура шлёт терминалу; символ из него делает терминал (КСМ, КЦГД). У
// клавиши один код: регистр, РУС/ЛАТ и ФКС - забота терминала.
//
// Коды взяты из таблицы матрицы в прошивке клавиатуры (ms7004.lst, 0380-03FF)
// и сверены с таблицей ПЗУ КСМ (0AFD + ~код). Клавиши, которых у LK201 нет,
// разложены по столбцам той же матрицы:
//   key_lcurl  ({ |, левая в ряду цифр) - $FC, столбец ТАБ, СУ, ФКС, ВР;
//   key_rcurl  (} ↖, правее - =)       - $F5, место = у LK201;
//   key_tilda  (~, правее : *)        - $C9, тот же столбец, что Ф12 и Ф13;
//   key_lf     (без надписи, левее ЗБ) - $C4, столбец ЗБ, ВК и Ф14; КСМ даёт
//                                       по ней ПС (012);
//   key_hard   (Ъ)                    - $F1, КСМ даёт _ ;
//   key_under  (_ —)                  - $FD, КСМ даёт _ .
// КСМ на $FC, $F5 и $C9 ничего не выдаёт (в его таблице там $FC), какой
// символ стоял за ними у других терминалов, не выяснено.

shift: key_shift_1      // ВР левая
shift: key_shift_2      // ВР правая
ctrl:  key_ctrl         // СУ

key_shift_1:    $AE
key_shift_2:    $AE
key_ctrl:       $AF
key_caps:       $B0     // ФКС
key_kmp:        $B1     // КМП
key_ruslat:     $B2     // РУС/ЛАТ

// --- Функциональный ряд -----------------------------------------------
key_f1:         $56     // СТОП КАДР
key_f2:         $57     // ПЕЧАТЬ КАДРА
key_f3:         $58     // ПАУЗА
key_f4:         $59     // УСТ РЕЖИМА
key_f5:         $5A     // Ф5
key_f6:         $64     // ПРЕРЫВ
key_f7:         $65     // ПРОДОЛЖ
key_f8:         $66     // ОТМЕН
key_f9:         $67     // ОСНОВН КАДР
key_f10:        $68     // ВЫХОД
key_f11:        $71     // АР2 (ESC)
key_f12:        $72     // ВШ (BS)
key_f13:        $73     // ПС (LF)
key_f14:        $74     // ДОП ВАРИАНТ
key_f15:        $7C     // ПМ
key_f16:        $7D     // ИСП
key_f17:        $80
key_f18:        $81
key_f19:        $82
key_f20:        $83

// --- Ряд цифр ---------------------------------------------------------
key_lcurl:      $FC
key_semi:       $BF     // ; +
key_1:          $C0
key_2:          $C5
key_3:          $CB
key_4:          $D0
key_5:          $D6
key_6:          $DB
key_7:          $E0
key_8:          $E5
key_9:          $EA
key_0:          $EF
key_minus:      $F9     // - =
key_rcurl:      $F5
key_lf:         $C4
key_bksp:       $BC     // ЗБ

// --- Й Ц У К Е Н Г Ш Щ З Х (латиница J C U K E N G [ ] Z H) -----------
key_tab:        $BE
key_j:          $C1
key_c:          $C6
key_u:          $CC
key_k:          $D1
key_e:          $D7
key_n:          $DC
key_g:          $E1
key_lbr:        $E6     // Ш [
key_rbr:        $EB     // Щ ]
key_z:          $F0
key_h:          $F6
key_colon:      $FA     // : *
key_tilda:      $C9
key_enter:      $BD     // ВК

// --- Ф Ы В А П Р О Л Д Ж Э (F Y W A P R O L D V \) ---------------------
key_f:          $C2
key_y:          $C7
key_w:          $CD
key_a:          $D2
key_p:          $D8
key_r:          $DD
key_o:          $E2
key_l:          $E7
key_d:          $EC
key_v:          $F2
key_bksl:       $FB     // Э \
key_dot:        $F7     // . >
key_hard:       $F1     // Ъ

// --- Я Ч С М И Т Ь Б Ю (Q ^ S M I T X B @) ----------------------------
key_q:          $C3
key_caret:      $C8     // Ч ^
key_s:          $CE
key_m:          $D3
key_i:          $D9
key_t:          $DE
key_x:          $E3
key_b:          $E8
key_at:         $ED     // Ю @
key_comma:      $F3     // , <
key_slash:      $CA     // / ?
key_under:      $FD     // _ —
key_space:      $D4

// --- Блок редактирования и стрелки ------------------------------------
key_nt:         $8A     // НТ
key_ins:        $8B     // ВСТ
key_del:        $8C     // УДАЛ
key_select:     $8D     // ВЫБР
key_pgup:       $8E     // ПРЕД КАДР
key_pgdn:       $8F     // СЛЕД КАДР
key_left:       $A7
key_right:      $A8
key_down:       $A9
key_up:         $AA

// --- Цифровой блок ----------------------------------------------------
// Справа на рисунке: «,» во втором ряду, «—» в третьем, «.» в четвёртом,
// ВВОД внизу во всю ширину - коды по надписям
key_num_pf1:    $A1
key_num_pf2:    $A2
key_num_pf3:    $A3
key_num_pf4:    $A4
key_num_7:      $9D
key_num_8:      $9E
key_num_9:      $9F
key_num_comma:  $9C
key_num_4:      $99
key_num_5:      $9A
key_num_6:      $9B
key_num_minus:  $A0
key_num_1:      $96
key_num_2:      $97
key_num_3:      $98
key_num_dot:    $94
key_num_0:      $92
key_num_enter:  $95     // ВВОД
