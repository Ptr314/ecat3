// ДВК-4 с КЦГД и графическим процессором: КЦГД с прошивкой 182 и ПЗУ
// расширения KeyGP (РР1-183, РР1-184) на 120000-157777. Прошивка 182 при
// пуске переходит на 120000 (если ПЗУ нет, зависание шины возвращает её по
// вектору 4), и KeyGP ставит в её ячейки ОЗУ свои обработчики: графические
// команды ESC M <команда> <параметры>. Работают они в режиме VT52, в
// котором прошивка 182 стартует; ESC < переводит её в режим ANSI.
//
// Стоит прямо на DVK-4.cfg и повторяет правки DVK-4-KCGD.ext: расширение
// поверх расширения не попадает в веб-сборку
@extends dvk/DVK-4.cfg
@version ДВК-4 (МС1201.04, КЦГД с графическим процессором, MX, MY)
@protected

-ksm-cpu
-ksm-rom
-ksm-ram
-ksm-vram
-ksm-cg
-ksm-pic
-ksm-line
-ksm-kbd
-ksm-ppi
-display
-keyboard
-ksm-mapper

// Линия ИРПС машины идёт в КЦГД
tt:baud = _57600
tt:~rxd = kcgd-host.txd

//=========================== КЦГД =========================================//

// КМ1801ВМ2, 30,8 МГц / 4. Начальный пуск и векторы пульта - от 100000, где
// лежит прошивка: пуск по 111516, HALT и двойное зависание - туда же. PSW
// вектора пуска - 340, без разряда 8: прошивка работает вне пультового режима
kcgd-cpu : 1801vm2 {
	clock = _7700000
	start_address = 100000
	start_vector = 1
	halt_sel = 100000
	// ОЗУ процессора - та же К565РУ5, что и видеопамять, и почти всё время
	// строки её занимает развёртка (100 слов за 31,7 мкс): процессор ждёт.
	// Сколько, не измерено: заводской тест KC.SAV ждёт кадровое прерывание в
	// цикле на 1208 проходов (ошибка 44): второй такой цикл должен быть
	// длиннее кадра. При задержке 8 он ровно в кадр, и тест проходит или
	// нет в зависимости от фазы кадра против пуска; 12 - с запасом
	reply_delay = _12
	mapper = kcgd-mapper
	// Прерывания цепочкой: ВП1-033, клавиатура, линия к ДВК
	~virq = kcgd.virq
	~vector = kcgd.vector
	// Кадровый импульс 60 Гц, вектор 100
	~irq2 = !display.vsync
	// АИП и АСП магистрали
	~dclo = panel.aip
	~aclo = panel.asp
}

// Прошивка 182 (КР1801РЕ2), 100000-117777: с ней работает KeyGP
kcgd-rom : rom {
	size = _8k
	image = kcgd182.rom
	files = "ПЗУ КЦГД (*.rom *.bin);;Все файлы (*.*)"
}

// Видеопамять, регистры 160000/160002 и КР1801ВП1-033 (167770-167776)
kcgd : kcgd {
	clock_source = kcgd-cpu
	mouse = mouse
	~virq_in = kcgd-kbd.virq
	~vector_in = kcgd-kbd.vector
	~iako = kcgd-cpu.iako
	~init = kcgd-cpu.init
}

// Клавиатура, 177560-177566, векторы 60 и 64, 4800 бод
kcgd-kbd : dl11 {
	clock_source = kcgd-cpu
	baud = _4800
	~virq_in = kcgd-host.virq
	~vector_in = kcgd-host.vector
	~iako = kcgd-cpu.iako
	~init = kcgd-cpu.init
	~rxd = keyboard.data
}

// Линия к ДВК, 176560-176566, векторы 360 и 364 (прошивка 181 её опрашивает)
kcgd-host : dl11 {
	clock_source = kcgd-cpu
	baud = _57600
	rx_vector = 360
	tx_vector = 364
	~iako = kcgd-cpu.iako
	~init = kcgd-cpu.init
	~rxd = tt.txd
}

// Изображение 800 x 480. Шрифт прошивки (для поля text) - с 012236 ПЗУ.
// Выходы цвета: U55 - красный, U56 - зелёный, U57 - синий; текст прошивки
// 181 (регистр палитры 017) - жёлтый
display : kcgd-display {
	clock_source = kcgd-cpu
	kcgd = kcgd
	font = kcgd-rom
	font_offset = 012236
}

// Мышь (разъём XP5): счётчики осей читаются в 167774. Прошивка её не
// читает - её читает программа, которую машина загружает в КЦГД
mouse : kcgd-mouse {
	clock_source = kcgd-cpu
}

keyboard : ms7004 {
	clock_source = kcgd-cpu
	map = ms7004.map
	use_remap = 0
	// Символ на 4800 бод - 2,1 мс, 16000 тактов процессора КЦГД
	interval = _16000
	// Команды КЦГД клавиатуре (индикаторы, перезапуск)
	~rxd = kcgd-kbd.txd
}

// Расширение KeyGP: две КР1801РЕ2, 120000-157777
kcgd-gp1 : rom {
	size = _8k
	image = kcgd183.rom
}

kcgd-gp2 : rom {
	size = _8k
	image = kcgd184.rom
}

kcgd-mapper : memory-mapper {
	portstomemory = 1
	// Младшие 16К слов видеопамяти - ОЗУ процессора КЦГД
	@memory[000000-077777] = kcgd
	@memory[100000-117777] = kcgd-rom {mode = r}
	@memory[120000-137777] = kcgd-gp1 {mode = r}
	@memory[140000-157777] = kcgd-gp2 {mode = r}
	@memory[160000-163777] = kcgd[160000]
	@memory[167770-167777] = kcgd[167770]
	@memory[176560-176567] = kcgd-host
	@memory[177560-177567] = kcgd-kbd
}
