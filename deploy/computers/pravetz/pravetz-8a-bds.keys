// Клавиатура Правец-8А (БДС). Сделано tools/pravetz-keyboard/make_keyboards.py по pravetz-8a-bds.map
// id: клавиша хоста; /S - с Shift рисунка, /R - в кириллице; $XX - код как есть;
// caps, cl, reset, f1, f2 - клавиши этих функций
key_esc: esc
key_1: 1
key_1/S: !
key_2: 2
key_2/S: "
key_2/SR: @
key_3: 3
key_3/S: #
key_4: 4
key_4/S: $
key_5: 5
key_5/S: %
key_6: 6
key_6/S: &
key_6/SR: circum
key_7: 7
key_7/S: '
key_7/SR: &
key_8: 8
key_8/S: (
key_8/SR: *
key_9: 9
key_9/S: )
key_9/SR: (
key_0: 0
key_0/S: under
key_0/SR: )
key_colon: colon
key_colon/S: *
key_colon/R: minus
key_colon/SR: under
key_minus: minus
key_minus/S: =
key_minus/R: =
key_minus/SR: plus
key_ch: circum
key_ch/S: circum
key_ch/R: \
key_ch/SR: bar
key_reset: reset
key_tab: tab
key_q: Q
key_w: W
key_e: E
key_r: R
key_t: T
key_y: Y
key_u: U
key_i: I
key_o: O
key_p: P
key_at: @
key_at/S: @
key_at/R: [
key_at/SR: {
key_backslash: \
key_backslash/S: bar
key_backslash/R: ]
key_backslash/SR: }
key_ret: ret
ctrl: key_ctrl
key_a: A
key_s: S
key_d: D
key_f: F
key_g: G
key_h: H
key_j: J
key_k: K
key_l: L
key_semicolon: semicolon
key_semicolon/S: plus
key_semicolon/R: semicolon
key_semicolon/SR: colon
key_lbracket: [
key_lbracket/S: {
key_lbracket/R: '
key_lbracket/SR: "
key_rbracket: ]
key_rbracket/S: }
key_rbracket/R: $DD
key_rbracket/SR: $DD
key_cl: cl
key_caps: caps
shift: key_shift_l
key_z: Z
key_x: X
key_c: C
key_v: V
