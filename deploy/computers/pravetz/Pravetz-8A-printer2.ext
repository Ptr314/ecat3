// Правец-8А с платой принтера неизвестного происхождения в слоте 1 (фото и
// ПЗУ на agatcomp.ru, «THIS ROM IS JUNK, DO NOT COPY IT!»): устроена как
// Epson APL - первые 31 байт ПЗУ совпадают, занятость в разряде 7 по $C1C1,
// - но байт выводит инверсным (прошивка пишет его с EOR #$FF), а после
// строба ждет, пока принтер станет занят. Своя таблица перекодировки и
// ESC-последовательности. Печать - PR#1.
@extends pravetz/Pravetz-8A.cfg
@version Правец-8А (плата принтера 2)
@protected

@before mmu
printer-rom : rom {
	size = 2k
	image = files/printer-8a-unknown.bin
}

printer-card : apple2-parallel {
	rom = printer-rom
	invert = 1
	~busy = printer.busy
}

printer : printer {
	title = Принтер
	~data = printer-card.data
	~strobe = printer-card.strobe
}

mmu:slot1 = printer-card
mmu:slot1_exp = printer-card

@before mapper:@memory[$C100-$FFFF]
mapper:@memory[$C090-$C09F] = printer-card
