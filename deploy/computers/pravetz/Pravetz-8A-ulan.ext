// Правец-8А с сетевой платой U-LAN в слоте 4 (СП «Вариант» и «Правец»):
// MC6850 на общей для класса линии, 115 кбит/с. $C0C3 - управление и
// состояние ACIA ($C0CB - то же), $C0C7 - данные. Выход RTS ACIA - разряд
// A11 ПЗУ: прошивка 4 Кб в двух банках по 2 Кб. Номер станции плата выдает
// при чтении $CFFF (перемычки, параметр station). Ученические машины
// грузились по сети - PR#4. Линию можно вывести на порт компьютера
// (параметр port, команда connect).
@extends pravetz/Pravetz-8A.cfg
@version Правец-8А (U-LAN)
@protected

@before mmu
ulan-rom : rom {
	size = 4k
	label = ПЗУ U-LAN
	image_1 = files/ulan-7732.bin
	title_1 = U-LAN 2.1 (СМ7732)
	image_2 = files/ulan-23e0.bin
	title_2 = U-LAN 2.0
	image = files/ulan-7732.bin
}

ulan : pravetz-ulan {
	rom = ulan-rom
	station = 1
}

mmu:slot4 = ulan
mmu:slot4_exp = ulan

@before mapper:@memory[$C100-$FFFF]
mapper:@memory[$C0C0-$C0CF] = ulan
