// Правец-8А с платой принтера в слоте 1 - копия Epson APL Printer Interface
// (такие делались в СССР и в Болгарии, APC-01). ПЗУ 2 Кб видно целиком в
// $C800 и первой страницей в $C100. Запись в $C090-$C09F защелкивает байт и
// дает строб; занятость принтера читается разрядом 7 по $C1C0-$C1FF, где в
// ПЗУ заполнитель (прошивка опрашивает $C1C1). Печать - PR#1.
@extends pravetz/Pravetz-8A.cfg
@version Правец-8А (плата принтера)
@protected

@before mmu
printer-rom : rom {
	size = 2k
	label = ПЗУ платы принтера
	image_1 = files/printer-epson-apl.bin
	title_1 = Epson APL Printer Interface
	image_2 = files/printer-intplat.bin
	title_2 = Копия (другая прошивка)
	image = files/printer-epson-apl.bin
}

printer-card : apple2-parallel {
	rom = printer-rom
	~busy = printer.busy
}

printer : printer {
	title = Принтер
	~data = printer-card.data
	~strobe = printer-card.strobe
}

mmu:slot1 = printer-card
mmu:slot1_exp = printer-card

@before mapper:@memory[$C100-$FFFF]
mapper:@memory[$C090-$C09F] = printer-card
