// Клавиатура Правец-82 (ранняя). Сделано tools/pravetz-keyboard/make_keyboards.py по pravetz-82.map
// id: клавиша хоста; /S - с Shift рисунка, /R - в кириллице; $XX - код как есть;
// caps, cl, reset, f1, f2 - клавиши этих функций
key_1: 1
key_1/S: !
key_2: 2
key_2/S: "
key_3: 3
key_3/S: #
key_4: 4
key_4/S: $
key_5: 5
key_5/S: %
key_6: 6
key_6/S: &
key_7: 7
key_7/S: '
key_8: 8
key_8/S: (
key_9: 9
key_9/S: )
key_0: 0
key_colon: colon
key_colon/S: *
key_minus: minus
key_minus/S: =
key_minus/SR: $BD
key_ch: circum
key_ch/S: circum
key_ch/R: =
key_ch/SR: plus
key_reset: reset
key_esc: esc
key_q: Q
key_w: W
key_e: E
key_r: R
key_t: T
key_y: Y
key_u: U
key_i: I
key_o: O
key_p: P
key_at: @
key_at/S: @
key_at/R: ~
key_at/SR: tilde
key_rpt: rpt
key_ret: ret
ctrl: key_ctrl
key_a: A
key_s: S
key_d: D
key_f: F
key_g: G
key_h: H
key_j: J
key_k: K
key_l: L
key_semicolon: semicolon
key_semicolon/S: plus
key_semicolon/SR: $AB
key_lbracket: [
key_rbracket: ]
key_down: down
shift: key_shift_l
key_z: Z
key_x: X
key_c: C
key_v: V
key_b: B
key_n: N
key_m: M
key_comma: ,
key_comma/S: <
key_period: .
key_period/S: >
key_slash: slash
key_slash/S: ?
shift: key_shift_r
key_cl: cl
key_space: space
