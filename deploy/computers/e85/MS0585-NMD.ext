// Электроника МС 0585 с контроллером НМД в первой позиции магистрали. Накопитель
// МС5401 на 10 МБ: 4 головки, 306 цилиндров, 16 секторов. Образ в гнездо не вставлен:
// файл на 10 МБ машина меняет при каждой загрузке. ПРОС 2.03 на винчестере -
// pros-2.03-10m.rd из библиотеки программ на сайте, в поставку он не входит. Без
// образа накопитель не готов, и автотест показывает код устройства 401 и ошибку 5.
// Образ размера известного накопителя (RD50-RD53 DEC Pro, 32 МБ у ПРОС) приносит свою
// геометрию, параметры ниже - для остальных, в том числе для чистого диска
@extends e85/MS0585.cfg
@version МС 0585 с винчестером
@protected

system:order = 200
sys:slots = 017

// Дискета ПРОС(Д) базы здесь не нужна: с ней в приводе 0 автотест загружается с
// дискеты, а не с винчестера
-fd0:image

pic2:~irq[0] = knmd.irqa
pic3:~irq[0] = knmd.irqb

knmd : e85-knmd {
	~init = cpu.init
	heads = _4
	sectors = _16
	cylinders = _306
	files = "Образы винчестера (*.rd *.dsk *.img);;Все файлы (*.*)"
}

mapper:@memory[17774000-17774177] = knmd
