// Клавиши клавиатуры самой БК: то, что нарисовано на bk_keyboard.svg.
// В отличие от bk.map, где слева стоит клавиша хоста, здесь слева -- имя
// клавиши машины, и оно же служит идентификатором элемента в рисунке.
//
// Модификаторы:
//   /S -- клавиша нижнего регистра (со стрелкой вниз), удерживается;
//   /C -- СУ, удерживается;
//   /L -- форма, которую выбирает защелка регистра букв ЗАГЛ / СТР.
//
// Записи /L и /S у букв совпадают по значению, но выбираются по-разному, и
// /L есть только у буквенных клавиш: под ЗАГЛ и СТР цифровой ряд не меняется.
// Защелку переворачивает РУС: в КОИ-7 русские заглавные стоят там же, где
// латинские строчные, поэтому в ЛАТ заглавную дает $41, а в РУС -- $61.
//
// Значения всегда с префиксом $: у БК radix = 8, без префикса числа
// прочитались бы восьмеричными.

shift:      key_shift
ctrl:       key_su
alt:        key_ar2
case-upper: key_zagl
case-lower: key_str
rus-on:     key_rus
rus-off:    key_lat
stop:       key_stop     // дергает линию ~stop, кода не имеет
repeat:     key_povt     // повторяет последний посланный код

// --- Буквенный блок ---------------------------------------------------
// Верхняя надпись -- кириллица, нижняя -- латиница; регистр выбирается
// защелками РУС/ЛАТ, поэтому коды взяты из bk.map без изменений.

key_a:    $41
key_a/S:  $61
key_a/L:  $61
key_a/C:  $01
key_b:    $42
key_b/S:  $62
key_b/L:  $62
key_b/C:  $02
key_c:    $43
key_c/S:  $63
key_c/L:  $63
key_c/C:  $03
key_d:    $44
key_d/S:  $64
key_d/L:  $64
key_d/C:  $04
key_e:    $45
key_e/S:  $65
key_e/L:  $65
key_e/C:  $05
key_f:    $46
key_f/S:  $66
key_f/L:  $66
key_f/C:  $06
key_g:    $47
key_g/S:  $67
key_g/L:  $67
key_g/C:  $07
key_h:    $48
key_h/S:  $68
key_h/L:  $68
key_h/C:  $08
key_i:    $49
key_i/S:  $69
key_i/L:  $69
key_i/C:  $09
key_j:    $4A
key_j/S:  $6A
key_j/L:  $6A
key_j/C:  $0A
key_k:    $4B
key_k/S:  $6B
key_k/L:  $6B
key_k/C:  $0B
key_l:    $4C
key_l/S:  $6C
key_l/L:  $6C
key_l/C:  $0C
key_m:    $4D
key_m/S:  $6D
key_m/L:  $6D
key_m/C:  $0D
key_n:    $4E
key_n/S:  $6E
key_n/L:  $6E
key_n/C:  $0E
key_o:    $4F
key_o/S:  $6F
key_o/L:  $6F
key_o/C:  $0F
key_p:    $50
key_p/S:  $70
key_p/L:  $70
key_p/C:  $10
key_q:    $51
key_q/S:  $71
key_q/L:  $71
key_q/C:  $11
key_r:    $52
key_r/S:  $72
key_r/L:  $72
key_r/C:  $12
key_s:    $53
key_s/S:  $73
key_s/L:  $73
key_s/C:  $13
key_t:    $54
key_t/S:  $74
key_t/L:  $74
key_t/C:  $14
key_u:    $55
key_u/S:  $75
key_u/L:  $75
key_u/C:  $15
key_v:    $56
key_v/S:  $76
key_v/L:  $76
key_v/C:  $16
key_w:    $57
key_w/S:  $77
key_w/L:  $77
key_w/C:  $17
key_x:    $58
key_x/S:  $78
key_x/L:  $78
key_x/C:  $18
key_y:    $59
key_y/S:  $79
key_y/L:  $79
key_y/C:  $19
key_z:    $5A
key_z/S:  $7A
key_z/L:  $7A
key_z/C:  $1A

// Клавиши с кириллицей вне латинского алфавита. Нижний регистр идет с
// тем же шагом +$20, что и у букв выше.
key_lbr:      $5B
key_lbr/S:    $7B
key_lbr/L:    $7B
key_bksl:     $5C
key_bksl/S:   $7C
key_bksl/L:   $7C
key_rbr:      $5D
key_rbr/S:    $7D
key_rbr/L:    $7D
key_not:      $5E
key_not/S:    $7E
key_not/L:    $7E
key_rcurl:    $5F
key_rcurl/S:  $7F
key_rcurl/L:  $7F

// --- Цифровой ряд -----------------------------------------------------
// Верхняя надпись -- без модификатора, нижняя -- с /S: bk.map подтверждает
// это парой "1: $31" и "!/S: $21".

key_semi:     $3B
key_semi/S:   $2B
key_1:        $31
key_1/S:      $21
key_2:        $32
key_2/S:      $22
key_3:        $33
key_3/S:      $23
key_4:        $34
key_4/S:      $24
key_5:        $35
key_5/S:      $25
key_6:        $36
key_6/S:      $26
key_7:        $37
key_7/S:      $27
key_8:        $38
key_8/S:      $28
key_9:        $39
key_9/S:      $29
key_0:        $30
key_minus:    $2D
key_minus/S:  $3D
key_colon:    $3A
key_colon/S:  $2A

// --- Знаки в буквенных рядах ------------------------------------------

key_slash:    $2F
key_slash/S:  $3F
key_dot:      $2E
key_dot/S:    $3E
key_comma:    $2C
key_comma/S:  $3C
key_at:       $40
key_at/L:     $60

// --- Управление и правка ----------------------------------------------

key_space:    $20
key_enter:    $0A            // ВК, восьмеричный 12
key_tab:      $0D            // УСТ.ТАБ, восьмеричный 15
key_bksp:     $18            // ЗАБ, восьмеричный 30
key_left:     $08
key_right:    $19
key_up:       $1A
key_down:     $1B
key_vs:       $13            // ВС, возврат строки, восьмеричный 23
key_sbr:      $0C            // СБР, очистка экрана, восьмеричный 14
key_kt:       $03            // КТ, конец текста
key_rus:      $0E            // РУС, восьмеричный 16
key_lat:      $0F            // ЛАТ, восьмеричный 17

// Клавиши верхнего ряда, правящие строку. Их коды лежат выше $7F: это то же
// смещение, что дает АР2, поэтому отдельного модификатора им не нужно.
key_clear:    $8B            // удаление части строки справа от курсора
key_del:      $16            // сдвижка в строке
key_ins:      $17            // раздвижка в строке
key_ind_su:   $82            // ИНД СУ, восьмеричный 202
key_block_ed: $84            // БЛОК РЕД, восьмеричный 204
key_step:     $80            // ШАГ, восьмеричный 200

// Собственного кода не имеют и потому в теле таблицы не значатся:
// key_shift, key_su, key_ar2, key_zagl, key_str, key_rus, key_lat,
// key_stop и key_povt -- все они объявлены в заголовке.
