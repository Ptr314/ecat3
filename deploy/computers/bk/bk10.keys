// Клавиши пленочной клавиатуры БК0010 (с Фокалом): то, что нарисовано на
// bk10_keyboard.svg. Контроллер клавиатуры тот же, что у БК0010-01, поэтому
// общие клавиши шлют те же коды, что и в bk.keys. Клавиши, которых на -01 нет,
// отвечают там сочетаниям с СУ и АР2 - соответствие взято со скана таблицы.
//
// Регистры:
//   НР (key_ar2) - нижний регистр, пока нажат: код идет через вектор 274, и
//      ПЗУ делает из него полуграфику, К1-К10 и коды режимов экрана. На -01
//      это АР2.
//   ПР (key_shift_1, key_shift_2) - правый регистр, пока нажат: знаки справа
//      на цифровых клавишах. Буквы под ним заглавные в ЛАТ и строчные в РУС,
//      то есть всегда код $40-$5F, при любой защелке ЗАГЛ/СТР.
//   /C - СУ, /L - форма, которую выбирает защелка ЗАГЛ/СТР.
//
// Значение выше $7F значит "через вектор 274": в порт уходят младшие семь
// бит. Так записаны ГРАФ, ЗАП и СТИР - на -01 это СУ+АР2+U, V, W. Коды 0-2,
// 4-7, 11, 13 и 21 уходят через 274 сами (alt-codes в конфиге машины).
//
// Значения всегда с префиксом $: у БК radix = 8.

shift:      key_shift_1
shift:      key_shift_2
ctrl:       key_su
alt:        key_ar2
case-upper: key_zagl
case-lower: key_str
rus-on:     key_rus
rus-off:    key_lat
stop:       key_stop     // дергает линию ~stop, кода не имеет

// --- Буквенный блок ---------------------------------------------------
// Кириллица и латиница на одной клавише, алфавит выбирают РУС/ЛАТ.

key_a:        $41
key_a/S:      $41
key_a/L:      $61
key_a/C:      $01
key_b:        $42
key_b/S:      $42
key_b/L:      $62
key_b/C:      $02
key_c:        $43
key_c/S:      $43
key_c/L:      $63
key_c/C:      $03
key_d:        $44
key_d/S:      $44
key_d/L:      $64
key_d/C:      $04
key_e:        $45
key_e/S:      $45
key_e/L:      $65
key_e/C:      $05
key_f:        $46
key_f/S:      $46
key_f/L:      $66
key_f/C:      $06
key_g:        $47
key_g/S:      $47
key_g/L:      $67
key_g/C:      $07
key_h:        $48
key_h/S:      $48
key_h/L:      $68
key_h/C:      $08
key_i:        $49
key_i/S:      $49
key_i/L:      $69
key_i/C:      $09
key_j:        $4A
key_j/S:      $4A
key_j/L:      $6A
key_j/C:      $0A
key_k:        $4B
key_k/S:      $4B
key_k/L:      $6B
key_k/C:      $0B
key_l:        $4C
key_l/S:      $4C
key_l/L:      $6C
key_l/C:      $0C
key_m:        $4D
key_m/S:      $4D
key_m/L:      $6D
key_m/C:      $0D
key_n:        $4E
key_n/S:      $4E
key_n/L:      $6E
key_n/C:      $0E
key_o:        $4F
key_o/S:      $4F
key_o/L:      $6F
key_o/C:      $0F
key_p:        $50
key_p/S:      $50
key_p/L:      $70
key_p/C:      $10
key_q:        $51
key_q/S:      $51
key_q/L:      $71
key_q/C:      $11
key_r:        $52
key_r/S:      $52
key_r/L:      $72
key_r/C:      $12
key_s:        $53
key_s/S:      $53
key_s/L:      $73
key_s/C:      $13
key_t:        $54
key_t/S:      $54
key_t/L:      $74
key_t/C:      $14
key_u:        $55
key_u/S:      $55
key_u/L:      $75
key_u/C:      $15
key_v:        $56
key_v/S:      $56
key_v/L:      $76
key_v/C:      $16
key_w:        $57
key_w/S:      $57
key_w/L:      $77
key_w/C:      $17
key_x:        $58
key_x/S:      $58
key_x/L:      $78
key_x/C:      $18
key_y:        $59
key_y/S:      $59
key_y/L:      $79
key_y/C:      $19
key_z:        $5A
key_z/S:      $5A
key_z/L:      $7A
key_z/C:      $1A

// Остальные клавиши той же половины таблицы: @ [ \ ] ^ и Ъ, на рисунке
// последняя подписана ЗБ - в строчных латинских это код забоя 177.
key_at:       $40
key_at/S:     $40
key_at/L:     $60
key_at/C:     $00
key_lbr:      $5B
key_lbr/S:    $5B
key_lbr/L:    $7B
key_lbr/C:    $1B
key_bksl:     $5C
key_bksl/S:   $5C
key_bksl/L:   $7C
key_bksl/C:   $1C
key_rbr:      $5D
key_rbr/S:    $5D
key_rbr/L:    $7D
key_rbr/C:    $1D
key_not:      $5E
key_not/S:    $5E
key_not/L:    $7E
key_not/C:    $1E
key_zb:       $5F
key_zb/S:     $5F
key_zb/L:     $7F
key_zb/C:     $1F

// --- Цифровой ряд и знаки --------------------------------------------
// Без регистра - левая надпись, с ПР - правая.

key_semi:     $3B
key_semi/S:   $2B
key_1:        $31
key_1/S:      $21
key_2:        $32
key_2/S:      $22
key_3:        $33
key_3/S:      $23
key_4:        $34
key_4/S:      $24
key_5:        $35
key_5/S:      $25
key_6:        $36
key_6/S:      $26
key_7:        $37
key_7/S:      $27
key_8:        $38
key_8/S:      $28
key_9:        $39
key_9/S:      $29
key_0:        $30
key_minus:    $2D
key_minus/S:  $3D
key_colon:    $3A
key_colon/S:  $2A
key_dot:      $2E
key_dot/S:    $3E
key_comma:    $2C
key_comma/S:  $3C
key_slash:    $2F
key_slash/S:  $3F

// --- Управление ------------------------------------------------------

key_space:    $20
key_enter:    $0A            // ВВОД, восьмеричный 12
key_tab:      $09            // ТАБ, 11
key_kt:       $03            // КТ
key_sbr_rp:   $0C            // СБР, 14; с НР - РП, 214
key_clear:    $0B            // СБР со стрелкой, 13, в ПЗУ 231
key_vs:       $13            // ВС, 23
key_gt:       $14            // ГТ, 24 (СУ+T на -01)
key_step:     $00            // ШАГ, в ПЗУ 220
key_ind_su:   $02            // ИНД СУ, в ПЗУ 202
key_block_ed: $04            // БЛОК РЕД, в ПЗУ 204
key_graph:    $95            // ГРАФ: 25 через 274 (СУ+АР2+U), в ПЗУ 225
key_zap:      $96            // ЗАП: 26 через 274 (СУ+АР2+V), в ПЗУ 226
key_erase:    $97            // СТИР: 27 через 274 (СУ+АР2+W), в ПЗУ 227
key_set_tab:  $0D            // УСТ ТАБ, 15 (СУ+M)
key_clear_tab:$10            // СБР ТАБ, 20 (СУ+P)
key_rus:      $0E            // РУС, 16
key_lat:      $0F            // ЛАТ, 17

// --- Курсор и правка ------------------------------------------------

key_left:     $08
key_right:    $19
key_up:       $1A
key_down:     $1B
key_home:     $12            // в начало экрана, 22 (СУ+R)
key_left_up:  $1C            // 34 (СУ+\)
key_right_up: $1D            // 35 (СУ+])
key_right_down:$1E           // 36 (СУ+^)
key_left_down:$1F            // 37 (СУ+Ъ)
key_del:      $16            // сдвижка в строке, 26
key_ins:      $17            // раздвижка в строке, 27
key_bksp:     $18            // забой, 30

// Собственного кода не имеют и потому в теле таблицы не значатся:
// key_shift_1, key_shift_2, key_su, key_ar2, key_zagl, key_str и key_stop -
// все они объявлены в заголовке. РУС и ЛАТ объявлены там же, но код шлют.
