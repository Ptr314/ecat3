// БК0011М с блоком КНГМД в разъеме МПИ: контроллер К1801ВП1-128 (регистры
// 0177130 и 0177132) и ПЗУ дискового драйвера DISK 326 по адресу 0160000.
// При включении БОС находит это ПЗУ и пытается загрузить систему с приводов
// 0 и 1; без дискеты машина уходит в БЕЙСИК.
//
// Расширения, написанные для прежнего BK-0011M-fdd.cfg (@extends
// bk/BK-0011M-fdd.cfg), загружаются поверх этого файла как раньше.
@extends bk/BK-0011M.cfg
@version БК0011М + КНГМД
@protected

@before port-kbd-state

// ПЗУ дискового драйвера, 4 КБ по 0160000-0167777. Адреса 0170000-0177127
// остаются пустыми: таймаут магистрали там нужен ПЗУ для поиска устройств.
disk : rom {
	size = _4k
	image = DISK_326.ROM
}

// Контроллер НГМД. Регистр состояния/команды 0177130, регистр данных 0177132.
// Контроллер отдает процессору дорожку словами, поиск секторов и контроль
// делает ПЗУ. Одно слово каждые 64 мкс - 300 об/мин, 3125 слов на дорожку.
fdc : bk-fdc {
	drives = fdd0|fdd1
}

// Приводы: 80 дорожек, две стороны, 10 секторов по 512 байт - 800 КБ.
// Образ - дамп секторов (*.img, *.bkd, *.dsk); укороченные образы на 40
// дорожек читаются как дискеты с пустым остатком.
fdd0 : fdd {
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 0
	image = andos330.img
	// Дорожки целиком, как их пишет контроллер (К1801ВП1-128); .mfm и .hfe хранят
	// их без потерь, с метками удаления и нестандартной разметкой
	mode = mfm_ibm
	files = "Образы дискет БК (*.img *.bkd *.dsk *.mfm *.hfe);;Все файлы (*.*)"
	~select = fdc.select[0-1]
	~motor_on = fdc.motor_on
}

fdd1 : fdd {
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 1
	// Дорожки целиком, как их пишет контроллер (К1801ВП1-128); .mfm и .hfe хранят
	// их без потерь, с метками удаления и нестандартной разметкой
	mode = mfm_ibm
	files = "Образы дискет БК (*.img *.bkd *.dsk *.mfm *.hfe);;Все файлы (*.*)"
	~select = fdc.select[0-1]
	~motor_on = fdc.motor_on
}

@before mapper:@memory[177660-177661]
mapper:@memory[160000-167777] = disk {mode = r}
mapper:@memory[177130-177133] = fdc
