// БК0010-01 с блоком КНГМД в разъеме МПИ: контроллер К1801ВП1-128 (регистры
// 0177130 и 0177132), ПЗУ дискового драйвера DISK 326 по 0160000 и 16 КБ
// дополнительного ОЗУ на 0120000-0157777 вместо второй и третьей частей
// БЕЙСИКа. Разряды 2-3 команды 0177130 выбирают, что стоит в этом окне:
// 11 - ПЗУ БЕЙСИКа, 10 - ничего, 0x - ОЗУ. Монитор при включении находит
// дисковое ПЗУ и пытается загрузить систему с приводов 0 и 1.
@extends bk/BK-0010-01.cfg
@version БК0010-01 + КНГМД
@protected

// Третьей части БЕЙСИКа нет: на ее адресах дисковое ПЗУ. Первые две части
// остаются, но теперь подключаются командой контроллера, см. карту ниже
-mapper:@memory[120000-137777]
-mapper:@memory[140000-157777]
-mapper:@memory[160000-177377]
-basic3

@before port-kbd-state

// Дополнительное ОЗУ блока КНГМД
ram-fdd : ram {
	size = _16k
}

// ПЗУ дискового драйвера, 4 КБ по 0160000-0167777. Адреса 0170000-0177127
// остаются пустыми: таймаут магистрали там нужен ПЗУ для поиска устройств.
disk : rom {
	size = _4k
	image = DISK_326.ROM
}

// Контроллер НГМД. Регистр состояния/команды 0177130, регистр данных 0177132.
// Контроллер отдает процессору дорожку словами, поиск секторов и контроль
// делает ПЗУ. Одно слово каждые 64 мкс - 300 об/мин, 3125 слов на дорожку.
fdc : bk-fdc {
	drives = fdd0|fdd1
}

// Приводы: 80 дорожек, две стороны, 10 секторов по 512 байт - 800 КБ.
// Образ - дамп секторов (*.img, *.bkd, *.dsk); укороченные образы на 40
// дорожек читаются как дискеты с пустым остатком.
fdd0 : fdd {
	title = A:
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 0
	image = andos330.img
	// Дорожки целиком, как их пишет контроллер (К1801ВП1-128); .mfm и .hfe хранят
	// их без потерь, с метками удаления и нестандартной разметкой
	mode = mfm_ibm
	files = "Образы дискет БК (*.img *.bkd *.dsk *.mfm *.hfe);;Все файлы (*.*)"
	~select = fdc.select[0-1]
	~motor_on = fdc.motor_on
}

fdd1 : fdd {
	title = B:
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 1
	// Дорожки целиком, как их пишет контроллер (К1801ВП1-128); .mfm и .hfe хранят
	// их без потерь, с метками удаления и нестандартной разметкой
	mode = mfm_ibm
	files = "Образы дискет БК (*.img *.bkd *.dsk *.mfm *.hfe);;Все файлы (*.*)"
	~select = fdc.select[0-1]
	~motor_on = fdc.motor_on
}

// Разряды 2-3 команды контроллера выбирают содержимое окна 0120000-0157777
mapper:~config[2-3] = fdc.control[2-3]

@before mapper:@memory[177660-177661]
mapper:@memory[14:14][120000-137777] = basic1 {mode = r}
mapper:@memory[14:14][140000-157777] = basic2 {mode = r}
mapper:@memory[0:10][120000-157777] = ram-fdd
mapper:@memory[160000-167777] = disk {mode = r}
mapper:@memory[177130-177133] = fdc
