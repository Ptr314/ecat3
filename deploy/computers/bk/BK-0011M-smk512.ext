// БК0011М с платой СМК-512 вместо блока КНГМД. Считается, что машина
// доработана по контакту B6 разъема МПИ: плата отключает ПЗУ БОС, ставя на
// его место свое ОЗУ. У реплики это и без доработки почти не видно - ее
// память на чтение перебивает ПЗУ.
@extends bk/BK-0011M.cfg
@version БК0011М + СМК-512
@protected

// Пуск - с 0166400, из ПЗУ платы. Процессор сам берет адрес пуска из 0177716,
// а в режиме SYS, который плата ставит при сбросе, ее ПЗУ перекрывает и
// страницу ввода-вывода, и там читается слово ПЗУ 0167716 = 0166400

// Плата СМК-512 (АльтПро) в разъеме МПИ, как ее делает ПЛИС-реплика: 512 КБ
// ОЗУ, ПЗУ BIOS 4 КБ, контроллер дисковода, совместимый с К1801ВП1-128, и
// контроллер винчестера ИДЕ. Память платы подключается в окно 0100000-0177777
// восемью режимами, выбираемыми записью в 0177130 (MOV #6, затем MOV
// режим+страница); в каждом режиме плата не только перекрывает, но и отключает
// часть памяти самой машины. Это решает устройство smk: в диспетчере оно
// стоит одним диапазоном с routed = 1 и по каждому адресу отвечает само,
// оставляет его машине или оставляет магистраль без ответа.
@before port-kbd-state

// Статическая память платы стоит на МПИ, а не за ВП1-037, и отвечает сразу
smk-bus : bus-timing {
}

smk-ram : ram {
	size = _512k
}

smk-rom : rom {
	size = _4k
	image = SMK512_V205.ROM
}

smk : smk512 {
	bus_timing = smk-bus
	ram = smk-ram
	rom = smk-rom
	machine = bk11
}

// Винчестер платы: те же регистры АльтПро, что у УК-НЦ, по 0177740-0177757.
// Геометрия - из таблицы разделов в блоке 7 образа. Образа по умолчанию нет:
// его вставляют командой hdd.load("файл")
hdd : uknc-hdd {
	board = bk
	files = "Образы винчестера БК (*.img *.hdi *.hdd);;Все файлы (*.*)"
}

// Контроллер НГМД. Регистр состояния/команды 0177130, регистр данных 0177132.
// Контроллер отдает процессору дорожку словами, поиск секторов и контроль
// делает ПЗУ. Одно слово каждые 64 мкс - 300 об/мин, 3125 слов на дорожку.
fdc : bk-fdc {
	drives = fdd0|fdd1
}

// Приводы: 80 дорожек, две стороны, 10 секторов по 512 байт - 800 КБ.
// Образ - дамп секторов (*.img, *.bkd, *.dsk); укороченные образы на 40
// дорожек читаются как дискеты с пустым остатком.
fdd0 : fdd {
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 0
	image = andos330.img
	// Дорожки целиком, как их пишет контроллер (К1801ВП1-128); .mfm и .hfe хранят
	// их без потерь, с метками удаления и нестандартной разметкой
	mode = mfm_ibm
	files = "Образы дискет БК (*.img *.bkd *.dsk *.mfm *.hfe);;Все файлы (*.*)"
	~select = fdc.select[0-1]
	~motor_on = fdc.motor_on
}

fdd1 : fdd {
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 1
	// Дорожки целиком, как их пишет контроллер (К1801ВП1-128); .mfm и .hfe хранят
	// их без потерь, с метками удаления и нестандартной разметкой
	mode = mfm_ibm
	files = "Образы дискет БК (*.img *.bkd *.dsk *.mfm *.hfe);;Все файлы (*.*)"
	~select = fdc.select[0-1]
	~motor_on = fdc.motor_on
}

// Запись в ПЗУ остается без ответа, как на настоящей БК
mapper:@memory[140000-157777] = bos {mode = r, strict = 1}

// Плата первой: по каждому адресу окна она сама решает, ответить,
// оставить адрес машине или не ответить никому
@before mapper:@memory[1:1][100000-137777]
mapper:@memory[100000-177777] = smk {routed = 1}

@before mapper:@memory[177660-177661]
mapper:@memory[177130-177133] = fdc
mapper:@memory[177740-177757] = hdd
