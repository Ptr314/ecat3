// Отладочный вариант БК0011М: в разъем МПИ вставлен модуль МСТД, поэтому
// вместо БЕЙСИКа машина запускается в мониторной системе тестовой диагностики.
@extends bk/BK-0011M.cfg
@version БК0011М + МСТД
@protected

system:debug = 1

// ПЗУ МСТД (монитор системы тестовой диагностики), постоянно занимает
// 0160000-0177577. С ним машина стартует так же, как настоящая БК0011М,
// без него БОС остается в своем отладочном мониторе.
@before basic1
mstd : rom {
	size = _8k
	image = B11M_MSTD.ROM
}

@before mapper:@memory[177660-177661]
mapper:@memory[160000-177577] = mstd {mode = r}
