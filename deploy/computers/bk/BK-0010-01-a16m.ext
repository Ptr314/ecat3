// БК0010-01 с дисковым контроллером А16М (АльтПро) вместо блока КНГМД:
// контроллер дисковода, совместимый с К1801ВП1-128, ПЗУ драйвера 4 КБ и
// 16 КБ дополнительного ОЗУ четырьмя сегментами по 4 КБ. Монитор и БЕЙСИК
// плата отключает сигналами разъема МПИ: монитор - в режимах, где ставит на
// его место свое ОЗУ, БЕЙСИК - всегда, кроме случая, когда разряд 3
// последней записи в 0177130 равен 1.
@extends bk/BK-0010-01.cfg
@version БК0010-01 + А16М
@protected

// Пуск - с 0164400, из ПЗУ платы. Процессор сам берет адрес пуска из 0177716,
// а в режиме Start, который плата ставит при включении, ее ПЗУ перекрывает и
// страницу ввода-вывода, и там читается слово ПЗУ 0167716 = 0164400

-mapper:@memory[120000-137777]
-mapper:@memory[140000-157777]
-mapper:@memory[160000-177377]

// Память платы подключается в окно 0100000-0177777 восемью режимами,
// выбираемыми записью в 0177130 (MOV #6, MOV код режима, MOV #0); в каждом
// режиме плата не только перекрывает, но и отключает часть памяти машины. Это
// решает устройство a16m: в диспетчере оно стоит одним диапазоном с
// routed = 1 и по каждому адресу отвечает само, оставляет его машине или
// оставляет магистраль без ответа.
@before port-kbd-state

// Память платы стоит на МПИ, а не за ВП1-037, и отвечает сразу
a16m-bus : bus-timing {
}

a16m-ram : ram {
	size = _16k
}

a16m-rom : rom {
	size = _4k
	image = DISK_A16M_V244.ROM
}

a16m : a16m {
	bus_timing = a16m-bus
	ram = a16m-ram
	rom = a16m-rom
	machine = bk10
}

// Контроллер НГМД. Регистр состояния/команды 0177130, регистр данных 0177132.
// Контроллер отдает процессору дорожку словами, поиск секторов и контроль
// делает ПЗУ. Одно слово каждые 64 мкс - 300 об/мин, 3125 слов на дорожку.
// Приводов у А16М два: разряды 2 и 3 команды заняты платой.
fdc : bk-fdc {
	drives = fdd0|fdd1
}

// Приводы: 80 дорожек, две стороны, 10 секторов по 512 байт - 800 КБ.
// Образ - дамп секторов (*.img, *.bkd, *.dsk); укороченные образы на 40
// дорожек читаются как дискеты с пустым остатком.
fdd0 : fdd {
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 0
	image = andos330.img
	// Дорожки целиком, как их пишет контроллер (К1801ВП1-128); .mfm хранит их
	// без потерь, с метками удаления и нестандартной разметкой
	mode = mfm_ibm
	files = "Образы дискет БК (*.img *.bkd *.dsk *.mfm);;Все файлы (*.*)"
	~select = fdc.select[0-1]
	~motor_on = fdc.motor_on
}

fdd1 : fdd {
	sides = _2
	tracks = _80
	sectors = _10
	sector_size = _512
	selector_value = 1
	// Дорожки целиком, как их пишет контроллер (К1801ВП1-128); .mfm хранит их
	// без потерь, с метками удаления и нестандартной разметкой
	mode = mfm_ibm
	files = "Образы дискет БК (*.img *.bkd *.dsk *.mfm);;Все файлы (*.*)"
	~select = fdc.select[0-1]
	~motor_on = fdc.motor_on
}

// Запись в ПЗУ остается без ответа, как на настоящей БК
mapper:@memory[100000-117777] = monitor {mode = r, strict = 1}

// ПЗУ БЕЙСИКа подключает разряд 3 записи в 0177130 (линии BAS1/BAS2)
mapper:~config[3] = a16m.basic[0]

// Плата первой: по каждому адресу окна она сама решает, ответить,
// оставить адрес машине или не ответить никому
@before mapper:@memory[100000-117777]
mapper:@memory[100000-177777] = a16m {routed = 1}

// БЕЙСИК с разрядом 3 закрывает и регистры контроллера: его диапазоны
// стоят перед ними
@before mapper:@memory[177660-177661]
mapper:@memory[10:10][120000-137777] = basic1 {mode = r, strict = 1}
mapper:@memory[10:10][140000-157777] = basic2 {mode = r, strict = 1}
mapper:@memory[10:10][160000-177377] = basic3 {mode = r, strict = 1}
mapper:@memory[177130-177133] = fdc
