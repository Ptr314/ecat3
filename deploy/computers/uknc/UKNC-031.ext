@extends uknc/UKNC.cfg
@version УК-НЦ (БМК К1515ХМ1-031)
@protected

// Машина с ранним БМК К1515ХМ1-031. Основная конфигурация подобрана под
// машину с доработанным К1515ХМ2-001; на машине с ранним периферийный процессор
// читает память на 4 такта медленнее (MOV R0,R1 20 тактов против 16), его
// ПЗУ и регистры - тоже. Числа - по тестам Alex_K на машине литеры 7 с этим
// кристаллом (tools/uknc-timing): чтение ПЗУ и регистров 32 такта, SOB в
// ПЗУ 26 (PSOB1 - 0.6 такта), пультовые команды (PHLT) - 0.3, таблицы команд
// ПП - 0.05. Первые две микросхемы ПЗУ (100000-137777) выбирают код
// медленнее остальных, как и с К1515ХМ2-001: с ответом 560 данные из них
// по-прежнему читаются за 32 такта, а таблицы перестают обгонять машину на
// 1.4 такта (в замере идут обработчики прерываний ПП). SOB в ПЗУ (PSOB1, по
// 170624) это не трогает. Центральный процессор тот же: его время подобрано
// по обеим машинам сразу

ppu-mem:setup = _480
ppu-mem:reply = _640
ppu-mem:reply_write = _80
ppu-mem:reply_write_byte = _80
ppu-mem:read = _2720
ppu-mem:write = _2080
ppu-mem:write_byte = _1920

ppu-io:reply = _160
ppu-rom-low:reply = _560

// Регистры (PRDWR1): чтение 32 такта, запись в каналы и прочие 28, в
// регистры видеоконтроллера 32, в 177010 - 36, в 177012 и 177030 - 40;
// чтение-запись у регистров видеоконтроллера на 4 такта дольше прочих
ppu-regs:reply = _560
ppu-regs:reply_write = _80
ppu-vc:reply = _560
ppu-vc:reply_write = _560
ppu-vc-draw:reply = _560
ppu-vc-draw:reply_write = _560
ppu-vc-addr:reply = _560
ppu-vc-addr:reply_write = _1200
ppu-vc-slow:reply = _560
ppu-vc-slow:reply_write = _1840
ppu-vc-slow:reply_write_byte = _1360
