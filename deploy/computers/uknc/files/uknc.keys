// Клавиши самой машины: то, что нарисовано на ms7007_keyboard.svg. Слева имя
// клавиши МС7007, оно же идентификатор элемента рисунка, справа её НОМЕР -
// контроллер отдаёт номер клавиши, а не код символа; при отпускании в
// регистре 177702 разряд 7 и только младшая тетрада номера.
//
// Поэтому модификаторов вида /S здесь нет и быть не может: регистровые
// клавиши (НР, УПР, ГРАФ, АЛФ, ФИКС) имеют собственные номера, а в символы
// всё это переводит ПЗУ машины - оно строит пять таблиц раскладки и выбирает
// нужную по нажатой регистровой клавише.
//
// Номера сняты с ПЗУ самой машины. Драйвер клавиатуры (103554-107743) считает
// адрес в таблице раскладки как
//
//      индекс = номер - поправка[номер >> 4],   поправка = 5,12,17,24,31,36,43,50
//
// а таблица содержит 0o130 = 88 элементов. Отсюда матрица: восемь групп по
// одиннадцать клавиш, младшая тетрада номера идёт от 5 до 17, и
//
//      индекс = 11 * (номер >> 4) + (номер & 17) - 5
//
// Номера 45 и 65 матрица имеет, а клавиш на них нет: во всех пяти таблицах
// они пустые. СТОП стоит особняком - его номер 4 в таблицу не попадает
// вовсе, потому что его ловит сама п/п прерывания (175412: `CMPB @7200,#4`)
// и ставит центральному процессору сигнал HALT.
//
// Числа восьмеричные: у машины radix = 8.

// --- Регистровые клавиши ----------------------------------------------
// Все они на машине удерживаются, а указатель на рисунке удержать не может,
// поэтому объявлены как hold: щелчок прижимает, второй отпускает. Кода
// клавиши это не отменяет - номер уходит машине и при нажатии, и при
// отпускании, как у всех остальных.
//
// НР - это Shift, УПР - Ctrl, ГРАФ даёт псевдографику, ФИКС фиксирует
// регистр, а АЛФ на время своего нажатия переключает алфавит (посылает 016
// и 017). Насовсем алфавит переключают УПР+N и УПР+O.
hold: key_shift_1
hold: key_shift_2
hold: key_ctrl
hold: key_graf
hold: key_alf
hold: key_fiks

// --- Верхний ряд ------------------------------------------------------
key_k1:         &10     // К1 - К5 программируются в меню УСТАНОВКА и во всех
key_k2:         &11     // пяти регистрах дают свою строку, отсюда «К1 - К25»
key_k3:         &12
key_k4:         &14
key_k5:         &15
key_pom:        &172    // ПОМ - в основном регистре ESC ~, с УПР режим ИСУ
key_ust:        &152    // УСТ - меню УСТАНОВКА
key_isp:        &151    // ИСП - ESC DEL, с УПР печать экрана
key_reset:      &171    // СБРОС - код 014, очистка экрана (не сброс машины!)
key_stop:       &4      // СТОП - ПЗУ ставит по нему HALT центральному

// --- Цифровой ряд -----------------------------------------------------
key_ar2:        &6      // АР2 - это ESC (033)
key_1:          &30
key_2:          &31
key_3:          &32
key_4:          &13
key_5:          &34
key_6:          &35
key_7:          &16
key_8:          &17
key_9:          &177
key_0:          &176
key_minus:      &175    // - =
key_slash:      &173    // / ?
key_bksp:       &132    // ЗБ, код 177

// --- Буквенные ряды ---------------------------------------------------
// Раскладка ЙЦУКЕН, а латинская буква на клавише - та, что делит с русской
// код КОИ-7: Й и J, Ц и C, У и U. Ровно как у БК.
key_tab:        &26
key_j:          &27     // Й
key_c:          &50     // Ц
key_u:          &51     // У
key_k:          &52     // К
key_e:          &33     // Е
key_n:          &54     // Н
key_g:          &55     // Г
key_lbr:        &36     // Ш [
key_rbr:        &37     // Щ ]
key_z:          &157    // З
key_h:          &156    // Х
key_under:      &155    // Ъ _
key_colon:      &174    // : *
key_enter:      &153    // ВК

key_f:          &47     // Ф
key_y:          &70     // Ы
key_w:          &71     // В
key_a:          &72     // А
key_p:          &53     // П
key_r:          &74     // Р
key_o:          &75     // О
key_l:          &56     // Л
key_d:          &57     // Д
key_v:          &137    // Ж
key_bksl:       &136    // Э \
key_dot:        &135    // . >

key_q:          &67     // Я
key_caret:      &110    // Ч ^
key_s:          &111    // С
key_m:          &112    // М
key_i:          &73     // И
key_t:          &114    // Т
key_x:          &115    // Ь
key_b:          &76     // Б
key_at:         &77     // Ю @
key_comma:      &117    // , <
key_semi:       &7      // ; +
key_space:      &113

// --- Стрелки ----------------------------------------------------------
// В основном регистре они не дают ничего: последовательности ESC A - ESC D
// лежат в таблице ГРАФ-регистра.
key_up:         &154
key_down:       &134
key_left:       &116
key_right:      &133

// --- Цифровой блок ----------------------------------------------------
// Под НР блок даёт четыре знака действий: + становится *, - становится /.
key_num_0:      &126
key_num_1:      &127
key_num_2:      &147
key_num_3:      &167
key_num_4:      &130
key_num_5:      &150
key_num_6:      &170
key_num_7:      &125
key_num_8:      &145
key_num_9:      &165
key_num_dot:    &146
key_num_comma:  &5
key_num_minus:  &25
key_num_plus:   &131
key_num_enter:  &166    // ВВОД

// Обе клавиши НР дают один номер: для ПЗУ это одна и та же клавиша.
key_shift_1:    &105
key_shift_2:    &105
key_ctrl:       &46     // УПР
key_graf:       &66     // ГРАФ
key_alf:        &106    // АЛФ
key_fiks:       &107    // ФИКС
