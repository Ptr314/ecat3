// Клавиши клавиатуры 15ВВВ-97-006: то, что нарисовано на 15vvv_keyboard.svg.
// В отличие от irisha.map, где слева стоит клавиша хоста, здесь слева -- имя
// клавиши машины, и оно же служит идентификатором элемента в рисунке.
//
// Коды взяты из ПЗУ-шифратора самой клавиатуры (15bbb.rt5, дамп в MAME,
// src/devices/machine/ie15_kbd.cpp): адрес в нем складывается из строки и
// столбца матрицы плюс линий РУС/ЛАТ и регистра, на каждую клавишу ровно один
// байт. Двухбайтных последовательностей клавиатура не отдает -- ESC-коды
// стрелок собирает прошивка терминала 15ИЭ, а Ириша получает код как есть.
//
// Модификаторы:
//   /S -- Shift хоста, удерживается;
//   /C -- СУ, удерживается: шифратор обрезает код до пяти бит;
//   /L -- форма, которую выбирает защелка регистра ВР / НР;
//   /R -- запись для русского регистра.
//
// Регистр тут не буквенный, как ЗАГЛ и СТР у БК, а полный: НР дает и строчные
// буквы, и знаки цифрового ряда (1 -> !). ВР -- состояние по умолчанию, как и
// m_case_lower = false после сброса.
//
// Коды семибитные, как их отдает клавиатура. Бит 7 в русском регистре ставит
// само ПЗУ Ириши, по своему флагу, который ведет от кодов $0E и $0F: после
// $0E код $66 печатает Ф, $46 -- ф, $7E -- Ч, а цифры ПЗУ не трогает вовсе;
// после $0F бит 7 снимается. По той же причине на семибитные коды переведена
// и irisha.map, где слева стоят клавиши хоста.
//
// Почему /R есть у цифр и нет у букв. У букв русский регистр переставляет коды
// местами ($46 <-> $66), и это ровно та перестановка, которую делает
// case_shift() (keyboard.h): две инверсии гасят друг друга, и записи /R
// буквам не нужны. У цифр и знаков коды от регистра не зависят, а инверсия
// применяется все равно -- ее и отменяют перевернутые записи /R и /RL.

ctrl:       key_ctrl     // СУ
case-upper: key_upcase   // ВР, верхний регистр
case-lower: key_lowcase  // НР, нижний регистр
rus-on:     key_rus      // РУС, посылает $0E и переключает регистр
rus-off:    key_lat      // ЛАТ, посылает $0F

// --- Цифровой ряд -----------------------------------------------------
// Верхняя надпись -- ВР, нижняя -- НР.

key_semi:       $3B      // ; +
key_semi/S:     $2B
key_semi/L:     $2B
key_semi/R:     $2B
key_semi/RL:    $3B

key_1:          $31
key_1/S:        $21
key_1/L:        $21
key_1/R:        $21
key_1/RL:       $31

key_2:          $32
key_2/S:        $22
key_2/L:        $22
key_2/R:        $22
key_2/RL:       $32

key_3:          $33
key_3/S:        $23
key_3/L:        $23
key_3/R:        $23
key_3/RL:       $33

key_4:          $34
key_4/S:        $24
key_4/L:        $24
key_4/R:        $24
key_4/RL:       $34

key_5:          $35
key_5/S:        $25
key_5/L:        $25
key_5/R:        $25
key_5/RL:       $35

key_6:          $36
key_6/S:        $26
key_6/L:        $26
key_6/R:        $26
key_6/RL:       $36

key_7:          $37
key_7/S:        $27
key_7/L:        $27
key_7/R:        $27
key_7/RL:       $37

key_8:          $38
key_8/S:        $28
key_8/L:        $28
key_8/R:        $28
key_8/RL:       $38

key_9:          $39
key_9/S:        $29
key_9/L:        $29
key_9/R:        $29
key_9/RL:       $39

key_0:          $30

key_minus:      $2D      // - =
key_minus/S:    $3D
key_minus/L:    $3D
key_minus/R:    $3D
key_minus/RL:   $2D

// --- Верхний буквенный ряд: Й Ц У К Е Н Г Ш Щ З Х ---------------------
// Имя клавиши -- по латинской букве на ее колпачке: у 15ВВВ латиница
// стоит на позициях ЙЦУКЕН, а не QWERTY.

key_j:          $4A
key_j/S:        $6A
key_j/L:        $6A
key_j/C:        $0A

key_c:          $43
key_c/S:        $63
key_c/L:        $63
key_c/C:        $03

key_u:          $55
key_u/S:        $75
key_u/L:        $75
key_u/C:        $15

key_k:          $4B
key_k/S:        $6B
key_k/L:        $6B
key_k/C:        $0B

key_e:          $45
key_e/S:        $65
key_e/L:        $65
key_e/C:        $05

key_n:          $4E
key_n/S:        $6E
key_n/L:        $6E
key_n/C:        $0E

key_g:          $47
key_g/S:        $67
key_g/L:        $67
key_g/C:        $07

key_lbr:        $5B      // Ш / [
key_lbr/S:      $7B
key_lbr/L:      $7B
key_lbr/C:      $1B

key_rbr:        $5D      // Щ / ]
key_rbr/S:      $7D
key_rbr/L:      $7D
key_rbr/C:      $1D

key_z:          $5A
key_z/S:        $7A
key_z/L:        $7A
key_z/C:        $1A

key_h:          $48
key_h/S:        $68
key_h/L:        $68
key_h/C:        $08

key_colon:      $3A      // : *
key_colon/S:    $2A
key_colon/L:    $2A
key_colon/R:    $2A
key_colon/RL:   $3A

// --- Средний буквенный ряд: Ф Ы В А П Р О Л Д Ж Э ---------------------

key_f:          $46
key_f/S:        $66
key_f/L:        $66
key_f/C:        $06

key_y:          $59
key_y/S:        $79
key_y/L:        $79
key_y/C:        $19

key_w:          $57
key_w/S:        $77
key_w/L:        $77
key_w/C:        $17

key_a:          $41
key_a/S:        $61
key_a/L:        $61
key_a/C:        $01

key_p:          $50
key_p/S:        $70
key_p/L:        $70
key_p/C:        $10

key_r:          $52
key_r/S:        $72
key_r/L:        $72
key_r/C:        $12

key_o:          $4F
key_o/S:        $6F
key_o/L:        $6F
key_o/C:        $0F

key_l:          $4C
key_l/S:        $6C
key_l/L:        $6C
key_l/C:        $0C

key_d:          $44
key_d/S:        $64
key_d/L:        $64
key_d/C:        $04

key_v:          $56
key_v/S:        $76
key_v/L:        $76
key_v/C:        $16

key_bksl:       $5C      // Э / \
key_bksl/S:     $7C
key_bksl/L:     $7C
key_bksl/C:     $1C

key_dot:        $2E      // . >
key_dot/S:      $3E
key_dot/L:      $3E
key_dot/R:      $3E
key_dot/RL:     $2E

key_bksp:       $7F      // ЗБ

// --- Нижний буквенный ряд: Я Ч С М И Т Ь Б Ю --------------------------
// Клавиша Ъ / _ в русском регистре отдает $7F, и Ъ из него не выходит:
// монитор Ириши разбирает $7F как стирание символа раньше, чем ставит
// бит 7 (проверено -- две Ф и $7F оставляют на экране одну). Так ведет
// себя и настоящая 15ВВВ на Ирише, поэтому код оставлен как есть; в
// irisha.map, где слева клавиша хоста, у ] на этот случай стоит $FF.

key_q:          $51
key_q/S:        $71
key_q/L:        $71
key_q/C:        $11

key_caret:      $5E      // Ч / ^
key_caret/S:    $7E
key_caret/L:    $7E
key_caret/C:    $1E

key_s:          $53
key_s/S:        $73
key_s/L:        $73
key_s/C:        $13

key_m:          $4D
key_m/S:        $6D
key_m/L:        $6D
key_m/C:        $0D

key_i:          $49
key_i/S:        $69
key_i/L:        $69
key_i/C:        $09

key_t:          $54
key_t/S:        $74
key_t/L:        $74
key_t/C:        $14

key_x:          $58
key_x/S:        $78
key_x/L:        $78
key_x/C:        $18

key_b:          $42
key_b/S:        $62
key_b/L:        $62
key_b/C:        $02

key_at:         $40      // Ю / @
key_at/S:       $60
key_at/L:       $60
key_at/C:       $00

key_comma:      $2C      // , <
key_comma/S:    $3C
key_comma/L:    $3C
key_comma/R:    $3C
key_comma/RL:   $2C

key_slash:      $2F      // / ?
key_slash/S:    $3F
key_slash/L:    $3F
key_slash/R:    $3F
key_slash/RL:   $2F

key_under:      $5F      // Ъ / _
key_under/S:    $7F
key_under/L:    $7F
key_under/C:    $1F

key_space:      $20      // пробел

// --- Служебные клавиши ------------------------------------------------
// Регистр их не меняет: в ПЗУ у этих столбцов один код на все блоки.
key_tab:        $18      // ТАБ
key_ht:         $09      // ГТ
key_sbr:        $0C      // СБР
key_str:        $1F      // СТР
key_sts:        $0B      // СТС
key_ps:         $0A      // ПС
key_enter:      $0D      // ВК
key_ar1:        $10      // АР1
key_c1:         $01      // С1
key_ar2:        $1B      // АР2
key_prd:        $1E      // ПРД
key_prm:        $11      // ПРМ
key_prs:        $06      // ПРС
key_rus:        $0E      // РУС
key_lat:        $0F      // ЛАТ

// --- Блок управления курсором -----------------------------------------
// Стрелки подтверждены трижды: ПЗУ клавиатуры, исходник ИРИТЕКСТа
// (KEY_UP EQU 1CH, KEY_DN EQU 1DH, ^Y -- вправо, ^Z -- влево) и irisha.map.
key_begin:      $15
key_up:         $1C
key_num_enter:  $0D      // ВК цифрового блока
key_left:       $1A
key_home:       $08
key_right:      $19
key_del:        $14
key_down:       $1D
key_ins:        $13
key_pgdn:       $16
key_setup_next: $02
key_pgup:       $12

// --- Цифровой блок ----------------------------------------------------
// Шлет то же, что и цифровой ряд: у 15ИЭ блок отличается только линией ДК,
// а к Ирише она не подведена. Записан после основного ряда, чтобы подсветка
// от набора на хосте зажигала ряд, а не блок.
key_num_7:      $37
key_num_8:      $38
key_num_9:      $39
key_num_4:      $34
key_num_5:      $35
key_num_6:      $36
key_num_1:      $31
key_num_2:      $32
key_num_3:      $33
key_num_0:      $30
key_num_comma:  $2C
// Своего кода не имеют и потому в теле таблицы не значатся: key_ctrl,
// key_upcase, key_lowcase -- они объявлены в заголовке.
//
// Нарисованы, но в матрицу клавиатуры не входят и здесь не описаны:
// key_red, key_dup, key_lin, key_pch, key_sdv (переключатели режимов
// терминала 15ИЭ) и key_ochs. К Ирише они не подключены, и без записи в
// таблице рисунок их просто не предлагает нажать.
