# Экран Спектрума во второй банке: чистим битовую карту, атрибуты - чёрное на
# белом, а верхняя строка под счёт - яркая красная
COMMAND ram.fill($14000,$157FF,$00)
COMMAND ram.fill($15800,$15AFF,$38)
COMMAND ram.fill($15800,$1581F,$42)

# ВГ75 и ВТ57 теми же словами, что пишет ZX.COM
COMMAND vg75.set($01,$00)
COMMAND vg75.set($00,$4F)
