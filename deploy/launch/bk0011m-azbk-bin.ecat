# Программа БК (.bin: адрес загрузки и длина по слову, затем данные) на БК0011М
# с контроллером AZBK.
#
# Стартовое ПЗУ платы проходит проверки (около десяти секунд) и грузит ANDOS с
# AZ0 (andos330.img поставки): к 15-й секунде система в памяти, БОС и его EMT
# работают, ANDOS ждет клавишу на заставке. Тогда при остановленном процессоре -
# раскладка страниц пользователя (034401: в окне 040000 страница 3, в окне
# 0100000 ПЗУ), как в bk0011m-bin.ecat, программа в память и пуск с адреса
# загрузки с PSW = 0. Запись в 0177716 и LOAD идут через маппер, поэтому теневые
# окна AZBK видят их так же, как запись процессора.
#
# Стек - под программой, SP = 01000, как у Монитора БК0010 и у программ из
# ANDOS, а не 02000 команды G БОС: программы для AZBK пишутся под ANDOS. Тест
# видео MAXIOL AZVIDT24 (с 01000, 11 КБ) сразу кладет в стек 15 слов и с
# SP = 02000 затирал свой код (work-bk0011m-azbk-azvidt).
#
# Заставка ANDOS живет в младших адресах, и векторы 4 (ошибка шины и HALT) и 0100
# (кадровое прерывание) смотрят в нее, на 003626 и 004556 - туда, куда ляжет
# программа. Они ставятся как у БОС: 4 - его обработчик 0140772, 0100 - на 0102,
# где лежит RTI (002). Иначе первое же кадровое прерывание уводит длинную
# программу в ее собственные данные (platform-azbk-bin).
#
# Подставляются: file - программа, load_address - адрес, куда ее положил LOAD
# (в системе счисления машины, у БК восьмеричной).
MACHINE "bk/BK-0011M-azbk.ext"
WAIT _15000
COMMAND cpu.stop()
COMMAND mapper.set16(4, 140772, 2340)
COMMAND mapper.set16(100, 102, 2)
COMMAND mapper.set16(177716, 34401)
LOAD "${file}"
COMMAND cpu.setreg(PSW, 0)
COMMAND cpu.setreg(SP, 1000)
COMMAND cpu.setreg(PC, ${load_address})
COMMAND cpu.run()
