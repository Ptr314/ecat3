# Программа БК (.bin: адрес загрузки и длина по слову, затем данные) на БК0010-01.
#
# Из Бейсика в Монитор, затем при остановленном процессоре: программа в память и
# пуск с адреса загрузки в том состоянии, в каком ее пускает директива S Монитора
# (0100366: CALL (R5) из главного цикла, где SP = 01000): SP = 0776, на вершине
# стека адрес возврата в Монитор 0100400, PSW = 0. RTS PC в конце программы
# возвращает в Монитор.
#
# Регистры ставятся сами, а не директивой S: программа, которая при загрузке
# затирает Монитору его область, не дала бы ее набрать (на БК0011М так
# затирается стек БОС, см. bk0011m-bin.ecat).
#
# Подставляются: file - программа, load_address - адрес, куда ее положил LOAD
# (в системе счисления машины, у БК восьмеричной).
MACHINE "bk/BK-0010-01.cfg"
WAIT _3000
TYPE "MO\n"
WAIT _1000
COMMAND cpu.stop()
# До LOAD: программа, которая сама занимает 0776, остается целой
COMMAND mapper.set16(776, 100400)
LOAD "${file}"
COMMAND cpu.setreg(PSW, 0)
COMMAND cpu.setreg(SP, 776)
COMMAND cpu.setreg(PC, ${load_address})
COMMAND cpu.run()
