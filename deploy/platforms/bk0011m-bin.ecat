# Программа БК (.bin: адрес загрузки и длина по слову, затем данные) на БК0011М.
#
# Из Бейсика в Монитор БОС, затем при остановленном процессоре: страницы
# пользователя, программа в память и пуск с адреса загрузки - то, что делает
# команда G БОС (подпрограмма 0142234). Она включает раскладку страниц
# пользователя из 040402 (034401: в окне 040000 страница 3, в окне 0100000 ПЗУ),
# берет SP из 040420 (02000) и ставит PSW = 0.
#
# Саму команду G набрать нельзя: в Мониторе в окне 040000 стоит рабочая страница
# БОС (5) с его стеком (SP = 043500), и программа, которая доходит до 040000,
# затирает его при загрузке - Монитор виснет, не дождавшись G. Поэтому и
# раскладка пользователя включается до LOAD: верх длинной программы ложится в
# страницы, с которыми она будет работать, а не в страницу БОС.
#
# Подставляются: file - программа, load_address - адрес, куда ее положил LOAD
# (в системе счисления машины, у БК восьмеричной).
MACHINE "bk/BK-0011M.cfg"
WAIT _3000
TYPE "MO\n"
WAIT _1000
COMMAND cpu.stop()
COMMAND mapper.set16(177716, 34401)
LOAD "${file}"
COMMAND cpu.setreg(PSW, 0)
COMMAND cpu.setreg(SP, 2000)
COMMAND cpu.setreg(PC, ${load_address})
COMMAND cpu.run()
