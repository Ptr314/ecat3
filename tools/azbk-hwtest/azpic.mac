; AZPIC - картинки платы AZBK для вопросов Б.9 (палитры слоеных режимов 4 и
; 5) и Б.10 (горизонтальный скролл за длину строки). Каждую картинку надо
; сфотографировать: где толкования расходятся, картинка выходит заметно иной
; (tools/azbk-hwtest/README.md). Запуск из ANDOS (с 01000), клавиша - дальше.
; Собирается tools/azbk-hwtest/asm11.py (build.py).

WPAG7   = 177316
WACT    = 177340
WRO     = 177342
WSHD    = 177344
VMODE   = 177230
VPG0    = 177232
PALI    = 177234
PALV    = 177236
VPG1    = 177240
VPG2    = 177242
VSC2    = 177244
VSC1    = 177246
VSC0    = 177250
HSC0    = 177252
HSC1    = 177254
HSC2    = 177256
BKPAL   = 177662                ; 11-8 палитра, 14 - запрет кадрового прерывания
SAVBUF  = 30000                 ; ОЗУ БК под окном 7
L0PG    = 1210                  ; слои: по 4 страницы (8192 слова)
L1PG    = 1214
L2PG    = 1220
HSPG    = 1230                  ; картинка 3: 3 страницы

        . = 1000
START:  MTPS    #340
        MOV     @#100,SV100             ; кадровое прерывание - на RTI, пока
        MOV     @#102,SV102             ; программа держит 177662
        MOV     #RTIV,@#100
        MOV     #340,@#102
        MTPS    #0
        MOV     #14,R0
        EMT     16
        MOV     #T.HEAD,R1
        JSR     PC,PRS
        MOV     #VREGS,R2               ; регистры видео как есть
        MOV     #VSAVE,R3
        CLR     R4
1$:     MOV     (R2)+,R0
        BEQ     2$
        MOV     (R0),(R3)
        JSR     PC,PROCT
        MOV     #'=,R0
        EMT     16
        MOV     (R3)+,R0
        JSR     PC,PROCT
        MOV     #' ,R0
        EMT     16
        INC     R4
        CMP     R4,#4
        BNE     1$
        CLR     R4
        JSR     PC,NL
        BR      1$
2$:     JSR     PC,NL
        MOV     #12100,@#VMODE          ; текст - черно-белым (при выходе вернется)
        MOV     #PCELLS,R2              ; ячейки палитры, которые меняются
        MOV     #PSAVE,R3
3$:     MOV     (R2)+,R0
        CMP     R0,#177777
        BEQ     4$
        MOV     R0,@#PALI
        MOV     @#PALV,(R3)+
        BR      3$
4$:     MOV     #7,@#PALI               ; читается ли палитра
        MOV     #12345,@#PALV
        MOV     #7,@#PALI
        MOV     @#PALV,R0
        CLR     PALRD
        CMP     R0,#12345
        BNE     5$
        INC     PALRD
5$:     MOV     R0,-(SP)
        MOV     #T.PAL,R1
        JSR     PC,PRS
        MOV     (SP)+,R0
        JSR     PC,PROCT
        JSR     PC,NL
        MOV     #T.HELP,R1
        JSR     PC,PRS
        JSR     PC,WAITK

;------------------------------------------------- 1. режим 4: восемь полос
        MTPS    #340
        JSR     PC,WSAVE
        MOV     #PAL1,R1
        JSR     PC,SETPAL
        MOV     #RT1,ROWFN
        MOV     #400,R4
        MOV     #360,R2                 ; слой 0 - полосы 4-7
        JSR     PC,B4
        MOV     #L0PG,R0
        JSR     PC,FILLR
        MOV     #314,R2                 ; слой 1 - 2, 3, 6, 7
        JSR     PC,B4
        MOV     #L1PG,R0
        JSR     PC,FILLR
        MOV     #252,R2                 ; слой 2 - 1, 3, 5, 7
        JSR     PC,B4
        MOV     #L2PG,R0
        JSR     PC,FILLR
        JSR     PC,WREST
        JSR     PC,LAYERS
        MOV     #12104,@#VMODE          ; рулон 8192, строка x3, точка x2, 1 бит, слои
        JSR     PC,WAITK

;--------------------------------------- 2. режим 5: три слоя, палитра p = 4
        MTPS    #340
        MOV     #42000,@#BKPAL          ; p = 4 (и запрет кадрового прерывания)
        JSR     PC,WSAVE
        MOV     #PAL2,R1
        JSR     PC,SETPAL
        MOV     #RT2,ROWFN
        CLR     R0                      ; слой 0: слова 0-9 сверху, 0-9 снизу
        MOV     #10.,R4
        JSR     PC,B5
        MOV     #400,R4
        MOV     #L0PG,R0
        JSR     PC,FILLR
        MOV     #24,R0                  ; слой 1: 10-19 сверху, 0-20 снизу
        MOV     #21.,R4
        JSR     PC,B5
        MOV     #400,R4
        MOV     #L1PG,R0
        JSR     PC,FILLR
        MOV     #50,R0                  ; слой 2: 20-29 сверху, 0-31 снизу
        MOV     #32.,R4
        JSR     PC,B5
        MOV     #400,R4
        MOV     #L2PG,R0
        JSR     PC,FILLR
        JSR     PC,WREST
        JSR     PC,LAYERS
        MOV     #12205,@#VMODE          ; рулон 8192, строка x3, точка x4, 2 бита, слои
        JSR     PC,WAITK
        MTPS    #340
        MOV     #40000,@#BKPAL          ; p = 0

;------------------------------- 3. скролл 16 слов при строке 32 слова
        JSR     PC,WSAVE
        MOV     #PAL3,R1
        JSR     PC,SETPAL
        JSR     PC,B3
        MOV     #RT3,ROWFN
        MOV     #300,R4
        MOV     #HSPG,R0
        JSR     PC,FILLR
        JSR     PC,WREST
        JSR     PC,LAYERS
        MOV     #HSPG,@#VPG0
        MOV     #20,@#HSC0
        MOV     #3100,@#VMODE           ; рулон 6144, строка x4, точка x2, 1 бит
        JSR     PC,WAITK

;------------------------------------------------------- все как было
        MTPS    #340
        MOV     #VREGS,R2
        MOV     #VSAVE,R3
6$:     MOV     (R2)+,R0
        BEQ     7$
        CMP     R0,#VMODE
        BEQ     8$
        MOV     (R3),(R0)
8$:     TST     (R3)+
        BR      6$
7$:     MOV     VSAVE,@#VMODE
        TST     PALRD
        BEQ     10$
        MOV     #PCELLS,R2
        MOV     #PSAVE,R3
9$:     MOV     (R2)+,R0
        CMP     R0,#177777
        BEQ     10$
        MOV     R0,@#PALI
        MOV     (R3)+,@#PALV
        BR      9$
10$:    MOV     SV100,@#100
        MOV     SV102,@#102
        MTPS    #0
        MOV     #T.END,R1
        TST     PALRD
        BNE     11$
        MOV     #T.ENDNP,R1
11$:    JSR     PC,PRS
        EMT     6
        JMP     @#100000

;================================================================ подпрограммы
RTIV:   RTI

PRS:    MOVB    (R1)+,R0
        BEQ     1$
        EMT     16
        BR      PRS
1$:     RTS     PC

NL:     MOV     #12,R0
        EMT     16
        RTS     PC

PROCT:  MOV     R0,-(SP)
        MOV     R1,-(SP)
        MOV     R2,-(SP)
        MOV     R0,R1
        CLR     R0
        ASL     R1
        ROL     R0
        ADD     #'0,R0
        EMT     16
        MOV     #5,R2
1$:     CLR     R0
        ASL     R1
        ROL     R0
        ASL     R1
        ROL     R0
        ASL     R1
        ROL     R0
        ADD     #'0,R0
        EMT     16
        SOB     R2,1$
        MOV     (SP)+,R2
        MOV     (SP)+,R1
        MOV     (SP)+,R0
        RTS     PC

WAITK:  MTPS    #0
        EMT     6
        RTS     PC

; Палитра: пары ячейка, цвет R5G5B5 до 177777
SETPAL: MOV     (R1)+,R0
        CMP     R0,#177777
        BEQ     1$
        MOV     R0,@#PALI
        MOV     (R1)+,@#PALV
        BR      SETPAL
1$:     RTS     PC

; Слои 0-2 - их страницы, скроллы - нули
LAYERS: MOV     #L0PG,@#VPG0
        MOV     #L1PG,@#VPG1
        MOV     #L2PG,@#VPG2
        CLR     @#VSC0
        CLR     @#VSC1
        CLR     @#VSC2
        CLR     @#HSC0
        CLR     @#HSC1
        CLR     @#HSC2
        RTS     PC

; Окно 7 и ОЗУ БК под ним (070000-077777): сохранить, вернуть
WSAVE:  MOV     @#WPAG7,SW7
        MOV     @#WACT,SACT
        MOV     @#WRO,SRO
        MOV     @#WSHD,SSHD
        BIC     #200,@#WACT
        BIC     #200,@#WSHD
        MOV     #70000,R1
        MOV     #SAVBUF,R2
        MOV     #4000,R3
1$:     MOV     (R1)+,(R2)+
        SOB     R3,1$
        RTS     PC

WREST:  BIC     #200,@#WACT
        BIC     #200,@#WSHD
        MOV     #SAVBUF,R1
        MOV     #70000,R2
        MOV     #4000,R3
1$:     MOV     (R1)+,(R2)+
        SOB     R3,1$
        MOV     SSHD,@#WSHD
        MOV     SRO,@#WRO
        MOV     SW7,@#WPAG7
        MOV     SACT,@#WACT
        RTS     PC

; R4 строк по 32 слова с первой страницы R0: строку R3 дает подпрограмма
; ROWFN (шаблон - в R2); страницы - через окно 7
FILLR:  MOV     R0,CURPG
        CLR     R3
1$:     BIT     #77,R3
        BNE     2$
        MOV     CURPG,@#WPAG7
        BIC     #200,@#WRO
        BIS     #200,@#WACT
        INC     CURPG
        MOV     #70000,R1
2$:     JSR     PC,@ROWFN
        MOV     #40,R0
3$:     MOV     (R2)+,(R1)+
        SOB     R0,3$
        INC     R3
        CMP     R3,R4
        BLO     1$
        BIC     #200,@#WACT
        RTS     PC

RT1:    MOV     #TPL1,R2
        RTS     PC
RT2:    MOV     #TPL1,R2                ; строки 0-127 - TPL1, ниже - TPL2
        CMP     R3,#200
        BLO     1$
        MOV     #TPL2,R2
1$:     RTS     PC
RT3:    MOV     #TPL1,R2                ; четные строки - TPL1, нечетные - TPL2
        BIT     #1,R3
        BEQ     1$
        MOV     #TPL2,R2
1$:     RTS     PC

; Шаблон режима 4: полоса k (4 слова) - 177777, если разряд k маски R2
B4:     MOV     R4,-(SP)
        MOV     #TPL1,R1
        MOV     #10,R4
1$:     CLR     R0
        ROR     R2
        BCC     2$
        MOV     #177777,R0
2$:     MOV     R0,(R1)+
        MOV     R0,(R1)+
        MOV     R0,(R1)+
        MOV     R0,(R1)+
        SOB     R4,1$
        MOV     (SP)+,R4
        RTS     PC

; Шаблоны режима 5: TPL1 - с байта R0 по 3 слова точек 1, 2, 3; TPL2 - R4 слов
; точек 3 с начала
B5:     MOV     #TPL1,R1
        MOV     #100,R2
1$:     CLR     (R1)+
        SOB     R2,1$
        MOV     #TPL1,R1
        ADD     R0,R1
        MOV     #3,R2
2$:     MOV     #52525,(R1)+
        SOB     R2,2$
        MOV     #3,R2
3$:     MOV     #125252,(R1)+
        SOB     R2,3$
        MOV     #3,R2
4$:     MOV     #177777,(R1)+
        SOB     R2,4$
        MOV     #TPL2,R1
5$:     MOV     #177777,(R1)+
        SOB     R4,5$
        RTS     PC

; Шаблоны картинки 3: TPL1 - все точки 1, TPL2 - нули
B3:     MOV     #TPL1,R1
        MOV     #40,R2
1$:     MOV     #177777,(R1)+
        SOB     R2,1$
        MOV     #40,R2
2$:     CLR     (R1)+
        SOB     R2,2$
        RTS     PC

;===================================================================== данные
SV100:  .WORD   0
SV102:  .WORD   0
PALRD:  .WORD   0
CURPG:  .WORD   0
ROWFN:  .WORD   0
SW7:    .WORD   0
SACT:   .WORD   0
SRO:    .WORD   0
SSHD:   .WORD   0
VREGS:  .WORD   VMODE,VPG0,VPG1,VPG2,VSC0,VSC1,VSC2,HSC0,HSC1,HSC2,0
VSAVE:  .BLKW   12
PCELLS: .WORD   0,1,2,3,4,5,6,7
        .WORD   400,401,402,403,404,405,406,407,410,411,412,413
        .WORD   420,421,422,423,424,425,426,427,430,431,432,433
        .WORD   510,511,512,513,514,515,516,517,520,521,177777
PSAVE:  .BLKW   60
TPL1:   .BLKW   40
TPL2:   .BLKW   40

; Цвета R5G5B5 (R - 14-10, G - 9-5, B - 4-0)
; 1: ячейки 328-335 (0510-0517) - восемь цветов по коду L0 L1 L2 (так у
; MAXIOL); 0-7 - восемь серых (так у gid)
PAL1:   .WORD   510,0,511,37,512,1740,513,1777
        .WORD   514,76000,515,76037,516,77740,517,77777
        .WORD   0,0,1,4.*2041,2,9.*2041,3,13.*2041
        .WORD   4,18.*2041,5,22.*2041,6,27.*2041,7,31.*2041
        .WORD   177777
; 2: палитры 0, 1, 2 (ячейки 256-267) - красные, зеленые, синие (так у MAXIOL:
; слой - своя палитра); палитры 4, 5, 6 (272-283) - желтые, голубые, пурпурные
; (так у gid: p + слой, p = 4); точка 0 - темно-серый
PAL2:   .WORD   400,6.*2041,401,12.*2000,402,21.*2000,403,31.*2000
        .WORD   404,6.*2041,405,12.*40,406,21.*40,407,31.*40
        .WORD   410,6.*2041,411,12.,412,21.,413,31.
        .WORD   420,6.*2041,421,12.*2040,422,21.*2040,423,31.*2040
        .WORD   424,6.*2041,425,12.*41,426,21.*41,427,31.*41
        .WORD   430,6.*2041,431,12.*2001,432,21.*2001,433,31.*2001
        .WORD   177777
; 3: ячейки 336, 337 - черный и белый
PAL3:   .WORD   520,0,521,77777,177777

T.HEAD: .ASCIZ  /AZPIC 1.0 eCat3: AZBK video probe (B.9, B.10)/<12>
T.PAL:  .ASCIZ  /Palette cell 7: wrote 012345, read /
T.HELP: .ASCII  /Three pictures; photograph each, then any key./<12>
        .ASCII  /1: mode 4, eight bars. 2: mode 5, three layers./<12>
        .ASCIZ  /3: scroll 16 words over 32-word lines./<12>/-- key --/
T.END:  .ASCIZ  <12>/Done, video and palette restored. Key - ANDOS./
T.ENDNP: .ASCIZ <12>/Done. Palette is not readable: reset to restore/<12>/the colours. Key - ANDOS./
        .EVEN
        .END
