; SPDX-License-Identifier: GPL-3.0-or-later
; Part of the eCat3 project: https://github.com/Ptr314/ecat3
;
; ЯЗС-плеер для Агата-9: меню мелодий .YZ на диске 840 КБ, движок формата
; (FORMAT.md), пульт каналов на экране АЦР-32 и вид трекера на АЦР-64.
; Запускается «Быстропускалкой» V2.0 как единственный защищенный B-файл,
; RTS возвращает в ее меню. Прерывания не используются: SEI все время, такт -
; опрос флага таймера ячейки.
;
; Сборка: as65 -l -n -opalyer.bin player.a65 (build.py)

            include "gen_const.a65"

; --- Память ---
SCREEN      equ $1000           ; страница АЦР-32 / АЦР-64 (режимы $0A / $8A)
SONGLD      equ $3EFC           ; сюда грузится тело B-файла (4 байта ДОС + .YZ)
YZ          equ $3F00           ; начало .YZ; смещения файла + YZ = адреса
SONGTOP     equ $C0             ; страница, выше которой мелодия не помещается
ZPSAVE      equ $0400
BUF         equ $0800           ; сектор каталога
TSBUF       equ $0900           ; список T/S
DIRTAB      equ $0A00           ; 48 файлов по 32 байта: дорожка и сектор списка, имя
MAXFILES    equ 48

; --- Нулевая страница (вся сохраняется и восстанавливается) ---
zt          equ $02             ; указатели
ip          equ $04
scr         equ $06
bufp        equ $08
str         equ $0A
t0          equ $0C
t1          equ $0D
t2          equ $0E
t3          equ $0F
tick        equ $10
speed       equ $11
row         equ $12
frows       equ $13
frame       equ $14
frames      equ $15
loopf       equ $16
jump        equ $17
brkf        equ $18
text        equ $19
ended       equ $1A
ntimer      equ $1B
card        equ $1C             ; слот ЯЗС * 16
fdc         equ $1D             ; слот контроллера 840 * 16
tcnt        equ $1E             ; счетчик тиков (2) - для проверки по yazs.irqs
patp        equ $20             ; указатели паттернов каналов 0-7 (16)
ch          equ $30
ch2         equ $31
tot         equ $32             ; высота (2)
per         equ $34             ; период (2)
oct         equ $36
mpos        equ $37
moff        equ $38
mval        equ $39
vibv        equ $3A
ordp        equ $3C             ; адрес таблицы кадров (2)
ptabp       equ $3E             ; таблица паттернов (2)
itabp       equ $40             ; таблица инструментов (2)
ttabp       equ $42             ; таблица подписей (2)
ltrk        equ $44             ; диск: логическая дорожка, сектор, текущий цилиндр
lsec        equ $45
curcyl      equ $46
tcyl        equ $47
retry       equ $48
tries       equ $49
csum        equ $4A
tolo        equ $4B
tohi        equ $4C
nfiles      equ $4D
sel         equ $4E
key         equ $4F
view        equ $50             ; 0 - пульт, 1 - трекер
playall     equ $51
uistep      equ $52
secacc      equ $53             ; накопитель секунд (2)
secs        equ $55             ; прошло секунд (2)
textchg     equ $57
tail        equ $58             ; тиков звучания после конца
cur         equ $59             ; номер играющего файла
rdtries     equ $5A
flash       equ $5B
tmp16       equ $5C             ; (2)
dirp        equ $5E             ; (2)
col         equ $60
attr        equ $61
lastframe   equ $62
lastrow     equ $63
nstr        equ $64             ; (4) буфер числа
tsidx       equ $68
cattrk      equ $69
catsec      equ $6A
keyrep      equ $6B
uirow       equ $6C
uich        equ $6D
upage       equ $6E
mtop        equ $6F
playing     equ $76
idle        equ $77             ; (2)
idlemin     equ $79             ; (2)
idletick    equ $7B             ; (2)

; --- Переменные каналов ($0500-$07FF) ---
c_ins       equ $0500           ; по 8 байт: каналы 0-4 (тоны), 5-6 ударные
c_pend      equ $0508
c_pnote     equ $0510
c_pins      equ $0518
c_delay     equ $0520
c_cut       equ $0528
c_cutreq    equ $0530
c_state     equ $0538
c_regpos    equ $0540
c_arppos    equ $0548
c_pitpos    equ $0550
c_curlo     equ $0558
c_curhi     equ $0560
c_tgtlo     equ $0568
c_tgthi     equ $0570
c_porta     equ $0578
c_slide     equ $0580
c_arpfx     equ $0588
c_arpph     equ $0590
c_vibfx     equ $0598
c_vibcnt    equ $05A0
c_vibph     equ $05A8
c_det       equ $05B0
c_bus       equ $05B8
c_trem      equ $05C0
c_tremph    equ $05C8
c_trans     equ $05D0
c_retrig    equ $05D8
c_retcnt    equ $05E0
c_lreg      equ $05E8
c_lperlo    equ $05F0
c_lperhi    equ $05F8
c_meter     equ $0600
c_note      equ $0608
c_wait      equ $0610           ; 8 каналов
c_uins      equ $0618           ; показанный инструмент (экран)
c_unote     equ $0620           ; показанная нота
c_ureg      equ $0628           ; показанный регистр
c_umeter    equ $0630
d_pend      equ $0638           ; ударные 5, 6 (индекс канала - 5)
d_preset    equ $063A
regoff      equ $0640           ; card + 8 + канал (8 байт)
cntoff      equ $0648           ; card + адрес счетчика тона (5)
c_pdirty    equ $0650           ; высоту пересчитать

            org $1800

; === Вход ===================================================================

start       php
            sei
            ldx #0
sv_zp       lda $00,x
            sta ZPSAVE,x
            inx
            bne sv_zp
            ; Слот контроллера - его оставила «Быстропускалка» в $F6;
            ; иначе 5
            lda $F6
            and #$70
            cmp #$10
            bcs st_fdcok
            lda #$50
st_fdcok    sta fdc
            lda #$10            ; ЯЗС по умолчанию в слоте 1
            sta card
            tsx
            stx savesp
            jsr card_init
            lda #0
            sta view
            sta sel
            sta playall
            sta playing
            jsr scan_disk
main_menu   jsr menu
            ; A: 0 - выход, 1 - играть sel
            beq quit
            jsr play_file
            jmp main_menu

quit        jsr card_off
            jsr dsk_off
            ldx #0
rs_zp       lda ZPSAVE,x
            sta $00,x
            inx
            bne rs_zp
            sta $C70A           ; экран загрузчика: АЦР-32, $1000
            sta $C058           ; палитра 1
            sta $C05A
            ; В монитор (приглашение «*»): RTS вернул бы в «Быстропускалку», а она
            ; сразу запустила бы единственный защищенный файл - плеер - снова
            ldx #$FF
            txs
            jsr $FDEB           ; очистка экрана монитором (COUT $8C)
            jmp $FF65

savesp      db 0

; === Ячейка =================================================================

; Сначала стоп счета и прерываний (после включения счетчики ВИ53 стоят в
; случайных режимах), режим 3 всем шести счетчикам, тишина в каналах, такт
card_init   ldy card
            lda #$C0
            sta $C08F,y
            lda #$36
            sta $C083,y
            lda #$76
            sta $C083,y
            lda #$B6
            sta $C083,y
            lda #$36
            sta $C087,y
            lda #$76
            sta $C087,y
            lda #$B6
            sta $C087,y
            ldx #0
ci_cnt      lda cntraw,x
            clc
            adc card
            tay
            lda #$E8            ; 1000 - тон без звука (канал выключен)
            sta $C080,y
            lda #$03
            sta $C080,y
            inx
            cpx #5
            bne ci_cnt
            ; Смещения регистров каналов
            ldx #0
ci_off      txa
            clc
            adc #8
            adc card
            sta regoff,x
            inx
            cpx #8
            bne ci_off
            ldx #0
ci_coff     lda cntraw,x
            clc
            adc card
            sta cntoff,x
            inx
            cpx #5
            bne ci_coff
            jsr card_silence
            lda #80
            sta ntimer
            jsr set_timer
            ldy card
            lda #$40            ; счет и прерывание таймера разрешены, внешнее - нет
            sta $C08F,y
            lda #$80            ; сброс флага (команда защелки счетчика 2)
            sta $C087,y
            rts

cntraw      db 0,1,2,4,5

card_silence
            ldy card
            lda #0
            ldx #7
cs_l        sta $C088,y
            iny
            dex
            bne cs_l
            rts

card_off    jsr card_silence
            ldy card
            lda #$C0
            sta $C08F,y
            lda #$80
            sta $C087,y
            rts

set_timer   ldy card
            lda ntimer
            sta $C086,y
            lda #0
            sta $C086,y
            rts

; Во время долгой работы с экраном: если флаг таймера взведен - сыграть тик.
; Движок портит временные ячейки - они сохраняются. Только при playing
poll_tick   pha
            lda playing
            beq pk_r1
            tya
            pha
            ldy card
            lda $C080,y
            bpl pk_r2
            lda #$80
            sta $C087,y
            txa
            pha
            ldx #13
pk_s        lda zt,x            ; zt, ip, scr, bufp, str, t0-t3
            sta pksave,x
            dex
            bpl pk_s
            lda tmp16
            sta pksave+14
            lda tmp16+1
            sta pksave+15
            jsr eng_tick
            ldx #13
pk_l        lda pksave,x
            sta zt,x
            dex
            bpl pk_l
            lda pksave+14
            sta tmp16
            lda pksave+15
            sta tmp16+1
            pla
            tax
pk_r2       pla
            tay
pk_r1       pla
            rts

pksave      ds 16

; Ждать флаг таймера и сбросить его. Пока ждем - кусочек работы экрана
; idle - проходы ожидания с прошлого тика (по 22 такта), idlemin - наименьшее
; за мелодию: запас времени тика; 0 - тик не уложился
wait_tick   ldy card
            lda $C080,y
            bmi wt_got
            inc idle
            bne wait_tick
            inc idle+1
            bne wait_tick
wt_got      lda #$80
            sta $C087,y
            lda tcnt+1          ; первая секунда - статичный экран, не в счет
            bne wt_cmp
            lda tcnt
            cmp #100
            bcc wt_r
wt_cmp      lda idle+1
            cmp idlemin+1
            bcc wt_min
            bne wt_r
            lda idle
            cmp idlemin
            bcs wt_r
wt_min      lda idle
            sta idlemin
            lda idle+1
            sta idlemin+1
            lda tcnt
            sta idletick
            lda tcnt+1
            sta idletick+1
wt_r        lda #0
            sta idle
            sta idle+1
            rts

            include "engine.a65"
            include "disk.a65"
            include "ui.a65"
            include "gen_tables.a65"

