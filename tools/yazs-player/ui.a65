; SPDX-License-Identifier: GPL-3.0-or-later
; Part of the eCat3 project: https://github.com/Ptr314/ecat3
;
; Экран: меню мелодий и «пульт» каналов (АЦР-32, $1000: знак и атрибут,
; 64 байта на строку), «трекер» (АЦР-64, мелодия по строкам кадра).
; Атрибут АЦР-32: D5 = 1 - знак цветом на черном (иначе фон цветом), D0-D2 -
; RGB, D4 - яркость, D3 - мигание.

KEY_LEFT    equ $88
KEY_RIGHT   equ $95
KEY_UP      equ $99
KEY_DOWN    equ $9A
KEY_ENTER   equ $8D
KEY_ESC     equ $9B
KEY_SPACE   equ $A0

A_WHITE     equ $37
A_GREY      equ $27
A_YELLOW    equ $33
A_CYAN      equ $36
A_GREEN     equ $32
A_RED       equ $31
A_MAGENTA   equ $35
A_BLUE      equ $34
A_DBLUE     equ $24
I_BLUE      equ $14             ; синий фон
I_CYAN      equ $16
I_WHITE     equ $17
I_GREEN     equ $12
I_YELLOW    equ $13
I_RED       equ $11

; --- Примитивы экрана ---

; Курсор: X - строка, Y - колонка (АЦР-32)
at          lda rowlo,x
            sta scr
            lda rowhi,x
            sta scr+1
            tya
            asl a
            clc
            adc scr
            sta scr
            bcc at_1
            inc scr+1
at_1        rts

; Знак A с атрибутом attr
putc        ldy #0
            sta (scr),y
            iny
            lda attr
            sta (scr),y
            lda scr
            clc
            adc #2
            sta scr
            bcc pt_1
            inc scr+1
pt_1        rts

; Строка (str), кончается 0
puts        jsr poll_tick
ps_l        ldy #0
            lda (str),y
            beq ps_r
            jsr putc
            inc str
            bne ps_l
            inc str+1
            bne ps_l
ps_r        rts

; Строка по адресу A (младший) / Y (старший) с курсора, атрибут attr
print       sta str
            sty str+1
            jmp puts

; n знаков (str) с курсора: X = n
putn        ldy #0
            lda (str),y
            stx t3
            jsr putc
            ldx t3
            inc str
            bne pn_1
            inc str+1
pn_1        dex
            bne putn
            rts

; Экран АЦР-32 залить пробелами
clrscr      sta $C70A
            lda #lo(SCREEN)
            sta zt
            lda #hi(SCREEN)
            sta zt+1
            ldx #8
cl_1        ldy #0
cl_2        lda #$A0
            sta (zt),y
            iny
            lda #A_WHITE
            sta (zt),y
            iny
            bne cl_2
            jsr poll_tick
            inc zt+1
            dex
            bne cl_1
            rts

; Атрибут всей строки X = A
row_attr    pha
            ldy #0
            jsr at
            pla
            ldy #1
ra_1        sta (scr),y
            iny
            iny
            cpy #65
            bcc ra_1
            rts

; Две десятичные цифры A (0-99) с курсора
dec2        ldx #$B0
d2_1        cmp #10
            bcc d2_2
            sbc #10
            inx
            bne d2_1
d2_2        pha
            txa
            jsr putc
            pla
            ora #$B0
            jmp putc

; Три цифры A
dec3        ldx #$B0
d3_1        cmp #100
            bcc d3_2
            sbc #100
            inx
            bne d3_1
d3_2        pha
            txa
            jsr putc
            pla
            jmp dec2

; Шестнадцатеричный байт A
hex2        pha
            lsr a
            lsr a
            lsr a
            lsr a
            jsr hexd
            pla
            and #$0F
hexd        cmp #10
            bcc hx_1
            adc #6              ; C = 1: + 7
hx_1        adc #$B0
            jmp putc

; Секунды (tmp16) как ММ:СС
mmss        ldx #0
ms_1        lda tmp16
            sec
            sbc #60
            tay
            lda tmp16+1
            sbc #0
            bcc ms_2
            sta tmp16+1
            sty tmp16
            inx
            bne ms_1
ms_2        txa
            jsr dec2
            lda #$BA            ; :
            jsr putc
            lda tmp16
            jmp dec2

kbd_get     lda $C000
            bpl kbd_get
            sta $C010
            rts

; --- Меню ---

scan_disk   jsr clrscr
            jsr header
            ldx #14
            ldy #6
            jsr at
            lda #A_YELLOW
            sta attr
            lda #lo(s_reading)
            ldy #hi(s_reading)
            jsr print
            jsr read_cat
            bcc sd_ok
            ldx #14
            ldy #6
            jsr at
            lda #A_RED
            sta attr
            lda #lo(s_diskerr)
            ldy #hi(s_diskerr)
            jsr print
            jsr kbd_get
sd_ok       lda #0
            sta sel
            sta mtop
            rts

header      ldx #0
            ldy #0
            jsr at
            lda #I_CYAN
            sta attr
            lda #lo(s_header)
            ldy #hi(s_header)
            jmp print

; A = 0 - выход, 1 - играть sel (playall - подряд)
menu        jsr clrscr
            jsr header
            lda #A_CYAN
            sta attr
            ldx #2
            ldy #1
            jsr at
            lda #lo(s_choose)
            ldy #hi(s_choose)
            jsr print
            lda #A_GREY
            sta attr
            ldx #28
            ldy #0
            jsr at
            lda #lo(s_help1)
            ldy #hi(s_help1)
            jsr print
            ldx #29
            ldy #0
            jsr at
            lda #lo(s_help2)
            ldy #hi(s_help2)
            jsr print
            ldx #30
            ldy #0
            jsr at
            lda #lo(s_help3)
            ldy #hi(s_help3)
            jsr print
mn_redraw   jsr show_slot
            lda nfiles
            bne mn_list
            ldx #12
            ldy #3
            jsr at
            lda #A_YELLOW
            sta attr
            lda #lo(s_nofiles)
            ldy #hi(s_nofiles)
            jsr print
            jmp mn_key
mn_list     jsr draw_list
mn_key      jsr kbd_get
            cmp #KEY_ESC
            bne mn_1
            lda #0
            rts
mn_1        cmp #KEY_UP
            bne mn_2
            lda sel
            beq mn_key
            dec sel
            jmp mn_scroll
mn_2        cmp #KEY_DOWN
            bne mn_3
            lda sel
            clc
            adc #1
            cmp nfiles
            bcs mn_key
            sta sel
            jmp mn_scroll
mn_3        cmp #KEY_ENTER
            beq mn_play1
            cmp #KEY_SPACE
            bne mn_4
mn_play1    lda #0
            sta playall
            beq mn_go
mn_4        cmp #$C1            ; A / А - все подряд
            beq mn_all
            cmp #$E1
            bne mn_5
mn_all      lda #1
            sta playall
mn_go       lda nfiles
            beq mn_key
            lda #1
            rts
mn_5        cmp #$C4            ; D / Д - перечитать диск
            beq mn_rescan
            cmp #$E4
            bne mn_6
mn_rescan   jsr scan_disk
            jmp menu
mn_6        cmp #KEY_LEFT
            bne mn_7
            lda card
            cmp #$20
            bcc mn_key
            sbc #$10
            jmp mn_setslot
mn_7        cmp #KEY_RIGHT
            bne mn_key
            lda card
            cmp #$60
            bcs mn_key
            adc #$10
mn_setslot  pha
            jsr card_off
            pla
            sta card
            jsr card_init
            jmp mn_redraw
mn_scroll   lda sel
            cmp mtop
            bcs mn_s1
            sta mtop
mn_s1       lda mtop
            clc
            adc #21
            cmp sel
            bcs mn_s2
            lda sel
            sec
            sbc #21
            sta mtop
mn_s2       jmp mn_list

show_slot   ldx #26
            ldy #1
            jsr at
            lda #A_GREEN
            sta attr
            lda #lo(s_slot)
            ldy #hi(s_slot)
            jsr print
            lda card
            lsr a
            lsr a
            lsr a
            lsr a
            ora #$B0
            jsr putc
            lda #lo(s_slot2)
            ldy #hi(s_slot2)
            jmp print

; Список: 22 строки с mtop, выбранная - инверсией
draw_list   lda #0
            sta t0
dl_l        lda t0
            clc
            adc #4
            tax
            ldy #1
            jsr at
            lda t0
            clc
            adc mtop
            cmp nfiles
            bcs dl_blank
            sta t1
            ldx #A_WHITE
            cmp sel
            bne dl_n
            ldx #I_YELLOW
dl_n        stx attr
            lda t1
            jsr dir_ptr
            lda dirp
            clc
            adc #2
            sta str
            lda dirp+1
            adc #0
            sta str+1
            ; имя без «.YZ» и хвостовых пробелов: 30 знаков, у «.YZ» - пробелы
            ldy #0
            sty t2
dl_c        lda (str),y
            cmp #$AE            ; точка перед YZ - конец имени
            bne dl_c1
            iny
            lda (str),y
            dey
            cmp #$D9
            bne dl_c1
            lda #$FF
            sta t2
dl_c1       lda t2
            beq dl_c2
            lda #$A0
            bne dl_c3
dl_c2       lda (str),y
dl_c3       sty t3
            jsr putc
            ldy t3
            iny
            cpy #30
            bne dl_c
            jmp dl_next
dl_blank    lda #A_WHITE
            sta attr
            ldx #30
dl_b        lda #$A0
            stx t3
            jsr putc
            ldx t3
            dex
            bne dl_b
dl_next     inc t0
            lda t0
            cmp #22
            bne dl_l
            rts

; --- Воспроизведение ---

play_file   jsr clrscr
            jsr header
            ldx #14
            ldy #6
            jsr at
            lda #A_YELLOW
            sta attr
            lda #lo(s_loading)
            ldy #hi(s_loading)
            jsr print
            jsr load_file
            bcc pf_ok
            ldx #14
            ldy #6
            jsr at
            lda #A_RED
            sta attr
            lda #lo(s_loaderr)
            ldy #hi(s_loaderr)
            jsr print
            jsr kbd_get
            lda #0
            sta playall
            rts
pf_ok       jsr eng_start
            lda #1
            sta playing
            jsr draw_play
pl_loop     jsr wait_tick
            jsr eng_tick
            jsr ui_tick
            lda $C000
            bpl pl_nokey
            sta $C010
            cmp #KEY_ESC
            bne pl_k1
            lda #0
            sta playall
            sta playing
            jmp card_silence
pl_k1       cmp #KEY_SPACE
            beq pl_next
            cmp #KEY_ENTER
            bne pl_k2
            lda view
            eor #1
            sta view
            jsr draw_play
            jmp pl_nokey
pl_k2       cmp #KEY_RIGHT
            bne pl_nokey
            lda frame
            clc
            adc #1
            sta jump
pl_nokey    lda ended
            beq pl_loop
            lda tail
            cmp #100
            bcc pl_loop
pl_next     lda #0
            sta playing
            jsr card_silence
            lda playall
            beq pl_r
            lda sel
            clc
            adc #1
            cmp nfiles
            bcc pl_n1
            lda #0
pl_n1       sta sel
            jmp play_file
pl_r        rts

; Неизменная часть экрана воспроизведения
draw_play   lda view
            beq dp_panel
            jmp trk_draw
dp_panel    jsr clrscr
            jsr header
            lda #A_YELLOW
            sta attr
            ldx #2
            ldy #1
            jsr at
            lda #lo(YZ+4)
            sta str
            lda #hi(YZ+4)
            sta str+1
            ldx #30
            jsr putn
            lda #A_CYAN
            sta attr
            ldx #3
            ldy #1
            jsr at
            lda #lo(YZ+34)
            sta str
            lda #hi(YZ+34)
            sta str+1
            ldx #30
            jsr putn
            lda #A_WHITE
            sta attr
            ldx #5
            ldy #1
            jsr at
            lda #lo(s_time)
            ldy #hi(s_time)
            jsr print
            ldx #6
            jsr sep_line
            ldx #17
            jsr sep_line
            ldx #23
            jsr sep_line
            ; номера и имена ударных
            ldx #0
dp_ch       stx t0
            lda chrow,x
            tax
            ldy #0
            jsr at
            ldx t0
            lda chcol,x
            sta attr
            txa
            clc
            adc #$B1
            jsr putc
            ldx t0
            inx
            cpx #7
            bne dp_ch
            lda #A_WHITE
            sta attr
            ldx #15
            ldy #2
            jsr at
            lda #lo(s_drum6)
            ldy #hi(s_drum6)
            jsr print
            ldx #16
            ldy #2
            jsr at
            lda #lo(s_drum7)
            ldy #hi(s_drum7)
            jsr print
            lda #A_GREY
            sta attr
            ldx #24
            ldy #1
            jsr at
            lda #lo(s_regs)
            ldy #hi(s_regs)
            jsr print
            ldx #31
            ldy #0
            jsr at
            lda #lo(s_playhelp)
            ldy #hi(s_playhelp)
            jsr print
            ; все показанное - заново
            ldx #7
            lda #$FF
dp_inv      sta c_uins,x
            sta c_unote,x
            sta c_ureg,x
            sta c_umeter,x
            dex
            bpl dp_inv
            lda #1
            sta textchg
            lda #0
            sta uistep
            sta flash
            rts

sep_line    ldy #0
            jsr at
            lda #A_DBLUE
            sta attr
            ldx #32
sl_1        lda #$1B
            stx t3
            jsr putc
            ldx t3
            dex
            bne sl_1
            rts

chrow       db 8,9,10,11,12,15,16
chcol       db A_RED,A_GREEN,A_YELLOW,A_CYAN,A_MAGENTA,A_WHITE,A_WHITE

ui_idle     rts

; Один шаг обновления экрана за тик
ui_tick     lda view
            beq ut_panel
            jmp trk_tick
ut_panel    ldx uistep
            inx
            cpx #10
            bcc ut_1
            ldx #0
ut_1        stx uistep
            cpx #5
            bcs ut_2
            jmp ui_tone
ut_2        cpx #7
            bcs ut_3
            jmp ui_drum
ut_3        bne ut_4
            jmp ui_time
ut_4        cpx #8
            bne ut_5
            jmp ui_text
ut_5        jmp ui_regs

; Тоновый канал X: инструмент, нота, полоса, полосы ячейки
ui_tone     stx uich
            lda chrow,x
            sta uirow
            ; инструмент
            lda c_state,x
            beq ut_noins
            lda c_ins,x
            cmp c_uins,x
            beq ut_noins
            sta c_uins,x
            jsr set_ip
            ldx uirow
            ldy #2
            jsr at
            lda #A_WHITE
            sta attr
            lda ip
            sta str
            lda ip+1
            sta str+1
            ldx #8
            jsr putn
            ldx uich
ut_noins    ; нота
            lda c_state,x
            beq ut_nn
            lda c_note,x
            bne ut_nt
ut_nn       lda #$FF
ut_nt       cmp c_unote,x
            beq ut_nonote
            sta c_unote,x
            pha
            ldx uirow
            ldy #11
            jsr at
            lda #A_YELLOW
            sta attr
            pla
            cmp #$FF
            bne ut_name
            lda #$AD
            jsr putc
            lda #$AD
            jsr putc
            lda #$AD
            jsr putc
            jmp ut_nend
ut_name     tay
            lda div12,y
            pha
            lda mod12,y
            asl a
            tay
            lda notenm,y
            sty t3
            jsr putc
            ldy t3
            lda notenm+1,y
            jsr putc
            pla
            ora #$B0
            jsr putc
ut_nend     ldx uich
ut_nonote   ; полоса уровня
            lda c_state,x
            bne ut_m1
            sta c_meter,x
ut_m1       lda c_meter,x
            lsr a
            lsr a
            lsr a
            lsr a
            cmp c_umeter,x
            beq ut_nomet
            sta c_umeter,x
            jsr bar_draw
            ldx uich
ut_nomet    ; полосы НЧ СЧ ВЧ и D3 по последнему регистру
            lda c_lreg,x
            and #$0F
            ldy c_state,x
            bne ut_b0
            lda #0
ut_b0       cmp c_ureg,x
            beq ut_r
            sta c_ureg,x
            sta t1
            ldx uirow
            ldy #28
            jsr at
            lda #$EE            ; Н
            ldx #4
            jsr bus_ch
            lda #$F3            ; С
            ldx #2
            jsr bus_ch
            lda #$F7            ; В
            ldx #1
            jsr bus_ch
            lda #$E7            ; Г
            ldx #8
            jsr bus_ch
ut_r        rts

; Буква A яркой, если в t1 есть разряд X
bus_ch      pha
            txa
            and t1
            beq bc_off
            lda #A_GREEN
            cpx #8
            bne bc_on
            lda #A_RED
            bne bc_on
bc_off      lda #A_DBLUE
bc_on       sta attr
            pla
            jmp putc

; Полоса уровня A (0-15) в строке uirow, 12 клеток с колонки 15
bar_draw    tay
            lda bartab,y
            sta t2
            ldx uirow
            ldy #15
            jsr at
            ldx #0
bd_l        cpx t2
            bcs bd_off
            lda barcol,x
            sta attr
            bne bd_put
bd_off      lda #A_WHITE
            sta attr
bd_put      lda #$A0
            stx t3
            jsr putc
            ldx t3
            inx
            cpx #12
            bne bd_l
            rts

bartab      db 0,1,2,2,3,4,5,5,6,7,8,8,9,10,11,12
barcol      db I_GREEN,I_GREEN,I_GREEN,I_GREEN,I_GREEN,I_GREEN,I_GREEN
            db I_YELLOW,I_YELLOW,I_YELLOW,I_RED,I_RED

; Ударный X (5, 6): пресет и полоса; на ударе - вспышка рамки
ui_drum     stx uich
            lda chrow,x
            sta uirow
            lda c_meter,x
            cmp #$F0
            bcc ud_1
            ; только что ударил
            lda d_preset-5,x
            pha
            ldx uirow
            ldy #11
            jsr at
            lda #A_YELLOW
            sta attr
            pla
            jsr hex2
            ldx uich
            lda flashcol-5,x
            jsr do_flash
            ldx uich
ud_1        lda c_meter,x
            sec
            sbc #$18
            bcs ud_2
            lda #0
ud_2        sta c_meter,x
            lsr a
            lsr a
            lsr a
            lsr a
            cmp c_umeter,x
            beq ud_3
            sta c_umeter,x
            jsr bar_draw
ud_3        lda flash
            beq ud_r
            dec flash
            bne ud_r
            lda #A_DBLUE
            jsr flash_rows
ud_r        rts

flashcol    db A_RED,A_CYAN

do_flash    pha
            lda #6
            sta flash
            pla
flash_rows  pha
            ldx #6
            jsr row_attr
            pla
            pha
            ldx #17
            jsr row_attr
            pla
            ldx #23
            jmp row_attr

; Время и кадр
ui_time     ldx #5
            ldy #7
            jsr at
            lda #A_WHITE
            sta attr
            lda secs
            sta tmp16
            lda secs+1
            sta tmp16+1
            jsr mmss
            lda #$AF            ; /
            jsr putc
            lda YZ+64
            sta tmp16
            lda YZ+65
            sta tmp16+1
            jsr mmss
            ldx #5
            ldy #26
            jsr at
            lda frame
            jmp dec3

; Подпись (2 строки по 32 знака)
ui_text     lda textchg
            beq ux_r
            lda #0
            sta textchg
            lda #A_YELLOW
            sta attr
            ldx #19
            ldy #0
            jsr at
            lda text
            cmp #$FF
            beq ux_clr
            asl a
            tay
            lda (ttabp),y
            sta str
            iny
            lda (ttabp),y
            clc
            adc #hi(YZ)
            sta str+1
            ; до 64 знаков, остаток строк - пробелы
            ldy #0
ux_l        lda (str),y
            beq ux_pad
            sty t3
            jsr putc
            ldy t3
            iny
            cpy #64
            bne ux_l
ux_r        rts
ux_pad      sty t3
            lda #$A0
            jsr putc
            ldy t3
            iny
            cpy #64
            bne ux_pad
            rts
ux_clr      ldy #0
            beq ux_pad

; Регистры ячейки, как их писал движок
ui_regs     lda #A_GREY
            sta attr
            ldx #25
            ldy #1
            jsr at
            ldx #0
ur_1        stx t0
            lda c_lreg,x
            jsr hex2
            lda #$A0
            jsr putc
            ldx t0
            inx
            cpx #5
            bne ur_1
            lda d_preset
            jsr hex2
            lda #$A0
            jsr putc
            lda d_preset+1
            jsr hex2
            ldx #26
            ldy #1
            jsr at
            ldx #0
ur_2        stx t0
            lda c_lperhi,x
            jsr hex2
            ldx t0
            lda c_lperlo,x
            jsr hex2
            lda #$A0
            jsr putc
            ldx t0
            inx
            cpx #5
            bne ur_2
            rts

            include "tracker.a65"
