# ДВК-3: заводской функциональный тест КВД (винчестер DW) TSTDW3 с диска
# ФОДОС, полный цикл - «тест КВД окончен, ошибок не обнаружено». Запись - в
# память, образ не меняется.
# @timeout 600
# @nomcp в живой сессии машина успевает поработать до первой команды, а загрузка RT-11 зависит от времени
MACHINE "dvk/DVK-3-MY.ext"
COMMAND my0.load("FODOSTMO.DSK")
COMMAND dw.load("rt11-dw.dsk")
COMMAND dw.volatile(1)
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BMY"
KEY _100,_50,ret
WAIT _20000
KEY _100,_50,ret
WAIT _1000
COMMAND panel.option(1,0)
TYPE "R TSTDW3"
KEY _100,_50,ret
WAIT _130000

LOGDEFS _16,_8
LOG dw.writes
PRINT "=== Экран ==="
LOG display.text
EXIT
