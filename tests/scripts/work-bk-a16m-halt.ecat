# БК0011М + А16М: пультовый режим К1801ВМ1 в режиме платы Hlt11.
#
# Вход в пультовое исключение ВМ1 (команда HALT, клавиша СТОП) - это RMW
# 0177716 с установкой разряда 3, запись PSW в 0177676 и PC в 0177674 и новые
# PC и PSW из 0160002/0160004. В Hlt11 (код 0) на 0170000-0177777 стоит
# сегмент 3 ОЗУ платы только на запись, на 0160000 - сегмент 2 на чтение и
# запись: пультовый вход проходит целиком. Прочитать сохраненное в Hlt11
# нельзя, поэтому обработчик включает Std10 (сегмент 3 там с 0130000) и
# возвращается командой RTI - она же снимает пультовые разряды PSW.
#
# 1. HALT в режиме Hlt11. Обработчик по 0160002 - 02000 в ОЗУ машины -
#    отмечает вход (0123 в 01500), берет PC и PSW из 0137674/0137676 и
#    возвращается на следующую за HALT команду (01032), которая отмечает
#    01502. В R0 и R1 - сохраненные PC и PSW, стек программы не тронут.
# 2. СТОП в режиме Hlt11: тот же обработчик, возврат на BR . по 03014.
# 3. СТОП в режиме Std10: сохранять PSW некуда, тайм-аут - ловушка через 004
#    по стеку программы, как на простой БК; обработчик 04000 отмечает 044.
# @timeout 40

MACHINE "bk/BK-0011M-a16m.ext"
LOGDEFS _16,_8
WAIT _300
COMMAND cpu.stop()

# Программа 1: Hlt11, вектор 0160002 = 02000 с PSW 02340, HALT
COMMAND ram0.set16(1000, 012737, 000006, 177130, 012737, 000000, 177130, 012737, 002000, 160002, 012737, 002340, 160004, 000000, 012737, 000001, 001502, 000777)
# Обработчик пультового входа
COMMAND ram0.set16(2000, 012737, 000123, 001500, 012737, 000006, 177130, 012737, 000060, 177130, 013700, 137674, 013701, 137676, 010146, 010046, 000002)
# Программа 2: Hlt11 и BR .
COMMAND ram0.set16(3000, 012737, 000006, 177130, 012737, 000000, 177130, 000777)
# Обработчик ловушки через 004
COMMAND ram0.set16(4000, 012737, 000044, 001504, 000777)
COMMAND ram0.set16(1500, 0, 0, 0)

PRINT "=== 1. HALT в режиме Hlt11 ==="
COMMAND cpu.setreg(SP, 1000)
COMMAND cpu.setreg(PSW, 0)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _50
LOG cpu.registers
LOG ram0.value16(1500, 1503)
LOG a16m.mode
LOG a16m-ram.value16(037674, 037677)

PRINT "=== 2. СТОП в режиме Hlt11 ==="
COMMAND ram0.set16(1500, 0)
COMMAND cpu.stop()
COMMAND cpu.setreg(PC, 3000)
COMMAND cpu.run()
WAIT _20
KEYDOWN key_stop
KEYUP key_stop
WAIT _50
LOG cpu.registers
LOG ram0.value16(1500, 1501)
LOG a16m.mode

PRINT "=== 3. СТОП в режиме Std10: ловушка через 004 ==="
COMMAND ram0.set16(4, 4000, 340)
KEYDOWN key_stop
KEYUP key_stop
WAIT _50
LOG cpu.registers
LOG ram0.value16(1504, 1505)
LOG ram0.value16(774, 777)
EXIT
