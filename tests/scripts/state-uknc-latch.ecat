# УК-НЦ: снимок возвращает защелку регистра данных планов и очередь приема СА.
#
# ../tests/files/state-uknc-latch.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-uknc-latch.ecat: в защелке cpu-indirect лежит 123456,
# а память за ней уже обнулена; в очереди сетевого адаптера пять байтов.
#
# Защелка не выводится из памяти, и раньше снимок нес только адрес: после
# загрузки регистр данных читал 0, пока программа снова не запишет адрес.
# Очередь восстанавливалась ровно в 256 байтов - поданные пять и нули за ними.
# @nomcp живая сессия MCP успевает покрутить машину до первой команды, и
# адаптер отдает ей байты из очереди
# @timeout 40

MACHINE "../tests/files/state-uknc-latch.ecats.zip"
COMMAND cpu.stop()
COMMAND ppu.stop()

LOGDEFS _16,_8
PRINT "=== адрес и защелка: 000200 и 123456, память за ней пуста ==="
LOG cpu-indirect.value16(0,3)
LOG planes12.value16(400)

PRINT "=== очередь приема: не больше пяти байтов ==="
LOG sa.queued
EXIT
