# Орион-128 Z80: образ, который дисковод не принял (здесь файла нет, размер не тот), оставляет
# в нем прежний диск с его именем, и диск читается дальше: команда чтения сектора идет
# (BUSY и DRQ). Раньше посекторный образ при такой ошибке стирал имя прежнего диска, а при
# ошибке открытия заменял его пустым
# @timeout 40

MACHINE "orion-128/Orion-128-Z80.cfg"
WAIT 9000

LOGDEFS 8,16
LOG fdd0.file
LOG fdd0.generation
COMMAND fdd0.load("no-such-image.odi")
LOG fdd0.loaded
LOG fdd0.file
LOG fdd0.generation
COMMAND fdc.set(0, $80)
WAIT 10
LOG fdc.status
LOG fdc.busy
EXIT
