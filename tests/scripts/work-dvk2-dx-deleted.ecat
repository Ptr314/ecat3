COMMAND dx.set16(2, 40)
COMMAND dx.set16(2, 43)
COMMAND dx.set16(2, 42)
COMMAND dx.set16(2, 55)
COMMAND dx.set16(2, 54)
COMMAND dx.set16(2, 57)
COMMAND dx.set16(2, 56)
COMMAND dx.set16(2, 51)
COMMAND dx.set16(2, 50)
COMMAND dx.set16(2, 53)
COMMAND dx.set16(2, 52)
WAIT _10
PRINT "=== Функция 6: сектор 3 дорожки 5 с меткой удаления ==="
COMMAND dx.set16(0, 15)
COMMAND dx.set16(2, 3)
COMMAND dx.set16(2, 5)
WAIT _50
LOG dx.writes
LOG dx0.deleted
PRINT "=== Чтение: RXES с разрядом DD ==="
COMMAND dx.set16(0, 7)
COMMAND dx.set16(2, 3)
COMMAND dx.set16(2, 5)
WAIT _50
LOG dx.rxes
PRINT "=== Соседний сектор - без метки ==="
COMMAND dx.set16(0, 7)
COMMAND dx.set16(2, 4)
COMMAND dx.set16(2, 5)
WAIT _50
LOG dx.rxes
PRINT "=== После .mfm ==="
COMMAND dx0.save("../../tests/results/work-dvk2-dx-deleted.mfm")
COMMAND dx0.eject()
COMMAND dx0.load("../../tests/results/work-dvk2-dx-deleted.mfm")
LOG dx0.deleted
COMMAND dx.set16(0, 7)
COMMAND dx.set16(2, 3)
COMMAND dx.set16(2, 5)
WAIT _50
LOG dx.rxes
EXIT
