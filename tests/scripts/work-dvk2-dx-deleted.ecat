COMMAND dx.set16(2, 32)
COMMAND dx.set16(2, 5)
COMMAND dx.set16(2, 4)
COMMAND dx.set16(2, 7)
COMMAND dx.set16(2, 6)
COMMAND dx.set16(2, 1)
COMMAND dx.set16(2, 0)
COMMAND dx.set16(2, 3)
