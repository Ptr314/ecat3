COMMAND dx.set16(2, 12)
COMMAND dx.set16(2, 65)
COMMAND dx.set16(2, 64)
COMMAND dx.set16(2, 67)
COMMAND dx.set16(2, 66)
COMMAND dx.set16(2, 61)
COMMAND dx.set16(2, 60)
