# ДВК-2, контроллер DX (RX11): метка удаления. Функция 6 пишет сектор с меткой
# F8, чтение такого сектора ставит разряд DD (0100) в RXES. Диск в приводе -
# дорожки IBM 3740 FM целиком (mode = fm_ibm), и .mfm хранит их без потерь:
# после сохранения и загрузки метка на месте (в плоском .dsk её нет).
# Команды контроллеру - прямо в его регистры (0 - RXCS, 2 - RXDB).
# @timeout 60
MACHINE "dvk/DVK-2.cfg"
WAIT _2000
LOGDEFS _16,_8
PRINT "=== Буфер: 128 байт ==="
COMMAND dx.set16(0, 1)
COMMAND dx.set16(2, 125)
COMMAND dx.set16(2, 124)
COMMAND dx.set16(2, 127)
COMMAND dx.set16(2, 126)
COMMAND dx.set16(2, 121)
COMMAND dx.set16(2, 120)
COMMAND dx.set16(2, 123)
COMMAND dx.set16(2, 122)
COMMAND dx.set16(2, 135)
COMMAND dx.set16(2, 134)
COMMAND dx.set16(2, 137)
COMMAND dx.set16(2, 136)
COMMAND dx.set16(2, 131)
COMMAND dx.set16(2, 130)
COMMAND dx.set16(2, 133)
COMMAND dx.set16(2, 132)
COMMAND dx.set16(2, 105)
COMMAND dx.set16(2, 104)
COMMAND dx.set16(2, 107)
COMMAND dx.set16(2, 106)
COMMAND dx.set16(2, 101)
COMMAND dx.set16(2, 100)
COMMAND dx.set16(2, 103)
COMMAND dx.set16(2, 102)
COMMAND dx.set16(2, 115)
COMMAND dx.set16(2, 114)
COMMAND dx.set16(2, 117)
COMMAND dx.set16(2, 116)
COMMAND dx.set16(2, 111)
COMMAND dx.set16(2, 110)
COMMAND dx.set16(2, 113)
COMMAND dx.set16(2, 112)
COMMAND dx.set16(2, 165)
COMMAND dx.set16(2, 164)
COMMAND dx.set16(2, 167)
COMMAND dx.set16(2, 166)
COMMAND dx.set16(2, 161)
COMMAND dx.set16(2, 160)
COMMAND dx.set16(2, 163)
COMMAND dx.set16(2, 162)
COMMAND dx.set16(2, 175)
COMMAND dx.set16(2, 174)
COMMAND dx.set16(2, 177)
COMMAND dx.set16(2, 176)
COMMAND dx.set16(2, 171)
COMMAND dx.set16(2, 170)
COMMAND dx.set16(2, 173)
COMMAND dx.set16(2, 172)
COMMAND dx.set16(2, 145)
COMMAND dx.set16(2, 144)
COMMAND dx.set16(2, 147)
COMMAND dx.set16(2, 146)
COMMAND dx.set16(2, 141)
COMMAND dx.set16(2, 140)
COMMAND dx.set16(2, 143)
COMMAND dx.set16(2, 142)
COMMAND dx.set16(2, 155)
COMMAND dx.set16(2, 154)
COMMAND dx.set16(2, 157)
COMMAND dx.set16(2, 156)
COMMAND dx.set16(2, 151)
COMMAND dx.set16(2, 150)
COMMAND dx.set16(2, 153)
COMMAND dx.set16(2, 152)
COMMAND dx.set16(2, 25)
COMMAND dx.set16(2, 24)
COMMAND dx.set16(2, 27)
COMMAND dx.set16(2, 26)
COMMAND dx.set16(2, 21)
COMMAND dx.set16(2, 20)
COMMAND dx.set16(2, 23)
COMMAND dx.set16(2, 22)
COMMAND dx.set16(2, 35)
COMMAND dx.set16(2, 34)
COMMAND dx.set16(2, 37)
COMMAND dx.set16(2, 36)
COMMAND dx.set16(2, 31)
COMMAND dx.set16(2, 30)
