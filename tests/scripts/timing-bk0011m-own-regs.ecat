# БК0011М: запись в собственные регистры К1801ВМ1 (0177700-0177717, здесь
# 0177714 - порт AY). Процессор сам выставляет RPLY вместе с DOUT и отпускает
# строб на такт раньше, чем при записи в статическую память; с кодом в ОЗУ за
# ВП1-037 этот такт решает, попадет ли выборка следующей команды в то же окно.
# Цикл MOV #377,(R0); MOVB (R1)+,(R0); SOB из ОЗУ с R0 = 0177714 на модели
# кристалла (tb_bk.v) идет ровно 24 мкс = 96 тактов на виток; 400 витков -
# 38400 тактов, 300 шагов таймера по 128 тактов. Таймер запущен перед циклом
# и прочитан после него: 0177777 - 300 = 0177323 (с точностью до шага). Пока
# запись в регистр считалась как запись в статическую память, виток шел 20
# окон (0177261), и музыкальный обработчик демо (26 записей в 0177714) отставал на
# 140 тактов - полстроки, - смещая смену палитры на половину строки.
# @timeout 40

MACHINE "bk/BK-0011M.cfg"
WAIT _3000
COMMAND cpu.stop
LOGDEFS _16,_8

COMMAND ram0.set16(024000, 106427, 000340)           # MTPS #340
COMMAND ram0.set16(024004, 012700, 177714)           # MOV #177714,R0
COMMAND ram0.set16(024010, 012701, 026000)           # MOV #26000,R1
COMMAND ram0.set16(024014, 012702, 000620)           # MOV #620,R2         ; 400 витков
COMMAND ram0.set16(024020, 012737, 177777, 177706)   # MOV #177777,@#177706 ; уставка таймера
COMMAND ram0.set16(024026, 012737, 000022, 177712)   # MOV #22,@#177712     ; пуск без перезагрузки
COMMAND ram0.set16(024034, 012710, 000377)           # MOV #377,(R0)
COMMAND ram0.set16(024040, 112110)                   # MOVB (R1)+,(R0)
COMMAND ram0.set16(024042, 077204)                   # SOB R2,24034
COMMAND ram0.set16(024044, 013703, 177710)           # MOV @#177710,R3      ; счетчик таймера
COMMAND ram0.set16(024050, 010337, 024300)           # MOV R3,@#24300
COMMAND ram0.set16(024054, 000777)                   # BR .
COMMAND ram0.fill(024300, 024301, 0)

COMMAND cpu.setreg(PC, 024000)
COMMAND cpu.run
WAIT _100
LOG ram0.value16(024300)
EXIT
