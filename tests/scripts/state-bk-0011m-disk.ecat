# БК0011М + КНГМД: запись на дискету переживает снимок состояния.
#
# ../tests/files/state-bk-disk.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-bk-disk.ecat сразу после того, как драйвер ПЗУ записал
# блок 1500 образцом из 20000. В тот момент записанного сектора нет ни в одном
# файле на диске: он лежит в буфере дорожки контроллера и в буфере дисковода,
# а образ на диске меняется только по явному save. Снимок обязан унести оба
# буфера с собой.
#
# Здесь состояние поднимается, и вторая половина программы - она осталась в
# ОЗУ - уводит головку чтением блока 0 и перечитывает блок 1500 из образа.
# Если бы снимок потерял запись, обратно пришел бы старый сектор.
#
# Регистры процессора не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
# @timeout 60

MACHINE "../tests/files/state-bk-disk.ecats.zip"

LOGDEFS _16,_8
PRINT "=== Флаги C чтения и записи, снятые до съемки состояния ==="
LOG ram0.value(022000, 022003)

COMMAND cpu.setreg(PC, 024112)
WAITFOR cpu.pc == 024202, _30000

PRINT "=== Флаги C увода головки и обратного чтения ==="
LOG ram0.value(022004, 022007)
LOG ram0.value(000052, 000052)

PRINT "=== Перечитанный из образа блок 1500: начало и конец ==="
LOG ram0.value(021000, 021037)
LOG ram0.value(021740, 021777)

PRINT "=== Состояние контроллера и дисковода ==="
LOG fdc.track
LOG fdd0.track
EXIT
