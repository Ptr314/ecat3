# Радио-86РК: ВГ75 и ПДП ВТ57 — растр, кража тактов и гашение экрана лентой.
# Снимает то, чем монитор программирует контроллеры, и меряет, сколько
# процессорного времени забирает регенерация экрана: счётный цикл в ОЗУ
# крутится ровно секунду эмулируемого времени, и его счётчик — это и есть
# эффективная частота машины. На реальном РК86 ВТ57 отбирает около четверти
# тактов, и без этого эмулятор считал заметно быстрее оригинала.
#
# Регистры процессора не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
# @timeout 40
# @nomcp счётчик оборотов и регистры ВТ57 снимаются в конкретной точке кадра, а живая сессия MCP крутит машину между загрузкой и первой командой

MACHINE "radio-86rk/Radio-86rk.cfg"
WAIT 2500

LOGDEFS 8,16
PRINT "=== Что монитор записал в ВГ75 и ВТ57 ==="
LOG vg75.mode
LOG vg75.geometry
LOG vg75.burst
LOG vg75.display
LOG dma.address
LOG dma.count
LOG dma.mode

LOGDEFS 16,10
PRINT "=== Растр ==="
LOG vg75.frame_rate

PRINT "=== Эффективная скорость процессора ==="
# INX H / SHLD $3010 / JMP - 31 такт на оборот, счётчик остаётся в памяти
COMMAND ram.set($3000, $21, $00, $00, $23, $22, $10, $30, $C3, $03, $30)
TYPE "G3000\n"
WAIT 1000
LOG ram.value16($3010, $3010)

PRINT "=== Лента гасит экран запретом канала ВТ57 ==="
RESET
WAIT 2500
COMMAND tape.load("XONIX.RKR")
COMMAND tape.play
WAIT 200
TYPE "I\n"
WAIT 2000
LOGDEFS 8,16
LOG dma.mode
LOG vg75.status
SCREEN "../results/work-rk86-vg75-tape.png"
EXIT
