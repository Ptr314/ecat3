# ДВК-4 с монитором 377 без образа винчестера. Прошивка КЗД после сброса ждёт от
# накопителя готовности бесконечно (Alex_K), так что «Занят» в SI не снимается,
# а остальные регистры не отвечают. Тест НЖД монитора ждёт снятия «Занят», не
# дожидается и пишет «? - ОШИБКА - ЗАНЯТ», оставаясь в пульте. Прежде сброс
# кончался и без накопителя: тогда монитор видел в CSR, что накопитель не готов
# («НЕТ ГОТОВНОСТИ»), а ещё раньше запускал чтение и печатал регистр ошибок
# @timeout 120
MACHINE "../../tests/files/dvk4-ksm-377.ext"
WAIT _40000

LOGDEFS _16,_8
PRINT "=== Экран ==="
LOG display.text
PRINT "=== CSR, SI ==="
LOG dw.csr
LOG dw.status
EXIT
