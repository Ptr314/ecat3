# Две машины в одной: проверка планировщика тактовых доменов.
#
# Два К1801ВМ1 на 8 и 6,25 МГц крутят одинаковый счётный цикл, каждый в своей
# памяти. Соотношение счётчиков обязано быть 32:25 - это единственное, что
# доказывает, что процессоры чередуются по частоте, а не как попало.
#
# Карты памяти обоих диспетчеров снимаются тоже: они показывают, что у каждого
# процессора своё адресное пространство, и что параметр mapper действительно
# развёл их.
# @timeout 30
# @nomcp счётчики набираются с момента пуска машины, а живая сессия MCP успевает
# покрутить её до первой команды: соотношение 32:25 держится и там, но абсолютные
# значения приходят другие

MACHINE "bk/2cpu-test.cfg"
WAIT _200

LOGDEFS _16,_8

PRINT "=== Процессоры ==="
LOG cpu.clock
LOG ppu.clock

PRINT "=== Счётчики циклов: должны относиться как 32:25 ==="
LOG ram.value16(100)
LOG ppu-ram.value16(100)

PRINT "=== Домены устройств ==="
LOG display.clock_source
LOG timer.clock_source
LOG ppu-timer.clock_source

PRINT "=== Карта памяти ведущего ==="
LOG mapper.map

PRINT "=== Карта памяти ведомого ==="
LOG ppu-mapper.map

EXIT
