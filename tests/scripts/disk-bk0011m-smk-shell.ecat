# БК0011М + СМК-512: оболочка ANDOS читает каталог дискеты через BIOS платы.
#
# Винчестера нет: BIOS около десяти секунд ждет его готовности, потом грузит
# ANDOS с дискеты. По пробелу запускается оболочка и читает каталоги обеих
# панелей через точку входа 0160004 BIOS СМК.
#
# Устройства панелей оболочка хранит в образе andos330.img (байты 17762 и
# 17776). У BIOS СМК устройства с номером 2 и выше - логические диски
# винчестера (A: и B: - дисководы), поэтому панель на E: без винчестера дает
# «ANDOS - Disk error #;» (ошибка 13 BIOS: таблицы разделов нет). КНГМД
# берет номер привода по модулю 4, и E: у него - тот же A:. В образе обе
# панели стоят на A:.
# @timeout 90

MACHINE "bk/BK-0011M-smk512.cfg"
LOGDEFS _16,_8

WAITFOR fdd0.track != 0, _30000
WAIT _8000
KEY _100,_100,space
WAIT _8000

PRINT "=== Оболочка: код ошибки драйвера в ячейке 052 ==="
LOG mapper.value(52, 52)
SCREEN "../results/disk-bk0011m-smk-shell.png"
EXIT
