# ДВК-3: заводской тест КНГМД MX TSTMX (TMX V04.03) с диска ФОДОС на пустой
# дискете во втором приводе MX: тип накопителя 1 (НГМД-6022, МС5301,
# МС5306 - 40 дорожек), разметка F и комплекс L: запись и чтение случайных
# чисел с проверкой, поиск дорожек, период вращения (200,5 мс), время
# перемещения головок и подвода головки.
#
# Тест кончает запись иначе, чем RT-11: подаёт заполнитель 177777, пока не
# увидит индекс, и только тогда бросает. Запись, остановленная контроллером
# на индексе, не давала ему готовности, и тест висел; теперь она идёт, пока
# программа подаёт слова (как в MAME). Пустой образ короче дискеты и
# дополняется нулями.
# @timeout 900
# @nomcp в живой сессии машина успевает поработать до первой команды, а загрузка RT-11 зависит от времени
MACHINE "dvk/DVK-3.cfg"
COMMAND my0.load("FODOSTMO.DSK")
COMMAND mx1.load("../files/mx-blank.img")
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BMY"
KEY _100,_50,ret
WAIT _20000
KEY _100,_50,ret
WAIT _1000
COMMAND panel.option(1,0)
TYPE "R TSTMX"
KEY _100,_50,ret
WAIT _5000
# Тип накопителя 1, привод 1
TYPE "1"
KEY _100,_50,ret
WAIT _2000
TYPE "1"
KEY _100,_50,ret
WAIT _3000
TYPE "F"
WAIT _60000
TYPE "L"
WAIT _240000

LOGDEFS _16,_8
LOG mx.writes
LOG mx.underruns
PRINT "=== Экран ==="
LOG display.text
EXIT
