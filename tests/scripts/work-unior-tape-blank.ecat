# Юниор ФВ-6506: запись на чистую кассету
#
# У чистой ленты нет ни одной записи, а длина есть: в файле .bt из одного
# заголовка ее взять неоткуда, и ее дает само устройство (blank_length, по
# умолчанию полчаса - сторона С-60). Без этого разметка уперлась бы в конец
# ленты на первом же секторе.
#
# Машина кладет на такую ленту запись в формате МОНИТОРа (тот же писатель, что
# и в work-unior-tape-write), лента отматывается назад, машина перезапускается
# и читает записанное командой "I": программа с ленты кладет $5A по $0300.
# @timeout 60

MACHINE "unior/Unior.cfg"
WAIT 1500

COMMAND tape.load("../files/unior-blank.bt")
LOGDEFS 8,16

PRINT "=== Чистая кассета ==="
LOG tape.records
LOG tape.total

COMMAND ram.set($0100,$31,$88,$F7,$CD,$43,$FC,$21,$30,$01,$06,$11,$3E,$01)
COMMAND ram.set($010D,$4E,$E5,$C5,$CD,$0C,$F8,$C1,$E1,$23,$AF,$05,$C2,$0D)
COMMAND ram.set($011A,$01,$3E,$40,$D3,$ED,$CD,$37,$FC,$76)
COMMAND ram.set($0130,$02,$00,$02,$08,$3E,$5A,$32,$00,$03,$76,$C3,$00,$02,$02,$08,$02,$08)

COMMAND cpu.setreg(PC,$0100)
WAIT 3000

PRINT "=== После записи ==="
LOG tape.records
LOG tape.writes
// Лента не укоротилась до записанного: кассета как была получасовой, так и осталась
LOG tape.total

COMMAND tape.seek(0)
RESET cold
WAIT 2000
COMMAND ram.set($0200,$00,$00,$00,$00,$00,$00,$00,$00,$00)
COMMAND ram.set($0300,$00)

// Монитор после перезапуска замечает клавишу не сразу
KEYDOWN I
WAIT 400
KEYUP I
WAIT 4000

PRINT "=== Прочитано с чистой кассеты ==="
LOG ram.value($0200,$0208)
LOG ram.value($0300,$0300)
LOG cpu.pc
EXIT
