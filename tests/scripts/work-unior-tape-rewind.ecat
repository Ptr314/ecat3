# Юниор ФВ-6506: чтение после отката ленты назад
#
# Перемотка двигает только положение головки - какая запись под ней, при этом
# никто не считает. Если после отката назад не пересчитать это заново, лента
# играет в пустоту до той записи, на которой ее оставили в прошлый раз, а
# машина ждет синхросимвола, которого уже не будет. Так зависала TCP/M после
# записи сектора: драйвер откатывает ленту, чтобы перечитать написанное.
#
# Здесь лентопротяжка гоняется точками входа МОНИТОРа (FC48 - пуск, FC4D -
# назад, FC37 - стоп), каждый кусочек возвращает управление монитору, а потом
# запись читается командой "I". Программа с ленты пишет "TAPE OK" в экранный
# буфер - если после отката запись не нашлась, там будет пусто.
# @timeout 60

MACHINE "unior/Unior.cfg"
WAIT 1500

COMMAND tape.load("../files/unior-test.bt")
LOGDEFS 8,16

// Каждый кусочек командует лентопротяжкой и остается в пустом цикле: вернуться
// в монитор нельзя, он лентопротяжку останавливает
// Сначала чуть вперед: окно должно увидеть именно перемотку
COMMAND ram.set($0130,$31,$88,$F7,$CD,$52,$FC,$C3,$36,$01)
COMMAND cpu.setreg(PC,$0130)
WAIT 10
LOG tape.mode

// Пуск: лента проходит запись насквозь
COMMAND ram.set($0100,$31,$88,$F7,$CD,$48,$FC,$C3,$06,$01)
COMMAND cpu.setreg(PC,$0100)
WAIT 1500
PRINT "=== Лента прошла запись ==="
LOG tape.record
// Режим для окна магнитофона: 0 - стоп, 1 - воспроизведение, 2 - вперед, 3 - назад.
// Окно по нему нажимает свои клавиши, и перемотка не должна выглядеть пуском
LOG tape.mode

// Немного назад - головка снова перед записью
COMMAND ram.set($0110,$31,$88,$F7,$CD,$4D,$FC,$C3,$16,$01)
COMMAND cpu.setreg(PC,$0110)
WAIT 50
LOG tape.mode
COMMAND ram.set($0120,$31,$88,$F7,$CD,$37,$FC,$C3,$00,$F8)
COMMAND cpu.setreg(PC,$0120)
WAIT 200

PRINT "=== После отката ==="
LOG tape.record
LOG tape.mode

COMMAND ram.set($F802,$20,$20,$20,$20,$20,$20,$20)
// Монитор после перезапуска замечает клавишу не сразу
KEYDOWN I
WAIT 400
KEYUP I
WAIT 4000

PRINT "=== Прочитано после отката ==="
LOG tape.transport
LOG ram.value($F802,$F808)
EXIT
