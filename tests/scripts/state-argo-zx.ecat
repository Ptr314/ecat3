# Арго ФВ-6511: снимок состояния помнит, какая лента заряжена.
#
# ../tests/files/state-argo-zx.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-argo-zx.ecat.
#
# Носитель у этой машины выбирает заряженный файл, а не конфигурация: в конфиге
# encoding = unior, то есть лента-накопитель, а в лентопротяжке лежит лента
# Спектрума - полупериоды, которые выдаются по запросу. Пока снимок этого не
# помнил, при восстановлении спрашивали не тот блок архива, и кассета пропадала
# целиком: записей ноль, длина ноль, "пуск" тут же упирался в конец ленты.
#
# Головка в снимке стоит внутри ленты, поэтому проверяется и то, что автомат
# полупериодов встал на то же место: после "пуска" лента должна играть дальше,
# а не с начала и не в тишину.
# @timeout 40

MACHINE "../tests/files/state-argo-zx.ecats.zip"
LOGDEFS 16,10

PRINT "=== лента Спектрума в снимке ==="
LOG tape.records
LOG tape.total
LOG tape.position
LOG tape.record

PRINT "=== играет дальше с того же места ==="
COMMAND tape.play()
WAIT 2000
LOG tape.position
LOG tape.sound
LOG tape.transport
EXIT
