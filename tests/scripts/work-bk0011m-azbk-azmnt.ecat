# БК0011М + AZBK: утилита MAXIOL AZMNT 09 (library/bk/AZMOUNT1.BIN, описание
# там же в AZMOUNT1.lst; без библиотеки тест пропускается) на карте microSD
# tests/files/azbk-sd (tests/files/bk0011m-azbk-sd.ext).
#
# Запуск - как у платформы «AZБК» (launch/bk0011m-azbk-bin.ecat): ANDOS с AZ0,
# пробел на заставке, в панели ANDOS программа в память и пуск с 01000. ВК -
# таблица контроллера (011): D00 - andos330.img конфигурации. D01, ВК - обзор
# карты (0:/DISKS/: TEST.IMG; long-file-name.txt не 8.3 и не виден), выбор
# TEST.IMG. WRITE: CONTROLLER - разница с контроллером, подтверждение, 016+004 и
# сверка таблицей: «CONTROLLER WRITE VERIFIED», AZ1 - TEST.IMG. Затем D01
# очищается пробелом, и WRITE: CONTROLLER снимает его (016 + "D01" + 014). EXIT
# TO ANDOS - снова панель ANDOS (экран БК, 0177230 = 012201).
# @timeout 180

MACHINE "../../tests/files/bk0011m-azbk-sd.ext"
LOGDEFS _16,_8
WAIT _15000
KEY _10,_50,space
WAIT _3000
COMMAND cpu.stop()
COMMAND mapper.set16(100, 102, 2)
LOAD "../library/bk/AZMOUNT1.BIN"
COMMAND cpu.setreg(PSW, 0)
COMMAND cpu.setreg(SP, 1000)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _3000
PRINT "=== Таблица контроллера ==="
KEY _10,_50,ret
WAIT _3000
SCREEN "../results/work-bk0011m-azbk-azmnt-map.png"
PRINT "=== D01: TEST.IMG с карты ==="
KEY _10,_50,down
WAIT _500
KEY _10,_50,ret
WAIT _3000
KEY _10,_50,down
WAIT _300
KEY _10,_50,ret
WAIT _3000
KEY _10,_50,down
WAIT _150
