# УК-НЦ: дисплейный контроллер.
#
# Таблица строк и точки кладутся сценарием, процессоры стоят - так проверяется
# сам контроллер, а не то, как его заполняет ПЗУ.
#
# Картинка: 288 строк по 640 точек, в каждой строке повторяется восьмицветная
# лесенка. Индекс цвета - три бита, по одному из каждого плана, поэтому байты
# 252, 314 и 360 в планах 0, 1 и 2 дают подряд цвета 0..7.
#
# Таблица строк:
#   0000270  двухсловный   -> четырёхсловный дескриптор палитры в 0000300
#   0000300  палитра       -> четырёхсловный дескриптор параметров в 0000310
#   0000310  параметры     -> двухсловный в 0000320
#   0000320  двухсловный, замкнутый сам на себя: его берут все остальные строки
# @timeout 30

MACHINE "uknc/display-test.cfg"
LOGDEFS _16,_8

PRINT "=== точки: лесенка из восьми цветов, повторённая по всей строке ==="
# 80 октетов на строку при растяжке 1
COMMAND plane0.fill(10000, 10117, 252)
COMMAND plane1.fill(10000, 10117, 314)
COMMAND plane2.fill(10000, 10117, 360)

PRINT "=== таблица строк ==="
# 0000270: двухсловный. Точки из 0010000, связь на 0000300 как на
# четырёхсловный дескриптор палитры: разряд 1 - следующий четырёхсловный,
# разряд 2 - он именно палитра
COMMAND plane0.set16(270, 10000, 306)

# 0000300: палитра. Цвета 0..3 в первом слове, 4..7 во втором, по четыре
# разряда YRGB на цвет, цвет 0 в младшей тетраде.
#   0 чёрный(0), 1 белый(17), 2 красный(14), 3 зелёный(12)
#   4 синий(11), 5 жёлтый(16), 6 голубой(13), 7 фиолетовый(15)
# Связь на 0000310 как на четырёхсловный дескриптор параметров:
# разряд 1 стоит, разряд 2 сброшен
COMMAND plane0.set16(300, 126360, 155751, 10000, 312)

# 0000310: параметры. Растяжка 1 (разряды 4-5 нулевые), яркость полная
# (разряды 0-2 равны 7), курсора нет. Связь на замкнутый двухсловный 0000320
COMMAND plane0.set16(310, 0, 7, 10000, 320)

# 0000320: двухсловный, замкнутый сам на себя
COMMAND plane0.set16(320, 10000, 320)

PRINT "=== контроллер обходит таблицу: ждём несколько кадров ==="
WAIT _100

LOG display.resolution
LOG display.entries
LOG display.frames
LOG display.scale
LOG display.palette
LOG display.cursor

PRINT "=== таблица строк, как её читает контроллер ==="
LOG display.list(0,4)

SCREEN "../results/boot-uknc-display.png"

PRINT "=== растяжка: тот же кадр вчетверо шире точкой ==="
# Разряды 4-5 второго слова дескриптора параметров - показатель растяжки.
# Значение 2 даёт растяжку 4, то есть 160 видимых точек в строке
COMMAND plane0.set16(312, 47)
WAIT _100
LOG display.scale
LOG display.scales(0,3)
SCREEN "../results/boot-uknc-display-scale4.png"

EXIT
