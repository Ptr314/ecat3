# ДВК-4: второй контроллер DW (174040-174077, вектор 310) с геометрией из
# конфигурации - 8 головок, 8 секторов, 2 цилиндра (tests/files/dvk4-dw1.ext,
# образ - make_dw_geometry.py: в начале сектора его блок, цилиндр, головка и
# сектор). Чтение головки 5 доходит до своего блока, сектор 0 - последний на
# дорожке; прерывание приходит по вектору 310 и не путается с первым DW (у
# того нет накопителя, он так и стоит в сбросе).
# Запрос прерывания - уровень (Alex_K по схеме КЗД): обработчик снимает его,
# запрещая прерывания, а разрешение при поднятом «закончено» даёт прерывание
# сразу. Сектора 8 на дорожке нет: контроллер ищет его два оборота, а чтение
# кончается, как у Э-85 (прошивка та же): запрос данных с ошибкой и
# прерывание, «закончено» - когда программа прочтёт буфер; следующая команда
# ошибку чистит. Пока контроллер занят, регистры, кроме SI, не отвечают:
# ловушка по вектору 4. Записанный буфер, прочитанный ещё раз, прошивка
# записывает снова; команда 000 - возврат с выдачей буфера, 140 - ошибка.
# @timeout 60
MACHINE "../../tests/files/dvk4-dw1.ext"
LOGDEFS _16,_8
PRINT "=== Геометрия: цилиндры/головки/секторы ==="
LOG dw1.geometry
LOG dw.geometry
WAIT _12000
# Программа: на 1000 - MTPS #0 и ожидание на месте; обработчик вектора 310
# на 2000 - INC @#3000, CLR @#174060 (запрет прерываний DW1), RTI; вектора 4 -
# на 2400: INC @#3002, RTI. Вектор 300 (первый DW) - на HALT по 2200
COMMAND ram.set16(1000, 106427, 0, 000777)
COMMAND ram.set16(2000, 005237, 3000, 005037, 174060, 000002)
COMMAND ram.set16(2400, 005237, 3002, 000002)
COMMAND ram.set16(2200, 0)
COMMAND ram.set16(3000, 0, 0)
COMMAND ram.set16(300, 2200, 340)
COMMAND ram.set16(310, 2000, 340)
COMMAND ram.set16(4, 2400, 340)
TYPE "1000G"
# RESET монитора - сброс контроллера, 200 мс: команды - после него
WAIT _300
PRINT "=== Регистры второго DW: ID, SI ==="
LOG dw1.value16(0,0)
LOG dw1.value16(20,20)
PRINT "=== Чтение: цилиндр 1, головка 5, сектор 3, прерывания разрешены ==="
COMMAND dw1.set16(12, 1)
COMMAND dw1.set16(14, 5)
COMMAND dw1.set16(6, 3)
COMMAND dw1.set16(16, 40)
COMMAND dw1.set16(20, 100)
WAIT _50
LOG cpu.trap_vector
LOG ram.value16(3000,3000)
PRINT "=== Сектор: блок, цилиндр, головка, сектор ==="
LOG dw1.value16(10,10)
LOG dw1.value16(10,10)
LOG dw1.value16(10,10)
LOG dw1.value16(10,10)
LOG dw1.reads
PRINT "=== Сектор 0 - последний (8-й) на дорожке, головка 7 ==="
COMMAND dw1.set16(12, 0)
COMMAND dw1.set16(14, 7)
COMMAND dw1.set16(6, 0)
COMMAND dw1.set16(16, 40)
WAIT _50
LOG dw1.value16(10,10)
LOG dw1.value16(10,10)
LOG dw1.value16(10,10)
LOG dw1.value16(10,10)
PRINT "=== Первый DW не тронут, обработчик вызван один раз, программа в цикле ==="
LOG dw.reads
LOG dw.status
LOG ram.value16(3000,3000)
LOG cpu.pc
# Регистры состояния - полями: чтение CSR программой снимает «закончено»
PRINT "=== Сектор 8 (его нет), прерывания разрешены: через 20 мс ещё «занят» ==="
COMMAND dw1.set16(6, 10)
COMMAND dw1.set16(16, 40)
COMMAND dw1.set16(20, 100)
WAIT _20
LOG dw1.status
PRINT "=== Занятый контроллер: TST CSR программой - ловушка по вектору 4 ==="
# 1100: TST @#174056; BR . - переход туда с 1004 (JMP @#1100)
COMMAND ram.set16(1100, 005737, 174056, 000777)
COMMAND ram.set16(1004, 000137, 1100)
WAIT _1
LOG dw1.refused
LOG ram.value16(3002,3002)
LOG cpu.pc
PRINT "=== Через два оборота: SI - слово готово, CSR - ошибка и запрос данных, ERR - нет адреса, прерывание ==="
WAIT _60
LOG dw1.status
LOG dw1.csr
LOG dw1.err
LOG ram.value16(3000,3000)
LOG dw1.reads
PRINT "=== Программа читает буфер (256 слов, прерывания запрещены): закончено, ошибка осталась ==="
# 1104: MOV #400,R0; 1110: TST @#174050; SOB R0,1110; BR . - на месте BR . по 1104
COMMAND ram.set16(1110, 005737, 174050, 077003, 000777)
COMMAND ram.set16(1104, 012700, 000400)
WAIT _10
LOG cpu.pc
LOG dw1.status
LOG dw1.csr
LOG dw1.err
PRINT "=== Разрешение при поднятом «закончено»: прерывание сразу ==="
COMMAND dw1.set16(20, 100)
WAIT _1
LOG ram.value16(3000,3000)
LOG dw1.status
PRINT "=== Следующая команда (на дорожку 0) чистит ошибку ==="
COMMAND dw1.set16(16, 20)
WAIT _10
LOG dw1.status
LOG dw1.csr
LOG dw1.err
PRINT "=== Запись: цилиндр 0, головка 0, сектор 1, буфер программой (MOV R1) ==="
COMMAND dw1.set16(12, 0)
COMMAND dw1.set16(14, 0)
COMMAND dw1.set16(6, 1)
COMMAND dw1.set16(16, 60)
# 1120: MOV #400,R0; 1124: MOV R1,@#174050; SOB R0,1124; BR . - с 1116 через BR .+2
COMMAND ram.set16(1120, 012700, 000400, 010137, 174050, 077003, 000777)
COMMAND ram.set16(1116, 000400)
WAIT _10
LOG cpu.pc
LOG dw1.writes
LOG dw1.status
PRINT "=== Тот же буфер прочитан ещё раз: прошивка записывает его снова ==="
# 1134: MOV #400,R0; 1140: TST @#174050; SOB R0,1140; BR .
COMMAND ram.set16(1134, 012700, 000400, 005737, 174050, 077003, 000777)
COMMAND ram.set16(1132, 000400)
WAIT _10
LOG cpu.pc
LOG dw1.writes
LOG dw1.status
PRINT "=== Команда 000 - возврат, но с разрядом 4 = 0: в конце запрос данных, не «закончено» ==="
COMMAND dw1.set16(16, 0)
WAIT _10
LOG dw1.status
LOG dw1.csr
PRINT "=== Команда 140 - несуществующая: «закончено» и «неисправность» ==="
COMMAND dw1.set16(16, 140)
WAIT _1
LOG dw1.status
LOG dw1.csr
LOG dw1.err
LOG ram.value16(3000,3000)
LOG ram.value16(3002,3002)
LOG dw1.refused
EXIT
