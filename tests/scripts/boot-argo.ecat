# Арго ФВ-6511: приглашение монитора
# Снимаются геометрия ВГ75, карта памяти и портов и сам экран. Заставка
# "ARGO" выводится знаками, которые монитор сам кладет в ОЗУ знакогенератора,
# так что снимок проверяет заодно и разводку адреса знакогенератора, и
# страничный диспетчер: знакогенератор - это страница 3 второй банки ОЗУ, и
# кладет их монитор туда, переключившись на конфигурацию $63.
# @pixels 0  -- снимок сверяется точка в точку: экран этой машины почти пуст,
# и допуск по умолчанию проглатывает даже смену цвета всего текста
# @timeout 40

MACHINE "argo/Argo.cfg"
WAIT 2000

LOGDEFS 8,16
PRINT "=== Экран ==="
LOG display.resolution
LOG vg75.geometry
LOG vg75.frame_rate

PRINT "=== Знакогенератор в ОЗУ ==="
LOG ram.value($1F881,$1F888)
LOG memcfg.value($00,$00)

PRINT "=== Диспетчер памяти ==="
LOG mem.config
LOG mem.pages

PRINT "=== Карта памяти и портов ==="
LOG mapper.map

PRINT "=== Клавиатура ==="
KEY 100,80,D
WAIT 300
LOG ram.value($F850,$F853)

SCREEN "../results/boot-argo.png"
EXIT
