# БК0011М + AZBK: блиттер (MAXIOL, тема 5556, «редакция от 2025-05-26 для
# прошивки 19b1»; маски байтов - по его Verilog).
#
# Процессор крутит BR ., пакеты кладутся в память AZ напрямую и пускаются
# вручную: 0177272 - страница пакета, 0177270 - сначала 040000 (ручной
# режим), затем 050000 + число команд (пуск).
# 1. Пакет из пяти команд, страница 0500. DST - страница 0400 (слово
#    02000000), SRC - страница 0410 (слово 02040000):
#    A - заливка 0125 4x2 слов с приращением 5 (строка 8 слов);
#    B - копия 2x2 слова 010421 021042 031463 042104 в слово 040 с
#        приращением 7;
#    C - наложение 0252, 0135400 на заливку: нулевые байты прозрачны -
#        052652 и 0135525;
#    D - копия 011064, 053170 с зеркалом по X и обменом байтов: с правого
#        слова 061 влево - 032022 в 061, 074126 в 060;
#    E - NOP.
# 2. Заливка 256x255 слов (страница 01000): блиттер занят, пока она идет;
#    время - по замеру MAXIOL (12.28 точки 65 МГц на запись слова: 65280
#    слов - около 12.3 мс).
# @timeout 60

MACHINE "bk/BK-0011M-azbk.ext"
LOGDEFS _16,_8
WAIT _500
COMMAND cpu.stop()
COMMAND ram0.set16(1000, 000777)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()

PRINT "=== 1. Пакет из пяти команд ==="
COMMAND azbk-ram.set16(04100000, 010421, 021042, 031463, 042104)
COMMAND azbk-ram.set16(04100040, 000252, 135400)
COMMAND azbk-ram.set16(04100100, 011064, 053170)
COMMAND azbk-ram.set16(05000000, 000010, 000000, 000000, 000000, 001003, 000005, 000000, 000125)
COMMAND azbk-ram.set16(05000020, 004010, 040000, 000040, 000011, 001001, 000007, 000000, 000000)
COMMAND azbk-ram.set16(05000040, 004010, 040020, 000000, 000021, 000401, 000000, 000000, 000000)
COMMAND azbk-ram.set16(05000060, 004010, 040040, 000061, 001111, 000401, 000000, 000000, 000000)
COMMAND azbk-ram.set16(05000100, 000000, 000000, 000000, 000004, 000000, 000000, 000000, 000000)
COMMAND azbk-vga.set16(177272, 500)
COMMAND azbk-vga.set16(177270, 040000)
COMMAND azbk-vga.set16(177270, 050005)
WAIT _2
LOG azbk-vga.blit_busy
LOG azbk-vga.blit_words
LOG azbk-ram.value16(04000000, 04000027)
LOG azbk-ram.value16(04000100, 04000143)

PRINT "=== 2. Заливка 256x255 слов ==="
COMMAND azbk-ram.set16(05010000, 000020, 000000, 000000, 000000, 177777, 000001, 000000, 000167)
COMMAND azbk-vga.set16(177272, 501)
COMMAND azbk-vga.set16(177270, 050001)
WAIT _5
LOG azbk-vga.blit_busy
WAIT _10
LOG azbk-vga.blit_busy
LOG azbk-vga.blit_words
LOG azbk-vga.blit_ticks
LOG azbk-ram.value16(010000000, 010000003)
LOG azbk-ram.value16(010376774, 010377003)
EXIT
