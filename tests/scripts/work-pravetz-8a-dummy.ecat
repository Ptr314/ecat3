# Правец-8А: холостые циклы NMOS 6502 (dummy_reads = 1) доходят до ключей.
#
# * INC $C030: чтение, обратная запись старого значения и запись нового -
#   три обращения к динамику, его уровень меняется (без холостой записи
#   было бы два обращения и уровень остался бы прежним).
# * LDA $C083, затем LDA $C0F3,Y при Y = $90: адрес переходит на страницу
#   $C1, и до переноса процессор читает $C083 - второе чтение подряд, запись
#   в ОЗУ языковой карты разрешается. $5A ложится в банк 2 по $D000 (в ram
#   по тому же адресу). Без холостого чтения запись была бы запрещена.
# @timeout 30

MACHINE "pravetz/Pravetz-8A.cfg"
# Без штатного диска в дисководе: ПЗУ не грузит DOS, CTRL+RESET выводит в БЕЙСИК
COMMAND fdd0.eject()
LOGDEFS 8,16
WAIT 1000
KEYDOWN ctrl
KEY 50,100,f12
KEYUP ctrl
WAIT 500

# $300: INC $C030; RTS
COMMAND ram.set($0300,$EE,$30,$C0,$60)
# $310: LDA $C083; LDY #$90; LDA $C0F3,Y; LDA #$5A; STA $D000; LDA $C082; RTS
COMMAND ram.set($0310,$AD,$83,$C0,$A0,$90,$B9,$F3,$C0,$A9,$5A,$8D,$00,$D0,$AD,$82,$C0,$60)

PRINT "=== INC $C030 ==="
LOG sound.input
TYPE "CALL 768"
KEY 50,50,ret
WAIT 300
LOG sound.input

PRINT "=== LDA $C0F3,Y через страницу ==="
LOG ram.value($D000)
TYPE "CALL 784"
KEY 50,50,ret
WAIT 300
LOG ram.value($D000)
LOG mmu.switches
EXIT
