# УК-НЦ + КНГМД: загрузка RT-11 с дискеты sys1002.dsk во втором приводе.
#
# Конфигурация вставляет дискеты в оба привода: в привод 0 - sysimage.dsk,
# в привод 1 - sys1002.dsk. Меню ЗАГРУЗКА рисует ПП; пункт 1 - диск, стрелка
# вправо переводит в поле номера привода, цифра его меняет. Чтение дорожек
# делает ПЗУ ПП через bk-fdc (тот же К1801ВП1-128, что у БК), а в память ЦП
# загрузчик и система попадают через косвенный доступ ПП к планам 1 и 2.
# STARTS.COM настраивает терминал и запускает DATE, которая ждёт даты; ВК её
# принимает. DIR показывает каталог дискеты - он обязан совпасть со списком
# sys1002.lst, а не sysimage.lst из привода 0.
#
# Регистры процессоров не выводятся: они зависят от того, где ОС ждёт
# клавиатуру, см. «Что нельзя проверять» в tests/README.md.
# @timeout 180

MACHINE "uknc/UKNC.cfg"
WAIT _12000

LOGDEFS _16,_8
PRINT "=== дискеты в приводах ==="
LOG fdd0.file
LOG fdd1.file

PRINT "=== ЗАГРУЗКА: 1 - диск, привод 1 ==="
KEY _100,_100,1
WAIT _200
KEY _100,_100,right
WAIT _200
KEY _100,_100,1
WAIT _200
KEY _100,_100,ret
WAIT _20000
LOG fdd0.track
LOG fdd1.track
SCREEN "../results/disk-uknc-rt11-date.png"

PRINT "=== DATE принимает дату, DIR читает каталог ==="
KEY _100,_100,ret
WAIT _3000
TYPE "DIR\n"
WAIT _15000
SCREEN "../results/disk-uknc-rt11-dir.png"

# СТОП: ПП ставит центральному процессору HALT, и тот входит в пультовый
# монитор вектором 160170 - монитор сохраняет регистры и печатает «*** СТОП ***»
# с адресом прерванной программы. Через вектор 160004 («зависание») монитор
# регистров не сохранял и показывал 000000. ИСП продолжает RT-11 с того же
# места, и следующая команда выполняется как ни в чём не бывало
PRINT "=== СТОП, пультовый монитор, ИСП ==="
KEYDOWN key_stop
WAIT _150
KEYUP key_stop
WAIT _2000
SCREEN "../results/disk-uknc-rt11-stop.png"
KEYDOWN key_isp
WAIT _150
KEYUP key_isp
WAIT _3000
TYPE "SHOW\n"
WAIT _6000
SCREEN "../results/disk-uknc-rt11-resume.png"
EXIT
