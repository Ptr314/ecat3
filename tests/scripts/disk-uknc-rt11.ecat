# УК-НЦ + КНГМД: загрузка RT-11 с системной дискеты sys1002.dsk.
#
# Меню ЗАГРУЗКА рисует ПП, пункт 1 - диск 0. Чтение дорожек делает ПЗУ ПП
# через bk-fdc (тот же К1801ВП1-128, что у БК), а в память ЦП загрузчик и
# система попадают через косвенный доступ ПП к планам 1 и 2. STARTS.COM
# настраивает терминал и запускает DATE, которая ждёт даты; ВК её принимает.
# DIR показывает каталог дискеты - он обязан совпасть со списком sys1002.lst.
#
# Регистры процессоров не выводятся: они зависят от того, где ОС ждёт
# клавиатуру, см. «Что нельзя проверять» в tests/README.md.
# @timeout 120

MACHINE "uknc/UKNC.cfg"
COMMAND fdd0.load("sys1002.dsk")
WAIT _12000

LOGDEFS _16,_8
PRINT "=== дискета в приводе ==="
LOG fdd0.loaded
LOG fdd0.file
LOG fdd0.protected

PRINT "=== ЗАГРУЗКА: 1 - диск 0 ==="
KEY _100,_100,1
WAIT _200
KEY _100,_100,ret
WAIT _20000
LOG fdc.motor
SCREEN "../results/disk-uknc-rt11-date.png"

PRINT "=== DATE принимает дату, DIR читает каталог ==="
KEY _100,_100,ret
WAIT _3000
TYPE "DIR\n"
WAIT _15000
SCREEN "../results/disk-uknc-rt11-dir.png"
EXIT
