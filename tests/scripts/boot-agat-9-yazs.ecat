# Агат-9 с ячейкой звукового синтеза 5/2 и дисководами 840 и 140 Кб:
# загрузка демонстрационного диска ЯЗС до меню редактора «Школьница».
# Снимаются карта памяти и портов (ячейка на $C090, контроллер 140 Кб на
# $C0E0 и его загрузчик на $C600), регистры ячейки в покое - по ним программы
# ищут ее в слотах - и экран.
#
# Допуск на снимок: в меню ИКП мигает выделенная строка.
# @pixels 800
# @timeout 34

MACHINE "agat/Agat-9-yazs.ext"
WAIT 9000

LOGDEFS 8,16
PRINT "=== Карта памяти и портов ==="
LOG mapper.map

PRINT "=== Ячейка в покое ==="
LOG mapper.value($C090,$C09F)
LOG yazs.sleeping

SCREEN "../results/boot-agat-9-yazs.png"
EXIT
