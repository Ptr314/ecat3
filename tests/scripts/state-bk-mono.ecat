# БК0010-01: снимок, сделанный в монохромном режиме, поднимается с картинкой.
#
# ../tests/files/state-bk-mono.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-bk-mono.ecat: машина цветная по конфигурации, режим
# переключен в моно опцией экрана.
#
# Машина собирается по конфигурации снимка, и поверхность экрана получает
# ширину цветного режима, 256. Пока экран брал режим из снимка напрямую, а не
# через переключение, поверхность так и оставалась шириной 256, строка моно
# шириной 512 в нее не помещалась и не рисовалась: экран был черным.
# @timeout 40

MACHINE "../tests/files/state-bk-mono.ecats.zip"

LOGDEFS _16,_10
PRINT "=== Режим и размер экрана после загрузки состояния ==="
LOG display.color
LOG display.resolution
# Процессор стоит, пока ждём снимок экрана
COMMAND cpu.stop()
SCREEN "../results/state-bk-mono-restored.png"
COMMAND cpu.run()

# Переключение после восстановления по-прежнему работает
COMMAND display.option(_1,_0)
WAIT _100
PRINT "=== После переключения в цвет ==="
LOG display.color
LOG display.resolution

EXIT
