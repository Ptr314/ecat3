# БК0010-01 + СМК-512: пуск из ПЗУ платы и загрузка ANDOS с дискеты.
#
# Винчестера нет: пустой канал ИДЕ читается единицами, и BIOS около десяти
# секунд ждет готовности накопителя, прежде чем перейти к дисководу. Дисковод
# на плате совместим с К1801ВП1-128, тот же bk-fdc, что у КНГМД.
# @timeout 60

MACHINE "bk/BK-0010-01-smk512.ext"
LOGDEFS _16,_8

WAITFOR fdd0.track != 0, _30000
PRINT "=== BIOS дождался винчестера и перешел к дисководу ==="
LOG hdd.attached

WAIT _6000
PRINT "=== Система загружена с дискеты ==="
LOG smk.mode
LOG smk.layout
SCREEN "../results/boot-bk0010-smk.png"
EXIT
