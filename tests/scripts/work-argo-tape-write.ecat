# Арго ФВ-6511: запись на ленту
# Чтение проверяет work-argo-tape, а запись до сих пор не проверял никто: тракт
# достался от Юниора, а у Арго своя разводка лентопротяжки (порт $81 сдвинут на
# два разряда) и свой монитор.
#
# Команды записи у монитора нет вовсе: процедура в ПЗУ ($FA95) есть, но её никто
# оттуда не зовёт - она оставлена точкой входа для TCP/M. Поэтому запись здесь
# делает своя программа, повторяющая то, что делает ПЗУ. Все числа сняты с него:
#
#   $FAC0  ВИ53: управляющее $36 в $A6, счёт $02C0 в канал 0 ($A0) - 2400 бод
#   $FA7E  ВВ51: три нуля в $C3 (сброс синхронизации), $40 (внутренний сброс),
#          $8C (режим), $E6 (синхросимвол), затем команда $11
#   $FBB1  лентопротяжка: $06 в порт $81 - пуск вместе с записью
#   $FADF  байт: ждать TxRDY (разряд 0 порта $C3), затем байт в $C1
#   $FBA8  стоп
#
# Преамбулу AA AA 19 00 и синхросимвол $E6 ПЗУ шлёт перед каждой записью
# ($FAD1-$FADD), и без неё образ не загрузится обратно.
# @timeout 40

MACHINE "unior/Argo.cfg"
WAIT 1500
LOGDEFS 8,16

# Чистая кассета - файл из одного заголовка. Берётся юниоровская: контейнер у
# машин общий, и заводить второй такой же файл незачем
COMMAND tape.load("../files/unior-blank.bt")
PRINT "=== чистая кассета ==="
LOG tape.records
LOG tape.transport

#   $8000  LD A,$36 : OUT ($A6),A      ВИ53: канал 0, режим
#          LD A,$C0 : OUT ($A0),A      счёт $02C0 - 2400 бод
#          LD A,$02 : OUT ($A0),A
#          XOR A : OUT ($C3),A x3      ВВ51: сброс синхронизации
#          LD A,$40 : OUT ($C3),A      внутренний сброс
#          LD A,$8C : OUT ($C3),A      режим
#          LD A,$E6 : OUT ($C3),A      синхросимвол
#          LD A,$11 : OUT ($C3),A      команда: передатчик включён
#          LD A,$06 : OUT ($81),A      лентопротяжка в ЗАПИСЬ
#          LD HL,$8045 : LD B,13
#   цикл:  IN A,($C3) : AND 1 : JR Z   ждать TxRDY
#          LD A,(HL) : OUT ($C1),A : INC HL : DJNZ
#          LD BC,$2000 : задержка      дать последнему байту уйти из сдвигателя
#          LD A,$20 : OUT ($81),A      стоп
#          HALT
#   $8045  AA AA 19 00 E6 01..08       преамбула, синхросимвол и данные
COMMAND ram.set($8000,$3E,$36,$D3,$A6,$3E,$C0,$D3,$A0,$3E,$02,$D3,$A0,$AF,$D3,$C3,$D3)
COMMAND ram.set($8010,$C3,$D3,$C3,$3E,$40,$D3,$C3,$3E,$8C,$D3,$C3,$3E,$E6,$D3,$C3,$3E)
COMMAND ram.set($8020,$11,$D3,$C3,$3E,$06,$D3,$81,$21,$45,$80,$06,$0D,$DB,$C3,$E6,$01)
COMMAND ram.set($8030,$28,$FA,$7E,$D3,$C1,$23,$10,$F4,$01,$00,$20,$0B,$78,$B1,$20,$FB)
COMMAND ram.set($8040,$3E,$20,$D3,$81,$76,$AA,$AA,$19,$00,$E6,$01,$02,$03,$04,$05,$06)
COMMAND ram.set($8050,$07,$08)

COMMAND cpu.setreg(PC,$8000)
WAIT 500
PRINT "=== записано ==="
LOG tape.transport
LOG tapectl.value
LOG tape.records
LOG tape.writes
COMMAND tape.save("../results/work-argo-tape-write.bt")

# И то же самое обратно: образ, написанный машиной, должен читаться как лента
COMMAND tape.load("../results/work-argo-tape-write.bt")
PRINT "=== образ загружен обратно ==="
LOG tape.records
LOG tape.record
COMMAND tape.seek(0)
LOG tape.transport

EXIT
