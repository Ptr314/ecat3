# ДВК-3 с КЦГД вместо КСМ: графический терминал на своём КМ1801ВМ2 с
# прошивкой 181, связь с машиной - линия ИРПС на 57600 бод.
#
# Пульт пускает обе машины разом; монитор 055 выдаёт приглашение в линию,
# КЦГД рисует его в своей видеопамяти. BMX грузит RT-11 с MX, DIR MX0: читает
# каталог. Экран сличается текстом (поле text распознаёт знаки по шрифту
# прошивки, кириллицу - латиницей того же кода КОИ-7) и снимком: проверяется
# и развёртка по таблице строк, и палитра, которую выставила прошивка.
# @timeout 120
# @nomcp часы RT-11 идут от сетевого таймера, а в живой сессии машина успевает поработать до первой команды
MACHINE "dvk/DVK-3-KCGD.ext"
WAIT _3000
TYPE "BMX"
KEY _100,_50,ret
WAIT _25000
KEY _100,_50,ret
WAIT _3000
TYPE "DIR MX0:"
KEY _100,_50,ret
WAIT _8000

LOGDEFS _16,_8
PRINT "=== КЦГД ==="
LOG kcgd.palette
LOG kcgd-host.received
PRINT "=== Экран ==="
LOG display.text
SCREEN "../results/boot-dvk3-kcgd.png"
EXIT
