# УК-НЦ: снимок, снятый со звучащим тоном, поднимается и звучит дальше.
#
# ../tests/files/state-uknc-sound.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-uknc-sound.ecat: машина у меню ЗАГРУЗКА, в регистре
# 177716 подняты разряды 7 и 8 (линия динамика и нижний отвод сетки частот),
# таймеру поставлен шаг 16 мкс. Архив несет в себе все: свою конфигурацию,
# ПЗУ и раскладку, так что ничего снаружи не читается.
#
# Тон этой машины идет от счетчика программируемого таймера, то есть уровень
# на выходе меняется сам, без единой записи в регистр. Восстановление обязано
# поднять вместе с состоянием и это: разряды регистра приезжают в линию
# присваиванием, без обратного вызова, поэтому все, что устройство из них
# когда-то вывело, оно обязано пересчитать в state_restored(). Пока этого не
# было, микшер держал однажды посчитанный уровень и тон возвращался огрубленным
# - на слух призвук, в полях машины не видно ничего.
# @timeout 40

MACHINE "../tests/files/state-uknc-sound.ecats.zip"

LOGDEFS _16,_8
PRINT "=== регистр, таймер и экран после загрузки состояния ==="
LOG sound.control
LOG pp-timer.state
LOG pp-timer.period
LOG pp-timer.reload
LOG display.resolution
SCREEN "../results/state-uknc-sound-restored.png"

PRINT "=== уровень меняется сам ==="
LOG sound.moving

# Полупериод нижнего отвода при шаге 16 мкс - 16.4 мс. В какой момент придет
# команда сценария, плавает на порцию времени хоста, поэтому тон ловится от
# собственного фронта, а выборки стоят посреди полупериодов
PRINT "=== тон идет: полупериод 16.4 мс ==="
WAITFOR sound.level == 0, _100
WAITFOR sound.level == 1, _100
WAIT _8
LOG sound.level
WAIT _16
LOG sound.level
WAIT _16
LOG sound.level
WAIT _16
LOG sound.level

# И машина после этого живая: ПЗУ отвечает на клавиши, меню листается
PRINT "=== машина продолжает работать ==="
KEY _50,_50,down
WAIT _500
SCREEN "../results/state-uknc-sound-continued.png"

EXIT
