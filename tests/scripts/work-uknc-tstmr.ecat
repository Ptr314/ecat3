# УК-НЦ: тест таймера ПП TSTMR v0.1d (Titus) - 177710-177714. Эталон
# машины с 1515ХМ1-031 - docs-external/UKNC/timings/real.jpg: 2600 шагов
# «8 мкс» за кадр, минимальный период 1,920 мкс (шаг - 12 тактов ПП),
# переходная пара 0->98 (уставка 99: ноль держится шаг, затем N - 1).
# Проценты «неснятия» и «незаписи» на машине ненулевые - это гонки внутри
# 031, здесь они не смоделированы и дают 0.0%; по ним тест и узнает
# версию чипа, поэтому пишет «КА1515ХМ2-001», как и EmuStudio.
# @timeout 200

MACHINE "uknc/UKNC.cfg"
WAIT _12000
KEY _100,_100,1
WAIT _200
KEY _100,_100,ret
WAIT _15000

# Программа DAY спрашивает дату, ВК оставляет предложенную
KEY _100,_100,ret
WAIT _18000

COMMAND fdd1.load("../files/uknc-cputest/tstmr.dsk")
WAIT _500
TYPE "RU MZ1:TSTMR\n"
WAIT _20000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/work-uknc-tstmr.png"
EXIT
