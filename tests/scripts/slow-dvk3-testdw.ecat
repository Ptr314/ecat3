# ДВК-3 с DW: заводской тест контроллера TESTDW с винчестера, функциональный
# тест, полный цикл.
#
# Цикл проверяет доступ к регистрам, буфер контроллера, команды (на дорожку
# 0, чтение, запись, разметку), прерывания и позиционирование, и кончается
# сообщением «операция завершена» (код 015; при ошибках - код 026 и их
# число). Проверка прерываний и выяснила, что разрешение при уже поднятом
# «закончено» запроса не даёт, а сброс - операция со временем: прерывание
# приходит от её конца. Тест переписывает векторы ловушками, поэтому
# тумблер «Прерывания» выключен, как и на настоящей машине. Запись - в
# память, образ не меняется.
# @timeout 600
# @nomcp в живой сессии машина успевает поработать до первой команды, а загрузка RT-11 зависит от времени
MACHINE "dvk/DVK-3-MY.ext"
COMMAND dw.load("rt11-dw.dsk")
COMMAND dw.volatile(1)
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BDW"
KEY _100,_50,ret
WAIT _20000
KEY _100,_50,ret
WAIT _1000
TYPE "R TESTDW"
KEY _100,_50,ret
COMMAND panel.option(1,0)
WAIT _5000
# Главное меню: «функциональный тест» - пятая строка
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,ret
WAIT _5000
# Его меню: «полный цикл тестирования» - восьмая строка
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,ret
WAIT _150000

LOGDEFS _16,_8
PRINT "=== Код завершения TESTDW (015 - без ошибок) ==="
LOG ram.value16(001000)
PRINT "=== Экран ==="
LOG display.text
EXIT
