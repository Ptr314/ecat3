# ДВК-3 с DW: заводской тест контроллера TESTDW с винчестера, функциональный
# тест, полный цикл.
#
# Цикл проверяет доступ к регистрам, буфер контроллера, команды (на дорожку
# 0, чтение, запись, разметку), прерывания и позиционирование, и кончается
# сообщением «операция завершена» (код 015; при ошибках - код 026 и их
# число). Проверка прерываний - сброс, пауза, разрешение, ожидание: запрос
# DW уровнем, и прерывание приходит, кончился сброс к разрешению или нет
# (защёлка по фронту требовала сброса дольше паузы). Тест переписывает
# векторы ловушками, поэтому тумблер «Прерывания» выключен, как и на
# настоящей машине. Запись - в память, образ не меняется.
# @timeout 600
MACHINE "dvk/DVK-3.cfg"
COMMAND dw.load("../library/dvk/rt11-dw.dsk")
COMMAND dw.volatile(1)
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BDW"
KEY _100,_50,ret
WAIT _20000
KEY _100,_50,ret
WAIT _1000
TYPE "R TESTDW"
KEY _100,_50,ret
COMMAND panel.option(1,0)
WAIT _5000
# Главное меню: «функциональный тест» - пятая строка
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,ret
WAIT _5000
# Его меню: «полный цикл тестирования» - восьмая строка
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,down
WAIT _300
KEY _100,_50,ret
WAIT _150000

LOGDEFS _16,_8
PRINT "=== Код завершения TESTDW (015 - без ошибок) ==="
LOG ram.value16(001000)
PRINT "=== Экран ==="
LOG display.text
EXIT
