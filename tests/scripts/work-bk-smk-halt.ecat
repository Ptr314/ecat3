# БК0011М + СМК-512: пультовый режим К1801ВМ1 в режимах платы Hlt.
#
# У ВМ1 нет своего пультового режима: вход в пультовое исключение (команда
# HALT, линия nIRQ1 - клавиша СТОП) - это RMW 0177716 с установкой разряда 3,
# запись PSW в 0177676 и PC в 0177674 и новые PC и PSW из 0160002/0160004.
# На простой БК по 0177676 никто не отвечает, тайм-аут превращается в
# ловушку через 004 - поэтому СТОП у БК и работает через вектор 4. В режимах
# платы Hlt10/Hlt11 на 0177000-0177777 стоит ее ОЗУ на запись, а на 0160000 -
# ОЗУ на чтение и запись: пультовый вход проходит целиком.
#
# 1. HALT в режиме Hlt11 (код 0, страница 0). Обработчик по 0160002 - 02000 в
#    ОЗУ машины - отмечает вход (0123 в 01500), достает сохраненные PC и PSW
#    через режим All (сегмент 7 там виден с 0130000), кладет их в сегмент 3
#    через ОЗУ10 (с 0130000 там сегмент 3), включает All, где 0177674/0177676
#    читаются из сегмента 3, и возвращается командой START. Стек программы не
#    тронут, в R0 и R1 - сохраненные PC (01032, следующая за HALT) и PSW.
# 2. СТОП в режиме Hlt11: тот же обработчик, возврат на BR . по 03014.
# 3. СТОП в режиме All: сохранять PSW некуда, тайм-аут - ловушка через 004 по
#    стеку программы, как на простой БК; обработчик 04000 отмечает 044 в 01504.
# @timeout 40

MACHINE "bk/BK-0011M-smk512.cfg"
LOGDEFS _16,_8
WAIT _300
COMMAND cpu.stop()

# Программа 1: Hlt11, вектор 0160002 = 02000 с PSW 02340, HALT
COMMAND ram0.set16(1000, 012737, 000006, 177130, 012737, 000000, 177130, 012737, 002000, 160002, 012737, 002340, 160004, 000000, 012737, 000001, 001502, 000777)
# Обработчик пультового входа
COMMAND ram0.set16(2000, 012737, 000123, 001500, 012737, 000006, 177130, 012737, 000020, 177130, 013700, 137674, 013701, 137676, 012737, 000006, 177130, 012737, 000120, 177130, 010037, 137674, 010137, 137676, 012737, 000006, 177130, 012737, 000020, 177130, 000012)
# Программа 2: Hlt11 и BR .
COMMAND ram0.set16(3000, 012737, 000006, 177130, 012737, 000000, 177130, 000777)
# Обработчик ловушки через 004
COMMAND ram0.set16(4000, 012737, 000044, 001504, 000777)
COMMAND ram0.set16(1500, 0, 0, 0)

PRINT "=== 1. HALT в режиме Hlt11 ==="
COMMAND cpu.setreg(SP, 1000)
COMMAND cpu.setreg(PSW, 0)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _50
LOG cpu.registers
LOG ram0.value16(1500, 1503)
LOG smk.mode
LOG smk-ram.value16(077674, 077677)

PRINT "=== 2. СТОП в режиме Hlt11 ==="
COMMAND ram0.set16(1500, 0)
COMMAND cpu.stop()
COMMAND cpu.setreg(PC, 3000)
COMMAND cpu.run()
WAIT _20
KEYDOWN key_stop
KEYUP key_stop
WAIT _50
LOG cpu.registers
LOG ram0.value16(1500, 1501)
LOG smk.mode

PRINT "=== 3. СТОП в режиме All: ловушка через 004 ==="
COMMAND ram0.set16(4, 4000, 340)
KEYDOWN key_stop
KEYUP key_stop
WAIT _50
LOG cpu.registers
LOG ram0.value16(1504, 1505)
LOG ram0.value16(774, 777)
EXIT
