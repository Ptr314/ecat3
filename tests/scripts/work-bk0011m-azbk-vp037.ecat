# БК0011М + AZBK с доработкой управления 037 (modification = vp037; Verilog
# MAXIOL, тема 5556): разряд 14 0177346 стоит сам и записью не снимается,
# разряд 9 отключает ОЗУ БК под окнами 0-11.
#
# Программа идет из окна 14 (страница AZ 0400): под окнами 0-7 память во
# время теста меняется. Ловушка через 004 считает себя в 0160600; вектор
# лежит и в ОЗУ БК, и в странице AZ 030. Прерывания запрещены.
# 1. R0 - 0177346 после старта: разряд 14 поднят.
# 2. Разряд 9, запись 014000 в 0177716: окна 0-7 отвечают сами, без тени;
#    запись 052525 в 040000 ложится только в страницу AZ 4, ОЗУ БК (ram5)
#    не трогает, чтение (R1) - из AZ.
# 3. Окно 4 снято из 0177340: ОЗУ БК под ним отключено - чтения 040000 никто
#    не подтверждает, ловушка (R2 остается 0).
# 4. Разряды 9 и 11 дают 040000 в чтении 0177716 (R3).
# 5. Снятие 045000: разряд 14 остается (R5); запись 014000 возвращает тень:
#    040000 снова из ОЗУ БК (R4 = 0), 012345 в 040002 ложится и туда, и в AZ.
# @timeout 60

MACHINE "../../tests/files/bk0011m-azbk-vp037.ext"
LOGDEFS _16,_8
WAIT _500
COMMAND cpu.stop()

COMMAND ram5.set16(0, 0, 0)
COMMAND azbk-ram.set16(040000, 0, 0)
COMMAND ram0.set16(4, 160400, 340)
COMMAND azbk-ram.set16(0300004, 160400, 340)
COMMAND ram0.set16(1000, 012737, 000400, 177334, 052737, 040000, 177340, 000137, 160000)
COMMAND azbk-ram.set16(04000000, 005002, 013700, 177346, 052737, 001000, 177346, 012737, 014000, 177716, 012737, 052525, 040000, 013701, 040000)
COMMAND azbk-ram.set16(04000034, 042737, 000020, 177340, 013702, 040000, 052737, 004000, 177346, 013703, 177716)
COMMAND azbk-ram.set16(04000060, 042737, 045000, 177346, 013705, 177346, 012737, 014000, 177716, 013704, 040000, 012737, 012345, 040002, 000777)
COMMAND azbk-ram.set16(04000400, 005237, 160600, 000002)
COMMAND azbk-ram.set16(04000600, 0)

COMMAND cpu.setreg(SP, 170000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _20

PRINT "=== Регистры ==="
LOG cpu.registers
LOG azbk.control
LOG azbk.active
LOG azbk.shadow
PRINT "=== 040000: ОЗУ БК и страница AZ 4 ==="
LOG ram5.value16(0, 3)
LOG azbk-ram.value16(040000, 040003)
PRINT "=== Ловушки ==="
LOG azbk-ram.value16(04000600)
EXIT
