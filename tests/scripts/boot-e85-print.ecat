# Электроника МС 0585: разъём «Печать». ПРОС 2.03 печатает кадр клавишей ПЕЧАТЬ КАДРА и текстовый
# файл через меню обслуживания печати: байты уходят из 2661 на 9600 бод, русский текст -
# в КОИ-7 с SO/SI (в поле text это латиница и точки). В конце линия работает и в обратную сторону:
# два одинаковых байта от принтера доходят до приёмника порознь
# @timeout 120
MACHINE "computers/e85/MS0585-NMD.ext"
COMMAND knmd.load("../library/e85/pros-2.03-10m.rd")
COMMAND knmd.volatile(1)
COMMAND fd0.load("../library/e85/emul-1.3.hfe")
LOGDEFS _16,_8
WAIT _45000
LOG prn.sent
KEYDOWN key_f2
WAIT _100
KEYUP key_f2
WAIT _300
WAIT _5000
LOG prn.sent
LOG prn.text
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _4000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _5000
KEYDOWN key_f14
WAIT _100
KEYUP key_f14
WAIT _300
WAIT _4000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _5000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _8000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _90000
LOG prn.sent
LOG prn.overruns
LOG prn.text(_400)
SCREEN "../results/boot-e85-print.png"
LOG prn.received
COMMAND prn.send("AA")
LOG prn.queued
WAIT _10
LOG prn.received
LOG prn.queued
LOG prn.overruns
EXIT
