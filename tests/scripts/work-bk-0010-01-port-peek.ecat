# БК0010-01: регистры в 0177600-0177777 глазами отладчика. Окно памяти и LOG
# читают байты через get_direct() диспетчера; у 16-разрядного регистра по
# нечетному адресу должен быть его старший байт, как его читает процессор.
# Раньше port и bk-timer отдавали там младший: 0177664 со значением 001330
# в отладчике выглядел как 154330, и казалось, что регистр не читается.
# @timeout 20

MACHINE "bk/BK-0010-01.cfg"
WAIT _1500

# 1000: MOV #1234,@#177664; MOV #12345,@#177706 (уставка таймера);
#       MOV @#177664,@#2000; MOV @#177706,@#2002; BR .
COMMAND ram.set16(&1000, &012737, &001234, &177664, &012737, &012345, &177706, &013737, &177664, &002000, &013737, &177706, &002002, &000777)
COMMAND cpu.setreg(PC, &1000)
WAIT _20

LOGDEFS _16,_8
PRINT "=== Прочитал процессор ==="
LOG ram.value16(&2000, &2003)
LOG port-scroll.value
LOGDEFS _8,_8
PRINT "=== Видит отладчик ==="
LOG mapper.value(&177664, &177665)
LOG mapper.value(&177706, &177707)
LOG mapper.value(&177700, &177705)
LOG mapper.value(&177716, &177717)
EXIT
