# Электроника МС 0585: «Вертолёт». Игра ждёт нажатия, читая состояние клавиатуры в цикле,
# а символ забирает обработчик ядра: это работает только потому, что команда читает
# состояние раньше, чем примется прерывание (rx_delay у kbd). Код клавиши игра берёт
# из регистра данных, где остаётся последний символ. На экране вертолёт в полёте и очки
# @timeout 120
MACHINE "computers/e85/MS0585-NMD.ext"
COMMAND knmd.load("../library/e85/pros-2.03-10m.rd")
COMMAND knmd.volatile(1)
WAIT _45000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _10000
KEYDOWN key_space
WAIT _100
KEYUP key_space
WAIT _300
WAIT _3000
KEYDOWN key_space
WAIT _100
KEYUP key_space
WAIT _300
WAIT _2000
KEYDOWN key_up
WAIT _1000
KEYUP key_up
WAIT _200
KEYDOWN key_right
WAIT _1000
KEYUP key_right
WAIT _200
WAIT _1000
KEYDOWN key_right
WAIT _1000
KEYUP key_right
WAIT _200
KEYDOWN key_up
WAIT _1000
KEYUP key_up
WAIT _200
LOGDEFS _16,_8
LOG kbd.received
LOG keyboard.clicks
# Игра стирает вертолёт и рисует заново: снимок через кадр, на целом вертолёте
WAIT _20
SCREEN "../results/boot-e85-game-helby.png"
EXIT
