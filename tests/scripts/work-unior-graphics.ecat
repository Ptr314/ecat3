# Юниор ФВ-6506: графический режим
# Монитор псевдографикой не пользуется, поэтому режим включает вписанная в
# память программа - тем же способом, что и программы с лент: разряд 3 порта C
# переводит знакогенератор на второй банк, ВГ75 перепрограммируется на 80x64
# знакоместа по 6x4 точки, канал 2 ВТ57 выдает буфер в 5120 байт.
# Счет канала 2 - $13FF: ВТ57 пересылает на байт больше, чем записано, и
# ровно 5120 = 80x64 байт на кадр дают неподвижную картинку.
# @timeout 30

MACHINE "unior/Unior.cfg"
WAIT 1500

PRINT "=== Программа в памяти ==="
COMMAND ram.set($0100, $3E, $2F, $D3, $4E, $3E, $32, $D3, $DF, $3E, $40, $D3, $DC)
COMMAND ram.set($010C, $AF, $D3, $DC, $F3, $AF, $D3, $61, $3E, $4F, $D3, $60, $3E)
COMMAND ram.set($0118, $FF, $D3, $60, $3E, $03, $D3, $60, $3E, $2D, $D3, $60, $3E)
COMMAND ram.set($0124, $E0, $D3, $61, $3E, $00, $D3, $34, $3E, $20, $D3, $34, $3E)
COMMAND ram.set($0130, $FF, $D3, $35, $3E, $93, $D3, $35, $3E, $23, $D3, $61, $DB)
COMMAND ram.set($013C, $61, $E6, $20, $CA, $3B, $01, $3E, $84, $D3, $38, $FB, $21)
COMMAND ram.set($0148, $00, $20, $01, $00, $14, $7D, $84, $E6, $3F, $77, $23, $0B)
COMMAND ram.set($0154, $78, $B1, $C2, $4D, $01, $76)
COMMAND cpu.setreg(PC, $0100)
WAIT 1000

LOGDEFS 8,16
PRINT "=== Графический режим ==="
LOG display.resolution
LOG vg75.geometry
LOG vg75.frame_rate
LOG port-kbd.value(0,3)
LOG cpu.pc

SCREEN "../results/work-unior-graphics.png"
EXIT
