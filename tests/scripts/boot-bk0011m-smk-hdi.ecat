# БК0011М + СМК-512: загрузка с винчестера в формате *.hdi.
#
# Образ *.hdi начинается с паспорта накопителя (ответ на IDENTIFY, 512 байт),
# и сектора идут после него. ../files/bk-smk-hdd.hdi - тот же образ, что в
# boot-bk0011m-smk (bk-smk-hdd.img), с таким заголовком спереди; геометрия в
# заголовке нарочно неверная (99/2/17): таблица разделов АльтПро в блоке 7
# (40/16/63) главнее паспорта. Без учета заголовка каждый сектор читался бы
# соседний, BIOS не нашел бы таблицы и загрузился с дискеты - дискета здесь
# вынута, так что тест тогда показал бы пустой экран.
# @timeout 60
# @nomcp образ винчестера вставляется до того, как BIOS опросит канал, а живая сессия успевает пройти опрос раньше первой команды

MACHINE "bk/BK-0011M-smk512.cfg"
LOGDEFS _16,_8

COMMAND fdd0.eject()
COMMAND hdd.load("../files/bk-smk-hdd.hdi")
COMMAND hdd.volatile(1)
LOG hdd.geometry

WAIT _8000
PRINT "=== Система загружена с винчестера ==="
LOG hdd.reads
SCREEN "../results/boot-bk0011m-smk-hdi.png"
EXIT
