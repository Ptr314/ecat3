# БК0011М + СМК-512: загрузка с обрезанного образа *.hdi.
#
# Образы для bkemu раздают обрезанными по последнему занятому сектору, и длина
# у них бывает не кратной сектору (Excess team, «Однажды»: 2081 сектор и еще
# 88 байт при диске 490/4/32). ../files/bk-smk-hdd-tail.hdi - образ из
# boot-bk0011m-smk-hdi с 88 байтами единиц в конце. Накопитель - по таблице
# разделов, сектора за концом файла читаются пустыми. Раньше такой образ не
# вставлялся вовсе, и тест показал бы пустой экран.
# @timeout 60
# @nomcp образ винчестера вставляется до того, как BIOS опросит канал, а живая сессия успевает пройти опрос раньше первой команды

MACHINE "bk/BK-0011M-smk512.ext"
LOGDEFS _16,_8

COMMAND fdd0.eject()
COMMAND hdd.load("../files/bk-smk-hdd-tail.hdi")
COMMAND hdd.volatile(1)
LOG hdd.geometry

WAIT _8000
PRINT "=== Система загружена с винчестера ==="
LOG hdd.reads
SCREEN "../results/boot-bk0011m-smk-hdi-tail.png"
EXIT
