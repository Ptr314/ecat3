// К1801ВМ2: флаг V у SBC/SBCB и DIV с нечетным регистром (тест процессора
// Titus v0.3a показывал ERROR у SBCB). Ожидаемое снято с модели кристалла
// (github 1801BM1/cpu11, vm2/hdl/syn) на той же программе:
//  - SBC/SBCB: V только при C = 1 и операнде 100000 (200); с C = 0 операнд
//    не меняется и V сброшен;
//  - DIV с нечетным регистром: делимое - R:R, в регистре остается частное
//    (R1 = 3, DIV #7,R1: 196611 / 7 -> 066667); при переполнении регистр
//    не меняется.
// Программа с 1000: шесть DIV #n,R1 (CCC, R1, R0 = 11111; в 2000+ - PSW,
// R1, R0), DIV #3,R2 с R2:R3 = 0:7, затем SBC R4 / SBCB R4 на 100000, 0,
// 200, 0, 1 сначала с C = 0, потом с C = 1 (PSW, R4).
// Модель кристалла записала в 2000-2120:
//   342 7 11111   340 66667 11111   342 77777 11111   342 100000 11111
//   343 5 11111   342 177775 11111  340 2 1
//   350 100000  344 0  350 200  344 0  340 1
//   342 77777   351 177777  342 177  351 377  344 0
// (байт PSW записан MFPS, у ВМ2 приоритет 7 - 340)
// @timeout 29
@extends uknc/reset-test.cfg
@version Тест SBC и DIV (.ext)

cpu:start_address = 1000

@script
LOGDEFS _16,_8
COMMAND ram.set16(1000, 257, 12701, 7, 12700, 11111, 71127, 3, 106737)
COMMAND ram.set16(1020, 2000, 10137, 2002, 10037, 2004, 257, 12701, 3)
COMMAND ram.set16(1040, 12700, 11111, 71127, 7, 106737, 2006, 10137, 2010)
COMMAND ram.set16(1060, 10037, 2012, 257, 12701, 77777, 12700, 11111, 71127)
COMMAND ram.set16(1100, 1, 106737, 2014, 10137, 2016, 10037, 2020, 257)
COMMAND ram.set16(1120, 12701, 100000, 12700, 11111, 71127, 177777, 106737, 2022)
COMMAND ram.set16(1140, 10137, 2024, 10037, 2026, 257, 12701, 5, 12700)
COMMAND ram.set16(1160, 11111, 71127, 0, 106737, 2030, 10137, 2032, 10037)
COMMAND ram.set16(1200, 2034, 257, 12701, 177775, 12700, 11111, 71127, 2)
COMMAND ram.set16(1220, 106737, 2036, 10137, 2040, 10037, 2042, 257, 12702)
COMMAND ram.set16(1240, 0, 12703, 7, 71227, 3, 106737, 2044, 10237)
COMMAND ram.set16(1260, 2046, 10337, 2050, 12704, 100000, 257, 5604, 106737)
COMMAND ram.set16(1300, 2052, 10437, 2054, 12704, 0, 257, 5604, 106737)
COMMAND ram.set16(1320, 2056, 10437, 2060, 12704, 200, 257, 105604, 106737)
COMMAND ram.set16(1340, 2062, 10437, 2064, 12704, 0, 257, 105604, 106737)
COMMAND ram.set16(1360, 2066, 10437, 2070, 12704, 1, 257, 5604, 106737)
COMMAND ram.set16(1400, 2072, 10437, 2074, 12704, 100000, 257, 261, 5604)
COMMAND ram.set16(1420, 106737, 2076, 10437, 2100, 12704, 0, 257, 261)
COMMAND ram.set16(1440, 5604, 106737, 2102, 10437, 2104, 12704, 200, 257)
COMMAND ram.set16(1460, 261, 105604, 106737, 2106, 10437, 2110, 12704, 0)
COMMAND ram.set16(1500, 257, 261, 105604, 106737, 2112, 10437, 2114, 12704)
COMMAND ram.set16(1520, 1, 257, 261, 5604, 106737, 2116, 10437, 2120)
COMMAND ram.set16(1540, 777)
COMMAND pp-sys.set16(0, 40)
WAIT _10
LOG cpu.pc
LOG ram.value16(2000, 2122)
EXIT
