COMMAND ram0.set16(4000, 000001, 000000, 000001, 000016, 000004, 010000, 000001, 000004)
COMMAND ram0.set16(4020, 000000, 000000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _100
PRINT "CSR 004 D02"
LOG ram0.value16(6004, 6005)
LOG cpu.registers
LOG az2.attached
COMMAND az-sd.eject()
LOG az-sd.attached
LOG az-sd.files
LOG azbk-disk.sd
LOG az2.attached
PRINT "=== 11. Без карты ==="
COMMAND cpu.stop()
COMMAND ram0.set16(4000, 000001, 000000, 000001, 000056, 000000, 000000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _100
PRINT "CSR 056 без карты"
LOG ram0.value16(6002, 6003)
LOG cpu.registers
COMMAND az-sd.load("../files/azbk-sd")
LOG az-sd.attached
LOG az-sd.file
LOG az-sd.files
PRINT "=== 11. Карта снова ==="
COMMAND cpu.stop()
COMMAND ram0.set16(10000, 042516, 027127, 054124, 000124, 000000)
COMMAND ram0.set16(10012, 042510, 046114, 027117, 054124, 000124, 000000)
COMMAND ram0.set16(4000, 000001, 000000, 000001, 000023, 000004, 010000, 000001, 000050)
COMMAND ram0.set16(4020, 000001, 000051, 000003, 000002, 000001, 000000, 000001, 000023)
COMMAND ram0.set16(4040, 000004, 010012, 000001, 000050, 000001, 000051, 000003, 000002)
COMMAND ram0.set16(4060, 000000, 000000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _100
PRINT "051 NEW.TXT: файлов прежней карты в памяти больше нет"
LOG ram0.value16(6010, 6013)
PRINT "051 HELLO.TXT"
LOG ram0.value16(6024, 6027)
LOG cpu.registers
EXIT
