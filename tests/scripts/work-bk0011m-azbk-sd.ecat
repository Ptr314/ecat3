# БК0011М + AZBK: карта microSD контроллера AZ - как ее обслуживает прошивка
# STM32 00019 MAXIOL (разбор - docs/dev/machines.md; вики «API контроллеров
# AZ», утилиты AZMNT/AZUMNT/AZSMNT, AZLIB02). Карта - каталог
# tests/files/azbk-sd (tests/files/bk0011m-azbk-sd.ext), записи машины - в
# памяти карты. Сценарий собирает tests/files/make-azbk-sd-test.py: таблицу
# операций выполняет интерпретатор в ОЗУ БК (описание - в начале скрипта
# сборки), CSR после каждой команды - 0200 (готово) или 0100200 (ошибка).
# Итог 003, 004, 013, 014 - только в слове ошибки (DR вне потока).
#
# 1. Объем карты (056/057): 1024 МБ, свободно 1023.
# 2. Оглавление корня (003, 013 и 015 по записи): DISKS, HELLO.TXT,
#    LOWER.TXT (lower.txt компьютера), SCREENS, TEMP (его, как и SCREENS,
#    плата заводит при старте; здесь - в памяти карты), затем запись с нулем в
#    первом байте имени (остальное - от TEMP, как у f_readdir). Атрибуты - 020
#    каталог, 040 файл. В DISKS - только TEST.IMG: long-file-name.txt не 8.3,
#    карта его не видит. Нет каталога - слово 0x8205; 003 без потока 016 -
#    0x8100.
# 3. Чтение HELLO.TXT (023 имя, 050, 051 длина 11, 052, 022): «HELLO AZBK!»;
#    следующая 052 - без ошибки, буфер - нули (файл прочитан и закрыт).
# 4. Ошибки открытия: 051 - 0, 0 (прошивка считает «1 << 31 + код» как
#    1 << (31 + код)): нет файла, «..», сетевой диск N:, нет каталога, не 8.3.
# 5. Запись NEW.TXT (053 с малыми буквами, 051 = 0, 0, 054 длина 5, 023,
#    055): лишняя 055 ничего не пишет; чтение назад - «ABCDE»; оглавление
#    DISKS не тронуто, файл - в памяти карты (поле files гнезда az-sd).
# 6. Монтирование (004 «D01=0:/disks/test.img», слово 0), блок 0 с AZ1:
#    012345 054321; таблица 011 - размер в блоках, флаги 5, атрибут 040, путь
#    большими буквами; D01 занят - 0x8900, D05 (у машины нет) - 0xB600, «D1=»
#    (одна цифра) - 0x8600; 014 «D01» - 0, AZ1 пуст (001 - 0x8C00); 014
#    «D03» пустого - 0xBC00; ошибки разбора 014 копятся: «D1» - 0x8600, «X01»
#    - 0x8700.
# 7. 047: HELLO.TXT в память AZ с адреса (0 + 020) << 16 = 04000000 (страница
#    01000); состояние - в слове 0 буфера (022): 0. Хвост файла короче
#    512 байт прошивка пишет из другого буфера - нули. Файл закрыт: 047 снова
#    - 3 (ошибка чтения).
# 8. Снимок экрана (044): заголовок в странице 076 - страница 4, одна (метку
#    0240 прошивка не проверяет); имя короче 10 знаков - по часам платы,
#    0:/SCREENS/ДДЧЧММСС.SCR, оно же в буфере; файл - 1024 + 4096 байт
#    (012000). Нет каталога - в буфере «ERROR 5 f_open 0:/NODIR/SHOT1.SCR».
# 9. Блок 1 образа, смонтированного с карты, записан машиной (006); после 014
#    файл TEST.IMG на карте (в ее памяти) - уже с ним: 111111 122222.
# 10. Файл 050/053 один: после 053 COPY.TXT 052 HELLO.TXT не читает (файл на
#    запись), буфер - нули, 055 пишет их в COPY.TXT: 11 нулевых байт.
# 11. Гнездо az-sd командами сценария (так же их дает кнопка SD окна):
#    protect 0/1 - запись в каталог и обратно (ничего не пишется); eject
#    снимает образ, смонтированный с карты (AZ2), команды карты - ошибка;
#    load вставляет каталог снова - файлов, записанных в память прежней
#    карты, на новой нет.
# @timeout 60

MACHINE "../../tests/files/bk0011m-azbk-sd.ext"
LOGDEFS _16,_8
WAIT _500
COMMAND cpu.stop()
COMMAND ram0.set16(1000, 012701, 177220, 012702, 004000, 012705, 006000, 012203, 001430)
COMMAND ram0.set16(1020, 012204, 005303, 001005, 010411, 105711, 100376, 011125, 000766)
COMMAND ram0.set16(1040, 005303, 001003, 010461, 000002, 000761, 005303, 001004, 016125)
COMMAND ram0.set16(1060, 000002, 077403, 000753, 012403, 010361, 000002, 001374, 000746)
COMMAND ram0.set16(1100, 000777)
LOG azbk-disk.sd
PRINT "=== 1. Объем карты ==="
COMMAND cpu.stop()
COMMAND ram0.set16(4000, 000001, 000000, 000001, 000056, 000001, 000057, 000003, 000002)
COMMAND ram0.set16(4020, 000000, 000000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _100
PRINT "056"
