COMMAND ram0.set16(4060, 000002, 042103, 000002, 000105, 000001, 000055, 000001, 000055)
COMMAND ram0.set16(4100, 000001, 000000, 000001, 000023, 000004, 010012, 000001, 000050)
COMMAND ram0.set16(4120, 000001, 000051, 000003, 000002, 000001, 000052, 000001, 000022)
COMMAND ram0.set16(4140, 000003, 000003, 000000, 000000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _100
