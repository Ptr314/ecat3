COMMAND ram0.set16(4120, 000003, 000013, 000001, 000000, 000001, 000013, 000001, 000015)
COMMAND ram0.set16(4140, 000003, 000013, 000001, 000000, 000001, 000013, 000001, 000015)
COMMAND ram0.set16(4160, 000003, 000013, 000001, 000000, 000001, 000016, 000004, 010006)
