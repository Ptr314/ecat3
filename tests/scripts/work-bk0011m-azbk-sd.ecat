LOG az2.attached
COMMAND az-sd.eject()
LOG az-sd.attached
LOG az-sd.files
LOG azbk-disk.sd
LOG az2.attached
PRINT "=== 11. Без карты ==="
COMMAND cpu.stop()
COMMAND ram0.set16(4000, 000001, 000000, 000001, 000056, 000000, 000000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
