COMMAND ram0.set16(4020, 000001, 000000, 000001, 000013, 000001, 000015, 000003, 000013)
COMMAND ram0.set16(4040, 000001, 000000, 000001, 000013, 000001, 000015, 000003, 000013)
COMMAND ram0.set16(4060, 000001, 000000, 000001, 000013, 000001, 000015, 000003, 000013)
COMMAND ram0.set16(4100, 000001, 000000, 000001, 000013, 000001, 000015, 000003, 000013)
COMMAND ram0.set16(4120, 000001, 000000, 000001, 000013, 000001, 000015, 000003, 000013)
COMMAND ram0.set16(4140, 000001, 000000, 000001, 000016, 000004, 010006, 000001, 000003)
COMMAND ram0.set16(4160, 000001, 000000, 000001, 000013, 000001, 000015, 000003, 000013)
