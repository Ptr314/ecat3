COMMAND ram0.set16(10000, 047516, 042520, 052056, 052130, 000000)
COMMAND ram0.set16(10012, 035060, 027057, 027456, 000130, 000000)
COMMAND ram0.set16(10024, 035116, 054057, 042056, 045523, 000000)
