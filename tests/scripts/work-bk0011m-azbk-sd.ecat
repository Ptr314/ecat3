COMMAND ram0.set16(4240, 000000, 000000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _100
PRINT "CSR 003 0:/"
LOG ram0.value16(6004, 6005)
PRINT "корень 1: CSR 013"
LOG ram0.value16(6010, 6011)
PRINT "корень 1: размер"
LOG ram0.value16(6014, 6017)
PRINT "корень 1: атрибут и имя"
LOG ram0.value16(6024, 6041)
PRINT "корень 2: CSR 013"
LOG ram0.value16(6044, 6045)
PRINT "корень 2: размер"
LOG ram0.value16(6050, 6053)
PRINT "корень 2: атрибут и имя"
LOG ram0.value16(6060, 6075)
PRINT "корень 3: CSR 013"
LOG ram0.value16(6100, 6101)
PRINT "корень 3: размер"
LOG ram0.value16(6104, 6107)
PRINT "корень 3: атрибут и имя"
LOG ram0.value16(6114, 6131)
PRINT "корень 4: CSR 013"
LOG ram0.value16(6134, 6135)
PRINT "корень 4: размер"
LOG ram0.value16(6140, 6143)
PRINT "корень 4: атрибут и имя"
LOG ram0.value16(6150, 6165)
PRINT "корень 5: CSR 013"
LOG ram0.value16(6170, 6171)
PRINT "корень 5: размер"
LOG ram0.value16(6174, 6177)
PRINT "корень 5: атрибут и имя"
LOG ram0.value16(6204, 6221)
PRINT "CSR 003 disks"
LOG ram0.value16(6226, 6227)
PRINT "DISKS 1: CSR 013"
LOG ram0.value16(6232, 6233)
PRINT "DISKS 1: размер"
LOG ram0.value16(6236, 6241)
PRINT "DISKS 1: атрибут и имя"
LOG ram0.value16(6246, 6263)
PRINT "DISKS 2: CSR 013"
LOG ram0.value16(6266, 6267)
PRINT "DISKS 2: размер"
LOG ram0.value16(6272, 6275)
PRINT "DISKS 2: атрибут и имя"
LOG ram0.value16(6302, 6317)
PRINT "CSR 003 0:/NOPE (нет каталога)"
LOG ram0.value16(6324, 6325)
LOG cpu.registers
PRINT "=== 3. Чтение HELLO.TXT ==="
COMMAND cpu.stop()
COMMAND ram0.set16(10000, 042510, 046114, 027117, 054124, 000124, 000000)
COMMAND ram0.set16(4000, 000001, 000000, 000001, 000023, 000004, 010000, 000001, 000050)
COMMAND ram0.set16(4020, 000001, 000051, 000003, 000002, 000001, 000052, 000001, 000022)
COMMAND ram0.set16(4040, 000003, 000006, 000001, 000052, 000000, 000000)
