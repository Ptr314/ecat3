COMMAND cpu.stop()
COMMAND ram0.set16(10000, 042510, 046114, 027117, 054124, 000124, 000000)
COMMAND ram0.set16(10014, 047503, 054520, 052056, 052130, 000000)
COMMAND ram0.set16(10026, 047503, 054520, 052056, 052130, 000000)
