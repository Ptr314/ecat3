COMMAND ram0.set16(4220, 000003, 000013, 000001, 000000, 000001, 000013, 000001, 000015)
COMMAND ram0.set16(4240, 000003, 000013, 000001, 000000, 000001, 000016, 000004, 010016)
COMMAND ram0.set16(4260, 000001, 000003, 000003, 000001, 000001, 000000, 000001, 000003)
COMMAND ram0.set16(4300, 000003, 000001, 000000, 000000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _100
PRINT "CSR 003 0:/"
LOG ram0.value16(6004, 6005)
PRINT "003 0:/: слово ошибки"
LOG ram0.value16(6006, 6007)
PRINT "корень 1: CSR 013"
LOG ram0.value16(6012, 6013)
PRINT "корень 1: размер"
LOG ram0.value16(6016, 6021)
PRINT "корень 1: атрибут и имя"
LOG ram0.value16(6026, 6043)
PRINT "корень 2: CSR 013"
LOG ram0.value16(6046, 6047)
PRINT "корень 2: размер"
LOG ram0.value16(6052, 6055)
PRINT "корень 2: атрибут и имя"
LOG ram0.value16(6062, 6077)
PRINT "корень 3: CSR 013"
LOG ram0.value16(6102, 6103)
PRINT "корень 3: размер"
LOG ram0.value16(6106, 6111)
PRINT "корень 3: атрибут и имя"
LOG ram0.value16(6116, 6133)
PRINT "корень 4: CSR 013"
LOG ram0.value16(6136, 6137)
PRINT "корень 4: размер"
LOG ram0.value16(6142, 6145)
PRINT "корень 4: атрибут и имя"
LOG ram0.value16(6152, 6167)
