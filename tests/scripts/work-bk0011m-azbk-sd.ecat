LOG az-sd.protected
COMMAND az-sd.protect(0)
LOG az-sd.protected
COMMAND az-sd.protect(1)
LOG az-sd.protected
LOG az-sd.file
PRINT "=== 11. Монтирование D02 перед тем, как вынуть карту ==="
COMMAND cpu.stop()
COMMAND ram0.set16(10000, 030104, 036462, 035060, 042057, 051511, 051513, 052057, 051505)
COMMAND ram0.set16(10020, 027124, 046511, 000107, 000000)
