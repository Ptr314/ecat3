# БК0011М + AZBK: пара AY платы (MAXIOL, тема 5553, «Добавлена эмуляция
# 2xAY»). 0177172/0177173 - адрес и данные первой, 0177174/0177175 - второй,
# прямой код; выход - справа A и B обеих, слева C и B обеих. Частота -
# 1,785714 МГц, ее называет тест автора платы AZPSG17 (Б.1).
#
# Тип - разряд 3 0177212: после включения 0, YM2149 (стартовое ПЗУ пишет туда
# выбор SETUP, при пустой памяти тоже 0). У YM2149 постоянная громкость v -
# ступень 2v+1 из 32 (уровни - модель MAME), поэтому громкость 0 дает не 0, а
# 2 из 1000.
#
# Процессор пишет регистры сам: первой AY словами (адрес младшим байтом,
# данные старшим), второй - байтами. Регистр 7 = 077 выключает тон и шум, и
# канал звучит своей громкостью: у первой A = 017 (справа), у второй C = 017
# (слева). Затем B первой: и справа, и слева. Чтение слова порта - адрес и
# выбранный регистр, как у микросхемы (MAXIOL чтения не описал).
#
# Огибающая второй AY (форма 010 - пила вниз, период 1000): у YM2149 32
# ступени по 8 * 1000 тактов, за 50 мс (89286 тактов) - 11 ступеней
# (31 - 11 = 20); у AY-3-8910 (0177212 = 010) 16 ступеней по 16 * 1000
# тактов, за 50 мс - 5 (15 - 5 = 10).
#
# Смесь: источник входит в нее, только когда зазвучал (idle_share = 0); вторая
# AY звучит одним левым каналом и тоже входит. Разъем звуковой приставки БК у
# машины с AZBK пустой.
#
# Затем 0177714, который плата перехватывает при разряде 1 0177212 = 0: слово -
# выбор регистра первой AY, байт - данные, оба дополнением, как у приставок
# БК; обнуление порта словом (так делает БОС) и выбор следом остаются выбором.
# Третья и дальше запись подряд одного вида - выборки Covox платы, как запись
# в 0177206: моно (разряд 0 = 0) - байт в оба канала, стерео - младший байт
# левый, старший правый (байты в канал сдвигом на 7). Первые две записи
# потока еще у AY: третий байт после пары уходит в регистр 3. Слово потока
# звучит, когда за ним пришло еще слово; если за ним байт, оно было выбором
# регистра (0177777 - регистр 0). Байты потока в стерео идут только в левый
# канал. С разрядом 1 = 1 плата 0177714 не видит; когда его снова сбросили,
# поток считается заново: первый байт - данные AY.
# @timeout 60

MACHINE "bk/BK-0011M-azbk.ext"
LOGDEFS _16,_8
WAIT _500
LOG sound.mixed
LOG azbk-sound.control
LOG az-ay1.ym
LOG az-ay2.ym
COMMAND cpu.stop()
COMMAND ram0.set16(1000, 012737, 037407, 177172)
COMMAND ram0.set16(1006, 012737, 007410, 177172)
COMMAND ram0.set16(1014, 112737, 000007, 177174)
COMMAND ram0.set16(1022, 112737, 000077, 177175)
COMMAND ram0.set16(1030, 112737, 000012, 177174)
COMMAND ram0.set16(1036, 112737, 000017, 177175)
COMMAND ram0.set16(1044, 013700, 177172)
COMMAND ram0.set16(1050, 013701, 177174)
COMMAND ram0.set16(1054, 000777)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _10

PRINT "=== A первой, C второй (YM2149) ==="
LOG cpu.registers
LOG az-ay1.regs(7,12)
LOG az-ay1.left
LOG az-ay1.right
LOG az-ay2.regs(7,12)
LOG az-ay2.left
LOG az-ay2.right
LOG ay.level
LOG sound.mixed

PRINT "=== B первой ==="
COMMAND mapper.set16(177172, 007411)
WAIT _10
LOG az-ay1.left
LOG az-ay1.right

PRINT "=== Огибающая YM2149: 32 ступени ==="
COMMAND mapper.set16(177174, 164013)
COMMAND mapper.set16(177174, 001414)
COMMAND mapper.set16(177174, 010012)
COMMAND mapper.set16(177174, 004015)
WAIT _50
LOG az-ay2.envelope
LOG az-ay2.left

PRINT "=== AY-3-8910 (0177212 = 010): 16 ступеней ==="
COMMAND mapper.set16(177212, 10)
LOG azbk-sound.control
LOG az-ay1.ym
LOG az-ay2.ym
LOG az-ay1.left
LOG az-ay1.right
COMMAND mapper.set16(177174, 004015)
WAIT _50
LOG az-ay2.envelope
LOG az-ay2.left

PRINT "=== 0177714: приставка AY - в первую AY платы ==="
COMMAND mapper.set16(177212, 0)
COMMAND mapper.set16(177714, 0)
COMMAND mapper.set16(177714, 177775)
COMMAND mapper.set(177714, 252)
COMMAND mapper.set16(177714, 177774)
COMMAND mapper.set(177714, 375)
LOG az-ay1.regs(2,3)
LOG azbk-sound.covox
LOG azbk-sound.legacy

PRINT "=== Covox моно: байты подряд ==="
COMMAND mapper.set(177714, 100)
COMMAND mapper.set(177714, 200)
LOG az-ay1.regs(3,3)
LOG azbk-sound.covox
COMMAND mapper.set(177714, 300)
LOG azbk-sound.covox

PRINT "=== Covox стерео: слова подряд ==="
COMMAND mapper.set16(177212, 1)
COMMAND mapper.set16(177714, 100200)
COMMAND mapper.set16(177714, 110220)
COMMAND mapper.set16(177714, 060240)
LOG azbk-sound.covox
COMMAND mapper.set16(177714, 177777)
LOG azbk-sound.covox
LOG az-ay1.regs(2,3)
PRINT "=== Байт после слова потока: то слово - выбор регистра 0 ==="
COMMAND mapper.set(177714, 252)
LOG azbk-sound.covox
LOG az-ay1.regs(0,1)

PRINT "=== Стерео: байты подряд - только левый канал ==="
COMMAND mapper.set(177714, 1)
COMMAND mapper.set(177714, 2)
COMMAND mapper.set(177714, 3)
LOG azbk-sound.covox
LOG az-ay1.regs(0,1)

PRINT "=== Перехват запрещен (0177212 = 2) ==="
COMMAND mapper.set16(177212, 2)
COMMAND mapper.set16(177714, 177776)
COMMAND mapper.set(177714, 0)
COMMAND mapper.set(177714, 0)
COMMAND mapper.set(177714, 0)
LOG az-ay1.regs(1,1)
LOG azbk-sound.covox

PRINT "=== Перехват снова разрешен: поток с начала ==="
COMMAND mapper.set16(177212, 1)
COMMAND mapper.set(177714, 4)
LOG azbk-sound.covox
LOG az-ay1.regs(0,1)
WAIT _10
LOG sound.mixed
EXIT
