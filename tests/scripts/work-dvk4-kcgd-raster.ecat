# КЦГД: изображение строится по строкам вслед за лучом, палитра берётся в
# момент прохода луча. Свой обработчик кадрового прерывания КЦГД (EVNT,
# вектор 100) ставит фону (регистр палитры 0) синий, отсчитывает задержку и
# ставит жёлтый: верх экрана синий, низ жёлтый, граница стоит на одной и
# той же строке в каждом поле. Раньше весь кадр рисовался одной палитрой,
# какой она была, когда до него дошёл поток отрисовки.
# @timeout 60
MACHINE "../../tests/files/dvk4-kcgd181.ext"
WAIT _12000
COMMAND kcgd-cpu.stop
LOGDEFS _16,_8

COMMAND kcgd.set16(001000, 106427, 000340)           # MTPS #340
COMMAND kcgd.set16(001004, 012706, 001000)           # MOV #1000,SP
COMMAND kcgd.set16(001010, 012737, 001100, 000100)   # MOV #1100,@#100        ; свой обработчик кадра
COMMAND kcgd.set16(001016, 012737, 000340, 000102)   # MOV #340,@#102
COMMAND kcgd.set16(001024, 106427, 000000)           # MTPS #0
COMMAND kcgd.set16(001030, 000777)                   # BR .
COMMAND kcgd.set16(001100, 012737, 030000, 167772)   # MOV #30000,@#167772    ; палитра 0 = 060, синий
COMMAND kcgd.set16(001106, 012700, 002000)           # MOV #2000,R0
COMMAND kcgd.set16(001112, 077001)                   # SOB R0,.
COMMAND kcgd.set16(001114, 012737, 007400, 167772)   # MOV #7400,@#167772     ; палитра 0 = 017, жёлтый
COMMAND kcgd.set16(001122, 000002)                   # RTI

COMMAND kcgd-cpu.setreg(PC, 001000)
COMMAND kcgd-cpu.run
WAIT _500
LOG kcgd.palette
LOG display.frame
SCREEN "../results/work-dvk4-kcgd-raster.png"
EXIT
