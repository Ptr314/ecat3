# Арго ФВ-6511: лента ZX Spectrum
# Настоящую кассету машины этот тест использовать не может - она 215 Кбайт и
# лежит вне git, то есть ПЗУ Спектрума в наборе нет. Зато можно проверить всю
# цепочку до него: разбор .tap и .tzx, построение волны и то, что уровень
# доходит до разряда 6 порта $FE, где его и читает загрузчик ПЗУ.
#
# Волна не разворачивается заранее: в памяти лежит сам файл, а полупериоды
# выдает автомат (см. tape_zx.h). Поле pulses считает их с начала ленты, а не
# от головки, поэтому его значения не зависят от того, когда его сняли.
# @timeout 60

MACHINE "unior/Argo.cfg"
WAIT 1500
LOGDEFS 8,16

# Линия не подведена ни к чему - разряд 6 читается единицей, как и раньше
PRINT "=== без ленты ==="
LOG zx-kbd.ear

PRINT "=== заряжена .tap ==="
COMMAND tape.load("../files/zx-test.tap")
LOG tape.records
LOG tape.transport
LOG zx-kbd.ear
LOGDEFS 16,10
LOG tape.total
# Пилот-тон 2168 тактов на полупериод, синхро 667 и 735, дальше биты: 855 на
# полупериод у нуля и 1710 у единицы. Первый байт заголовка - $00
PRINT "--- начало ленты: пилот-тон ---"
LOG tape.pulses(0,5)
# Пилот у заголовка длиной 8063 импульса, и сразу за ним видно все остальное:
# синхро 667 и 735, потом биты. Первый байт заголовка $00 - восемь нулей,
# то есть шестнадцать полупериодов по 855
PRINT "--- конец пилота, синхро, первые биты ---"
LOG tape.pulses(8060,8073)
LOGDEFS 8,16

PRINT "=== пуск ==="
COMMAND tape.play()
LOG tape.transport
# Перед первым блоком секунда тишины, потом пилот-тон начинает дергать линию
WAITFOR zx-kbd.ear == 0, 2000
LOG zx-kbd.ear
WAITFOR zx-kbd.ear == 1, 2000
LOG zx-kbd.ear
WAITFOR zx-kbd.ear == 0, 2000
LOG zx-kbd.ear
WAIT 2000
LOGDEFS 16,10
LOG tape.position
LOGDEFS 8,16
COMMAND tape.stop()
LOG tape.transport

# Тот же сигнал из .tzx: блоки ID $10, текстовый $30 разбор пропускает
PRINT "=== заряжена .tzx ==="
COMMAND tape.load("../files/zx-test.tzx")
LOG tape.records
LOGDEFS 16,10
LOG tape.pulses(8060,8073)
LOGDEFS 8,16

# Блок, которого мы не умеем, должен отвергаться целиком: сыграть половину
# ленты и встать хуже, чем не загрузиться - это выглядит как отказ машины
PRINT "=== неподдерживаемый блок ==="
COMMAND tape.load("../files/zx-bad.tzx")
PRINT "--- в лентопротяжке осталась прежняя лента ---"
LOG tape.records

EXIT
