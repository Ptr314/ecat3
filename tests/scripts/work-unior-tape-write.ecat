# Юниор ФВ-6506: запись на ленту и обратное чтение
#
# Магнитофоном машина командует сама, а байты на ленту кладет передатчик
# КР580ВВ51 в синхронном режиме - по восемь битовых интервалов на байт, то есть
# в темпе самой ленты. Программа ниже пишет запись в формате МОНИТОРа через его
# же точки входа: FC43 - лентопротяжка в запись, F80C - байт на ленту (A<>0
# добавляет преамбулу AA AA 19 00 E6 00), FC37 - стоп.
#
# Запись повторяет то, что делает сам МОНИТОР (FB1F): начальный адрес, конечный,
# тело, и контрольная сумма ДВАЖДЫ - хвост записи теряется, когда лентопротяжку
# останавливают с недосланным байтом, и вторая копия суммы за это отвечает.
#
# Потом лента отматывается на эту запись, машина перезапускается и читает ее
# командой МОНИТОРа "I". Записанное - программа, которая кладет $5A по адресу
# $0300 и останавливается; МОНИТОР пускает блок с адреса "конец минус два".
# Значит, сошлось все: кадр, адреса, контрольная сумма и место на ленте.
#
# Заодно tape.sound - перепады в динамике, их около полутора на бит: ноль
# означал бы немую запись, а сотни - передатчик, отдавший все байты разом.
# @timeout 60

MACHINE "unior/Unior.cfg"
WAIT 1500

COMMAND tape.load("../files/unior-test.bt")
LOGDEFS 8,16

// Писатель: $0100, таблица записи: $0130
COMMAND ram.set($0100,$31,$88,$F7,$CD,$43,$FC,$21,$30,$01,$06,$11,$3E,$01)
COMMAND ram.set($010D,$4E,$E5,$C5,$CD,$0C,$F8,$C1,$E1,$23,$AF,$05,$C2,$0D)
COMMAND ram.set($011A,$01,$3E,$40,$D3,$ED,$CD,$37,$FC,$76)
// 0200-0208, тело (MVI A,$5A / STA $0300 / HLT / JMP $0200) и сумма дважды
COMMAND ram.set($0130,$02,$00,$02,$08,$3E,$5A,$32,$00,$03,$76,$C3,$00,$02,$02,$08,$02,$08)

PRINT "=== До записи ==="
LOG tape.records
LOG tape.writes
LOG tape.sound

COMMAND cpu.setreg(PC,$0100)
WAIT 3000

PRINT "=== После записи ==="
LOG cpu.pc
LOG tape.transport
LOG tape.records
LOG tape.writes
LOG tape.sound

// Отматываем на свою запись и читаем ее машиной с чистой памятью
// Голова стояла в начале ленты, поэтому запись легла перед прежней
COMMAND tape.seek(0)
RESET cold
WAIT 2000
COMMAND ram.set($0200,$00,$00,$00,$00,$00,$00,$00,$00,$00)
COMMAND ram.set($0300,$00)

KEYDOWN I
WAIT 100
KEYUP I
WAIT 4000

PRINT "=== Прочитано обратно и запущено ==="
LOG ram.value($0200,$0208)
LOG ram.value($0300,$0300)
LOG cpu.pc
EXIT
