# УК-НЦ: машина доходит до меню ЗАГРУЗКА.
#
# Периферийный процессор выполняет ПЗУ, чистит экран, строит таблицу строк и
# поднимает центральный, перекачав ему в ОЗУ пультовый монитор. Центральный
# стартует по вектору из 160000 - в пультовом режиме там ОЗУ, - и выходит из
# режима командой RUN. Дальше терминал гонит текст по каналу 0, а ПП рисует
# его графическим блоком.
#
# Экран синий: меню рисует ПП, и вместе с ним чистит экран цветом фона окна
# (код цвета 1 в регистрах 177020/177022). Меню машина показывает только
# когда нашла контроллер НГМД - ПЗУ щупает его командой `TST @#177132`, и от
# ответа зависит вся дальнейшая загрузка.
#
# Снимаются карты памяти обоих процессоров, состояние обмена и сам экран:
# этого хватает, чтобы заметить сломанную конфигурацию или изменившееся
# изображение.
#
# Регистры процессоров не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
# @timeout 60

MACHINE "uknc/UKNC.cfg"
// Меню рисуется небыстро: ПП чистит экран октетами, по одному на байт,
// и 21120 октетов пользовательского экрана занимают заметное время
WAIT _12000

LOGDEFS _16,_8

PRINT "=== Экран ==="
LOG display.resolution
LOG display.entries

PRINT "=== Обмен между процессорами ==="
LOG channels.channels

PRINT "=== Ни одного таймаута магистрали ==="
LOG cpu.timeouts
LOG ppu.timeouts

PRINT "=== Контроллер НГМД отвечает, без него меню не появляется ==="
LOG fdc-jumpers.value16
LOG fdd0.track

PRINT "=== Карта памяти центрального процессора ==="
LOG mapper.map

PRINT "=== Карта памяти периферийного процессора ==="
LOG ppu-mapper.map

SCREEN "../results/boot-uknc.png"
EXIT
