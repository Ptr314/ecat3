# УК-НЦ: звук регистра 177716 периферийного процессора.
#
# Разряд 7 - линия динамика, разряды 8-12 - сетка частот 60 Гц, 250 Гц,
# 500 Гц, 1 кГц и 8 кГц (техническое описание, таблица 32). Отдельного
# делителя у сетки нет: это отводы 10, 8, 7, 6 и 3 счётчика программируемого
# таймера, поэтому период счёта и уставка в 177712 двигают тон. Проверяется,
# что щелчок клавиши ПЗУ делает сама машина, что тон идёт от счётчика и
# меняется вместе с ним и что разряд 7 его глушит.
#
# Здесь же Covox: восьмиразрядный ЦАП на выходных линиях порта A параллельного
# порта (177100). Линии инвертированы, поэтому уровень - дополнение того, что
# записано в порт, и ЦАП слышит запись, не дожидаясь управляющего слова: порт
# машины разведён на вывод жёстко.
#
# И звуковой модуль во втором слоте кассет: три AY на 177360, 177362, 177364
# и ЦАП на 177372. Запись слова выбирает регистр AY, запись байта кладёт в
# него данные, инверсии нет - её снимают буферы модуля. Пока программа в
# модуль не писала, он не занимает доли в миксе и не приглушает динамик.
#
# @nomcp щелчок снимается ПЗУ по кадрам 50 Гц, а живая сессия гоняет машину
# между загрузкой и первой командой
# @timeout 60

MACHINE "uknc/UKNC.cfg"
WAIT _8000

LOGDEFS _16,_8

PRINT "=== в покое звука нет ==="
LOG sound.control
LOG sound.level

# Щелчок - это ПЗУ, а не эмулятор: п/п прерывания от клавиатуры ставит
# разряд 7 (`BIS #200,@#177716`), а через два кадра 50 Гц снимает разряды
# 7-12 (`BIC #17600`)
PRINT "=== нажатие клавиши щёлкает динамиком ==="
KEYDOWN key_a
WAIT _10
LOG sound.control
LOG sound.level
KEYUP key_a
WAIT _200
LOG sound.control

# Счётчик идёт свободно, и в какой момент придёт команда сценария, плавает
# на порцию времени хоста (около 1 мс). Поэтому ни счётчик, ни уровень в
# абсолютный момент эталоном быть не могут - тон проверяется от его же
# фронта: WAITFOR ловит подъём, дальше выборки стоят посреди полупериодов.
#
# ПЗУ оставляет таймер идущим с шагом 2 мкс на полные двенадцать разрядов, и
# отвод 10 даёт тогда полупериод 2 мс - для сценария, который умеет ждать
# только целые миллисекунды, мелковато. Ставится шаг 16 мкс (разряды 1-2
# регистра состояния), и тот же отвод растягивается до 16.4 мс.
#
# Разряды 7 и 8 регистра 177716: нижний отвод сетки. Разряды 15 и 4
# оставлены как были: это ACLO и HALT центрального процессора
PRINT "=== разряды 7 и 8: тон нижнего отвода, полупериод 16.4 мс ==="
COMMAND ppu-mapper.set(177710, 7)
LOG pp-timer.period
COMMAND pp-sys.set16(0,100620)
LOG sound.control
WAITFOR sound.level == 0, _100
WAITFOR sound.level == 1, _100
WAIT _8
LOG sound.level
WAIT _16
LOG sound.level
WAIT _16
LOG sound.level
WAIT _16
LOG sound.level

# Уставка двигает сетку вместе со счётчиком: так машина и играет мелодии -
# разряды 177716 не трогаются, нота пишется в 177712. С уставкой 777 счётчик
# выше 511 не поднимается, отвод 10 не доходит, и уровень стоит
PRINT "=== уставка двигает тон: до отвода 10 счётчик не доходит ==="
COMMAND ppu-mapper.set16(177712, 777)
WAIT _16
LOG pp-timer.reload
LOG sound.level
WAIT _16
LOG sound.level
WAIT _16
LOG sound.level

# И обратно: с полной уставкой отвод снова ходит
PRINT "=== полная уставка возвращает тон ==="
COMMAND ppu-mapper.set16(177712, 7777)
WAITFOR sound.level == 0, _100
WAITFOR sound.level == 1, _100
WAIT _8
LOG sound.level
WAIT _16
LOG sound.level
WAIT _16
LOG sound.level

# Разряд 7 снят - тишина, что бы ни стояло в сетке
PRINT "=== разряд 7 в нуле глушит сетку ==="
COMMAND pp-sys.set16(0,100420)
LOG sound.control
LOG sound.level
WAIT _8
LOG sound.level
WAIT _8
LOG sound.level

COMMAND pp-sys.set16(0,100020)

PRINT "=== Covox на порту A параллельного порта ==="
LOG lpt.device
LOG covox.plugged
COMMAND ppu-mapper.set(177100, 200)
LOG pp-printer.a
LOG covox.value
COMMAND ppu-mapper.set(177100, 377)
LOG pp-printer.a
LOG covox.value
COMMAND ppu-mapper.set(177100, 0)
LOG pp-printer.a
LOG covox.value

PRINT "=== вынутый из гнезда ЦАП молчит ==="
COMMAND lpt.plug(none)
LOG lpt.device
LOG covox.plugged
COMMAND lpt.plug(covox)

PRINT "=== звуковой модуль: пока он молчит, в миксе его нет ==="
WAIT _2
LOG sound.mixed

# Регистр 7 - смеситель: 077 отключает и тон, и шум, и канал держит свою
# громкость постоянной. Регистр 10 - громкость канала A, 17 - наибольшая
PRINT "=== AY2: слово выбирает регистр, байт пишет данные ==="
COMMAND ppu-mapper.set16(177362, 7)
COMMAND ppu-mapper.set(177362, 77)
COMMAND ppu-mapper.set16(177362, 10)
COMMAND ppu-mapper.set(177363, 17)
LOG asm-ay2.register
LOG asm-ay2.regs(7,10)
LOG asm-ay2.level
PRINT "AY2 зазвучал и занял долю, AY1 и AY3 - нет"
WAIT _2
LOG sound.mixed
PRINT "чтение регистров модуля даёт 0"
LOG ppu-mapper.value16(177362)

PRINT "=== ЦАП модуля: байт без инверсии ==="
COMMAND ppu-mapper.set(177372, 200)
LOG asm-dac.value
WAIT _2
LOG sound.mixed
PRINT "сброс возвращает модуль в молчание"
RESET cold
WAIT _10
LOG asm-ay2.regs(7,10)
LOG asm-dac.value
LOG sound.mixed
EXIT
