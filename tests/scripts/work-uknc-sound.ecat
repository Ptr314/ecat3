# УК-НЦ: звук регистра 177716 периферийного процессора.
#
# Разряд 7 - линия динамика, разряды 8-12 - сетка частот 60 Гц, 250 Гц,
# 500 Гц, 1 кГц и 8 кГц от одного делителя 128 кГц (техническое описание,
# таблица 32). Проверяется, что щелчок клавиши ПЗУ делает сама машина, что
# делитель идёт с точной частотой и что тон сетки получается нужной длины.
#
# @nomcp уровень и счётчик делителя зависят от абсолютного эмулированного
# времени, а живая сессия гоняет машину между загрузкой и первой командой
# @timeout 60

MACHINE "uknc/UKNC.cfg"
WAIT _8000

LOGDEFS _16,_8

PRINT "=== в покое звука нет ==="
LOG sound.control
LOG sound.level

# Щелчок - это ПЗУ, а не эмулятор: п/п прерывания от клавиатуры ставит
# разряд 7 (`BIS #200,@#177716`), а через два кадра 50 Гц снимает разряды
# 7-12 (`BIC #17600`)
PRINT "=== нажатие клавиши щёлкает динамиком ==="
KEYDOWN key_a
WAIT _10
LOG sound.control
LOG sound.level
KEYUP key_a
WAIT _200
LOG sound.control

# 128 кГц - за секунду делитель проходит ровно 128000 отсчётов
PRINT "=== делитель сетки: 128000 отсчётов за секунду ==="
LOGDEFS _16,_10
LOG sound.grid
WAIT _1000
LOG sound.grid
LOGDEFS _16,_8

# Разряды 7 и 8: самая низкая частота сетки, 62.5 Гц - полупериод 8 мс.
# Разряды 15 и 4 оставлены как были: это ACLO и HALT центрального процессора
# Выборка через 4 мс даёт по два одинаковых уровня подряд
PRINT "=== разряды 7 и 8: тон 62.5 Гц ==="
COMMAND pp-sys.set16(0,100620)
LOG sound.control
LOG sound.level
WAIT _4
LOG sound.level
WAIT _4
LOG sound.level
WAIT _4
LOG sound.level
WAIT _4
LOG sound.level
WAIT _4
LOG sound.level

# Разряд 7 снят - тишина, что бы ни стояло в сетке
PRINT "=== разряд 7 в нуле глушит сетку ==="
COMMAND pp-sys.set16(0,100420)
LOG sound.control
LOG sound.level
WAIT _4
LOG sound.level
WAIT _4
LOG sound.level

COMMAND pp-sys.set16(0,100020)
EXIT
