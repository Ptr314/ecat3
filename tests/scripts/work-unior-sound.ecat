# Юниор ФВ-6506: звук тактируется строчной частотой ВГ75
#
# Второй канал ВИ53 считает не такты процессора, а строчные импульсы
# контроллера экрана: 106 символьных тактов на строку растра при символьном
# клоке 7/10 от процессора дают 14675 Гц. Так это и восстановлено по играм с
# кассет: «Гномик» и родня гоняют тон делителями 6..60, а это 245 Гц ... 2.4 кГц
# только от строчной частоты - от тактов процессора вышел бы ультразвук.
#
# Программы здесь пишут в порты сами: COMMAND dev.set() кладет значение в
# регистр, не трогая шину, и ни вентиль, ни таймер так не заводятся.
# @timeout 30

MACHINE "unior/Unior.cfg"
WAIT 1500
LOGDEFS 16,10

# Поднять разряд 4 порта C (вентиль канала) и пустить канал 2 в режиме 0 с
# полным счетом: за известное время видно, сколько импульсов он насчитал
COMMAND ram.set($0100,$3E,$09,$D3,$4F,$3E,$B0,$D3,$DF,$3E,$FF,$D3,$DE,$D3,$DE,$C3,$0E,$01)
COMMAND cpu.setreg(PC,$0100)
WAIT 10
LOG timer.gates

PRINT "=== Сколько насчитал канал 2 за секунду ==="
WAIT 1000
LOG timer.counters

# Тот же канал в режиме 3 с делителем 33 - это около 445 Гц
COMMAND ram.set($0120,$3E,$B6,$D3,$DF,$3E,$21,$D3,$DE,$AF,$D3,$DE,$C3,$2B,$01)
COMMAND cpu.setreg(PC,$0120)
WAIT 10

PRINT "=== Уровень на динамике идет вверх-вниз ==="
LOGDEFS 8,16
LOG sound.enable
LOG sound.input
WAIT 1
LOG sound.input
WAIT 1
LOG sound.input
WAIT 1
LOG sound.input
EXIT
