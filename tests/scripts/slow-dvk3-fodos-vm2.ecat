# Заводские тесты ВМ2 на ДВК-3 с MY: диск тестов ФОДОС (FODOSTMO.DSK),
# монитор тестов FTMON, цепочка VM2MY.CCC: основной тест команд 791401,
# расширенная арифметика 791402, плавающая запятая 791403 (FIS выполняет
# эмулятор монитора 279 в теневом ОЗУ), прерывания 791404, тест памяти 791324.
#
# Что ими найдено и исправлено в ВМ2: пуск в пульт - по разряду 8 слова
# состояния из вектора; T, поставленный RTI, ловит сразу, а после
# команды-ловушки (IOT) ловушки трассировки нет (791404, 060); слово
# состояния - только младший байт (791403, 107: на стеке было 004012 вместо
# 012); зависание магистрали в пульте - по вектору SEL+004 без сохранения
# (791403: эмулятор FIS читает операнд по адресу без памяти).
#
# Сетевой таймер выключен тумблером пульта: FTMON переписывает область
# векторов при разрешённых прерываниях, и тик по уже затёртому вектору 100
# останавливает машину. Тест памяти идёт без конца - сценарий кончается на
# его первом проходе.
# @timeout 900
# @nomcp часы RT-11 и время прогона
MACHINE "dvk/DVK-3.cfg"
COMMAND my0.load("FODOSTMO.DSK")
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BMY"
KEY _100,_50,ret
WAIT _20000
KEY _100,_50,ret
WAIT _1000
TYPE "R FTMON"
KEY _100,_50,ret
WAIT _5000
COMMAND panel.option(1,0)
TYPE "C VM2MY"
KEY _100,_50,ret
WAIT _480000

PRINT "=== Экран ==="
LOG display.text
EXIT
