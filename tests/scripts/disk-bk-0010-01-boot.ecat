# БК0010-01 + КНГМД: загрузка ANDOS 3.1 с образа andos.img из software/bk.
# Монитор БК0010 сам дисковый загрузчик не вызывает: его запускают директивой
# S160000. ANDOS отличает БК0010 от БК0011М по таймауту при записи в 0177662,
# поэтому этот регистр в конфигурации помечен strict.
#
# Регистры процессора не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
#
# Допуск на снимки: логотип ANDOS на заставке крутится, и момент запуска
# загрузчика чуть плавает - в снимок заставки попадает разная фаза анимации.
#
# Одно нажатие в оболочке должно сдвигать выделение ровно на одну строку.
# Автоповтор ANDOS ведет по разряду 6 регистра 0177716, который читается
# отдельным регистром port-sys-rd: если он не подключен к клавиатуре, машина
# считает клавишу вечно нажатой и курсор улетает вниз с одного нажатия.
# @pixels 800
# @timeout 70

MACHINE "bk/BK-0010-01-fdd.cfg"
WAIT _3000

TYPE "S160000"
KEY _100,_100,ret
WAIT _12000

LOGDEFS _16,_8
PRINT "=== Заставка ==="
LOG fdd0.loaded
LOG fdd0.file
LOG fdc.motor
LOG fdc.track
LOG cpu.timeouts
SCREEN "../results/disk-bk-0010-01-boot-splash.png"

KEY _100,_100,space
WAIT _5000

PRINT "=== Оболочка ==="
LOG fdd0.track
LOG fdd0.side
LOG fdc.command
LOG mapper.map
SCREEN "../results/disk-bk-0010-01-boot.png"

PRINT "=== Два нажатия - две строки вниз ==="
KEY _100,_100,down
KEY _100,_100,down
WAIT _2000
SCREEN "../results/disk-bk-0010-01-boot-keys.png"

PRINT "=== Разряд 6 при нажатой и отпущенной клавише ==="
LOG port-sys-rd.value
KEYDOWN down
WAIT _100
LOG port-sys-rd.value
KEYUP down
WAIT _100
LOG port-sys-rd.value
EXIT
