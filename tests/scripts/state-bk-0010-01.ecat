# БК0010-01: сохраненное состояние поднимается и продолжает работать.
#
# ../tests/files/state-bk.ecats.zip (от deploy/) - машина с набранной в Бейсике программой,
# снятая скриптом ../files/make-state-bk.ecat. Архив несет в себе все: свою
# конфигурацию, ПЗУ, раскладку и рисунок клавиатуры, так что ничего снаружи
# не читается.
#
# Проверяется и то, что состояние восстановлено (экран сразу после загрузки
# совпадает с тем, что было в момент съемки), и то, что машина после этого
# живая: набранная программа запускается и печатает свое.
#
# Регистры процессора не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
# @timeout 40

MACHINE "../tests/files/state-bk.ecats.zip"

LOGDEFS _16,_8
PRINT "=== Экран и карта после загрузки состояния ==="
LOG display.resolution
LOG mapper.map
SCREEN "../results/state-bk-0010-01-restored.png"

PRINT "=== Программа, набранная до съемки состояния ==="
LOG ram.value(_1000,_1017)

# Машина продолжает работать: программа, которая была набрана до съемки,
# запускается и печатает
TYPE "RUN\n"
WAIT _2500
SCREEN "../results/state-bk-0010-01-continued.png"

EXIT
