# Программа БК (.bin) по имени платформы «БК0011М + AZБК». Сценарий
# bk0011m-azbk-bin.ecat: стартовое ПЗУ AZBK грузит ANDOS с AZ0, затем при
# остановленном процессоре - векторы 4 и 0100 как у БОС, раскладка страниц
# пользователя (034401), LOAD и пуск с адреса загрузки со стеком под программой
# (SP = 01000), как из ANDOS.
#
# Программа (tests/files/make-bk-platform.py) - длинная, из архива
# 123-bk-platform-long.zip: код с 02000, дополненный нулями до 050000. Она
# затирает заставку ANDOS в младших адресах, куда та направила векторы 4 и
# 0100; без их замены первое кадровое прерывание уводило процессор в нули
# программы (PC около 003632, стек через 0). Кладет в 02100 SP, с которым ее
# пустили (01000), а в 02102 слово на вершине стека, рисует полосу в 054400 - в
# окне 040000 страница 3 (страница AZ 014 в тени) - и остается на BR .
# (PC = 02026).
# @timeout 60

PLATFORM "БК0011М + AZБК", "../files/123-bk-platform-long.zip"
WAIT _500
LOGDEFS _16,_8
LOG mapper.value16(2100,2103)
LOG cpu.registers
LOG mapper.value16(100,103)
LOG ram3.value16(14400)
LOG azbk-ram.value16(0154400)
EXIT
