# Программа БК (.bin) по имени платформы «БК0011М + AZБК». Сценарий
# bk0011m-azbk-bin.ecat: стартовое ПЗУ AZBK грузит ANDOS с AZ0, пробел убирает
# заставку, и в панели ANDOS при остановленном процессоре - вектор 0100 как у
# БОС, LOAD и пуск с адреса загрузки со стеком под программой (SP = 01000), как
# из ANDOS. Раскладка страниц - та, что оставила ANDOS (016000: в окне 040000
# страница с кодом 1).
#
# Программа (tests/files/make-bk-platform.py) - длинная, из архива
# 123-bk-platform-long.zip: код с 02000, дополненный нулями до 050000. Она
# затирает младшие адреса, куда заставка ANDOS направляла вектор 0100; без
# его замены первое кадровое прерывание уводило процессор в нули программы
# (PC около 003632, стек через 0). Кладет в 02100 SP, с которым ее
# пустили (01000), а в 02102 слово на вершине стека, рисует полосу в 054400 - в
# окне 040000 страница с кодом 1 (страница AZ 004 в тени) - и остается на BR .
# (PC = 02026).
# @timeout 60

PLATFORM "БК0011М + AZБК", "../files/123-bk-platform-long.zip"
WAIT _500
LOGDEFS _16,_8
LOG mapper.value16(2100,2103)
LOG cpu.registers
LOG mapper.value16(100,103)
LOG mapper.value16(54400)
LOG azbk-ram.value16(054400)
EXIT
