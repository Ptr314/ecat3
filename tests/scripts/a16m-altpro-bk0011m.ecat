# БК0011М + А16М: тест контроллеров АльтПро v4.77F (gid, gid.pdp-11.net).
#
# Тест самостоятелен, ни ОС, ни монитор ему не нужны: грузится по 01000 и сам
# перебирает режимы платы. Его таблица ожидаемого поведения А16(М) на БК11
# (COAD16_11) - спецификация, по которой сделано устройство a16m. Что должно
# получиться:
#   - опознан «A16M», версия прошивки ПЗУ 44, ОЗУ 16 КБ;
#   - регистров винчестера и его буфера нет («Это не СМК, пропускаем тест»);
#   - разряд 2 блокирует чтение 0177130/0177132 во всех режимах;
#   - разряд 3 на БК11 не действует, RESET на режим не влияет;
#   - тест режимов - «ОК» во всех восьми режимах (код 0 - Hlt11);
#   - тест переключения страниц для А16 пропускается.
# Длинный тест памяти сценарий не ждет.
# @timeout 150

MACHINE "bk/BK-0011M-a16m.ext"
LOGDEFS _16,_8
WAIT _300

COMMAND cpu.stop()
COMMAND ram0.load("../files/altpro/ALTV477F.BIN", 774)
COMMAND cpu.setreg(SP, 1000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()

# Длительность длинного теста памяти: 0 - без него
WAIT _2000
KEY _100,_100,0
KEY _100,_100,ret
WAIT _10000
SCREEN "../results/a16m-altpro-bk0011m-1.png"
KEY _100,_100,space
WAIT _10000
SCREEN "../results/a16m-altpro-bk0011m-2.png"
KEY _100,_100,space
WAIT _40000
SCREEN "../results/a16m-altpro-bk0011m-3.png"
LOG a16m.mode
EXIT
