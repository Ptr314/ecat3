WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _5000
COMMAND fd0.load("../library/e85/eldos-emulator.dsk")
WAIT _3000
