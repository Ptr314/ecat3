# Электроника МС 0585 с МС 1702: рецепт образа pros-2.03-10m-pc.rd и виртуальный винчестер.
# На pros-2.03-10m.rd штатным установщиком ПРОС ставится «PC Эмулятор» в меню Б; образ с
# готовым эмулятором - результат этой части. Затем по OPPRIM.TXT: FDISK создаёт активный
# раздел на 20 цилиндров, перезапуск, FORMAT D:/S (диск называется D:, A:-C: - дискеты), выход
# по Ф17, новый запуск без дискеты грузит DOS с D:. Выход здесь обязателен: это первый сеанс,
# файл IBMDSK.DAT ещё не закрывался, и без выхода следующий запуск виснет в .WAIT
# @timeout 600
MACHINE "computers/e85/MS0585-1702.ext"
COMMAND knmd.load("../library/e85/pros-2.03-10m.rd")
COMMAND knmd.volatile(1)
WAIT _45000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
