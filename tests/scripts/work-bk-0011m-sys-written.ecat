# БК0011М: разряд 2 регистра 0177716 при чтении - признак записи в 0177716
# (триггер D9:A, К555ТМ2). Его ставит запись в любой из двух регистров за этим
# адресом, в том числе в регистр памяти (разряд 11 = 1), а сбрасывает конец
# чтения 0177716. БОС по нему отличает в обработчике вектора 4 пультовый вход
# от ошибки шины и, сохранив его при входе (ячейка 156), снимает свой след
# чтением, если программа его не оставляла. Подробнее - тест
# work-bk-0010-01-sys-written.
#
# Программа складывает прочитанное из 0177716 в 2000-2004: после
# TST @#177716 - 0, после записи MOV #54002,@#177716 (страницы и ПЗУ, как
# ставит БОС) - 1, следующее чтение - 0.
#
# 1000: TST @#177716; MOV @#177716,@#2000; MOV #54002,@#177716
# 1020: MOV @#177716,@#2002; MOV @#177716,@#2004; BR .
# @timeout 30

MACHINE "bk/BK-0011M.cfg"
WAIT _3000

COMMAND ram0.set16(&1000, &005737, &177716, &013737, &177716, &002000, &012737, &054002, &177716, &013737, &177716, &002002, &013737, &177716, &002004, &000777)
COMMAND ram0.set16(&2000, 0, 0, 0)
COMMAND cpu.setreg(PSW, &340)
COMMAND cpu.setreg(PC, &1000)
WAIT _20

LOGDEFS _16,_8
LOG cpu.pc
LOG ram0.value16(&2000, &2005)
LOG sys-written.value
EXIT
