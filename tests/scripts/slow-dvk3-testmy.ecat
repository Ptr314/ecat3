# ДВК-3 с MY: заводской тест контроллера TESTMY с диска тестов ФОДОС.
#
# Контроллер MY - плата КМД целиком: свой К1801ВМ1 с прошивкой 092 и
# К1801ВП1-128. Функциональный тест на пустой дискете в приводе 1 проходит
# самодиагностику прошивки, поиск дорожки, чтение заголовка, запись, чтение,
# чтение дорожки, запись и чтение с меткой «удалённые данные» (её ВП1-128
# хранит, пока образ в дисководе), прерывание и сброс по INIT машины. Ошибку
# тест печатает в строке проверки («ошибка», «нет завершения»). Пустой образ
# короче дискеты и дополняется нулями: дорожки ВП1-128 строит сама.
# @timeout 600
# @nomcp в живой сессии машина успевает поработать до первой команды, а загрузка ФОДОС зависит от времени
MACHINE "dvk/DVK-3.cfg"
COMMAND my0.load("FODOSTMO.DSK")
COMMAND my1.load("../files/my-blank.img")
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BMY"
KEY _100,_50,ret
WAIT _20000
KEY _100,_50,ret
WAIT _1000
TYPE "R TESTMY"
KEY _100,_50,ret
WAIT _5000
# Меню: «выбор устройства» - последняя строка, устройство 1
KEY _100,_50,down
WAIT _500
KEY _100,_50,down
WAIT _500
KEY _100,_50,down
WAIT _500
KEY _100,_50,down
WAIT _500
KEY _100,_50,down
WAIT _500
KEY _100,_50,ret
WAIT _2000
TYPE "1"
KEY _100,_50,ret
WAIT _2000
# Вверх на «функциональный тест», параметры по умолчанию
KEY _100,_50,up
WAIT _500
KEY _100,_50,up
WAIT _500
KEY _100,_50,up
WAIT _500
KEY _100,_50,ret
WAIT _3000
KEY _100,_50,ret
WAIT _3000
KEY _100,_50,ret
WAIT _3000
KEY _100,_50,ret
WAIT _3000
KEY _100,_50,ret
WAIT _3000
KEY _100,_50,ret
WAIT _3000
KEY _100,_50,ret
WAIT _40000

LOGDEFS _16,_8
LOG my.commands
# Сектора, которые тест записал с меткой удаления (F8). Диск в приводе -
# дорожки целиком, и .mfm хранит их без потерь: после сохранения и загрузки
# меток столько же (в плоском .dsk их не было бы вовсе)
PRINT "=== Сектора с меткой удаления ==="
LOG my1.deleted
COMMAND my1.save("../../tests/results/slow-dvk3-testmy.mfm")
COMMAND my1.eject()
COMMAND my1.load("../../tests/results/slow-dvk3-testmy.mfm")
LOG my1.deleted
PRINT "=== После .hfe: дорожки и пометки те же (checksum) ==="
LOG my1.checksum
COMMAND my1.save("../../tests/results/slow-dvk3-testmy.hfe")
COMMAND my1.eject()
COMMAND my1.load("../../tests/results/slow-dvk3-testmy.hfe")
LOG my1.checksum
LOG my1.deleted
PRINT "=== Экран ==="
LOG display.text
SCREEN "../results/slow-dvk3-testmy.png"
EXIT
