# БК0011М + СМК-512: пуск из ПЗУ платы и загрузка ANDOS с ее винчестера.
#
# При сбросе плата стоит в режиме SYS, ее ПЗУ перекрывает и страницу
# ввода-вывода, поэтому процессор стартует с 0166400 - слова ПЗУ, прочитанного
# вместо 0177716. BIOS находит на винчестере таблицу разделов и грузит ANDOS с
# него; дискета вынута, чтобы загрузка с нее не могла подменить результат.
#
# Образ ../files/bk-smk-hdd.img взят из тестов bkemu-android (test_hdd.img):
# таблица разделов АльтПро в блоке 7 (40 цилиндров, 16 головок, 63 сектора) и
# только начало диска, но системы на нем хватает для загрузки. Запись идет в
# режиме volatile - в память, а не в файл.
# @timeout 60
# @nomcp образ винчестера вставляется до того, как BIOS опросит канал, а живая сессия успевает пройти опрос раньше первой команды

MACHINE "bk/BK-0011M-smk512.ext"
LOGDEFS _16,_8

PRINT "=== Сразу после сброса: режим SYS ==="
LOG smk.mode
LOG smk.layout

COMMAND fdd0.eject()
COMMAND hdd.load("../files/bk-smk-hdd.img")
COMMAND hdd.volatile(1)
LOG hdd.geometry

WAIT _8000
PRINT "=== Система загружена с винчестера ==="
LOG smk.mode
LOG smk.layout
LOG hdd.reads
SCREEN "../results/boot-bk0011m-smk.png"
EXIT
