# Юниор ФВ-6506: магнитофон
# ОС этой машины обращается с лентой как с диском, и обмен идет байтами через
# ВВ51 в синхронном режиме: синхросимвол $E6, преамбула $AA $AA $19 $00,
# лентопротяжкой командует порт B дополнительного ВВ55.
#
# Лента сделана tests/files/make-unior-tape.py: одна запись в формате команды
# МОНИТОРа "I". Программа с нее пишет "TAPE OK" прямо в экранный буфер, так что
# проверяется вся цепочка - команда, пуск лентопротяжки, охота за
# синхросимволом, чтение блока, сверка контрольной суммы и запуск.
# @timeout 60

MACHINE "unior/Unior.cfg"
WAIT 1500

COMMAND tape.load("../files/unior-test.bt")
LOGDEFS 8,16
PRINT "=== Лента заряжена ==="
LOG tape.records
LOG tape.transport

KEYDOWN I
WAIT 50
KEYUP I
// Лента короткая: запись проходит головку меньше чем за секунду
WAIT 3000

PRINT "=== После загрузки ==="
LOG tape.transport
LOG tape.bytes
// Лента должна быть слышна, как у остальных машин: данные машине отдаются
// байтами, но в динамик уходит манчестер по половине битового интервала.
// Перепадов примерно полтора на бит - тишина здесь означает немую ленту
LOG tape.sound
LOG cpu.pc
LOG ram.value($0100,$011C)
PRINT "=== Что программа написала на экран ==="
LOG ram.value($F802,$F809)

SCREEN "../results/work-unior-tape.png"
EXIT
