# Электроника МС 0585: «Форматирование дискет v 2.0» на форматирующей прошивке Ф1. Программа ставится
# штатно, затем размечает дискету 400 КБ с проверкой: 80 дорожек Write Track и 800 секторов
# проверочной записи. На дискете было 12 меченых секторов, разметка снимает все метки. На штатной
# прошивке программа тоже сообщает об успехе, но дорожек не пишет
# @timeout 120
MACHINE "../../tests/files/e85-kochan-f1.ext"
COMMAND knmd.load("software/e85/pros-2.03-10m.rd")
COMMAND knmd.volatile(1)
LOGDEFS _16,_8
WAIT _45000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
