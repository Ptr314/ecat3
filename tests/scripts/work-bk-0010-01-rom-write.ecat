# БК0010-01: запись в ПЗУ остается без ответа, и команда кончается прерыванием
# по вектору 4. ПЗУ К1801РЕ2 (Монитор и БЕЙСИК) отвечают только на чтение. На
# этом стоит загрузчик Robocop: собрав в младших адресах загрузчик следующей
# части, его интерпретатор ставит вектор 4 на него и выходит командой
# INC @#100120 - записью в Монитор. Когда запись молча пропадала, интерпретатор
# шел дальше по данным, затирал загрузчик и падал.
#
# Обработчик вектора 4 считает прерывания в R3. INC в Монитор и в БЕЙСИК - два
# прерывания, INC в ОЗУ - ни одного, и ОЗУ меняется.
#
# 1000: MOV #1000,SP; MOV #3000,@#4; MOV #340,@#6; CLR R3
# 1022: INC @#100120; INC @#120000; INC @#1100; BR .
# 3000: INC R3; RTI
# @timeout 20

MACHINE "bk/BK-0010-01.cfg"
WAIT _1500

COMMAND ram.set16(&1000, &012706, &001000, &012737, &003000, &000004, &012737, &000340, &000006, &005003, &005237, &100120, &005237, &120000, &005237, &001100, &000777)
COMMAND ram.set16(&3000, &005203, &000002)
COMMAND ram.set16(&1100, &000007)
COMMAND cpu.setreg(PSW, &340)
COMMAND cpu.setreg(PC, &1000)
WAIT _20

LOGDEFS _16,_8
PRINT "=== программа дошла до конца, прерываний два ==="
LOG cpu.pc
LOG cpu.registers
LOG cpu.timeout_address
PRINT "=== слово в ОЗУ увеличилось ==="
LOG ram.value16(&1100, &1101)
EXIT
