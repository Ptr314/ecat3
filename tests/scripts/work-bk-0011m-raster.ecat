# БК0011М: экран рисуется по развертке, палитра берется в момент прохода луча.
# Обработчик кадрового прерывания ставит палитру 0, отсчитывает задержку и
# ставит палитру 1; экран залит цветом 1, поэтому верх кадра синий, низ желтый,
# и граница стоит на одной и той же строке. Раньше кадр рисовался одной
# палитрой, какой она была в момент перерисовки, и такой экран мигал (демо
# INSULT). Прерывание приходит с кадровым синхроимпульсом контроллера экрана,
# на 21-й служебной строке, за 43 строки до первой видимой.
# @timeout 40

MACHINE "bk/BK-0011M.cfg"
WAIT _3000
COMMAND cpu.stop
LOGDEFS _16,_8

COMMAND ram0.set16(024000, 106427, 000340)           # MTPS #340
COMMAND ram0.set16(024004, 012737, 024200, 000100)   # MOV #24200,@#100       ; свой обработчик кадра
COMMAND ram0.set16(024012, 012737, 000340, 000102)   # MOV #340,@#102
COMMAND ram0.set16(024020, 012737, 001330, 177664)   # MOV #1330,@#177664     ; без сдвига, полный экран
COMMAND ram0.set16(024026, 012737, 000000, 177662)   # MOV #0,@#177662        ; кадровое прерывание разрешено
COMMAND ram0.set16(024034, 106427, 000000)           # MTPS #0
COMMAND ram0.set16(024040, 000777)                   # BR .
COMMAND ram0.set16(024200, 012737, 000000, 177662)   # MOV #0,@#177662        ; палитра 0: цвет 1 синий
COMMAND ram0.set16(024206, 012700, 005000)           # MOV #5000,R0
COMMAND ram0.set16(024212, 077001)                   # SOB R0,.
COMMAND ram0.set16(024214, 012737, 000400, 177662)   # MOV #400,@#177662      ; палитра 1: цвет 1 желтый
COMMAND ram0.set16(024222, 000002)                   # RTI
COMMAND ram5.fill(0, 037777, 125)

COMMAND cpu.setreg(PC, 024000)
COMMAND cpu.run
WAIT _500
LOG display.standard
LOG display.lines
LOG display.scroll
LOG display.offset
SCREEN "../results/work-bk-0011m-raster.png"
EXIT
