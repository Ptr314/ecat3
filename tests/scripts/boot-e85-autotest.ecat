# Электроника МС 0585 без дискеты: автотест ПЗУ проходит ЦП, диспетчер памяти,
# ОЗУ, контроллеры прерываний, порты, таймер, FP11, НВ1 и НВ2, контроллер НГМД
# на прошивке «Кочан» и выводит «ЭЛЕКТРОНИКА» и значок дискеты с вопросом.
# Таблица конфигурации - в конце ОЗУ, все коды ошибок нулевые
# @timeout 100
MACHINE "computers/e85/MS0585.cfg"
COMMAND fd0.eject()
WAIT _25000
LOGDEFS _16,_8
PRINT "=== Таблица конфигурации ==="
LOG ram.value16(&1777554,&1777777)
LOG sys.lamps
LOG kngmd.regs_read
LOG pic1.served
SCREEN "../results/boot-e85-autotest.png"
EXIT
