# УК-НЦ: группы клавиш МС7007 (ms7007.grp, параметр groups клавиатуры).
#
# Группа - столбец матрицы. Пока на хосте держится клавиша столбца, остальные
# клавиши того же столбца кода не дают, а отпускание (код - номер столбца)
# уходит, только когда отпущены все клавиши столбца (@hold). Клавиша,
# проглоченная так, остается ненажатой до своего собственного отпускания. Касается только клавиш хоста, поэтому здесь не KEY,
# а COMMAND keyboard.host(...) - нажатие так, будто оно пришло с хоста.
#
# Й (27), Ф (47) и Я (67) - столбец 2, Ц (50) - столбец 3. keyboard.last -
# последний отданный машине код, keyboard.codes - их число.
# @timeout 60

MACHINE "uknc/UKNC.cfg"
WAIT _4000

LOGDEFS _16,_8

PRINT "=== Й держится, Ф того же столбца не уходит ==="
COMMAND keyboard.host("j",1)
WAIT _10
LOG keyboard.last
LOG keyboard.codes
COMMAND keyboard.host("f",1)
WAIT _10
LOG keyboard.last
LOG keyboard.codes
LOG keyboard.blocked

PRINT "=== Й отпущена, но Ф держит столбец: отпускания нет ==="
COMMAND keyboard.host("j",0)
WAIT _10
LOG keyboard.last
LOG keyboard.codes
COMMAND keyboard.host("q",1)
WAIT _10
COMMAND keyboard.host("q",0)
WAIT _10
LOG keyboard.last
LOG keyboard.codes
PRINT "=== Ф отпущена, столбец свободен: 207 ==="
COMMAND keyboard.host("f",0)
WAIT _10
LOG keyboard.last
LOG keyboard.codes

PRINT "=== ВВЕРХ 154, ВНИЗ 134 - один столбец: 214 только после обеих ==="
COMMAND keyboard.host("up",1)
WAIT _10
LOG keyboard.last
COMMAND keyboard.host("down",1)
WAIT _10
COMMAND keyboard.host("up",0)
WAIT _10
LOG keyboard.last
LOG keyboard.codes
COMMAND keyboard.host("down",0)
WAIT _10
LOG keyboard.last
LOG keyboard.codes

PRINT "=== Й и Ц - разные столбцы, уходят обе ==="
COMMAND keyboard.host("j",1)
WAIT _10
COMMAND keyboard.host("c",1)
WAIT _10
LOG keyboard.last
COMMAND keyboard.host("c",0)
WAIT _10
COMMAND keyboard.host("j",0)
WAIT _10
LOG keyboard.last
LOG keyboard.codes
LOG keyboard.blocked

PRINT "=== не с хоста группы не действуют ==="
KEYDOWN j
WAIT _10
KEYDOWN f
WAIT _10
LOG keyboard.last
KEYUP f
WAIT _10
KEYUP j
WAIT _10
LOG keyboard.last
LOG keyboard.codes
LOG keyboard.blocked

EXIT
