# Орион-128, Монитор-1: директива D — дамп памяти на экран.
# Проверяет клавиатуру (сканируемая матрица), монитор в ПЗУ и вывод через ВГ75.
#
# Синтаксис у Ориона не такой, как у Радио-86РК: D<адрес>[,<страница 1-3>], и
# конечного адреса нет вовсе - за раз выводится 256 байт, ВК выводит следующую
# порцию, точка прерывает. Раньше здесь стояло «D0000,001F» по образцу РК86,
# то есть запрос страницы $1F, которой не существует: дамп выходил из одних
# $FF и ничего про память не проверял.
#
# В память кладется образец, чтобы на снимке было видно, что монитор читает ее,
# а не отвечает $FF.
#
# Регистры процессора не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
# @timeout 30

MACHINE "orion-128/Orion-128-m1.cfg"
WAIT 3000

COMMAND ram0.set($0000, $11,$22,$33,$44,$55,$66,$77,$88,$99,$AA,$BB,$CC,$DD,$EE,$FF,$00)

TYPE "D0000\n"
WAIT 1500

LOGDEFS 8,16
LOG port-videomode.value
LOG port-page.value
LOG ram0.value($0000,$000F)

SCREEN "../results/work-orion-m1-monitor.png"
EXIT
