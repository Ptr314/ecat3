# БК0011М + AZBK: дисковый контроллер AZ (вики MAXIOL «API контроллеров AZ»).
#
# Программа в ОЗУ БК с 01000 при запрещенных прерываниях; ловушка через 004
# считает себя в 01600, обработчики 060, 0274 и 0174 пишут свой вектор по R4
# (с 01700), клавиатурные читают 0177662; кадровое 0100 - только RTI.
# 1. Сброс до DONE (стартовое ПЗУ могло оставить сеть включенной), прерывания
#    клавиатуры разрешены (0177660 = 0).
# 2. Выбор AZ5 - его нет: ERR (R0 = 0100200); AZ0 - готово (R2 = 0200).
# 3. Блок 0, чтение с IE (0105): пока DONE = 0, чтение 0177222 никто не
#    подтверждает - ловушка; R5 - сколько раз опрошен CSR до DONE (650 мкс
#    блока). Затем 015 и первое слово блока (R3).
# 4. Прерывание 0174 ждет (поле vector); нажатие клавиши добавляет запрос
#    клавиатуры. После MTPS #0 первой обслуживается клавиатура (на схеме
#    БК0011М ее IAKO выходит на ППР2 разъема МПИ, после нее), за ней AZ.
# @timeout 60

MACHINE "bk/BK-0011M-azbk.ext"
LOGDEFS _16,_8
WAIT _500
COMMAND cpu.stop()

COMMAND ram0.set16(4, 2000, 340)
COMMAND ram0.set16(60, 2010, 340)
COMMAND ram0.set16(100, 2060, 340)
COMMAND ram0.set16(174, 2050, 340)
COMMAND ram0.set16(274, 2030, 340)
COMMAND ram0.set16(1600, 0)
COMMAND ram0.set16(1700, 0, 0, 0, 0)
COMMAND ram0.set16(1776, 0)
COMMAND ram0.set16(2000, 005237, 001600, 000002)
COMMAND ram0.set16(2010, 012724, 000060, 005737, 177662, 000002)
COMMAND ram0.set16(2030, 012724, 000274, 005737, 177662, 000002)
COMMAND ram0.set16(2050, 012724, 000174, 000002)
COMMAND ram0.set16(2060, 000002)
COMMAND ram0.set16(1000, 012704, 001700, 012701, 177220, 005011, 105711, 100375, 005037, 177660)
COMMAND ram0.set16(1022, 012737, 000005, 177222, 012711, 000001, 011100, 005037, 177222, 012711, 000001, 011102)
COMMAND ram0.set16(1050, 005037, 177222, 012711, 000002, 012711, 000105, 013703, 177222)
COMMAND ram0.set16(1070, 005005, 005205, 105711, 100375, 012711, 000015, 013703, 177222)
COMMAND ram0.set16(1110, 005737, 001776, 001775, 106427, 000000, 000777)

COMMAND cpu.setreg(R0, 0)
COMMAND cpu.setreg(R2, 0)
COMMAND cpu.setreg(R3, 0)
COMMAND cpu.setreg(SP, 1000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()
WAIT _20

PRINT "=== 1-3. Выбор, чтение блока, ловушка ==="
LOG cpu.registers
LOG ram0.value16(1600)
LOG azbk-disk.csr
LOG azbk-disk.unit
LOG azbk-disk.block
LOG azbk-disk.refused
LOG az0.reads
PRINT "=== 4. Ждет прерывание AZ, затем клавиша ==="
LOG azbk-disk.vector
KEY _10,_50,A
COMMAND ram0.set16(1776, 1)
WAIT _20
LOG ram0.value16(1700, 1705)
LOG azbk-disk.vector
LOG cpu.registers
EXIT
