# УК-НЦ: периферийный процессор держит центральный в сбросе и отпускает его.
#
# На настоящей машине ПЗУ стоит на стороне ПП, и ЦП запускает именно он -
# разрядом 5 своего регистра 177716. Пока линия ~dclo активна (ноль), ЦП не
# выполняет ни одной команды; отпущенная, она стартует его с начального адреса.
#
# Проверяется ровно это: счётчик ЦП стоит на нуле, пока линия держит, и идёт
# после того, как её отпустили.
# @timeout 30
# @nomcp счётчик набирается с момента отпускания линии, а живая сессия MCP
# успевает покрутить машину до первой команды

MACHINE "uknc/reset-test.cfg"
LOGDEFS _16,_8

PRINT "=== при включении разряд 5 нулевой: ЦП стоит ==="
LOG pp-sys.value16(0)
WAIT _100
PRINT "прошло 100 мс эмулированного времени, счётчик обязан остаться нулевым:"
LOG ram.value16(100)
LOG cpu.pc

PRINT "=== ПП отпускает линию: пишет 40 (разряд 5) в свой регистр ==="
COMMAND pp-sys.set16(0, 40)
LOG pp-sys.value16(0)
WAIT _100
PRINT "теперь счётчик обязан идти:"
LOG ram.value16(100)

PRINT "=== линию снова прижали: счёт останавливается ==="
COMMAND pp-sys.set16(0, 0)
LOG ram.value16(100)
WAIT _100
PRINT "за следующие 100 мс значение не изменилось:"
LOG ram.value16(100)

EXIT
