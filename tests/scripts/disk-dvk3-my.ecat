# ДВК-3 с MY: загрузка RT-11 через монитор 279 и запись на дискету.
#
# Монитор 279 командой BMY даёт контроллеру команду LOAD (037 в MYCSR, номер
# привода в MYDR): сектор 1 нулевой дорожки ложится по адресу 0 прямым
# доступом, и монитор пускает его, проверив, что там NOP. Дальше драйвер
# MY.SYS читает и пишет сектора по блокам параметров. Файл копируется и
# выводится обратно.
# @timeout 150
# @nomcp в живой сессии машина успевает поработать до первой команды, а загрузка RT-11 зависит от времени
MACHINE "dvk/DVK-3-MY.ext"
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BMY"
KEY _100,_50,ret
WAIT _20000
TYPE "COPY STARTS.COM TEST.COM"
KEY _100,_50,ret
WAIT _15000
TYPE "TYPE TEST.COM"
KEY _100,_50,ret
WAIT _10000

LOGDEFS _16,_8
LOG my.dma
PRINT "=== Экран ==="
LOG display.text
SCREEN "../results/disk-dvk3-my.png"
EXIT
