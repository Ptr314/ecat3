# Правец-8А, Liberty Drive: издательская система ПАРИС (русская версия 1.0,
# 1990) с диска из комплекта контроллера. Из XONEX SHELL - /PARIS/
# PARIS.SYSTEM; заставка, дата (часов нет - ПАРИС спрашивает ее сам, так что
# платы Time RAM этой версии не нужно), меню: 1 - добавить документ, 3 -
# текстовый редактор, имя документа и текст.
# ПАРИС опознает Правец при запуске: 256 раз пишет в $C060 0 и $FF, и разряд
# 6 должен читаться инверсно записанному. Тогда он оставляет 8-битную таблицу
# (SOFTSW = 1) и берет код клавиши целиком, с KD7 из $C060, так что алфавит
# меняет C/L Lock, а CTRL+A ни на что не влияет: X и Y в конце - латиница.
# На Apple //e этот разряд плавающий, и ПАРИС переходит на свой CTRL+A.
# Разряд 7 у него - признак строчной буквы, обратный таблице Правеца: клавиша
# без Shift дает заглавную, с Shift - строчную. Поэтому TYPE "test" набирает
# имя TEST, а TYPE "Pravec" - текст pRAVEC.
# @timeout 300

MACHINE "pravetz/Pravetz-8A-full.ext"
# Без штатного диска в дисководе 140 Кб: ПЗУ не грузит с него DOS
COMMAND fdd0.eject()
WAIT 1000
KEYDOWN ctrl
KEY 50,100,f12
KEYUP ctrl
WAIT 300
TYPE "PR#5"
KEY 50,50,ret
WAIT 15000
TYPE "24-OCT-90"
KEY 50,50,ret
WAIT 2000
KEY 50,50,ret
WAIT 2000
KEY 50,50,ret
WAIT 20000
SCREEN "../results/disk-pravetz-8a-paris-title.png"
KEY 50,50,space
WAIT 5000
TYPE "24/10/90"
KEY 50,50,ret
WAIT 3000
TYPE "1"
KEY 50,50,ret
WAIT 3000
TYPE "3"
KEY 50,50,ret
WAIT 5000
KEY 50,50,ret
WAIT 1000
TYPE "test",100,150
KEY 100,150,ret
WAIT 3000
TYPE "Pravec",100,150
KEY 100,150,space
TYPE "Правец",100,150
KEY 100,150,space
KEYDOWN ctrl
KEY 100,150,a
KEYUP ctrl
TYPE "xy",100,150
KEY 100,150,space
KEY 100,150,caps
KEY 100,150,q
KEY 100,150,caps
KEY 100,150,ret
LOG iou.softsw
LOG keyboard.caps
LOG keyboard.cl
WAIT 2000
SCREEN "../results/disk-pravetz-8a-paris.png"
EXIT
