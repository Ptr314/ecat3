# ДВК-1: монитор 000 платы МС1201.01 (К1801ВМ1) и БЕЙСИК в ПЗУ пользователя.
#
# Процессор стартует с 160000 по старшему байту SEL1 (177716) и входит в
# пульт: монитор работает в пультовом режиме ВМ1, PC и слово состояния
# прерванной программы лежат в системном ОЗУ платы (177674/177676). Команда
# 140000G пускает БЕЙСИК: он переписывает себя с адреса 0 и ищет верх ОЗУ
# записью вниз от 160000 - ПЗУ на запись не отвечает, и тайм-аут по первому
# же его слову даёт границу. На вопросы о расширенных функциях - ВК.
# @timeout 90
MACHINE "dvk/DVK-1.cfg"
WAIT _2000
KEY _100,_50,ret
WAIT _500
TYPE "140000G"
WAIT _10000
KEY _100,_50,ret
WAIT _3000
KEY _100,_50,ret
WAIT _3000
TYPE "PRINT 2+2"
KEY _100,_50,ret
WAIT _2000

LOGDEFS _16,_8
LOG sel1.value
PRINT "=== Экран ==="
LOG display.text
SCREEN "../results/boot-dvk1.png"
EXIT
