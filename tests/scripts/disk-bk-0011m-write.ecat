# БК0011М + КНГМД: запись сектора через дисковый драйвер ПЗУ и чтение обратно.
#
# После загрузки ANDOS процессор останавливается, в ОЗУ кладется программа,
# которая через вход 0160004 читает блок 0, пишет блок 1500 (дорожка 75) из
# буфера с образцом, снова читает блок 0 и затем перечитывает блок 1500.
# Промежуточное чтение блока 0 уводит головку с дорожки 75, поэтому записанная
# дорожка успевает разобраться на секторы и попасть в образ дискеты, а обратное
# чтение собирает ее из образа заново - так проверяется весь путь записи.
# Образ на диске не меняется: fdd пишет только в память.
#
# Каждый вызов драйвера оставляет флаг C в ячейках 22000-22006: 0 - успех.
# Код ошибки драйвера лежит в байте 52.
# @timeout 60

MACHINE "bk/BK-0011M-fdd.cfg"
WAIT _12000
COMMAND cpu.stop

LOGDEFS _16,_8
PRINT "=== Программа по адресу 24000 ==="
COMMAND ram0.set16(024000, 106427, 000340)           # MTPS #340            ; запретить прерывания: ANDOS в памяти больше не нужна
COMMAND ram0.set16(024004, 012706, 027400)           # MOV #27400,SP
COMMAND ram0.set16(024010, 012703, 030000)           # MOV #30000,R3
COMMAND ram0.set16(024014, 004737, 160010)           # JSR PC,@#160010      ; инициализация рабочей области
COMMAND ram0.set16(024020, 012703, 030000)           # MOV #30000,R3        ; рабочая область драйвера
COMMAND ram0.set16(024024, 012700, 000000)           # MOV #0,R0            ; номер блока
COMMAND ram0.set16(024030, 012701, 000400)           # MOV #400,R1            ; число слов: >0 чтение, <0 запись
COMMAND ram0.set16(024034, 012702, 021000)           # MOV #21000,R2            ; буфер
COMMAND ram0.set16(024040, 004737, 160004)           # JSR PC,@#160004      ; чтение блока 0: заполняет размер сектора в рабочей области
COMMAND ram0.set16(024044, 005037, 022000)           # CLR @#22000
COMMAND ram0.set16(024050, 005537, 022000)           # ADC @#22000              ; сюда попадает флаг C - признак ошибки
COMMAND ram0.set16(024054, 012703, 030000)           # MOV #30000,R3        ; рабочая область драйвера
COMMAND ram0.set16(024060, 012700, 002734)           # MOV #2734,R0            ; номер блока
COMMAND ram0.set16(024064, 012701, 177400)           # MOV #177400,R1            ; число слов: >0 чтение, <0 запись
COMMAND ram0.set16(024070, 012702, 020000)           # MOV #20000,R2            ; буфер
COMMAND ram0.set16(024074, 004737, 160004)           # JSR PC,@#160004      ; запись блока 1500 (дорожка 75) образцом из 20000
COMMAND ram0.set16(024100, 005037, 022002)           # CLR @#22002
COMMAND ram0.set16(024104, 005537, 022002)           # ADC @#22002              ; сюда попадает флаг C - признак ошибки
COMMAND ram0.set16(024110, 012703, 030000)           # MOV #30000,R3        ; рабочая область драйвера
COMMAND ram0.set16(024114, 012700, 000000)           # MOV #0,R0            ; номер блока
COMMAND ram0.set16(024120, 012701, 000400)           # MOV #400,R1            ; число слов: >0 чтение, <0 запись
COMMAND ram0.set16(024124, 012702, 021000)           # MOV #21000,R2            ; буфер
COMMAND ram0.set16(024130, 004737, 160004)           # JSR PC,@#160004      ; чтение блока 0: уводит головку, записанная дорожка уходит в образ
COMMAND ram0.set16(024134, 005037, 022004)           # CLR @#22004
COMMAND ram0.set16(024140, 005537, 022004)           # ADC @#22004              ; сюда попадает флаг C - признак ошибки
COMMAND ram0.set16(024144, 012703, 030000)           # MOV #30000,R3        ; рабочая область драйвера
COMMAND ram0.set16(024150, 012700, 002734)           # MOV #2734,R0            ; номер блока
COMMAND ram0.set16(024154, 012701, 000400)           # MOV #400,R1            ; число слов: >0 чтение, <0 запись
COMMAND ram0.set16(024160, 012702, 021000)           # MOV #21000,R2            ; буфер
COMMAND ram0.set16(024164, 004737, 160004)           # JSR PC,@#160004      ; чтение блока 1500 обратно в 21000
COMMAND ram0.set16(024170, 005037, 022006)           # CLR @#22006
COMMAND ram0.set16(024174, 005537, 022006)           # ADC @#22006              ; сюда попадает флаг C - признак ошибки
COMMAND ram0.set16(024200, 000777)                   # BR .                 ; конец: сценарий ждет этот адрес

PRINT "=== Образец для записи, буфер чтения и рабочая область ==="
COMMAND ram0.fill(020000, 020777, $A5)
COMMAND ram0.set(020000, $45, $43, $41, $54, $33, $42, $4B, $21)
COMMAND ram0.set(020776, $12, $34)
COMMAND ram0.fill(021000, 022007, $00)
COMMAND ram0.fill(030000, 030101, $00)
COMMAND ram0.set(000052, $00)

COMMAND cpu.setreg(PC, 024000)
COMMAND cpu.run
WAITFOR cpu.pc == 024200, _30000

PRINT "=== Флаги C четырех вызовов, код ошибки, положение головки ==="
LOG ram0.value(022000, 022007)
LOG ram0.value(000052, 000052)
LOG fdc.track
LOG fdc.side
LOG fdd0.track

PRINT "=== Прочитанный обратно блок 1500: начало и конец ==="
LOG ram0.value(021000, 021037)
LOG ram0.value(021740, 021777)
EXIT
