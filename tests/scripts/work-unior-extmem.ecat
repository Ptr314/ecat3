# Юниор ФВ-6506: дополнительная память
# Блоки расширения процессор не видит, данные ходят только пересылками ПДП.
# Программа вызывает те же точки входа МОНИТОРа, что и штатное ПО: $F818
# кладет 256 байт из основной памяти в блок 3, $F81B забирает их обратно по
# другому адресу. Сходство считанного с записанным и есть проверка.
# @timeout 30

MACHINE "unior/Unior.cfg"
WAIT 1500

COMMAND ram.set($0100, $31, $00, $F7, $21, $00, $20, $06, $00, $7D, $EE, $A5, $77)
COMMAND ram.set($010C, $23, $04, $C2, $08, $01, $21, $28, $01, $E5, $21, $00, $20)
COMMAND ram.set($0118, $E5, $21, $FF, $20, $E5, $21, $00, $40, $E5, $21, $03, $00)
COMMAND ram.set($0124, $E5, $C3, $18, $F8, $21, $00, $20, $06, $00, $36, $00, $23)
COMMAND ram.set($0130, $04, $C2, $2D, $01, $21, $4B, $01, $E5, $21, $00, $40, $E5)
COMMAND ram.set($013C, $21, $FF, $40, $E5, $21, $00, $21, $E5, $21, $03, $00, $E5)
COMMAND ram.set($0148, $C3, $1B, $F8, $76)

COMMAND cpu.setreg(PC, $0100)
WAIT 500

LOGDEFS 8,16
PRINT "=== Пересылки ==="
LOG ext-memory.transfers
LOG ext-memory.bytes
LOG ext-memory.last
LOG ext-memory.direction
PRINT "=== Что осталось в основной памяти (затерто) ==="
LOG ram.value($2000,$200F)
PRINT "=== Что приехало обратно из блока 3 ==="
LOG ram.value($2100,$211F)
PRINT "=== Сам блок 3 ==="
LOG extram.value($24000,$2400F)
LOG cpu.pc
EXIT
