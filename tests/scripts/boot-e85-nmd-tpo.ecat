# Электроника МС 0585 с винчестером: «Проверка системного блока» из ТПО. К пяти пунктам
# без винчестера добавляется «Накопитель МД»: запись и чтение на рабочем цилиндре
# @timeout 200
MACHINE "computers/e85/MS0585-NMD.ext"
COMMAND knmd.load("software/e85/pros-2.03-10m.rd")
COMMAND knmd.volatile(1)
COMMAND fd0.load("software/e85/pros-d-1.8-system.dsk")
WAIT _60000
COMMAND fd0.eject()
WAIT _3000
COMMAND fd0.load("software/e85/tpo-1.dsk")
WAIT _3000
KEYDOWN key_f7
WAIT _100
KEYUP key_f7
WAIT _300
WAIT _30000
COMMAND fd1.load("software/e85/tpo-2.dsk")
WAIT _3000
KEYDOWN key_f7
WAIT _100
KEYUP key_f7
WAIT _300
WAIT _40000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _90000
LOGDEFS _16,_8
LOG knmd.reads
LOG knmd.writes
LOG knmd.refused
LOG knmd.err
SCREEN "../results/boot-e85-nmd-tpo.png"
EXIT
