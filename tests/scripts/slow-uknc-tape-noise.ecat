# УК-НЦ: запись на ленту, включённая задолго до SAVE.
#
# Перед записью программы по выходу на ленту прошёл чужой сигнал: заводской
# «Тест магнитофона (ЗАГЛ.)» из TEST.SAV (диск FODOS) сотни раз переключает
# разряд 1 регистра 177716. Магнитофон всё это время пишет. Декодер записи
# раньше мерил короткий полупериод по первым перепадам после включения записи
# и брал этот шум за мерку, так что программа после него не распознавалась.
# Теперь каждая запись разбирается по мерке своего пилот-тона, как это делает
# ПЗУ при чтении.
#
# Программу пишет дисковый Бейсик DBAS.SAV (диск basic.dsk) через устройство
# CAS:, и он же читает её обратно; снимок - LIST последней строки.
# @timeout 600

MACHINE "uknc/UKNC.cfg"
LOGDEFS _16,_8

WAIT _12000
KEY _100,_100,1
WAIT _200
KEY _100,_100,ret
WAIT _60000
KEY _100,_100,ret
WAIT _25000

PRINT "=== Шум на выходе при включённой записи ==="
COMMAND tape.record(1)
TYPE "RU TEST\n"
WAIT _10000
COMMAND tape-plug.set(0,1)
KEY _100,_300,down
WAIT _500
KEY _100,_300,down
WAIT _500
KEY _100,_300,down
WAIT _500
KEY _100,_300,down
WAIT _500
KEY _100,_300,down
WAIT _500
KEY _100,_100,ret
WAIT _9000
COMMAND tape-plug.set(0,0)
LOG pp-timer.events

PRINT "=== Дисковый Бейсик ==="
RESET
WAIT _12000
KEY _100,_100,1
WAIT _200
KEY _100,_100,ret
WAIT _60000
KEY _100,_100,ret
WAIT _25000
COMMAND fdd1.load("../../deploy/software/uknc/basic.dsk")
WAIT _500
TYPE "RU MZ1:DBAS\n"
WAIT _10000
TYPE "10 FOR I=1 TO 3\n"
WAIT _500
TYPE "20 PRINT I,I*I\n"
WAIT _500
TYPE "30 NEXT I\n"
WAIT _500
TYPE "40 REM ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\n"
WAIT _500
TYPE "50 REM ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\n"
WAIT _500
TYPE "60 REM ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\n"
WAIT _500
TYPE "70 REM ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\n"
WAIT _500
TYPE "SAVE \"CAS:TST\"\n"
WAIT _30000
COMMAND tape.record(0)
LOG tape.recorded
COMMAND tape.save("../results/slow-uknc-tape-noise.uknc.tap")

PRINT "=== Чтение обратно ==="
TYPE "NEW\n"
WAIT _500
COMMAND tape.load("../results/slow-uknc-tape-noise.uknc.tap")
TYPE "LOAD \"CAS:TST\"\n"
WAIT _500
COMMAND tape.play()
WAITFOR tape.mode == 0, _60000
WAIT _1000
TYPE "LIST\n"
WAIT _1500
TYPE "RUN\n"
WAIT _1500
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tape-noise.png"
EXIT
