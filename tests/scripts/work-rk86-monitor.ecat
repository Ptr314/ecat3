# Радио-86РК: директива монитора D — дамп памяти на экран.
# Проверяет клавиатуру (сканируемая матрица), монитор в ПЗУ и вывод через ВГ75.
#
# Регистры процессора не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
# @timeout 30

MACHINE "radio-86rk/Radio-86rk.cfg"
WAIT 2500

TYPE "D0000,001F\n"
WAIT 1500

LOGDEFS 8,16
LOG ram.value($76D0,$76EF)

SCREEN "../results/work-rk86-monitor.png"
EXIT
