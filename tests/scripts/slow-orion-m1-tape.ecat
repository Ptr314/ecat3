# Орион-128: чтение программы с ленты директивой I.
#
# Формат .rko отличается от .rk и .rkm: файл несет собственную преамбулу и
# собственный байт синхронизации $E6, поэтому запись в [TapeFiles] своего не
# добавляет. Пока добавляла, монитор ловил синхронизацию на чужом $E6 и читал
# следующие за ним байты как адрес загрузки - на экране оставался один «?».
#
# Лента orion-tape.rko записана самой машиной директивой O0000,03FF: килобайт
# по адресу 0, первые 32 байта - узнаваемый образец, остальное $5A.
#
# Директива I дается первой командой намеренно. После записи на ленту монитор
# печатает на «I» один «?», и это не про ленту: запись гонит через порт C целые
# байты данных, задевая разряд 3 - линию индикатора РУС/ЛАТ. scan-keyboard берет
# из нее свой регистр (~ruslat_led), поэтому после записи keyboard.rus расходится
# с состоянием самого монитора ($F3E5), и «I» приходит кодом $5B («Ш») вместо $49.
# Такой директивы монитор не знает - отсюда «?».
#
# Регистры процессора не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
# @timeout 120

MACHINE "orion-128/Orion-128-m1.cfg"
WAIT 3000

COMMAND ram0.fill($0000,$03FF,$00)
COMMAND tape.load("../files/orion-tape.rko")
LOGDEFS 8,16
LOG tape.size
LOG tape.baudrate

COMMAND tape.play
WAIT 200
TYPE "I\n"
WAITFOR tape.mode == 0, 60000
WAIT 3000

PRINT "=== Прочитанное с ленты ==="
LOG ram0.value($0000,$001F)
LOG ram0.value($03F0,$03FF)

SCREEN "../results/slow-orion-m1-tape.png"
EXIT
