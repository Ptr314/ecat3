# Арго ФВ-6511: кадровое прерывание
# Своя программа машины прерываниями не пользуется вовсе - в ПЗУ монитора нет
# ни IM, ни EI, ни RETI, - а ПЗУ Спектрума без них не читает клавиатуру: его
# KEY-SCAN вызывается обработчиком кадрового прерывания. Разрешает прерывание
# разряд 7 того же байта, которым задается карта памяти (на схеме это триггер
# К555ТМ8, куда идут разряды данных 4-7, а его Q3 через ЛА3 - на /INT).
#
# Здесь путь проверяется без ПЗУ Спектрума и без кассеты: свой обработчик по
# $0038 считает прерывания, а программа по $8000 ставит IM 1, разрешает их и
# крутится на месте. За секунду машинного времени счетчик должен вырасти ровно
# на столько, сколько кадров выдала ВГ75, - ни меньше (импульс должен пережить
# самую длинную команду Z80, иначе процессор его не заметит), ни больше (он не
# должен доживать до конца обработчика, INT у Z80 уровневый: этот обработчик
# вместе с приемом идет около 95 тактов, и с такой ширины счет удваивается).
# @timeout 40
# @nomcp регистр R и счетчик кадров ВГ75 считают от пуска машины, а живая
#       сессия MCP успевает покрутить ее до первой команды

MACHINE "unior/Argo.cfg"
WAIT 1500

LOGDEFS 8,16
PRINT "=== прерывание запрещено ==="
LOG int-frame.enabled
LOG int-frame.pulses

# Обработчик по $0038: PUSH AF / LD A,($8300) / INC A / LD ($8300),A / POP AF /
# EI / RETI
COMMAND mem.set($0038,$F5,$3A,$00,$83,$3C,$32,$00,$83,$F1,$FB,$ED,$4D)
# Программа по $8000: DI / IM 1 / XOR A / LD ($8300),A / EI / JR $
COMMAND mem.set($8000,$F3,$ED,$56,$AF,$32,$00,$83,$FB,$18,$FE)
COMMAND cpu.setreg(PC,$8000)

# Разряд 7 конфигурации памяти - он же режим ZX
COMMAND memcfg.set($00,$C1)
WAIT 200
PRINT "=== разрешено ==="
LOG int-frame.enabled
LOG cpu.registers

WAIT 1000
PRINT "=== за секунду машинного времени ==="
LOG mem.value($8300,$8300)
LOG int-frame.pulses
LOG vg75.frames

EXIT
