# БК0010-01 + А16М: пуск из ПЗУ контроллера и загрузка ANDOS с дискеты.
#
# При включении плата стоит в режиме Start, ее ПЗУ перекрывает и страницу
# ввода-вывода, поэтому процессор стартует с 0164400 - слова ПЗУ, прочитанного
# вместо 0177716. ПЗУ v2.44 показывает заставку, проверяет таймер процессора,
# ставит стандартный для БК0010 режим 060 и грузит систему с привода 0. По пробелу
# запускается оболочка ANDOS и читает каталоги панелей через драйвер ПЗУ А16М
# (ячейка 052 - код ошибки драйвера).
# @timeout 90

MACHINE "bk/BK-0010-01-a16m.ext"
LOGDEFS _16,_8

PRINT "=== Сразу после сброса: режим Start ==="
LOG a16m.mode
LOG a16m.layout
LOG cpu.pc

WAITFOR fdd0.track != 0, _30000
PRINT "=== ПЗУ перешло к дисководу ==="
LOG a16m.mode

WAIT _8000
KEY _100,_100,space
WAIT _8000
PRINT "=== Оболочка ANDOS прочитала каталог ==="
LOG mapper.value(52, 52)
LOG a16m.mode
LOG a16m.layout
SCREEN "../results/boot-bk0010-a16m.png"
EXIT
