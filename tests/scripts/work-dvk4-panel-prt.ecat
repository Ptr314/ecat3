# Пульт ДВК, тумблер «Прерывания» (линия ПРТ, 50 Гц) и пуск по АИП/АСП.
#
# У МС1201.04 сетевой таймер - сама линия ПРТ магистрали на входе EVNT
# процессора (регистра LKS на плате нет): cpu.irq2_requests считает запросы,
# дошедшие до процессора, взятые или нет (монитор стоит в пульте, где
# прерывания не берутся). Тумблер при включении выключен (с ним монитор 134
# срывает свой тест памяти); включённый - 50 запросов в секунду.
# @timeout 60
MACHINE "../../tests/files/dvk4-ksm.ext"
LOGDEFS _16,_10
WAIT _1000
PRINT "=== Первая секунда ==="
LOG panel.phase
LOG cpu.irq2_requests
WAIT _1000
PRINT "=== Тумблер выключен ==="
LOG panel.prt
LOG cpu.irq2_requests
COMMAND panel.option(1,1)
WAIT _1000
PRINT "=== Тумблер включён ==="
LOG panel.prt
LOG cpu.irq2_requests
EXIT
