# Пульт ДВК, тумблер «Прерывания» (линия ПРТ, 50 Гц) и пуск по АИП/АСП.
#
# У МС1201.04 частота сетевого таймера приходит с линии ПРТ магистрали, и
# регистр LKS (lks.ticks) считает её импульсы. Пульт включает машину через
# 0,5 с после пуска, так что за первую секунду тиков около 24; пока тумблер
# выключен - ни одного; включили - 50 за секунду.
# @timeout 60
MACHINE "../../tests/files/dvk4-ksm.ext"
LOGDEFS _16,_10
WAIT _1000
PRINT "=== Первая секунда ==="
LOG panel.phase
LOG lks.ticks
COMMAND panel.option(1,0)
WAIT _1000
PRINT "=== Тумблер выключен ==="
LOG panel.prt
LOG lks.ticks
COMMAND panel.option(1,1)
WAIT _1000
PRINT "=== Тумблер включён ==="
LOG panel.prt
LOG lks.ticks
EXIT
