# Арго ФВ-6511: режим ZX Spectrum
# Настоящий режим включает ZX.COM с кассеты, но кассеты в наборе нет и быть не
# может - она большая. Здесь то же самое делается руками, теми же значениями,
# что пишет сама программа: ВГ75 на 80 знакомест в строке, 16 строк по 16
# растровых, канал 2 ВТ57 на $4800, разряд 7 в регистре конфигурации памяти.
#
# Поток для ВГ75 выкладывается как у ZX.COM: восемь нулей, атрибут поля, 32
# пары, атрибут поля, восемь нулей. Пара - это младший и старший байты адреса
# атрибута Спектрума, и по ней же считается адрес битовой карты. Битовая карта
# и атрибуты лежат во второй банке, куда страницу 1 уводит конфигурация $8.
# @pixels 0  -- снимок сверяется точка в точку: экран этой машины почти пуст,
# и допуск по умолчанию проглатывает даже смену цвета всего текста
# @timeout 40

MACHINE "unior/Argo.cfg"
WAIT 1500

LOGDEFS 8,16
PRINT "=== обычный режим ==="
LOG display.resolution
LOG mem.pages

# Экран Спектрума во второй банке: битовая карта с $18000, атрибуты с $19800
COMMAND ram.fill($18000,$19FFF,$00)
COMMAND ram.fill($19800,$19AFF,$38)
# Строка 0 знакомест: рамка, решётка и сплошное поле в первых четырёх столбцах
COMMAND ram.set($18000,$FF,$81,$81,$FF)
COMMAND ram.set($18100,$81,$00,$00,$FF)
COMMAND ram.set($18200,$81,$AA,$55,$FF)
COMMAND ram.set($18300,$81,$55,$AA,$FF)
COMMAND ram.set($18400,$81,$AA,$55,$FF)
COMMAND ram.set($18500,$81,$55,$AA,$FF)
COMMAND ram.set($18600,$81,$00,$00,$FF)
COMMAND ram.set($18700,$FF,$81,$81,$FF)
# Цвета: чёрное на белом, белое на чёрном, яркое красное, яркое синее
COMMAND ram.set($19800,$38,$07,$4A,$51)

# Поток знакомест в первой банке. Строка без атрибутов поля занимает ровно
# 80 байт, поэтому девятая строка начинается с $4800 + 8*80 = $4A80
COMMAND ram.fill($4800,$4D1F,$00)
COMMAND ram.set($4A88,$8A)
COMMAND ram.set($4A89,$00,$58,$01,$58,$02,$58,$03,$58,$04,$58,$05,$58,$06,$58,$07,$58)
COMMAND ram.set($4A99,$08,$58,$09,$58,$0A,$58,$0B,$58,$0C,$58,$0D,$58,$0E,$58,$0F,$58)
COMMAND ram.set($4AA9,$10,$58,$11,$58,$12,$58,$13,$58,$14,$58,$15,$58,$16,$58,$17,$58)
COMMAND ram.set($4AB9,$18,$58,$19,$58,$1A,$58,$1B,$58,$1C,$58,$1D,$58,$1E,$58,$1F,$58)
COMMAND ram.set($4AC9,$80)

# ВГ75 теми же словами, что пишет ZX.COM
COMMAND vg75.set($01,$00)
COMMAND vg75.set($00,$4F)
COMMAND vg75.set($00,$8F)
COMMAND vg75.set($00,$FF)
COMMAND vg75.set($00,$1D)
COMMAND vg75.set($01,$E0)
# ВТ57: канал 2 на $4800
COMMAND dma.set($08,$80)
COMMAND dma.set($04,$00)
COMMAND dma.set($04,$48)
COMMAND dma.set($05,$C2)
COMMAND dma.set($05,$84)
COMMAND vg75.set($01,$23)
COMMAND dma.set($08,$E4)
# И сам режим: то же значение, что ZX.COM пишет в $B9 последним. Разряд 4 -
# теневая область второй банки (экран Спектрума), разряды 1-3 - конфигурация
# $8, разряд 7 - разрешение кадрового прерывания
COMMAND memcfg.set($00,$D8)

WAIT 200
PRINT "=== режим ZX ==="
LOG display.resolution
LOG vg75.geometry
LOG mem.config
LOG mem.pages

SCREEN "../results/work-argo-zx.png"

# Клавиатура Спектрума поверх клавиатуры машины: полуряды порта $FE, активный
# ноль. Раскладка из руководства к машине - сетка Спектрума наложена на
# клавиатуру Арго по месту. Q - полуряд 2 разряд 0, ENTER - полуряд 6 разряд 0.
# Три служебные клавиши стоят не там, где их ждешь: CAPS SHIFT - это ДОП
# (полуряд 0 разряд 0), SYMBOL SHIFT - клавиша Б, она же запятая (полуряд 7
# разряд 1), а пробел - клавиша Ю, она же точка (полуряд 7 разряд 0)
# Сканирование после входа в режим выключено: на живой машине клавиатуры нет,
# пока не нажмут Ф10 - автор ролика так и говорит, «включается сканирование
# клавиатуры». Разбирает Ф10 то же железо, что собирает матрицу: программой это
# быть не может, потому что управление лентой стрелками работает и в запущенной
# игре, а в образе ПЗУ Спектрума нет ни одного перехвата - проверены $0038,
# $0066, $028E, $0556, $05E7, и NMIADD пуст
PRINT "=== клавиатура ZX: пока заперта ==="
LOG zx-kbd.scan
KEYDOWN key_q
WAIT 50
LOG zx-kbd.rows
KEYUP key_q

PRINT "=== Ф10 включает сканирование ==="
KEYDOWN key_f10
WAIT 50
KEYUP key_f10
WAIT 50
LOG zx-kbd.scan

# Матрицу собирает опрос клавиш раз в миллисекунду, а не чтение порта, - так
# же, как на живой машине её собирает железо. Поэтому между нажатием и чтением
# нужна пауза: без неё видно состояние до нажатия
PRINT "=== клавиатура ZX ==="
LOG zx-kbd.rows
KEYDOWN key_q
WAIT 10
LOG zx-kbd.rows
KEYUP key_q
KEYDOWN key_enter
KEYDOWN key_dot
WAIT 10
LOG zx-kbd.rows
KEYUP key_enter
KEYUP key_dot
KEYDOWN key_dop
KEYDOWN key_comma
WAIT 10
LOG zx-kbd.rows
KEYUP key_dop
KEYUP key_comma
WAIT 10
LOG zx-kbd.rows

# Звук. Динамик у машины один, а линий к нему две: своя - разряд 4 порта $80,
# спектрумовская - разряд 4 порта $FE. Работают они порознь (монитор трогает
# только $80, ПЗУ Спектрума - только $FE) и друг другу не мешают. Живая
# проверка была на самом ПЗУ: щелчок клавиши и BEEP 1,0 из Бейсика
PRINT "=== звук ==="
LOG sound.input
COMMAND zx-port.set($00,$10)
LOG sound.input
COMMAND zx-port.set($00,$00)
LOG sound.input
COMMAND sysctl.set($00,$10)
LOG sound.input
COMMAND sysctl.set($00,$00)
LOG sound.input

# Бордюр. В режиме ZX ВГ75 развертывает 40 знакомест на 16 строк, и картинка
# Спектрума занимает из них 32 на 12: остальное - бордюр, и цвет ему дают
# разряды 0-2 порта $FE. Место под него в кадре было всегда, просто заливалось
# черным.
PRINT "=== бордюр: сплошной цвет ==="
LOG display.border
COMMAND zx-port.set($00,$02)
LOG display.border
# Кадр идет 20 мс - за 100 развертка успевает пройти его целиком
WAIT 100
SCREEN "../results/work-argo-zx-border.png"

# А теперь главное, ради чего это делается: цвет держится на КАЖДУЮ растровую
# строку, а не на кадр. Программа ниже переключает бордюр каждые ~2100 тактов,
# то есть примерно раз на восемь строк растра, и на экране должны выйти полосы.
# Сними мы цвет раз в кадр - вместо полос было бы мигание сплошной заливкой.
#
#   8000  F3        DI
#   8001  3E 02     LD A,$02        красный
#   8003  D3 FE     OUT ($FE),A
#   8005  06 A0     LD B,$A0
#   8007  10 FE     DJNZ $          160 витков по 13 тактов
#   8009  3E 05     LD A,$05        голубой
#   800B  D3 FE     OUT ($FE),A
#   800D  06 A0     LD B,$A0
#   800F  10 FE     DJNZ $
#   8011  18 EE     JR $8001
PRINT "=== бордюр: полосы ==="
COMMAND ram.set($8000,$F3,$3E,$02,$D3,$FE,$06,$A0,$10,$FE,$3E,$05,$D3,$FE,$06,$A0,$10,$FE,$18,$EE)
COMMAND cpu.setreg(PC,$8000)
WAIT 100
LOGDEFS 16,10
LOG display.border_changes
LOGDEFS 8,16
# Вот она, суть: в одном кадре должны встретиться ОБА цвета - красный (2) и
# голубой (5), то есть разряды 2 и 5 маски, $24. При защелке раз в кадр разряд
# был бы ровно один, и полос бы не было.
#
# Проверяется именно набор цветов, а не сами строки: и снимок, и построчные
# значения плавают фазой. Снимок - потому что его берут с поверхности, которую
# красит поток отрисовки по настенным часам; строки - потому что момент съема
# гуляет на доли миллисекунды, срезы тактования зависят от часов хоста. А
# набор цветов от фазы не зависит. Сами строки при надобности видны полем
# display.border_lines
PRINT "--- какие цвета встретились в кадре ---"
LOG display.border_seen

# Стрелки ведут лентопротяжку мимо процессора - оттого это и работает под
# запущенной игрой. Вверх пуск, вниз стоп, влево назад, вправо вперёд; из
# видео достоверна только «вверх», остальные разложены по смыслу
PRINT "=== стрелки ведут лентопротяжку ==="
COMMAND tape.load("../files/zx-test.tap")
LOG tape.transport
KEYDOWN key_up
WAIT 50
KEYUP key_up
WAIT 50
LOG tape.transport
KEYDOWN key_down
WAIT 50
KEYUP key_down
WAIT 50
LOG tape.transport

# SAVE: та же волна, разобранная обратно. ПЗУ Спектрума пишет на ленту
# разрядом 3 порта $FE (SA-BYTES, $04C2) теми же длительностями, какими потом
# читает, поэтому запись - это Pulser наоборот. Сам автомат проверяет
# eCat3-headless --selftest, гоняя блок через генератор и декодер; здесь
# проверяется тракт машины: порт, линия, лентопротяжка и файл.
#
# ZX.COM в наборе нет, поэтому волну выдает своя программа - ровно то, что
# делает SA-BYTES: пилот-тон, два синхроимпульса и блок старшим битом вперед.
# Длительности подобраны так, чтобы держать отношения настоящих: декодер берет
# мерку с пилот-тона, а не с абсолютных чисел, потому что пачки ПДП растягивают
# отдельные полупериоды на треть.
#
#   8000  DI : LD A,0 : LD (LEVEL),A : OUT ($FE),A
#         LD B,100 : LD DE,83 : CALL PULSE : DJNZ      пилот-тон
#         LD DE,24 : CALL PULSE  x2                    синхро
#         LD HL,DATA : LD A,7 : LD (COUNT),A
#   байт: LD A,(HL) : LD (CUR),A : LD B,8
#   бит:  LD A,(CUR) : RLCA : LD (CUR),A : AND 1       старший бит вперед
#         LD DE,31 / LD DE,65 : два раза CALL PULSE    ноль короче единицы
#         DJNZ : INC HL : счетчик байтов : JR NZ
#   8053  PULSE: DEC DE : LD A,D : OR E : JR NZ
#         LD A,(LEVEL) : XOR 8 : LD (LEVEL),A : OUT ($FE),A : RET
#   8066  DATA: FF 65 43 61 74 33 FF   флаг, "eCat3" и контрольная сумма
PRINT "=== SAVE: чистая кассета ==="
COMMAND tape.load("../files/zx-blank.tap")
LOG tape.records
COMMAND ram.set($8000,$F3,$3E,$00,$32,$63,$80,$D3,$FE,$06,$64,$11,$53,$00,$CD,$53,$80)
COMMAND ram.set($8010,$10,$F8,$11,$18,$00,$CD,$53,$80,$11,$18,$00,$CD,$53,$80,$21,$66)
COMMAND ram.set($8020,$80,$3E,$07,$32,$65,$80,$7E,$32,$64,$80,$06,$08,$3A,$64,$80,$07)
COMMAND ram.set($8030,$32,$64,$80,$E6,$01,$11,$1F,$00,$28,$03,$11,$41,$00,$D5,$CD,$53)
COMMAND ram.set($8040,$80,$D1,$CD,$53,$80,$10,$E5,$23,$3A,$65,$80,$3D,$32,$65,$80,$20)
COMMAND ram.set($8050,$D5,$18,$FE,$1B,$7A,$B3,$20,$FB,$3A,$63,$80,$EE,$08,$32,$63,$80)
COMMAND ram.set($8060,$D3,$FE,$C9,$00,$00,$00,$FF,$65,$43,$61,$74,$33,$FF)

COMMAND tape.record(1)
LOG tape.transport
COMMAND cpu.setreg(PC,$8000)
# Волна идет около 110 мс, дальше тишина закрывает блок
WAIT 300
COMMAND tape.record(0)
PRINT "=== записано ==="
LOG tape.records
LOG tape.writes
LOGDEFS 16,10
LOG tape.recorded
LOGDEFS 8,16
COMMAND tape.save("../results/work-argo-zx-save.tap")

# И то же самое обратно: то, что машина написала, должно читаться как лента
COMMAND tape.load("../results/work-argo-zx-save.tap")
PRINT "=== образ загружен обратно ==="
LOG tape.records
LOG tape.record

# Разряд 0 конфигурации - защита первых 16 Кбайт от записи, и включает ее НОЛЬ.
# Полярность видна по самим значениям: монитор и TCP/M ставят $61, а система
# обязана писать в TPA с $0100, значит единица разрешает; ZX.COM пишет $D8, и по
# $0000-$3FFF в этот момент лежит копия ПЗУ Спектрума, которой полагается быть
# ПЗУ. Без этого разряда первая же программа, записавшая что-нибудь по младшим
# адресам, убила бы образ ПЗУ вместе с собственной машиной.
PRINT "=== защита первых 16 Кбайт ==="
#   8000  LD A,$AA : LD ($0100),A : LD ($7F00),A : JR $
COMMAND ram.set($8000,$3E,$AA,$32,$00,$01,$32,$00,$7F,$18,$FE)
# Обе ячейки чистим при снятой защите, иначе первую не достать
COMMAND memcfg.set($00,$D9)
COMMAND mem.set($0100,$00)
COMMAND mem.set($7F00,$00)
COMMAND memcfg.set($00,$D8)
LOG mem.config
COMMAND cpu.setreg(PC,$8000)
WAIT 50
PRINT "--- ниже $4000 запись не прошла, выше прошла ---"
LOG mem.value($0100)
LOG mem.value($7F00)

PRINT "=== разряд 0 в единицу - защиты нет ==="
COMMAND memcfg.set($00,$D9)
COMMAND cpu.setreg(PC,$8000)
WAIT 50
LOG mem.value($0100)
COMMAND memcfg.set($00,$D8)

# Кнопка СБРОС дергает только процессор: регистр конфигурации, оба блока ПДП и
# ВГ75 теплый сброс переживают. Иначе сброс в режиме ZX гасил бы экран совсем -
# под Спектрум их настраивает ZX.COM, а после сброса процессор уходит на $0000,
# в копию ПЗУ Спектрума, которая про ВГ75 не знает. На живой машине сброс в
# игре возвращает как раз на начальный экран Спектрума
PRINT "=== теплый сброс режим не трогает ==="
RESET soft
WAIT 100
LOG display.resolution
LOG vg75.geometry
LOG mem.config

# А холодный - это включение: возвращается и зеркало ПЗУ с нуля, и монитор
PRINT "=== холодный возвращает машину в исходное ==="
RESET cold
WAIT 100
LOG display.resolution
LOG mem.config

EXIT
