# Арго ФВ-6511: магнитофон
# Формат ленты и протокол обмена те же, что у Юниора: преамбула AA AA 19 00,
# синхросимвол $E6, байты идут через ВВ51 в синхронном режиме, лентопротяжкой
# командует порт $81. Лента сделана tests/files/make-argo-tape.py: одна запись
# в формате команды МОНИТОРа "I", программа с нее пишет "LOAD OK" прямо в
# экранный буфер. Проверяется вся цепочка - команда, пуск лентопротяжки,
# охота за синхросимволом, чтение блока, сверка суммы и запуск.
# @nomcp регистр R считает такты регенерации с пуска машины, а живая сессия
# MCP успевает покрутить ее до первой команды
# @pixels 0  -- снимок сверяется точка в точку: экран этой машины почти пуст,
# и допуск по умолчанию проглатывает даже смену цвета всего текста
# @timeout 60

MACHINE "argo/Argo.cfg"
WAIT 1500

COMMAND tape.load("../files/argo-test.bt")
LOGDEFS 8,16
PRINT "=== Лента заряжена ==="
LOG tape.records
LOG tape.transport

KEY 200,100,I
WAIT 4000

PRINT "=== После загрузки ==="
LOG tape.transport
LOG cpu.registers
LOG ram.value($0100,$0105)
LOG ram.value($F8A2,$F8A9)

SCREEN "../results/work-argo-tape.png"
EXIT
