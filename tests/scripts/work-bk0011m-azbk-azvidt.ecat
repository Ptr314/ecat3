# БК0011М + AZBK: тест видеоконтроллера MAXIOL AZVIDT24 (library/bk/AZVIDT24.BIN,
# описание там же в AZVIDT24.lst; без библиотеки тест пропускается).
#
# Запуск - платформой «AZБК»: стартовое ПЗУ грузит ANDOS с AZ0, программа
# пускается с 01000 со стеком под ней. Меню и сетка режимов 15 x 4 - снимки
# (совпадают со снимками автора AZVID24_1 и AZVID24_2). Затем SELECT VIDEO
# MODE обходит сетку змейкой: на каждом из 60 однослойных режимов (1, 2, 4, 8
# бит на точку, ширина 128-1024, высота 192-768) - ВК, 3 с на отрисовку, номер
# режима (0177230) и свертка всей картины, пробел - назад в сетку. На каждом
# режиме - кольца рамки по краю и подписи; 061122 - снимок (совпадает с
# AZVID24_3 автора с точностью до перевода 5 бит цвета в 8). Моменты отсчетов
# задают клавиши, а не таймер теста, поэтому повтор через MCP сходится.
# @timeout 180

PLATFORM "AZБК", "../library/bk/AZVIDT24.BIN"
LOGDEFS _16,_8
WAIT _1500
LOG azbk-vga.mode
LOG display.crc
SCREEN "../results/work-bk0011m-azbk-azvidt-menu.png"
KEY _10,_50,down
WAIT _300
KEY _10,_50,ret
WAIT _1500
SCREEN "../results/work-bk0011m-azbk-azvidt-grid.png"
KEY _100,_50,up
KEY _100,_50,up
KEY _100,_50,left
WAIT _300
PRINT "=== 003300 ==="
KEY _10,_50,ret
WAIT _3000
LOG azbk-vga.mode
LOG display.crc
KEY _10,_50,space
WAIT _1500
KEY _100,_50,right
WAIT _300
PRINT "=== 012300 ==="
KEY _10,_50,ret
WAIT _3000
LOG azbk-vga.mode
LOG display.crc
KEY _10,_50,space
