# БК0011М + СМК-512: тест контроллеров АльтПро v4.77F (gid, gid.pdp-11.net).
#
# Тест самостоятелен, ни ОС, ни монитор ему не нужны: грузится по 01000 и сам
# перебирает режимы платы. Его таблицы ожидаемого поведения (CODSR11 для
# реплики СМК-512 на БК11) - спецификация, по которой сделано устройство
# smk512. Что должно получиться:
#   - опознан «SMK512 (ПЛИС репл.)», версия прошивки ПЗУ 205, ОЗУ 512 КБ;
#   - регистры винчестера доступны на запись и чтение, буфер ОЗУ в норме;
#   - разряд 2 блокирует чтение 0177130/0177132 во всех режимах;
#   - RESET на режим не влияет;
#   - тест режимов - «ОК» во всех восьми режимах;
#   - тест переключения страниц: ошибки только в 0100->0020 и 0000->0020, по
#     адресам 137130 и 137716. Так и должно быть у новой прошивки с
#     доработкой: запись в режиме Hlt в 0177130 и 0177716 ложится и в ОЗУ.
# Длинный тест памяти (по минуте на страницу) сценарий не ждет.
# @timeout 150

MACHINE "bk/BK-0011M-smk512.ext"
LOGDEFS _16,_8
WAIT _300

COMMAND cpu.stop()
COMMAND ram0.load("../files/altpro/ALTV477F.BIN", 774)
COMMAND cpu.setreg(SP, 1000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()

# Длительность длинного теста памяти: 0 - без него
WAIT _2000
KEY _100,_100,0
KEY _100,_100,ret
WAIT _10000
SCREEN "../results/smk-altpro-bk0011m-1.png"
KEY _100,_100,space
WAIT _10000
SCREEN "../results/smk-altpro-bk0011m-2.png"
KEY _100,_100,space
WAIT _40000
SCREEN "../results/smk-altpro-bk0011m-3.png"
LOG smk.mode
EXIT
