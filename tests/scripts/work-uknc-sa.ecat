# УК-НЦ: сетевой адаптер СА (176560-176566) - заводской тест «СА (УС или ЗАГЛ.)».
#
# СА - такой же последовательный порт, как стык С2 (устройство dl11), только
# с векторами 360/364 и номером станции в старших разрядах регистров:
# разряды номера 0-3 ложатся в 8-11, разряды 4-5 - в 13-14, мимо разряда 12
# (переполнения). Станция 21 = 025 даёт в регистрах 022400.
#
# Заводской тест с sysimage.dsk проверяет: прерывание передатчика по вектору
# 364 сразу после его разрешения; чтение XBUF (младший байт 0360); сброс
# регистров командой RESET (INIT магистрали); передачу всех байтов 0-377 через
# внутреннюю петлю (разряд 2 XCSR) и затем - через заглушку на разъёме,
# замыкающую выход на вход (COMMAND sa.plug(1)). Без заглушки тест пишет
# «ОБНАРУЖЕНЫ ОШИБКИ», с ней возвращается в меню.
# @timeout 240

MACHINE "uknc/UKNC.cfg"
LOGDEFS _16,_8

PRINT "=== номер станции в регистрах ==="
COMMAND sa.station(21)
LOG sa.station
LOG mapper.value16(176560)
LOG mapper.value16(176564)
LOG mapper.value16(176566)
COMMAND sa.station(0)
LOG mapper.value16(176566)

COMMAND sa.plug(1)
LOG sa.plug
WAIT _14000
KEY _100,_100,1
WAIT _200
KEY _100,_100,ret
WAIT _22000
# Программа DAY спрашивает дату, ВК оставляет предложенную
KEY _100,_100,ret
WAIT _25000
TYPE "RU TEST\n"
WAIT _15000

PRINT "=== «Тест СА (УС или ЗАГЛ.)» - седьмой пункт меню ==="
KEY _100,_100,down
WAIT _300
KEY _100,_100,down
WAIT _300
KEY _100,_100,down
WAIT _300
KEY _100,_100,down
WAIT _300
KEY _100,_100,down
WAIT _300
KEY _100,_100,down
WAIT _300
KEY _100,_100,ret
WAIT _45000
PRINT "байты 0-377 прошли через петлю и заглушку и вернулись"
LOG sa.sent
LOG sa.received
LOG sa.rcsr
LOG sa.xcsr
SCREEN "../results/work-uknc-sa.png"
EXIT
