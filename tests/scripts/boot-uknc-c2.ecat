# УК-НЦ: стык С2 (176570-176576) и загрузка по нему - пункт 4 меню ЗАГРУЗКА.
#
# Так УК-НЦ грузит RT-11 с сервера HX (OpenHX): ПЗУ посылает в линию @,
# сервер отвечает блоком из 512 байт, ПЗУ кладёт его в ОЗУ ЦП с адреса 0 и,
# если первое слово 000240, переходит на него. Здесь сервером работает сам
# сценарий: дождавшись @, он подаёт блок командой c2.sendfile.
#
# Блок - ../files/uknc-c2-boot.bin, его делает make_uknc_c2_boot.py. Он
# передаёт строку "C2 OK", затем проверяет петлю (разряд 2 XCSR): Z уходит в
# собственный приёмник и кладётся в 0700; затем прерывание приёмника по
# вектору 370: обработчик кладёт Q в 0704 и увеличивает счётчик 0702.
# @timeout 60

MACHINE "uknc/UKNC.cfg"
LOGDEFS _16,_8

PRINT "=== после сброса передатчик свободен, приёмник пуст ==="
LOG c2.xcsr
LOG c2.rcsr
LOG c2.connected

WAIT _12000
PRINT "=== ЗАГРУЗКА: 4 - стык С2 ==="
KEY _100,_100,4
WAIT _300
KEY _100,_100,ret
WAITFOR c2.sent == 1, _5000
PRINT "ПЗУ просит блок символом @"
LOG c2.output

COMMAND c2.sendfile("../files/uknc-c2-boot.bin")
LOG c2.queued
WAITFOR cpu-ram.value16(702) == 1, _3000
WAIT _100

PRINT "=== блок принят и работает ==="
LOG c2.received
PRINT "линия: @, строка блока, затем Z и Q через петлю"
LOG c2.output
PRINT "0700 - байт, вернувшийся по петле; 0702 - сколько раз сработало прерывание; 0704 - байт из обработчика"
LOG cpu-ram.value16(700,705)
PRINT "петля выключена, прерывание приёмника разрешено, приёмник пуст"
LOG c2.xcsr
LOG c2.rcsr
LOG c2.vector
EXIT
