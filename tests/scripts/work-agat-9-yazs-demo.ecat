# Агат-9 + ЯЗС 5/2: демонстрация Новосибирской компьютерной лаборатории с
# диска music-d. Шаги - из ее readme: ИКП -> «Ассемблер» -> РЕД -> «Выйти в
# отладчик» -> [RUN DEMO. Без эмуляции ячейки, по тому же readme, программа
# зацикливается на первой части; с ячейкой она доходит до рекламной заставки
# и играет музыку.
#
# Проверяется, что таймер ячейки дает прерывания (yazs.irqs), программа пишет
# в регистры каналов и ударных, и экран заставки.
# @pixels 800
# @timeout 90

MACHINE "agat/Agat-9-yazs.ext"
WAIT 9000

# Три пункта вверх по стопке карточек - «Ассемблер»
KEY 300,100,up,up,up
KEY 300,100,ret
WAIT 6000
# Из редактора - в меню системы, четыре пункта вниз - «Выйти в отладчик»
KEY 300,100,esc
WAIT 3000
KEY 300,100,down,down,down,down
KEY 300,100,ret
WAIT 2000
TYPE "[RUN DEMO"
KEY 300,100,ret
WAIT 30000

LOGDEFS 8,16
LOG yazs.irqs
LOG yazs.regs
LOG yazs.counters

SCREEN "../results/work-agat-9-yazs-demo.png"
EXIT
