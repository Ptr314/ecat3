# БК0011М: музыкальный сопроцессор AY-3-8910 на порту 0177714. Программа в
# кодах выбирает регистр записью слова в порт и записывает данные байтом,
# в обоих случаях с инверсией, как это делает плата. Канал A - тон с периодом
# 100, канал B - шум с огибающей (период 100, треугольник), канал C - тон с
# периодом 256 и шумом. Запись байта по адресу 0177715 до микросхемы дойти не
# должна. Уровень и огибающая снимаются дважды через отрезок эмулируемого
# времени, так что проверяются и генераторы.
# @timeout 40
# @nomcp ay.level - мгновенная фаза генераторов, зависит от абсолютного эмулируемого времени

MACHINE "bk/BK-0011M.cfg"
WAIT _3000
COMMAND cpu.stop

LOGDEFS _16,_8
COMMAND ram0.set16(024000, 106427, 000340)           # MTPS #340            ; запретить прерывания
COMMAND ram0.set16(024004, 012737, 000377, 177714)   # MOV #377,@#177714    ; выбор регистра 0
COMMAND ram0.set16(024012, 112737, 000233, 177714)   # MOVB #233,@#177714   ; регистр 0 = 144
COMMAND ram0.set16(024020, 012737, 000376, 177714)   # MOV #376,@#177714    ; выбор регистра 1
COMMAND ram0.set16(024026, 112737, 000377, 177714)   # MOVB #377,@#177714   ; регистр 1 = 0
COMMAND ram0.set16(024034, 012737, 000375, 177714)   # MOV #375,@#177714    ; выбор регистра 2
COMMAND ram0.set16(024042, 112737, 000377, 177714)   # MOVB #377,@#177714   ; регистр 2 = 0
COMMAND ram0.set16(024050, 012737, 000374, 177714)   # MOV #374,@#177714    ; выбор регистра 3
COMMAND ram0.set16(024056, 112737, 000376, 177714)   # MOVB #376,@#177714   ; регистр 3 = 1
COMMAND ram0.set16(024064, 012737, 000371, 177714)   # MOV #371,@#177714    ; выбор регистра 6
COMMAND ram0.set16(024072, 112737, 000370, 177714)   # MOVB #370,@#177714   ; регистр 6 = 7
COMMAND ram0.set16(024100, 012737, 000370, 177714)   # MOV #370,@#177714    ; выбор регистра 7
COMMAND ram0.set16(024106, 112737, 000341, 177714)   # MOVB #341,@#177714   ; регистр 7 = 36
COMMAND ram0.set16(024114, 012737, 000367, 177714)   # MOV #367,@#177714    ; выбор регистра 8
COMMAND ram0.set16(024122, 112737, 000360, 177714)   # MOVB #360,@#177714   ; регистр 8 = 17
COMMAND ram0.set16(024130, 012737, 000366, 177714)   # MOV #366,@#177714    ; выбор регистра 9
COMMAND ram0.set16(024136, 112737, 000357, 177714)   # MOVB #357,@#177714   ; регистр 9 = 20
COMMAND ram0.set16(024144, 012737, 000365, 177714)   # MOV #365,@#177714    ; выбор регистра 10
COMMAND ram0.set16(024152, 112737, 000363, 177714)   # MOVB #363,@#177714   ; регистр 10 = 14
COMMAND ram0.set16(024160, 012737, 000364, 177714)   # MOV #364,@#177714    ; выбор регистра 11
COMMAND ram0.set16(024166, 112737, 000277, 177714)   # MOVB #277,@#177714   ; регистр 11 = 100
COMMAND ram0.set16(024174, 012737, 000363, 177714)   # MOV #363,@#177714    ; выбор регистра 12
COMMAND ram0.set16(024202, 112737, 000377, 177714)   # MOVB #377,@#177714   ; регистр 12 = 0
COMMAND ram0.set16(024210, 012737, 000362, 177714)   # MOV #362,@#177714    ; выбор регистра 13
COMMAND ram0.set16(024216, 112737, 000361, 177714)   # MOVB #361,@#177714   ; регистр 13 = 16
COMMAND ram0.set16(024224, 112737, 000000, 177715)   # MOVB #0,@#177715     ; старший байт: до микросхемы не доходит
COMMAND ram0.set16(024232, 000777)                   # BR .

COMMAND cpu.setreg(PC, 024000)
COMMAND cpu.run
WAITFOR cpu.pc == 024232, _5000

LOG ay.regs
LOG ay.register
LOG ay.level
LOG ay.envelope
WAIT _10
LOG ay.level
LOG ay.envelope
WAIT _500
LOG ay.level
LOG ay.envelope
LOG port-ppi.value
EXIT
