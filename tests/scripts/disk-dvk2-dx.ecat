# ДВК-2: МС1201.01 и 8" дискеты DX (RX11): загрузка RT-11 и запись.
#
# Загрузчик DX лежит в ПЗУ 000 на 173000 и виден всегда; монитор пускает его
# командой 173000G. Это стандартный загрузчик RX11: чтение сектора 1
# дорожки 1, выдача буфера с адреса 0 и проверка, что там NOP. Готовности он
# ждёт по маске 100247, куда входят и разряды функции, - у RX11 они только
# пишутся и читаются нулями. Файл копируется и выводится обратно.
# @timeout 150
# @nomcp на экране часы RT-11, а в живой сессии машина успевает поработать до первой команды
MACHINE "dvk/DVK-2.cfg"
WAIT _2000
KEY _100,_50,ret
WAIT _500
TYPE "173000G"
WAIT _15000
KEY _100,_50,ret
WAIT _3000
TYPE "COPY SWAP.SYS TEST.SYS"
KEY _100,_50,ret
WAIT _10000
TYPE "DIR TEST.SYS"
KEY _100,_50,ret
WAIT _5000

LOGDEFS _16,_8
LOG dx.writes
LOG dx.rxes
PRINT "=== Экран ==="
LOG display.text
SCREEN "../results/disk-dvk2-dx.png"
EXIT
