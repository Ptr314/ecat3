# БК0010-01 + А16М: режим, разряды 2 и 3 и память платы переживают снимок
# состояния.
#
# ../tests/files/state-bk-a16m.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-bk-a16m.ecat в режиме 0120 (ОЗУ10) с образцами 012345,
# 023456, 034567, 045670 в начале сегментов 0-3 и с последней записью 014 в
# 0177130: регистры дисковода закрыты на чтение, подключен БЕЙСИК.
#
# Проверяется, что после загрузки в 0120000 виден БЕЙСИК, а не сегмент 2, что
# 0177130 читается из ПЗУ БЕЙСИКа, что запись 0 в 0177130 возвращает сегменты
# 2 и 3 и регистры, и что режим Start показывает сегменты 0 и 1 в 0140000.
# @timeout 40

MACHINE "../tests/files/state-bk-a16m.ecats.zip"
LOGDEFS _16,_8

PRINT "=== Режим и разряды после загрузки состояния ==="
LOG a16m.register
LOG a16m.mode
LOG a16m.read_off
LOG a16m.basic
LOG a16m.layout

PRINT "=== 0100000 и 0110000 - сегменты 0 и 1, 0120000 и 0177130 - БЕЙСИК ==="
LOG mapper.value16(100000, 100001)
LOG mapper.value16(110000, 110001)
LOG mapper.value16(120000, 120001)
LOG mapper.value16(177130, 177131)

PRINT "=== Запись 0 в 0177130: БЕЙСИК снят, сегменты 2 и 3 на месте ==="
COMMAND mapper.set16(177130, 0)
LOG a16m.basic
LOG mapper.value16(120000, 120001)
LOG mapper.value16(130000, 130001)

PRINT "=== Режим Start: ПЗУ платы в 0160000, сегменты 0 и 1 в 0140000 ==="
COMMAND mapper.set16(177130, 6)
COMMAND mapper.set16(177130, 160)
COMMAND mapper.set16(177130, 0)
LOG a16m.layout
LOG mapper.value16(140000, 140001)
LOG mapper.value16(150000, 150001)
LOG mapper.value16(167776, 167777)
EXIT
