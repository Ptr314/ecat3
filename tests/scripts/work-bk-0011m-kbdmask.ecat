# БК0011М: разряд 6 регистра 0177660 запрещает прерывание от клавиатуры.
# Программа с маской опрашивает разряд 7 сама и читает код из 0177662.
# Раньше запрос шел на процессор мимо маски: код забирал обработчик по вектору
# 060, готовность сбрасывалась, и цикл ожидания нажатия не видел (демо INSULT
# на пробеле оставалось на первом экране).
# Вторая часть: код, пришедший под маской, дает прерывание сразу после ее снятия.
# @timeout 40

MACHINE "bk/BK-0011M.cfg"
WAIT _3000
COMMAND cpu.stop
LOGDEFS _16,_8

COMMAND ram0.set16(024000, 012737, 000100, 177660)   # MOV #100,@#177660      ; маска клавиатуры
COMMAND ram0.set16(024006, 012737, 047400, 177662)   # MOV #47400,@#177662    ; без кадрового прерывания
COMMAND ram0.set16(024014, 012737, 024200, 000060)   # MOV #24200,@#60        ; свой обработчик 060
COMMAND ram0.set16(024022, 012737, 000200, 000062)   # MOV #200,@#62
COMMAND ram0.set16(024030, 106427, 000000)           # MTPS #0
COMMAND ram0.set16(024034, 105737, 177660)           # TSTB @#177660          ; ждать готовности
COMMAND ram0.set16(024040, 100375)                   # BPL 024034
COMMAND ram0.set16(024042, 013737, 177662, 024302)   # MOV @#177662,@#24302   ; код, прочитанный опросом
COMMAND ram0.set16(024050, 000777)                   # BR .
COMMAND ram0.set16(024060, 005037, 177660)           # CLR @#177660           ; снять маску
COMMAND ram0.set16(024064, 000777)                   # BR .
COMMAND ram0.set16(024200, 013737, 177662, 024304)   # MOV @#177662,@#24304   ; код, взятый прерыванием
COMMAND ram0.set16(024206, 005237, 024300)           # INC @#24300            ; число прерываний
COMMAND ram0.set16(024212, 000002)                   # RTI
COMMAND ram0.set16(024300, 0, 0, 0)

PRINT "=== Опрос под маской ==="
COMMAND cpu.setreg(PC, 024000)
COMMAND cpu.run
WAIT _100
KEY _50,_50,space
WAITFOR cpu.pc == 024050, _3000
LOG cpu.pc
LOG ram0.value16(024300, 024305)

PRINT "=== Нажатие под маской, затем снятие маски ==="
COMMAND cpu.stop
COMMAND ram0.set16(024300, 0, 0, 0)
COMMAND cpu.setreg(PC, 024050)
COMMAND cpu.run
KEY _50,_50,space
WAIT _200
LOG ram0.value16(024300, 024305)
COMMAND cpu.stop
COMMAND cpu.setreg(PC, 024060)
COMMAND cpu.run
WAIT _200
LOG ram0.value16(024300, 024305)
EXIT
