# ДВК-3: заводской тест КГД TSTKGD с диска ФОДОС, полная проверка (о):
# регистры, память бегущими 1 и 0, адресный тест - «тест ошибок не
# обнаружил».
# @timeout 400
# @nomcp в живой сессии машина успевает поработать до первой команды, а загрузка RT-11 зависит от времени
MACHINE "dvk/DVK-3-MY.ext"
COMMAND my0.load("FODOSTMO.DSK")
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BMY"
KEY _100,_50,ret
WAIT _20000
KEY _100,_50,ret
WAIT _1000
COMMAND panel.option(1,0)
TYPE "R TSTKGD"
KEY _100,_50,ret
WAIT _10000
TYPE "o"
WAIT _240000

PRINT "=== Экран ==="
LOG display.text
EXIT
