# БК0010-01 + А16М: тест контроллеров АльтПро v4.77F (gid, gid.pdp-11.net).
#
# То же, что a16m-altpro-bk0011m, по таблице COAD16 для БК10: опознан «A16M»,
# версия ПЗУ 44, 16 КБ, разряд 2 блокирует чтение 0177130/0177132, разряд 3
# подключает ПЗУ БЕЙСИКа («Норма. Подключается ПЗУ Бейсика»), RESET на режим не
# влияет, тест режимов - «ОК» во всех восьми режимах. На 3 МГц тест идет
# медленнее, чем на БК0011М.
# @timeout 180

MACHINE "bk/BK-0010-01-a16m.ext"
LOGDEFS _16,_8
WAIT _300

COMMAND cpu.stop()
COMMAND ram.load("../files/altpro/ALTV477F.BIN", 774)
COMMAND cpu.setreg(SP, 1000)
COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 1000)
COMMAND cpu.run()

# Длительность длинного теста памяти: 0 - без него
WAIT _2000
KEY _100,_100,0
KEY _100,_100,ret
WAIT _15000
SCREEN "../results/a16m-altpro-bk0010-1.png"
KEY _100,_100,space
WAIT _15000
SCREEN "../results/a16m-altpro-bk0010-2.png"
KEY _100,_100,space
WAIT _60000
SCREEN "../results/a16m-altpro-bk0010-3.png"
LOG a16m.mode
EXIT
