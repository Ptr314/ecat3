# ДВК-3: тест быстродействия SPEED под FTMON (диск ФОДОС). Тест просит
# «включите таймер» и мерит сетевым таймером, сколько тысяч команд в секунду
# делает процессор: сложение регистр-регистр, память-регистр, умножение,
# деление. Таймер включается после вопроса: FTMON затирает вектор 100, и
# тик до того останавливает машину. Числа - сторож скорости ВМ2 (около 800
# тыс. операций в секунду называют для ДВК-3).
# @timeout 300
# @nomcp в живой сессии машина успевает поработать до первой команды, а загрузка RT-11 зависит от времени
MACHINE "dvk/DVK-3-MY.ext"
COMMAND my0.load("FODOSTMO.DSK")
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BMY"
KEY _100,_50,ret
WAIT _20000
KEY _100,_50,ret
WAIT _1000
TYPE "R FTMON"
KEY _100,_50,ret
WAIT _5000
COMMAND panel.option(1,0)
TYPE "R SPEED"
KEY _100,_50,ret
WAIT _5000
COMMAND panel.option(1,1)
WAIT _60000

PRINT "=== Экран ==="
LOG display.text
EXIT
