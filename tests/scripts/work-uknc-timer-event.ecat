# УК-НЦ: внешнее событие таймера ПП (перепад на входе с ленты).
#
# По реверсу ХМ2-001 (docs-external/UKNC/BMK_texts, «таймер») событие не
# останавливает счёт: регистр текущего значения 177714 замирает на том, что
# насчитал счётчик в момент перепада, а сам счётчик на следующем шаге
# грузится из буфера и считает дальше. Чтение 177714 отдаёт замороженное
# значение и снимает готовность, после чего регистр снова идёт за счётчиком.
# Так ПЗУ мерит полупериоды ленты от перепада до перепада, а не от чтения.
#
# Перепад даёт сам ПП (запись из сценария защёлкивает порт, но на линии не
# выходит): заглушка замыкает выход на ленту (разряд 1 регистра 177716) на
# вход, программа ставит разряд 2 (разрешение события) и затем разряд 1.
#   000620  BIS #4,@#177716
#   000626  BIS #2,@#177716
#   000634  BR .
# ПП работает с приоритетом 7, прерывания таймера запрещены: регистр читает
# только сценарий. Поле counter - сам счётчик, value16(4) - регистр, как его
# читает процессор (со снятием готовности).
# @timeout 60

MACHINE "uknc/UKNC.cfg"
WAIT _4000

LOGDEFS _16,_8
COMMAND ppu.setreg(PSW, 340)
COMMAND plane0.set16(620, 52737, 4, 177716, 52737, 2, 177716, 777)
COMMAND tape-plug.set(0, 1)

PRINT "=== таймер: уставка 1000, период 16 мкс, пуск, прерывания запрещены ==="
# ПЗУ могло оставить готовности и переполнение: их снимает чтение 177714 и 177710
COMMAND pp-timer.set16(0, 0)
LOG pp-timer.value16(4)
LOG pp-timer.value16(0)
COMMAND pp-timer.set16(2, 1000)
COMMAND pp-timer.set16(0, 7)
# До перепада 2 мс, после - 1 мс: значение на перепаде и то, что счётчик
# насчитал после перезагрузки, различаются
WAIT _2
LOG pp-timer.counter

PRINT "=== перепад: готовность события (разряд 5) ==="
COMMAND ppu.setreg(PC, 620)
WAIT _1
LOG pp-timer.state
LOG pp-timer.events

PRINT "=== счётчик перезагрузился и считает дальше ==="
LOG pp-timer.counter
WAIT _1
LOG pp-timer.counter

PRINT "=== регистр держит значение на перепаде, чтение снимает готовность ==="
LOG pp-timer.value16(4)
LOG pp-timer.state

PRINT "=== дальше регистр идёт за счётчиком ==="
WAIT _1
LOG pp-timer.counter
LOG pp-timer.value16(4)

EXIT
