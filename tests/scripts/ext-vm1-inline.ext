// Расширение конфигурации со встроенными данными и сценарием
// Вариант отладочной bk/1801vm1-test.cfg: программа в ПЗУ заменена другой,
// записанной прямо здесь в base64, и запускается сценарием из секции @script.
// Тест запускается как сам файл .ext, без .ecat: сценарий берется из него.
// Программа заливает видеопамять словом 052525 вместо убывающего счетчика:
//   0100000: 0100004 0000340    начальные PC и PSW
//   0100004: MOV #040000,R0
//   0100010: MOV #020000,R1
//   0100014: MOV #052525,R2
//   0100020: MOV R2,(R0)+
//   0100022: SOB R1,0100020
//   0100024: BR .
// @timeout 29
@extends bk/1801vm1-test.cfg
@version Тест К1801ВМ1 (.ext)

// Образ задан данными, а не файлом: имя сохраняется, по нему видно расширение
-bios:data
bios:size = _22
bios:image = fill.rom {base64:
    BIDgAMAVAEDBFQAg
    whVVVZAQQn7/AQ==
}

// Программа стала длиннее, диапазон ПЗУ - тоже
-mapper:@memory[100000-100021]
mapper:@memory[100000-100025] = bios {mode = r}

@script
# Сценарий расширения: строки после @script, синтаксис .ecat
WAIT _500
LOGDEFS _16,_8
PRINT "=== ПЗУ и начало видеопамяти ==="
LOG bios.value(0,25)
LOG vram.value(0,17)
SCREEN "../results/ext-vm1-inline.png"
EXIT
