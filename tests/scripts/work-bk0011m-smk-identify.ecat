# БК0011М + СМК-512: паспорт накопителя (IDENTIFY) в обратном коде.
#
# Магистраль БК несет данные в обратном коде, а плата их не переворачивает:
# сектор процессор получает инвертированным, и так же должен получать ответ на
# IDENTIFY - его отдает тот же накопитель через ту же магистраль. Загрузчик
# MKDOS 3.18 читает паспорт словами из 0177756, делает SWAB и COM и печатает
# модель после «HDD:»; паспорт прямым кодом давал там мусор, и байт 0214
# («s», инвертированная) переключал монитор БК0010 в режим расширенной памяти.
#
# После загрузки ANDOS с винчестера процессор останавливается, и программа в
# ОЗУ подает команду 0354 (в обратном коде 0177423), ждет разряда 3 состояния
# (готовность буфера, в обратном коде - ноль) и читает 256 слов: после COM - в
# 021000 (паспорт как его отдал накопитель, числа читаются прямо), после SWAB
# еще и в 020000 (то, что видит MKDOS, строки читаются по порядку). После
# паспорта буфер больше не готов, и накопитель не читает следом сектор:
# состояние 0120 (готов, поиск завершен), счетчик прочитанных секторов прежний.
#
# 1. Образ без заголовка: паспорт собирает эмулятор - модель «eCat3 Hard Disk»,
#    геометрия 40/16/63 из таблицы разделов (слова 1, 3, 6; 54-56; 57-58 и
#    60-61 - произведение и всего секторов).
# 2. Тот же диск в *.hdi: на IDENTIFY приходит паспорт из заголовка - модель
#    «HDI PASSPORT TEST DRIVE», номер HDI-0001, версия 2.0. Геометрия в
#    заголовке нарочно неверная (99/2/17, 3366 секторов), а сектора адресуются
#    по таблице, поэтому паспорт называет 40/16/63 и 40320 секторов, и
#    контрольная сумма в слове 255 пересчитана: байты паспорта в сумме дают 0.
# @timeout 60

MACHINE "bk/BK-0011M-smk512.ext"
LOGDEFS _16,_8

COMMAND fdd0.eject()
COMMAND hdd.load("../files/bk-smk-hdd.img")
COMMAND hdd.volatile(1)

WAIT _8000
COMMAND cpu.stop

COMMAND ram0.set16(024000, 106427, 000340)           # MTPS #340
COMMAND ram0.set16(024004, 012706, 027400)           # MOV #27400,SP
COMMAND ram0.set16(024010, 012737, 177423, 177740)   # MOV #177423,@#177740  ; IDENTIFY
COMMAND ram0.set16(024016, 032737, 000010, 177740)   # BIT #10,@#177740      ; буфер готов - ноль
COMMAND ram0.set16(024024, 001374)                   # BNE 024016
COMMAND ram0.set16(024026, 012701, 020000)           # MOV #20000,R1
COMMAND ram0.set16(024032, 012703, 021000)           # MOV #21000,R3
COMMAND ram0.set16(024036, 012702, 000400)           # MOV #400,R2
COMMAND ram0.set16(024042, 013700, 177756)           # MOV @#177756,R0
COMMAND ram0.set16(024046, 005100)                   # COM R0
COMMAND ram0.set16(024050, 010023)                   # MOV R0,(R3)+
COMMAND ram0.set16(024052, 000300)                   # SWAB R0
COMMAND ram0.set16(024054, 010021)                   # MOV R0,(R1)+
COMMAND ram0.set16(024056, 077207)                   # SOB R2,024042
COMMAND ram0.set16(024060, 000777)                   # BR .
COMMAND ram0.fill(020000, 021777, 0)

PRINT "=== 1. Образ без заголовка: секторов прочитано до паспорта ==="
LOG hdd.reads

COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 024000)
COMMAND cpu.run()
WAITFOR cpu.pc == 024060, 1000
WAIT _10

PRINT "=== Слова 0-7 ==="
LOG ram0.value16(021000, 021017)
PRINT "=== Слова 53-61 ==="
LOG ram0.value16(021152, 021173)
PRINT "=== Модель, слова 27-46: eCat3 Hard Disk ==="
LOG ram0.value(020066, 020135)
PRINT "=== Состояние после паспорта ==="
LOG hdd.status
LOG hdd.reads

COMMAND cpu.stop
COMMAND hdd.load("../files/bk-smk-hdd.hdi")
COMMAND hdd.volatile(1)
LOG hdd.geometry
# Вставленный образ сбрасывает накопитель: процессор ждет на BR ., пока
# сброс не кончится
COMMAND cpu.setreg(PC, 024060)
COMMAND cpu.run()
WAIT _10
COMMAND cpu.stop
COMMAND ram0.fill(020000, 021777, 0)

PRINT "=== 2. Образ *.hdi: секторов прочитано до паспорта ==="
LOG hdd.reads

COMMAND cpu.setreg(PSW, 340)
COMMAND cpu.setreg(PC, 024000)
COMMAND cpu.run()
WAITFOR cpu.pc == 024060, 1000
WAIT _10

PRINT "=== Слова 0-7 ==="
LOG ram0.value16(021000, 021017)
PRINT "=== Слова 53-61 ==="
LOG ram0.value16(021152, 021173)
PRINT "=== Слово 255 ==="
LOG ram0.value16(021776, 021777)
PRINT "=== Номер, слова 10-19: HDI-0001 ==="
LOG ram0.value(020024, 020047)
PRINT "=== Версия, слова 23-26: 2.0 ==="
LOG ram0.value(020056, 020065)
PRINT "=== Модель, слова 27-46: HDI PASSPORT TEST DRIVE ==="
LOG ram0.value(020066, 020135)
PRINT "=== Состояние после паспорта ==="
LOG hdd.status
LOG hdd.reads
EXIT
