# Электроника МС 0585 с контроллером НМД без образа. Прошивка контроллера без накопителя
# не выходит из начальной установки («Занят»), а пока она занята, отвечает только РСНУ
# (Alex_K). Опрос позиций автотеста ПЗУ получает на регистрах позиции 1 тайм-аут шины,
# повторяет обращение 5 * 65536 раз (около 22 с, экран чёрный), пишет в таблицу
# конфигурации 177776 («позиция занята, регистры не отвечают») и проверку НМД
# пропускает. Рисунок системного блока - с этим кодом
# @timeout 120
MACHINE "computers/e85/MS0585-NMD.ext"
WAIT _40000
LOGDEFS _16,_8
PRINT "=== Таблица конфигурации ==="
LOG ram.value16(&1777554,&1777777)
PRINT "=== КНМД: обращений без ответа, РСНУ ==="
LOG knmd.refused
LOG knmd.status
SCREEN "../results/boot-e85-nmd-empty.png"
EXIT
