# Поиск-1 без BIOS: видео 320x200 и такты ожидания ОЗУ платы
# Вместо ПЗУ BIOS (его в репозитории нет) стоит маленькая программа по FFF00.
# Она программирует второй ВВ55, ставит режим 320x200 (палитра 1, фон
# синий, ловушка выключена), заливает видеопамять через окно B8000 полосами
# (четные строки - 1Bh, точки 0-1-2-3; нечетные - E4h, точки 3-2-1-0),
# копирует цикл INC [100h] / JMP в ОЗУ платы (0050:0000) и в ОЗУ картриджа
# (2000:0000) и ждет в ячейке 0000:0400 номер варианта.
# Цикл в ОЗУ платы ждет слотов видео, в картридже - нет: за одно и то же
# время его счетчик уходит дальше
# @timeout 30
# @nomcp счетчики цикла и тактов ожидания зависят от фазы кадра в момент записи в ячейку 0400, а живая сессия MCP запускает машину раньше первой команды
MACHINE "../../tests/files/poisk-video.ext"
LOGDEFS 16,16
WAIT 50
PRINT "=== 320x200, полосы ==="
LOG display.mode
LOG cpu.registers
PRINT "=== цикл в ОЗУ платы ==="
COMMAND ram0.set($400, 1)
WAIT 100
LOG ram0.value16($600)
LOG display.waits
PRINT "=== тот же цикл в ОЗУ картриджа ==="
COMMAND cpu.setreg(CS, $2000)
COMMAND cpu.setreg(IP, 0)
WAIT 100
LOG cart.value16($100)
LOG display.waits
# SCREEN ждет кадра от потока отрисовки: команды после него выполнялись бы
# в момент, который зависит от хоста, поэтому снимок в самом конце
SCREEN "../results/work-poisk-video.png"
EXIT
