# УК-НЦ: порядок векторных прерываний периферийного процессора.
#
# Таймер, клавиатура и каналы сходятся на один вход ПП цепочкой; ближе к
# процессору - старше. По реверсу ХМ2-001 (docs-external/UKNC/BMK_texts,
# «векторные прерывания VIRQ») порядок такой: 310 (внешнее событие таймера),
# 304 (обнуление таймера), 300 (клавиатура), за ними каналы.
#
# ПП сначала работает с приоритетом 7: запросы никто не берёт, и сценарий
# взводит их сам. Векторы 300 и 304 сценарий направляет на свои циклы BR .
# с PSW 340, и после снятия приоритета видно, какой запрос процессор взял
# первым: по ppu.trap_vector и по тому, в каком цикле он стоит. Остановить ПП
# нельзя: с ним стоит и его домен, и ни таймер, ни клавиатура не тактуются.
# Готовность таймера снимается так же, как это делает программа: чтением
# 177714 (value16 читает как процессор, с побочными действиями).
# @timeout 60

MACHINE "uknc/UKNC.cfg"
WAIT _4000

LOGDEFS _16,_8
COMMAND ppu.setreg(PSW, 340)

# 000600 - цикл для вектора 300, 000604 - для 304; новое PSW 340 держит
# процессор в цикле, не пуская других запросов
COMMAND plane0.set16(600, 777, 240, 777)
COMMAND plane0.set16(300, 600, 340, 604, 340)

PRINT "=== ПЗУ могло оставить готовность таймера: снимаем ==="
COMMAND pp-timer.set16(0, 0)
LOG pp-timer.value16(4)

PRINT "=== клавиатура: готовность (разряд 7) и разрешение от ПЗУ (разряд 6) ==="
KEY _50,_50,a
WAIT _10
LOG pp-kbd-state.value

PRINT "=== обнуление таймера: уставка 1, пуск с прерыванием, затем останов ==="
COMMAND pp-timer.set16(2, 1)
COMMAND pp-timer.set16(0, 101)
WAIT _1
COMMAND pp-timer.set16(0, 100)
LOG pp-timer.state

PRINT "=== приоритет снят: первым взят 304, а не 300 ==="
COMMAND ppu.setreg(PSW, 0)
WAIT _1
LOG ppu.trap_vector
LOG ppu.pc

PRINT "=== готовность таймера снята: теперь 300 ==="
LOG pp-timer.value16(4)
COMMAND ppu.setreg(PSW, 0)
WAIT _1
LOG ppu.trap_vector
LOG ppu.pc

# Внешнее событие - перепад на входе с ленты при разряде 2 регистра 177716.
# Заглушка замыкает выход на ленту (разряд 1) на вход, а перепад даёт сам ПП:
# запись из сценария (set) защёлкивает порт, но на линии не выходит.
#   000620  BIS #4,@#177716   разрешить событие
#   000626  BIS #2,@#177716   выход на ленту в единицу - перепад на входе
#   000634  BR .
# Процессор здесь уже стоит в цикле обработчика 300 с PSW 340
PRINT "=== все три запроса сразу: первым взят 310 ==="
COMMAND plane0.set16(610, 777)
COMMAND plane0.set16(310, 610, 340)
COMMAND plane0.set16(620, 52737, 4, 177716, 52737, 2, 177716, 777)
# Сначала обнуление (пока событие не прочитано, счёт стоит): разрешены оба
# прерывания таймера, разряды 4 и 6
COMMAND pp-timer.set16(2, 1)
COMMAND pp-timer.set16(0, 121)
WAIT _1
COMMAND pp-timer.set16(0, 120)
COMMAND tape-plug.set(0, 1)
COMMAND ppu.setreg(PC, 620)
WAIT _1
LOG pp-timer.state
LOG pp-timer.events
LOG pp-kbd-state.value
COMMAND ppu.setreg(PSW, 0)
WAIT _1
LOG ppu.trap_vector
LOG ppu.pc

EXIT
