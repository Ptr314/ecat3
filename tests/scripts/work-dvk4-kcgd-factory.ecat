# Заводской тест КЦГД KC.SAV с диска тестов ФОДОС (FODOSTMO.DSK) на ДВК-4.
#
# Тест на ДВК рисует символьную таблицу и цветовую шкалу и загружает в КЦГД
# свою программу: та проверяет процессор КЦГД (ловушка T после RTI - ошибка
# 15), клавиатуру МС7004 (ответ на команду перезапуска $FD - 17), кадровое
# прерывание (44), регистры палитры (40-43), REQB - разряд счётчика строк
# (120-125), REQA и прерывание A (126-132). При ошибке КЦГД крупно рисует её
# номер и стоит; без ошибок машина выводит «тест КЦГД окончен».
# @timeout 400
# @nomcp тест опирается на фазу кадрового прерывания от пуска машины
MACHINE "dvk/DVK-4-KCGD.ext"
COMMAND my0.load("FODOSTMO.DSK")
WAIT _12000
TYPE "BMY0"
WAIT _20000
TYPE "R KC"
KEY _100,_50,ret
WAIT _120000

LOGDEFS _16,_8
PRINT "=== КЦГД ==="
LOG kcgd.palette
LOG keyboard.commands
PRINT "=== Экран ==="
LOG display.text
SCREEN "../results/work-dvk4-kcgd-factory.png"
EXIT
