# Поиск-1: снимок состояния с дисководом и графикой.
#
# ../tests/files/state-poisk-disk.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-poisk-disk.ecat: загрузочный сектор poisk-boot.img
# записал сектор на дорожку 2 (в образе на диске его нет, он только в буфере
# привода), затем программа поставила 320x200 и залила экран полосами.
#
# * Режим видео и палитра живут в порту 68h второго ВВ55, а экран - в верхних
#   32 КБ ОЗУ платы: после загрузки снимка полосы те же и в тех же цветах;
# * дискета едет в архиве со своим содержимым: программа по 0060:0000 заново
#   читает через INT 13h записанный сектор (дорожка 2, сторона 0, сектор 5)
#   в 0000:9800, и он совпадает с тем, что загрузочный сектор прочитал до
#   снимка в 0000:9000. Заодно это проверяет, что после загрузки живы
#   контроллер, мотор картриджа и прерывания таймера, которых ждет драйвер
# @timeout 60

MACHINE "../tests/files/state-poisk-disk.ecats.zip"
LOGDEFS 16,16

PRINT "=== режим видео ==="
LOG display.mode
LOG ppi2.ports

PRINT "=== сектор, прочитанный до снимка ==="
LOG ram0.value($9000,$901F)

PRINT "=== тот же сектор, прочитанный после ==="
#  0: xor ax,ax / mov es,ax / mov bx,9800h
#  7: mov ax,0201h / mov cx,0205h / mov dx,0 / int 13h
# 12: jmp $
COMMAND ram0.set($600, $31, $C0, $8E, $C0, $BB, $00, $98)
COMMAND ram0.set($607, $B8, $01, $02, $B9, $05, $02, $BA, $00, $00, $CD, $13, $EB, $FE)
COMMAND cpu.setreg(CS, $60)
COMMAND cpu.setreg(IP, 0)
WAITFOR cpu.pc == $612, 10000
LOG cpu.registers
LOG ram0.value($9800,$981F)
LOG fdc.reads

SCREEN "../results/state-poisk-disk.png"
EXIT
