# Электроника МС 0585 с МС 1702: «Эмулятор DOS v 1.3» с дискеты, защищённой метками F8. Установщик
# SHAG2 читает блоки EMUL.TSK, ловит ошибку 364, берёт сектор из буфера контроллера и переворачивает
# его слова, а номер машины пишет на дискету меченым сектором. Без меток задача попала бы на винчестер
# с перевёрнутыми блоками и упала бы при запуске (состояние 4, код ошибки 8). Образ - tests/files/make-emul-1.3.ecat
# @timeout 300
MACHINE "computers/e85/MS0585-1702.ext"
COMMAND knmd.load("software/e85/pros-2.03-10m.rd")
COMMAND knmd.volatile(1)
LOGDEFS _16,_8
WAIT _45000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _5000
COMMAND fd0.load("software/e85/emul-1.3.hfe")
WAIT _3000
KEYDOWN key_f7
WAIT _100
KEYUP key_f7
WAIT _300
WAIT _15000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _20000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _15000
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _30000
LOG fdc.writes
LOG fd0.deleted
SCREEN "../results/slow-e85-emul13-install.png"
COMMAND fd0.eject()
RESET cold
WAIT _45000
COMMAND fd0.load("software/e85/eldos-msdos-3.30.dsk")
WAIT _2000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _4000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _80000
TYPE "\n"
WAIT _500
WAIT _6000
TYPE "\n"
WAIT _500
WAIT _8000
TYPE "ver\n"
WAIT _500
WAIT _15000
LOG mc1702.unsupported
LOG knmd.refused
SCREEN "../results/slow-e85-emul13.png"
EXIT
