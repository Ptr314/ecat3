# Электроника МС 0585 с МС 1702: печать из MS-DOS. Вывод в PRN идёт через порт 3BC платы, EMUL на ЦП
# комплекса отдаёт его на разъём «Печать»
# @timeout 150
MACHINE "computers/e85/MS0585-1702.ext"
COMMAND knmd.load("../library/e85/pros-2.03-10m-pc.rd")
COMMAND knmd.volatile(1)
LOGDEFS _16,_8
WAIT _45000
COMMAND fd0.load("../library/e85/eldos-msdos-3.30.dsk")
WAIT _2000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _4000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _80000
TYPE "\n"
WAIT _500
WAIT _6000
TYPE "\n"
WAIT _500
WAIT _8000
LOG prn.sent
LOG prn.output
TYPE "ver>prn\n"
WAIT _500
WAIT _25000
LOG prn.sent
TYPE "dir>prn\n"
WAIT _500
WAIT _40000
LOG prn.sent
LOG prn.overruns
LOG prn.text
LOG mc1702.unsupported
SCREEN "../results/boot-e85-1702-print.png"
EXIT
