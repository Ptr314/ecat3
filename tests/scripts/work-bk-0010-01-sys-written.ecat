# БК0010-01: разряд 2 регистра 0177716 при чтении - признак записи в 0177716.
# По схеме это триггер D9.1 (155ТМ2): любая запись в 0177716 его ставит, а
# конец чтения 0177716 сбрасывает, так что само чтение еще видит единицу.
# Пультовый вход процессора (HALT, СТОП) делает чтение-модификацию-запись
# 0177716 |= 010 и тоже его ставит, а ошибка шины - нет: по этому разряду
# обработчик вектора 4 и отличает одно от другого (так делает БОС БК0011М).
#
# Программа в ОЗУ складывает прочитанное из 0177716 в 2000 и дальше:
#   2000 - после TST @#177716: 0
#   2002 - после записи MOV #100000,@#177716: 1
#   2004 - следующее чтение: 0, предыдущее чтение сбросило
#   2006 - в обработчике вектора 4 после ошибки шины (TST @#177600): 0
#   2010 - в обработчике вектора 4 после HALT: 1
# Таймаутов четыре. Два здесь: 177600 и 177676, куда пультовый вход кладет PSW.
# Два раньше, при запуске БЕЙСИКа: он сбрасывает регистры ИРПС ДВК (CLR @#176564
# и CLR @#176560 в 120510), которых у БК нет, а ПЗУ на запись не отвечает.
#
# 1000: MOV #1000,SP; MOV #2000,R5; MOV #3000,@#4; MOV #340,@#6
# 1024: TST @#177716; MOV @#177716,(R5)+
# 1034: MOV #100000,@#177716; MOV @#177716,(R5)+; MOV @#177716,(R5)+
# 1052: MOV #1062,R4; TST @#177600
# 1062: MOV #1000,SP; MOV #1074,R4; HALT
# 1074: MOV #1000,SP; BR .
# 3000: MOV @#177716,(R5)+; JMP (R4)
# @timeout 20

MACHINE "bk/BK-0010-01.cfg"
WAIT _1500

COMMAND ram.set16(&1000, &012706, &001000, &012705, &002000, &012737, &003000, &000004, &012737, &000340, &000006, &005737, &177716, &013725, &177716, &012737, &100000, &177716, &013725, &177716, &013725, &177716, &012704, &001062, &005737, &177600, &012706, &001000, &012704, &001074, &000000, &012706, &001000, &000777)
COMMAND ram.set16(&3000, &013725, &177716, &000114)
COMMAND ram.set16(&2000, 0, 0, 0, 0, 0)
COMMAND cpu.setreg(PSW, &340)
COMMAND cpu.setreg(PC, &1000)
WAIT _20

LOGDEFS _16,_8
PRINT "=== программа дошла до конца ==="
LOG cpu.pc
LOG cpu.timeouts
PRINT "=== прочитанное из 0177716 ==="
LOG ram.value16(&2000, &2011)
PRINT "=== последнее чтение сбросило признак ==="
LOG sys-written.value
EXIT
