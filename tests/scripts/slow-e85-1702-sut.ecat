WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _5000
COMMAND fd0.load("software/e85/tpo-1.dsk")
WAIT _3000
KEYDOWN key_f7
WAIT _100
KEYUP key_f7
WAIT _300
WAIT _15000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _12000
