WAIT _300
WAIT _12000
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _35000
COMMAND fd1.load("software/e85/tpo-2.dsk")
WAIT _3000
KEYDOWN key_f7
WAIT _100
KEYUP key_f7
WAIT _300
WAIT _45000
SCREEN "../results/slow-e85-1702-sut-install.png"
COMMAND fd0.eject()
COMMAND fd1.eject()
RESET cold
