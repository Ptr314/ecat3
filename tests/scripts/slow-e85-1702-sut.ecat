# Электроника МС 0585 с МС 1702: заводской тест платы D00049 (исходник ATD0.C на той же дискете). ТПО
# ставится на винчестер, «Тестовый компоновщик» берёт модуль с дискеты EMUL 1.3, «Проверка системного
# блока» запускает его: сброс, тест из ПЗУ платы, обмен с ней, прерывания. Строка СОПРОЦЕССОР МС-1702
# на итоговом экране - «ОШИБОК НЕТ», mc1702.writes растёт только от этого теста
# @timeout 200
MACHINE "computers/e85/MS0585-1702.ext"
COMMAND knmd.load("software/e85/pros-2.03-10m.rd")
COMMAND knmd.volatile(1)
LOGDEFS _16,_8
WAIT _45000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
