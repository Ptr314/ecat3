# УК-НЦ: загрузка с картриджа ПЗУ - кассетный Бейсик (romctr_basic.bin).
#
# Картридж - три банка по 8 КБ, которые ПП видит по очереди в окне
# 100000-117777. Окно переключает регистр 177054: разряд 4 - ОЗУ, иначе
# разряд 0 - системное ПЗУ, иначе разряды 1-2 - банк картриджа, разряд 3 -
# слот. Пункт 2 меню ЗАГРУЗКА (номер кассеты 1 по умолчанию) перекачивает
# банки в память ЦП через тот же цикл ПЗУ 125442, что и чтение по каналу 2,
# и запускает Бейсик.
#
# Бейсик считает командами FIS, как и дисковый, поэтому здесь же проверяется
# арифметика. Второй слот пуст: его обращения остаются без ответа.
# @timeout 60

MACHINE "uknc/UKNC.cfg"
LOGDEFS _16,_8

PRINT "=== окно 0 периферийного процессора ==="
LOG ppu-mapper.map
LOG cart1.size

WAIT _12000
PRINT "=== ЗАГРУЗКА: 2 - кассета ПЗУ 1 ==="
KEY _100,_100,2
WAIT _200
KEY _100,_100,ret
WAIT _15000
LOG pp-win.value16
SCREEN "../results/boot-uknc-cartridge-start.png"

TYPE "PRINT 6*7;SIN(1);ATN(1)*4\n"
WAIT _2000
TYPE "10 FOR I=1 TO 3\n"
WAIT _500
TYPE "20 PRINT I,I*I\n"
WAIT _500
TYPE "30 NEXT I\n"
WAIT _500
TYPE "RUN\n"
WAIT _2000
SCREEN "../results/boot-uknc-cartridge.png"
EXIT
