# Правец-8А: триггер кодовой таблицы D128 читается в разряде 6 $C06x с
# инверсного выхода (схема 8С, с. 57; в книге «когда флаг установлен,
# клавиатура посылает 7-битовый код»): запись 0 - разряд 1, запись 1 - разряд 0.
# На экране 192 и 128 (разряд 7 - KD7 последней клавиши). Этот разряд проверяет ПАРИС, а ПЗУ по нему делает
# мигающими знаки $A0-$BF в 7-битной таблице: FLASH и «1» дают $71 (113), а не
# инверсный $31.
# @timeout 30

MACHINE "pravetz/Pravetz-8A.cfg"
# Без штатного диска в дисководе: ПЗУ не грузит DOS, CTRL+RESET выводит в БЕЙСИК
COMMAND fdd0.eject()
WAIT 1000
KEYDOWN ctrl
KEY 50,100,f12
KEYUP ctrl
WAIT 500
TYPE "HOME:POKE 49248,0:?PEEK(49248):POKE 49248,1:?PEEK(49248):POKE 49248,0"
KEY 50,50,ret
WAIT 300
TYPE "VTAB 1:FLASH:?\"1\":NORMAL:VTAB 4:?PEEK(1024)"
KEY 50,50,ret
WAIT 300
LOG iou.softsw
SCREEN "../results/work-pravetz-8a-softsw.png"
EXIT
