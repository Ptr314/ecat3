# УК-НЦ + КНГМД: дисковый Бейсик (basic.dsk, FODOS/RT-11 + DBAS), набор с
# клавиатуры хоста, арифметика и запись на дискету.
#
# Что здесь проверяется, по порядку поломок, которые тест ловил:
# - знаки верхнего регистра. На МС7007 `'` набирается с НР, а `:` без него, не
#   так, как на хосте; раскладка помечает их +shift/-shift, и клавиатура сама
#   ставит НР. Код отпускания НР - 205 (разряд 7 и четыре младших разряда
#   номера 105): с кодом 305 НР залипал, и всё после первого `"` набиралось
#   в другом регистре, а ВК становился переводом строки;
# - арифметика. FADD/FSUB/FMUL/FDIV у ВМ2 уводят процессор в пультовый режим
#   по вектору 010, где их считает пультовая программа; без этого Бейсик
#   отвечал «Ошибка» на любое действие;
# - SIN и COS. Регистр косвенного доступа ЦП 176640 хранит индекс байта в
#   планах, а не адрес ЦП; принятый за адрес, он делился на 2, и загрузка
#   портила слово 070074 Бейсика - SIN уводил машину на HALT;
# - запись: SAVE пишет файл в образ (в памяти, файл на диске не трогается),
#   NEW стирает программу, LOAD читает её обратно с дискеты.
# @timeout 180

MACHINE "uknc/UKNC.cfg"
COMMAND fdd0.load("basic.dsk")
WAIT _12000

LOGDEFS _16,_8
KEY _100,_100,1
WAIT _200
KEY _100,_100,ret
WAIT _15000

# Программа DAY спрашивает дату, ВК оставляет предложенную
KEY _100,_100,ret
WAIT _18000
SCREEN "../results/disk-uknc-basic-start.png"

PRINT "=== слово Бейсика, которое портил косвенный доступ ЦП ==="
LOG cpu-ram.value16(70074,70074)

TYPE "10 REM !\"#$%&'()*+,-./:;<=>?\n"
WAIT _1000
TYPE "20 PRINT 6*7;7/2;SQR(2);SIN(1);COS(0);ATN(1)*4\n"
WAIT _1000
TYPE "SAVE \"TEST\"\n"
WAIT _8000
TYPE "NEW\n"
WAIT _1000
TYPE "LOAD \"TEST\"\n"
WAIT _8000
TYPE "LIST\n"
WAIT _2000
TYPE "RUN\n"
WAIT _3000

PRINT "=== ПЗУ ПП не ждёт отпускания НР и держит основную таблицу ==="
LOG plane0.value16(7212,7216)
LOG keyboard.dropped
SCREEN "../results/disk-uknc-basic.png"
EXIT
