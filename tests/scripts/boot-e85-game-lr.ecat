# Электроника МС 0585: Lode Runner, первый уровень. Цвет через расширитель НВ2 и палитру;
# в режиме 525 строк видно 240 строк, и уровень занимает их точно
# @timeout 120
MACHINE "computers/e85/MS0585-NMD.ext"
COMMAND knmd.load("software/e85/pros-2.03-10m.rd")
COMMAND knmd.volatile(1)
WAIT _45000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _10000
TYPE "1"
WAIT _4500
TYPE "1"
WAIT _4500
KEYDOWN key_down
WAIT _300
KEYUP key_down
WAIT _200
WAIT _2000
KEYDOWN key_up
WAIT _300
KEYUP key_up
WAIT _200
WAIT _2000
KEYDOWN key_space
WAIT _400
KEYUP key_space
WAIT _200
WAIT _6000
LOGDEFS _16,_8
LOG video.vectors
SCREEN "../results/boot-e85-game-lr.png"
EXIT
