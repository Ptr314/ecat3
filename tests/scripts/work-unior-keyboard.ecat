# Юниор ФВ-6506: экранная клавиатура
#
# Клавиши рисунка (unior_keyboard.svg) замыкают контакты матрицы по таблице
# unior.keys. Здесь нажимается каждая из них, а программа в памяти читает коды
# точкой входа МОНИТОРа $F803 и складывает их подряд: эталон - это вся таблица
# кодов ПЗУ ($F9E0) в порядке обхода матрицы. Если клавиша встанет не в ту
# ячейку, разойдется ровно ее код.
#
# Потом проверяются пять модификаторов: они в матрицу входят, кода не дают, а
# переключают разряды признака $F7AF - РУС/ЛАТ (АЛФ), регистр (ФИКС), ГРАФ, НР
# и УПР. Обе клавиши НР сидят на одном контакте (в таблице записаны через "|"),
# поэтому проверяются обе.
# @timeout 60

MACHINE "unior/Unior.cfg"
WAIT 1500
LOGDEFS 8,16

// Читает коды клавиш и складывает их с адреса $2000
COMMAND ram.set($0100,$21,$00,$20,$CD,$03,$F8,$B7,$CA,$03,$01,$77,$23,$C3,$03,$01)
COMMAND cpu.setreg(PC,$0100)
WAIT 200
KEYDOWN key_num_9
WAIT 60
KEYUP key_num_9
WAIT 60
KEYDOWN key_ar2
WAIT 60
KEYUP key_ar2
WAIT 60
KEYDOWN key_semi
WAIT 60
KEYUP key_semi
WAIT 60
