# БК0011М + AZBK: окна, регистры, палитра и все 32 МБ памяти контроллера
# переживают снимок состояния; в снимок идут только непустые страницы
# (state_pages = 1 у azbk-ram).
#
# ../tests/files/state-bk-azbk.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-bk-azbk.ecat на экране BIOS: окно 14 (0160000) - страница
# 01234 с RPLY и образцом 054321, 012345; в последнем слове памяти AZ -
# 070707; ячейка палитры 0400 - 012345.
#
# Проверяется, что после загрузки окна и память те же, экран рисуется заново
# по восстановленной памяти, а запись в ОЗУ БК в тени по-прежнему доходит до
# страницы AZ (ROUTE_SNOOP разобран диспетчером заново).
# @timeout 40

MACHINE "../tests/files/state-bk-azbk.ecats.zip"
LOGDEFS _16,_8

PRINT "=== Окна и регистры после загрузки ==="
LOG azbk.windows
LOG azbk.control
LOG azbk-vga.mode
LOG azbk-vga.palette(400, 400)

PRINT "=== Память: окно 14 и конец 32 МБ ==="
LOG mapper.value16(160000, 160003)
LOG azbk-ram.value16(177777776, 177777777)

PRINT "=== Экран по восстановленной памяти ==="
WAIT _40
LOG display.crc

PRINT "=== Тень: запись в 040000 доходит до страницы AZ ==="
COMMAND mapper.set16(040000, 070707)
LOG ram5.value16(0, 1)
LOG azbk-ram.value16(040000, 040001)
EXIT
