# Радио-86РК: снимок поднимается с пустой матрицей клавиатуры.
#
# ../tests/files/state-rk86.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-rk86.ecat: монитор с набранной, но не отправленной
# командой. Архив несет в себе все: свою конфигурацию, ПЗУ, шрифт и раскладку.
#
# Клавиши хоста в снимок не пишутся нарочно - когда его открывают, никто
# ничего не держит. Но в этой матрице ноль разряда означает нажатую клавишу,
# и обнулить ее - это не «ничего не нажато», а «нажато все»: машина при первом
# же сканировании видела всю матрицу зажатой. Пустая матрица здесь - это все
# единицы, как после сброса.
# @timeout 40

MACHINE "../tests/files/state-rk86.ecats.zip"

LOGDEFS _16,_8
PRINT "=== матрица после загрузки состояния ==="
LOG keyboard.count
LOG keyboard.matrix
SCREEN "../results/state-rk86-keyboard-restored.png"

# И клавиатура после этого живая: набранная до съемки команда отправляется
# и монитор печатает дамп
PRINT "=== клавиатура работает ==="
TYPE "\n"
WAIT _1000
SCREEN "../results/state-rk86-keyboard-continued.png"

EXIT
