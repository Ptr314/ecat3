# МС7004 и прошивка КСМ: ВР и СУ, нажатые вместе и отпущенные в любом
# порядке, не должны оставаться нажатыми у терминала. Так Windows переключает
# раскладку (Ctrl+Shift); раньше ВР, отпущенный под СУ, залипал, буквы уходили
# в машину строчными, и монитор их не принимал.
#
# Прошивка КСМ держит СУ в ячейке 20B3 своего ОЗУ (FF - нажат), ВР - в
# разряде 0 ячейки 20B4; код $B3 снимает сначала СУ, потом ВР. Клавиатура по
# своей прошивке шлёт $B3 при отпускании каждой из двух клавиш, поэтому ВР,
# отпущенный под СУ, оставляет у терминала ВР вместо СУ - до отпускания СУ,
# как на настоящей машине. После каждого порядка обе должны быть сняты.
#
# Затем автоповтор: клавиатура сама шлёт $B4, терминал повторяет последний
# символ. Цифра, удержанная 500 мс, - задержка 360 мс и повторы через 28 мс.
#
# Цифровой блок хоста - цифровой блок МС7004 ($99 у 4, ВВОД $95), основное
# поле - свои коды ($D0); знака, которого в блоке нет («*»), блок даёт тот же
# код, что основное поле. КСМ печатает из блока ту же цифру.
# В конце набирается команда монитора, и экран показывает её заглавными.
# @timeout 60
MACHINE "../../tests/files/dvk3-055.ext"
WAIT _2000
KEY _100,_50,ret
WAIT _300
LOGDEFS _16,_8

PRINT "=== Ctrl, Shift; отпустить Shift, потом Ctrl ==="
KEYDOWN ctrl
WAIT _50
KEYDOWN shift
WAIT _50
LOG ksm-ram.value($B3,$B4)
KEYUP shift
WAIT _50
LOG ksm-ram.value($B3,$B4)
KEYUP ctrl
WAIT _50
LOG ksm-ram.value($B3,$B4)

PRINT "=== Ctrl, Shift; отпустить Ctrl, потом Shift ==="
KEYDOWN ctrl
WAIT _50
KEYDOWN shift
WAIT _50
KEYUP ctrl
WAIT _50
LOG ksm-ram.value($B3,$B4)
KEYUP shift
WAIT _50
LOG ksm-ram.value($B3,$B4)

PRINT "=== Shift, Ctrl; отпустить Shift, потом Ctrl ==="
KEYDOWN shift
WAIT _50
KEYDOWN ctrl
WAIT _50
KEYUP shift
WAIT _50
LOG ksm-ram.value($B3,$B4)
KEYUP ctrl
WAIT _50
LOG ksm-ram.value($B3,$B4)

PRINT "=== Shift, Ctrl; отпустить Ctrl, потом Shift ==="
KEYDOWN shift
WAIT _50
KEYDOWN ctrl
WAIT _50
KEYUP ctrl
WAIT _50
LOG ksm-ram.value($B3,$B4)
KEYUP shift
WAIT _50
LOG ksm-ram.value($B3,$B4)

PRINT "=== Автоповтор ==="
KEYDOWN 1
WAIT _500
KEYUP 1
WAIT _100
LOG keyboard.repeats
KEY _100,_50,ret
WAIT _300

PRINT "=== Цифровой блок ==="
KEY _100,_50,kp4
WAIT _100
LOG keyboard.last
KEY _100,_50,4
WAIT _100
LOG keyboard.last
KEY _100,_50,kpmult
WAIT _100
LOG keyboard.last
KEY _100,_50,enter
WAIT _300

TYPE "BMX"
WAIT _500
PRINT "=== Экран ==="
LOG display.text
EXIT
