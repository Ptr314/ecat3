# БК0011М + AZBK: проба AZHWT для настоящей платы (tools/azbk-hwtest) - что
# отвечает модель eCat3. С платы нужны те же числа: таблица RESULT (014000),
# экраны и файл 0:/AZHWT.TXT; расхождение - ответ на вопрос к ПЛИС (Б.5-Б.8,
# Б.11-Б.13). Программа пускается платформой AZБК, карта - tests/files/azbk-sd
# (отчет пишется в ее память).
#
# Экран 1: версии (177370, 027 - 0x1904), слово ошибки (001 с DR = 040 -
# 0x8600, 013 - 0x8B00), 177176 (ловушка), Covox на чтение (у модели нули),
# окно 7: запись в активное окно доходит и до ОЗУ БК, чтение - ИЛИ (037477),
# запись в окно с запретом - без ловушки, в ОЗУ БК под ним.
# Экран 2: страницы AZ 0206, 01000 (тест памяти STM32 - 0x1111, начало
# переписала BIOS), 01100, 02000, 03777, 017777; время 8000 обращений к ОЗУ БК
# и к странице AZ поверх него, к 0140000 с окном 12 как есть и наоборот.
# Экран 3: блиттер (0 строк - одна, приращение 0 - вторая строка с последнего
# слова первой, разряд 12 без ручного режима - не пускает), прерывания 0174
# (только по окончании длительной 021), файл отчета - длина назад та же.
# Затем звук: регистры AY1 (тон A, период 256) и AY приставки на 0177714.
# @timeout 120

PLATFORM "AZБК", "../files/azhwt.bin"
COMMAND az-sd.load("../files/azbk-sd")
LOGDEFS _16,_8
WAIT _2000
SCREEN "../results/work-bk0011m-azbk-hwtest-1.png"
KEY _10,_50,space
WAIT _3000
SCREEN "../results/work-bk0011m-azbk-hwtest-2.png"
KEY _10,_50,space
WAIT _3000
SCREEN "../results/work-bk0011m-azbk-hwtest-3.png"
PRINT "=== Таблица RESULT ==="
LOG ram0.value16(14000, 14377)
LOG az-sd.files
KEY _10,_50,space
WAIT _500
PRINT "=== S1: AY1, тон A ==="
LOG az-ay1.regs(0, 15)
KEY _10,_50,space
WAIT _500
KEY _10,_50,space
WAIT _500
KEY _10,_50,space
WAIT _500
PRINT "=== S4: AY2, тон A ==="
LOG az-ay2.regs(0, 15)
KEY _10,_50,space
WAIT _500
PRINT "=== S5: AY через 0177714 ==="
LOG ay.regs(0, 15)
KEY _10,_50,space
WAIT _500
KEY _10,_50,space
WAIT _500
PRINT "=== Выход ==="
KEY _10,_50,space
WAIT _2000
LOG az-ay1.regs(7, 10)
LOG azbk-vga.mode
SCREEN "../results/work-bk0011m-azbk-hwtest-4.png"
EXIT
