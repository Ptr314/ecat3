# Юниор ФВ-6506: снимок состояния поднимается со всем своим хозяйством.
#
# ../tests/files/state-unior.ecats.zip (от deploy/) снят скриптом
# ../files/make-state-unior.ecat. У этой машины в архив уходит больше, чем у
# остальных, и каждая часть здесь проверяется:
#
# * ПЗУ палитры. Оно чуть не потерялось: имя файла palette.rom совпадало с
#   именем устройства, и сборщик архива принимал его за ссылку на устройство.
#   Без него архив вообще не загрузится, а цвет в верхней строке снимка
#   показывает, что палитра на месте;
# * дополнительная память - полмегабайта, метка в блоке;
# * кассета. Носитель этой машины живет в устройстве, а не в файле на диске,
#   поэтому лента едет в архиве целиком - и после загрузки с нее читается
#   запись командой МОНИТОРа "I".
# @timeout 60

MACHINE "../tests/files/state-unior.ecats.zip"
LOGDEFS 8,16

PRINT "=== метки в памяти ==="
LOG ram.value($0300,$0303)
LOG extram.value($1234,$1237)

PRINT "=== кассета в снимке ==="
LOG tape.records
LOG tape.total

SCREEN "../results/state-unior-restored.png"

PRINT "=== машина живая: читаем запись с ленты ==="
COMMAND ram.set($F802,$20,$20,$20,$20,$20,$20,$20)
KEYDOWN I
WAIT 400
KEYUP I
WAIT 4000
LOG ram.value($F802,$F808)
LOG cpu.pc
EXIT
