# БК0010-01: разъем УП и мышь УВК-01 «Марсианка» на порту 0177714.
# Разъем по умолчанию пуст, и стрелка хоста до порта не доходит (было: джойстик
# на тех же стрелках гнал курсор TDR к краю экрана); с джойстиком доходит.
# Затем в память кладется контрольная программа из руководства по эксплуатации
# мыши (адрес 01264, запуск 1264G), мышь подключается, «Л» включает режим
# записи, и курсор рисует угол: 40 шагов вправо и 30 вниз. «П» включает
# стирание, обратный ход на 15 шагов вверх стирает нижнюю половину вертикали.
# @timeout 60

MACHINE "bk/BK-0010-01.cfg"
WAIT _3000
LOGDEFS _16,_8
# Выбор разъема сохраняется в ecat.ini, так что умолчание здесь не проверить
COMMAND up.plug(none)

LOG up.device
KEYDOWN right
WAIT _100
LOG port-ppi.value
KEYUP right
COMMAND up.plug(joystick)
KEYDOWN right
WAIT _100
LOG port-ppi.value
# Выдернутый джойстик не оставляет на порту зажатое направление
COMMAND up.plug(none)
LOG port-ppi.value
KEYUP right
WAIT _100

COMMAND up.plug(mouse)
LOG up.device
COMMAND cpu.stop()
COMMAND ram.set16(1264,12700,14,104016,12700,225,104016,5003,12701,177714,11100,10004,5011,12711,10,42704,177637,22704,140,1517,12767,40,226,12702,226,5005,5004,32703,40,1401,5105,32703,10,1401,5105,10504,36700,170,1401,5105,5705,1426,62703,100,42703,400,32703,300,1017,5704,1011,10005,10200,104016,10500,62703,40,42703,100,404,62703,10,42703,20,22702,227,1407,12702,227,12767,100,64,303,717,303,10004,42704,177760,12702,1546,122204,1003,111200,104016,665,5202,20227,1565,1367,660,16403,16011,17006,17414,15001,14402,15404,4010,100,12700,225,104016,12700,7,104016)
COMMAND cpu.setreg(SP,1000)
COMMAND cpu.setreg(PC,1264)
COMMAND cpu.run()
WAIT _500
LOG port-ppi-out.value

MOUSE _20,_10
WAITFOR mouse.pending == 0,_3000
MOUSE 0,0,1
WAIT _100
MOUSE 0,0,0
WAIT _100
MOUSE _40,0
WAITFOR mouse.pending == 0,_3000
MOUSE 0,_30
WAITFOR mouse.pending == 0,_3000
MOUSE 0,0,2
WAIT _100
MOUSE 0,0,0
WAIT _100
MOUSE 0,-_15
WAITFOR mouse.pending == 0,_3000
WAIT _200

LOG mouse.pending
LOG mouse.state
SCREEN "../results/work-bk-0010-01-mouse.png"
EXIT
