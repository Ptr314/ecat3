# УК-НЦ: время команд обоих процессоров по тесту TSSPD v0.1i (Titus).
#
# TSSPD заполняет буфер копиями одной команды и за одно поле (20 мс) считает,
# сколько их выполнено: сначала в ПП, потом в ЦП, всё в ОЗУ. Снимки должны
# быть близки к фотографиям с настоящей машины литеры 7 с 1515ХМ1-031
# (Alex_K, emuverse «УКНЦ Расчёт точного времени выполнения команд»): ПП -
# NOP 20, MOV (R0),R1 40, MOV R1,(R0) 36, INC (R0) 56, MOVB R1,(R0) 52; ЦП -
# NOP 14.05, MOV R0,R0 12.32, MOV (R0),R1 33.1, MOV R1,(R0) 35.2,
# INC (R0) 40.3. Модель памяти и её подбор - tools/uknc-timing/README.md.
#
# Диск - tests/files/uknc-timing/timing.dsk (make_disk.py).
#
# SCREEN ждёт кадр от потока отрисовки, и то, что идёт после него, попадало
# бы в момент, зависящий от загрузки хоста: следующую страницу TSSPD меряет
# сразу после нажатия, и её числа дрожали на единицу. Поэтому перед каждым
# снимком оба процессора останавливаются (ПП работает в своём домене и
# без этого считал бы дальше), а после пускаются снова
# @timeout 400

MACHINE "uknc/UKNC.cfg"
WAIT _12000
KEY _100,_100,1
WAIT _200
KEY _100,_100,ret
WAIT _15000

# Программа DAY спрашивает дату, ВК оставляет предложенную
KEY _100,_100,ret
WAIT _18000

COMMAND fdd1.load("../files/uknc-timing/timing.dsk")
WAIT _500
TYPE "RU MZ1:TSSPD\n"
WAIT _15000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tsspd-1.png"
COMMAND ppu.run()
COMMAND cpu.run()
KEY _100,_100,ret
WAIT _15000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tsspd-2.png"
COMMAND ppu.run()
COMMAND cpu.run()
KEY _100,_100,ret
WAIT _15000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tsspd-3.png"
COMMAND ppu.run()
COMMAND cpu.run()
KEY _100,_100,ret
WAIT _15000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tsspd-4.png"
COMMAND ppu.run()
COMMAND cpu.run()
KEY _100,_100,ret
WAIT _15000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tsspd-5.png"
COMMAND ppu.run()
COMMAND cpu.run()
KEY _100,_100,ret
WAIT _15000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tsspd-6.png"
COMMAND ppu.run()
COMMAND cpu.run()
KEY _100,_100,ret
WAIT _15000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tsspd-7.png"
COMMAND ppu.run()
COMMAND cpu.run()
KEY _100,_100,ret
WAIT _15000
COMMAND cpu.stop()
COMMAND ppu.stop()
SCREEN "../results/slow-uknc-tsspd-8.png"
COMMAND ppu.run()
COMMAND cpu.run()
EXIT
