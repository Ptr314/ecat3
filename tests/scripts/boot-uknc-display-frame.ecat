# УК-НЦ: дисплейный контроллер, начальные значения кадра.
#
# Кадровый импульс видеоконтроллера загружает регистры, которые иначе задают
# четырёхсловные дескрипторы: палитру 0x10, 0x32, 0x54, 0x76 (цвет n - YRGB n,
# от чёрного к белому пониженной яркости), слово курсора 0x0008 и растяжку 1
# (реверс ХМ1-136, docs-external/UKNC/BMK_texts, «Циклы памяти
# видеоконтроллера»). Таблица, которая меняет палитру и растяжку только в
# середине экрана, выше этих строк показывает их, а не то, чем кончился
# прошлый кадр.
#
# Точки - та же лесенка из восьми цветов, что в boot-uknc-display. Таблица:
#   0000270          двухсловный, строка растра 0 -> 0000400
#   0000400-0001307  114 двухсловных, строки 1-114 -> палитра в 0002000
#   0002000          палитра, строка 115 (видимая 96) -> 0002100
#   0002100-0002673  95 двухсловных, строки 116-210 -> параметры в 0003000
#   0003000          параметры: растяжка 2, строка 211 (видимая 192) -> 0003020
#   0003020          двухсловный, замкнутый сам на себя
# Первые 19 строк растра - над картинкой. Ожидается: видимые строки 0-95
# серые пониженной яркости (палитра по умолчанию), 96-287 - палитра
# дескриптора, 192-287 вдвое шире точкой. Без сброса верхняя треть
# повторяла бы палитру из 0002000.
# @timeout 30

MACHINE "uknc/display-test.cfg"
LOGDEFS _16,_8

PRINT "=== точки: лесенка из восьми цветов ==="
COMMAND plane0.fill(10000, 10117, 252)
COMMAND plane1.fill(10000, 10117, 314)
COMMAND plane2.fill(10000, 10117, 360)

PRINT "=== таблица строк ==="
COMMAND plane0.set16(270, 10000, 400)

# Строки растра 1-114, последняя ссылается на дескриптор палитры (разряды 1 и 2)
COMMAND plane0.set16(400, 10000, 404, 10000, 410, 10000, 414, 10000, 420, 10000, 424, 10000, 430, 10000, 434, 10000, 440)
COMMAND plane0.set16(440, 10000, 444, 10000, 450, 10000, 454, 10000, 460, 10000, 464, 10000, 470, 10000, 474, 10000, 500)
COMMAND plane0.set16(500, 10000, 504, 10000, 510, 10000, 514, 10000, 520, 10000, 524, 10000, 530, 10000, 534, 10000, 540)
COMMAND plane0.set16(540, 10000, 544, 10000, 550, 10000, 554, 10000, 560, 10000, 564, 10000, 570, 10000, 574, 10000, 600)
COMMAND plane0.set16(600, 10000, 604, 10000, 610, 10000, 614, 10000, 620, 10000, 624, 10000, 630, 10000, 634, 10000, 640)
COMMAND plane0.set16(640, 10000, 644, 10000, 650, 10000, 654, 10000, 660, 10000, 664, 10000, 670, 10000, 674, 10000, 700)
COMMAND plane0.set16(700, 10000, 704, 10000, 710, 10000, 714, 10000, 720, 10000, 724, 10000, 730, 10000, 734, 10000, 740)
COMMAND plane0.set16(740, 10000, 744, 10000, 750, 10000, 754, 10000, 760, 10000, 764, 10000, 770, 10000, 774, 10000, 1000)
COMMAND plane0.set16(1000, 10000, 1004, 10000, 1010, 10000, 1014, 10000, 1020, 10000, 1024, 10000, 1030, 10000, 1034, 10000, 1040)
COMMAND plane0.set16(1040, 10000, 1044, 10000, 1050, 10000, 1054, 10000, 1060, 10000, 1064, 10000, 1070, 10000, 1074, 10000, 1100)
COMMAND plane0.set16(1100, 10000, 1104, 10000, 1110, 10000, 1114, 10000, 1120, 10000, 1124, 10000, 1130, 10000, 1134, 10000, 1140)
COMMAND plane0.set16(1140, 10000, 1144, 10000, 1150, 10000, 1154, 10000, 1160, 10000, 1164, 10000, 1170, 10000, 1174, 10000, 1200)
COMMAND plane0.set16(1200, 10000, 1204, 10000, 1210, 10000, 1214, 10000, 1220, 10000, 1224, 10000, 1230, 10000, 1234, 10000, 1240)
COMMAND plane0.set16(1240, 10000, 1244, 10000, 1250, 10000, 1254, 10000, 1260, 10000, 1264, 10000, 1270, 10000, 1274, 10000, 1300)
COMMAND plane0.set16(1300, 10000, 1304, 10000, 2006)

# Палитра, как в boot-uknc-display: 0 чёрный, 1 белый, 2 красный, 3 зелёный,
# 4 синий, 5 жёлтый, 6 голубой, 7 фиолетовый. Дальше двухсловный 0002100
COMMAND plane0.set16(2000, 126360, 155751, 10000, 2100)

# Строки растра 116-210, последняя ссылается на дескриптор параметров (разряд 1)
COMMAND plane0.set16(2100, 10000, 2104, 10000, 2110, 10000, 2114, 10000, 2120, 10000, 2124, 10000, 2130, 10000, 2134, 10000, 2140)
COMMAND plane0.set16(2140, 10000, 2144, 10000, 2150, 10000, 2154, 10000, 2160, 10000, 2164, 10000, 2170, 10000, 2174, 10000, 2200)
COMMAND plane0.set16(2200, 10000, 2204, 10000, 2210, 10000, 2214, 10000, 2220, 10000, 2224, 10000, 2230, 10000, 2234, 10000, 2240)
COMMAND plane0.set16(2240, 10000, 2244, 10000, 2250, 10000, 2254, 10000, 2260, 10000, 2264, 10000, 2270, 10000, 2274, 10000, 2300)
COMMAND plane0.set16(2300, 10000, 2304, 10000, 2310, 10000, 2314, 10000, 2320, 10000, 2324, 10000, 2330, 10000, 2334, 10000, 2340)
COMMAND plane0.set16(2340, 10000, 2344, 10000, 2350, 10000, 2354, 10000, 2360, 10000, 2364, 10000, 2370, 10000, 2374, 10000, 2400)
COMMAND plane0.set16(2400, 10000, 2404, 10000, 2410, 10000, 2414, 10000, 2420, 10000, 2424, 10000, 2430, 10000, 2434, 10000, 2440)
COMMAND plane0.set16(2440, 10000, 2444, 10000, 2450, 10000, 2454, 10000, 2460, 10000, 2464, 10000, 2470, 10000, 2474, 10000, 2500)
COMMAND plane0.set16(2500, 10000, 2504, 10000, 2510, 10000, 2514, 10000, 2520, 10000, 2524, 10000, 2530, 10000, 2534, 10000, 2540)
COMMAND plane0.set16(2540, 10000, 2544, 10000, 2550, 10000, 2554, 10000, 2560, 10000, 2564, 10000, 2570, 10000, 2574, 10000, 2600)
COMMAND plane0.set16(2600, 10000, 2604, 10000, 2610, 10000, 2614, 10000, 2620, 10000, 2624, 10000, 2630, 10000, 2634, 10000, 2640)
COMMAND plane0.set16(2640, 10000, 2644, 10000, 2650, 10000, 2654, 10000, 2660, 10000, 2664, 10000, 2670, 10000, 3002)

# Параметры: курсора нет, растяжка 2 (разряды 4-5 = 1), яркость полная.
# Дальше замкнутый двухсловный 0003020
COMMAND plane0.set16(3000, 0, 27, 10000, 3020)
COMMAND plane0.set16(3020, 10000, 3020)

PRINT "=== несколько кадров ==="
WAIT _100

LOG display.entries
LOG display.scales(0,3)
LOG display.scales(_95,_96)
LOG display.scales(_191,_192)
LOG display.scales(_284,_287)
LOG display.list(_113,_117)
LOG display.list(_209,_213)

SCREEN "../results/boot-uknc-display-frame.png"

EXIT
