# ДВК-3: графический контроллер КГД поверх текста КСМ.
#
# Программа в ОЗУ включает графику (разряд 15 регистра 176640) и через
# регистры адреса и данных заливает первые 50 строк картинки узором 125 -
# точка через точку, каждая удвоена по горизонтали. Монитор пускает её
# командой 1000G. Перед пуском вектор 100 ставится на RTI: запрос сетевого
# таймера защёлкивается, пока процессор стоит в пульте, и берётся сразу
# после RUN - с пустым вектором машина ушла бы в 0.
MACHINE "dvk/DVK-3.cfg"
COMMAND monitor.option(0,1)
WAIT _2000
KEY _100,_50,ret
WAIT _300
COMMAND ram.set16(100,1100,340)
COMMAND ram.set16(1100,000002)
COMMAND ram.set16(1000,106427,000340)         // MTPS #340
COMMAND ram.set16(1004,012737,140000,176640)  // MOV #140000,@#176640
COMMAND ram.set16(1012,005001)                // CLR R1
COMMAND ram.set16(1014,010137,176644)         // MOV R1,@#176644
COMMAND ram.set16(1020,112737,000125,176642)  // MOVB #125,@#176642
COMMAND ram.set16(1026,005201)                // INC R1
COMMAND ram.set16(1030,020127,004704)         // CMP R1,#4704
COMMAND ram.set16(1034,001367)                // BNE 1014
COMMAND ram.set16(1036,000777)                // BR .
TYPE "1000G"
WAIT _2000

LOGDEFS _16,_8
LOG kgd.cr
LOG kgd.ar
LOG kgd.lit
LOG kgd.vram(0,7)
SCREEN "../results/work-dvk3-kgd.png"
EXIT
