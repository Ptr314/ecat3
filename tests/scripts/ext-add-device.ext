// Расширение: новое устройство и место строки в карте (@before)
// Поверх uknc/reset-test.cfg добавляется второй счетный цикл в ПЗУ, counter2,
// который увеличивает слово 102 вместо 100. Его диапазон ставится в карту
// ПЕРЕД диапазоном исходного счетчика: карта отдает адрес первой подходящей
// строке, поэтому центральный процессор крутит новый цикл - растет слово 102,
// а 100 стоит на нуле. Добавленный в конец карты, диапазон не ответил бы
// никогда. Второе новое устройство, порт, ставится перед ram; порядок
// устройств проверяет eCat3-headless --selftest, сценарию он не виден.
// @timeout 29
@extends uknc/reset-test.cfg
@version Тест добавления устройства (.ext)

//   0100000: 0005237 0000102   INC @#102
//   0100004: 0000775           BR  0100000
counter2 : rom {
	data = {$9F,$0A,$42,$00,$FD,$01}
}

@before mapper:@memory[100000-100005]
mapper:@memory[100000-100005] = counter2 {mode = r}

@before ram
spare : port {
	size = _16
	default = 123
}
mapper:@memory[020000-020001] = spare

@script
LOGDEFS _16,_8
PRINT "=== карта: counter2 перед counter ==="
LOG mapper.map
PRINT "=== новый порт со значением по умолчанию ==="
LOG spare.value16(0)
PRINT "=== ЦП отпущен: растет 102, 100 стоит ==="
COMMAND pp-sys.set16(0, 40)
WAIT _100
LOG ram.value16(100)
LOG ram.value16(102)
EXIT
