# ДВК-4 (МС1201.04, КМ1801ВМ3): пуск, монитор 134 и загрузка RT-11 с MY.
#
# Плата держит процессор в пульте с самого пуска, монитор (ПЗУ 134 в теневой
# памяти) проверяет себя и терминал, переписывает тест в ОЗУ, отдаёт ему
# управление, и тот через диспетчер памяти с 22-разрядным адресом ищет
# границу ОЗУ («доступное ОЗУ - 1 M») и проверяет его - около 10 секунд.
# Тест кончается остановом, и монитор отвечает адресом и приглашением `@`.
# Команда BMY0 грузит RT-11 с привода 0, DIR читает каталог.
#
# Проверяются экран КСМ текстом, снимок и число блоков, прочитанных MY.
# @timeout 120
# @nomcp часы RT-11 идут от сетевого таймера, а в живой сессии машина успевает поработать до первой команды
MACHINE "dvk/DVK-4.cfg"
WAIT _12000
TYPE "BMY0"
WAIT _25000
KEY _100,_50,ret
WAIT _3000
TYPE "DIR"
KEY _100,_50,ret
WAIT _8000

LOGDEFS _16,_8
PRINT "=== MY ==="
LOG my.dma
PRINT "=== Экран ==="
LOG display.text
SCREEN "../results/boot-dvk4.png"
EXIT
