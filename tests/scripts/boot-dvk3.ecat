# ДВК-3: пультовый монитор, терминал КСМ и загрузка RT-11 с дискеты MX.
#
# Процессор входит в пультовый режим по регистру начального пуска платы
# (140000, режим 001) и отдаёт приглашение `@`, как только КСМ готов его
# принять: первые символы монитор шлёт, пока прошивка КСМ ещё чистит
# видеопамять, и они пропадают - поэтому сначала нажимается ВК. Команда BMX
# грузит RT-11 с привода 0; STARTS.COM доходит до DAY, которая ждёт ВК.
#
# Проверяется экран КСМ текстом (служебная строка первой) и снимком, и
# счётчики контроллера MX.
# @timeout 120
# @nomcp часы RT-11 идут от сетевого таймера, а в живой сессии машина успевает поработать до первой команды
MACHINE "../../tests/files/dvk3-055.ext"
WAIT _2000
KEY _100,_50,ret
WAIT _300
TYPE "BMX"
KEY _100,_50,ret
WAIT _25000
KEY _100,_50,ret
WAIT _3000
TYPE "DIR MX0:"
KEY _100,_50,ret
WAIT _8000

LOGDEFS _16,_8
PRINT "=== MX ==="
LOG mx.reads
LOG mx.writes
LOG mx.track
PRINT "=== Экран ==="
LOG display.text
SCREEN "../results/boot-dvk3.png"
EXIT
