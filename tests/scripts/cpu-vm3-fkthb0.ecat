# Диагностический тест DEC для PDP-11/34 на КМ1801ВМ3: диспетчер памяти (FKTHB0). Образы - из
# github.com/1801BM1/cpu11 (vm3/tst/org), там же восстановленные исходники;
# ВМ3 ближе всего к 11/34, поэтому его автор гонял кристалл именно по ним.
#
# Машина - отладочная dvk/vm3-test.cfg: процессор, ОЗУ и ИРПС без терминала.
# Тест кладётся в ОЗУ с 0 и стартует с 200 по сбросу; всё, что он пишет,
# читается полем tt.text. Он должен дойти до конца первого прохода без
# ошибок.
# Сначала тест спрашивает переключатели пульта - хватает ВК; в отчёте
# прохода должно стоять «TOTAL ERRORS ... 0».
# @timeout 60

MACHINE "dvk/vm3-test.cfg"
COMMAND ram.load("../files/vm3/fkthb0.bin", 0)
RESET soft
WAIT _1000
COMMAND tt.send("\r")
WAIT _3000
PRINT "=== FKTHB0 ==="
LOG tt.text
LOGDEFS _16,_8
LOG cpu.mmu
EXIT
