# Юниор ФВ-6506: запуск из блока расширения
# Команда МОНИТОРа L забирает 16 Кбайт из блока 7 по адресу 0040 и передает
# туда управление. В блок кладется программа, которая пишет "OK" прямо в
# экранный буфер и останавливается: так проверяется вся цепочка - клавиатура,
# разбор команды, пересылка ПДП с выбором блока и исполнение приехавшего кода.
# @timeout 30

MACHINE "unior/Unior.cfg"
WAIT 1500

# Блок 7 начинается со смещения 6*64K в дополнительной памяти
# LXI H,$F802 / MVI M,'O' / INX H / MVI M,'K' / HLT
COMMAND extram.set($60000, $21, $02, $F8, $36, $4F, $23, $36, $4B, $76)

KEY 100,100,L
WAIT 500

LOGDEFS 8,16
PRINT "=== Пересылка ==="
LOG ext-memory.transfers
LOG ext-memory.last
LOG ext-memory.direction
PRINT "=== Что приехало по 0040 ==="
LOG ram.value($0040,$0048)
PRINT "=== Что программа написала на экран ==="
LOG ram.value($F802,$F803)
LOG cpu.pc

SCREEN "../results/work-unior-block-boot.png"
EXIT
