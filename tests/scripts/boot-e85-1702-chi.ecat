# Электроника МС 0585 с МС 1702: Chi-DOS 3.30 с дискеты ЭЛДОС, русская DOS на тех же
# портах платы
# @timeout 120
MACHINE "computers/e85/MS0585-1702.ext"
COMMAND knmd.load("../library/e85/pros-2.03-10m-pc.rd")
COMMAND knmd.volatile(1)
WAIT _45000
COMMAND fd0.load("../library/e85/eldos-chi-dos-3.30.dsk")
WAIT _2000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _3000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _4000
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_down
WAIT _100
KEYUP key_down
WAIT _300
KEYDOWN key_f16
WAIT _100
KEYUP key_f16
WAIT _300
WAIT _85000
TYPE "\n"
WAIT _500
WAIT _4000
TYPE "\n"
WAIT _500
WAIT _6000
TYPE "dir\n"
WAIT _500
WAIT _10000
SCREEN "../results/boot-e85-1702-chi.png"
EXIT
