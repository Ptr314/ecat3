# Правец-8А: загрузка DOS 3.3 с диска 140 Кб (контроллер в слоте 6, ПЗУ P5
# платы Правец), CATALOG, запись программы на диск и чтение ее обратно.
# Диск - DOS и HELLO с диска Правец (tests/files/make-pravetz-dos33.py).
# Запись проверяется на машине: SAVE, NEW, LOAD, LIST и CATALOG с новым
# файлом; образ остается в памяти дисковода, файл на диске не меняется.
# @timeout 60

MACHINE "pravetz/Pravetz-8A.cfg"
COMMAND fdd0.load("../files/pravetz-dos33.dsk")
WAIT 6000
LOG fdd0.track
TYPE "CATALOG"
KEY 50,50,ret
WAIT 2000
SCREEN "../results/disk-pravetz-8a-dos33-catalog.png"
TYPE "10 PRINT \"PRAVETZ \";2*4;\"A\""
KEY 50,50,ret
TYPE "SAVE TEST"
KEY 50,50,ret
WAIT 3000
TYPE "NEW"
KEY 50,50,ret
TYPE "LOAD TEST"
KEY 50,50,ret
WAIT 3000
TYPE "HOME:LIST:RUN"
KEY 50,50,ret
WAIT 500
TYPE "CATALOG"
KEY 50,50,ret
WAIT 2000
SCREEN "../results/disk-pravetz-8a-dos33.png"
EXIT
