# БК0010-01: режим расширенной памяти (РП) драйвера ТВ - четверть экрана.
# Код 0214 (CHR$(140)) переключает драйвер: он сбрасывает разряд 9 регистра
# 0177664 и ставит смещение 0230, так что на экране остаются служебная строка
# и четыре строки текста из области 070000-077777, а остаток растра темный.
# Повторный код возвращает полный экран.
# @timeout 40

MACHINE "bk/BK-0010-01.cfg"
WAIT _4000

TYPE "PRINT \"FULL SCREEN\"\n"
WAIT _800
TYPE "PRINT CHR$(140)\n"
WAIT _800

LOGDEFS _16,_8
PRINT "=== Четверть экрана ==="
LOG port-scroll.value
SCREEN "../results/work-bk-0010-01-rp-quarter.png"

TYPE "PRINT \"HELLO RP\"\n"
WAIT _800
TYPE "PRINT 1234\n"
WAIT _800
SCREEN "../results/work-bk-0010-01-rp-text.png"

TYPE "PRINT CHR$(140)\n"
WAIT _800
PRINT "=== Полный экран ==="
LOG port-scroll.value
SCREEN "../results/work-bk-0010-01-rp-back.png"
EXIT
