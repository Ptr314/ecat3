# КМ1801ВМ3: после RTT, поставившей разряд T, ловушка трассировки приходит
# после первой же следующей команды (у RTI - сразу, до неё). Тесты DEC этого
# не различают: в FKABD0 вторая команда не проверяется.
#
# С 200: SP = 2000, вектор 14 -> 300, R1 = R2 = 0, в стек PSW 20 и PC 250,
# RTT. С 250: INC R1, INC R2. Обработчик с 300 кладёт в R3 сохранённый PC.
# Ждём R1 = 1, R2 = 0, R3 = 252.
# @timeout 30

MACHINE "dvk/vm3-test.cfg"
COMMAND ram.set16(200, 012706, 002000, 012737, 000300, 000014, 012737, 000340, 000016)
COMMAND ram.set16(220, 005001, 005002, 012746, 000020, 012746, 000250, 000006)
COMMAND ram.set16(250, 005201, 005202, 000777)
COMMAND ram.set16(300, 011603, 000777)
RESET soft
WAIT _10
LOGDEFS _16,_8
LOG cpu.registers
EXIT
