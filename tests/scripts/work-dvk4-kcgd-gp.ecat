# ДВК-4 с КЦГД и графическим процессором: прошивка 182 и ПЗУ KeyGP.
#
# Прошивка 182 при пуске переходит на 120000, и KeyGP ставит свои
# обработчики: в ОЗУ КЦГД появляется таблица графических команд (по слову
# на символ команды, 045336 + 2 * код; '$' - 144160). Команда
# ESC M ' x y в режиме VT52, в котором стартует прошивка 182, рисует
# прямоугольник от начала координат (левый нижний угол) до точки x = 100,
# y = 50: x - двумя символами по 6 разрядов + 040, y - одним.
MACHINE "../../tests/files/dvk4-keygp.ext"
WAIT _12000
COMMAND kcgd-host.send("\033M'!DR")
WAIT _1000

LOGDEFS _16,_8
PRINT "=== Таблица команд KeyGP: ! \" # $ ==="
LOG kcgd.value16(045440)
LOG kcgd.value16(045442)
LOG kcgd.value16(045444)
LOG kcgd.value16(045446)
SCREEN "../results/work-dvk4-kcgd-gp.png"
EXIT
