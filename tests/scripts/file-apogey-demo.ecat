# Апогей: загрузка .rka и запуск с адреса $7E0 (первые два байта файла).
# Демонстрация рисует цветную картинку - тест заодно проверяет знакогенератор
# и цветовые атрибуты.
#
# Регистры процессора не выводятся: между прогонами они плавают, см. раздел
# «Что нельзя проверять» в tests/README.md.
# @timeout 40

MACHINE "apogey/Apogey.cfg"
WAIT 2500

LOAD "demo.rka"

LOGDEFS 8,16
PRINT "=== Начало загруженного файла ==="
LOG ram.value($07E0,$07FF)

TYPE "G7E0\n"
WAIT 4000

SCREEN "../results/file-apogey-demo.png"
EXIT
