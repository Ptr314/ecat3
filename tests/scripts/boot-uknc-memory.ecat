# УК-НЦ: память. Три вещи, на которых стоит вся машина.
#
# 1. plane-pair: слово ЦП собирается из младшего байта плана 1 и старшего
#    плана 2, и 64 КБ адресов стоят по 32 КБ каждого плана.
# 2. indirect-memory: ПП достаёт и план 0, и память ЦП; регистр данных
#    защёлкивается при записи адреса, а не при чтении.
# 3. or_read: в окне отвечают ПЗУ и ОЗУ сразу, шина видит ИЛИ, а запись
#    доходит только до ОЗУ.
#
# Процессор стоит, всё делает сценарий, поэтому эмулированное время не идёт
# и задержек здесь нет.
# @timeout 30

MACHINE "uknc/memory-test.cfg"
LOGDEFS _16,_8

PRINT "=== 1. plane-pair: слово ЦП разложено по двум планам ==="
# Кладём слово по адресу 1000 адресного пространства ЦП
COMMAND cpu-ram.set16(1000, 123456)
PRINT "записано слово 123456 (=$A72E) по адресу 1000"
LOG cpu-ram.value16(1000)
# Адрес 1000 - это байт 400 каждого плана: младший в плане 1, старший в плане 2
PRINT "младший байт 056 обязан лечь в план 1, старший 247 - в план 2:"
LOG plane1.value(400)
LOG plane2.value(400)

PRINT "=== байтовый доступ выбирает план по разряду 0 адреса ==="
LOG cpu-ram.value(1000,1001)

PRINT "=== 64 КБ адресов на 32 КБ плана ==="
LOG cpu-ram.size
LOG cpu-ram.planes

PRINT "=== 2. indirect-memory: ПП видит план 0 и память ЦП ==="
# Кладём метку прямо в план 0 и читаем её через косвенный доступ
COMMAND plane0.set16(2000, 052525)
COMMAND pp-indirect.set16(0, 2000)
PRINT "адрес 2000 -> регистр данных плана 0 обязан отдать 052525:"
LOG pp-indirect.value16(2)
PRINT "тот же адрес в памяти ЦП (планы 1 и 2), там ещё ноль:"
LOG pp-indirect.value16(4)

PRINT "=== запись через косвенный доступ доходит до плана 0 ==="
COMMAND pp-indirect.set16(2, 077777)
LOG plane0.value16(2000)

PRINT "=== ПП пишет в память ЦП, и ЦП видит это своим адресным пространством ==="
COMMAND pp-indirect.set16(0, 1000)
COMMAND pp-indirect.set16(4, 001234)
LOG cpu-ram.value16(1000)

PRINT "=== защёлка: регистр данных не перечитывает память сам по себе ==="
# Меняем план 0 мимо косвенного доступа - защёлка обязана остаться прежней
COMMAND pp-indirect.set16(0, 2000)
LOG pp-indirect.value16(2)
COMMAND plane0.set16(2000, 000001)
PRINT "план 0 изменён, но защёлка держит прежнее значение:"
LOG pp-indirect.value16(2)
PRINT "перезапись адреса пересматривает память:"
COMMAND pp-indirect.set16(0, 2000)
LOG pp-indirect.value16(2)

PRINT "=== 3. or_read: ПЗУ и ОЗУ отвечают вместе ==="
PRINT "в ПЗУ окна лежит 170017, ОЗУ пока нулевое:"
LOG win-rom.value16(0)
LOG win-ram.value16(0)
LOG mapper.value16(160000)
PRINT "пишем в окно 007700 - запись доходит только до ОЗУ:"
COMMAND mapper.set16(160000, 007700)
LOG win-rom.value16(0)
LOG win-ram.value16(0)
PRINT "а чтение отдаёт ИЛИ того и другого:"
LOG mapper.value16(160000)

PRINT "=== карта памяти ==="
LOG mapper.map

EXIT
