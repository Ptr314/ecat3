# Юниор ФВ-6506: кадровое прерывание ВГ75 на INT процессора
#
# Выход прерывания ВГ75 заведен на INT, и на подтверждении шину никто не ведет:
# подтяжки дают $FF, то есть RST 7 (в b2m это rst[7]=crt.irq). Монитор его не
# видит - он включает прерывание ВГ75 только на время опроса и выключает перед
# EI, - а программы под TCP/M им живут: «Питон» опрашивает клавиатуру только в
# обработчике на $0038, и без прерывания не видит ни одной клавиши.
#
# Программа включает прерывание ВГ75 командой $A0, разрешает прерывания и
# стоит на HLT; обработчик читает состояние ВГ75 (это снимает запрос) и
# считает кадры в $0200. За секунду их около 50, а процессор каждый раз
# выходит из HLT. Потом прерывание ВГ75 выключается командой $C0, и счет
# стоит, хотя EI у процессора остается.
# @timeout 30
# @nomcp число кадров за окно зависит от фазы кадровой развертки, а в живом сеансе машина идет между загрузкой и первой командой

MACHINE "unior/Unior.cfg"
WAIT 1500
LOGDEFS 8,16

# $0038: IN $61 / INR M / EI / RET
COMMAND ram.set($0038,$DB,$61,$34,$FB,$C9)
# $0100: LXI H,$0200 / MVI M,0 / MVI A,$A0 / OUT $61 / EI / HLT / JMP $010A
COMMAND ram.set($0100,$21,$00,$02,$36,$00,$3E,$A0,$D3,$61,$FB,$76,$C3,$0A,$01)
COMMAND cpu.setreg(PC,$0100)

PRINT "=== Кадров за секунду ==="
WAIT 1000
LOG ram.value($0200)
LOG cpu.interfaces

# $0120: MVI A,$C0 / OUT $61 / EI / JMP $0124
# Туда программа уходит сама: после HLT вместо возврата в цикл теперь стоит
# JMP $0120. Через cpu.setreg так не сделать - процессор на HLT остался бы
# стоять до следующего прерывания, и оно попало бы в счет
COMMAND ram.set($0120,$3E,$C0,$D3,$61,$FB,$C3,$24,$01)
COMMAND ram.set($010B,$C3,$20,$01)
WAIT 30
LOG ram.value($0200)

PRINT "=== Прерывание ВГ75 выключено: счет стоит ==="
WAIT 500
LOG ram.value($0200)
EXIT
