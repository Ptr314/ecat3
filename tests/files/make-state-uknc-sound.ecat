# Сборка эталонного снимка состояния для state-uknc-sound.ecat.
#
# Запускается руками, а не набором тестов: снимок - это двоичный эталон,
# который обновляют осознанно. Из каталога deploy/:
#
#   eCat3-headless --no-sound --script ../tests/files/make-state-uknc-sound.ecat
#
# Машина доводится до меню ЗАГРУЗКА, после чего включается тон: разряды 7 и 8
# регистра 177716 (линия динамика и нижний отвод сетки частот). Сетка идет от
# счетчика программируемого таймера, поэтому ему заодно ставится шаг 16 мкс -
# с ним полупериод нижнего отвода 16.4 мс, и тест может ловить его фронты
# целыми миллисекундами.
#
# Снимок снимается со звучащим тоном нарочно: в этом состоянии уровень
# меняется сам, без единой записи в регистр, и восстановление обязано это
# восстановить вместе с ним.

MACHINE "uknc/UKNC.cfg"
WAIT _8000

# Дисководы освобождаются: снимок несет в себе содержимое каждого вставленного
# образа, а звуку они не нужны - без них архив вчетверо меньше
COMMAND fdd0.eject()
COMMAND fdd1.eject()

COMMAND ppu-mapper.set(177710, 7)
COMMAND pp-sys.set16(0,100620)
WAIT _100

SAVESTATE "state-uknc-sound.ecats.zip"
# Снимок экрана рядом с архивом - чтобы глазами сверить, что снималось
SCREEN "state-uknc-sound-made.png"
EXIT
