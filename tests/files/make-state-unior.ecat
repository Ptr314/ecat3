# Сборка эталонного снимка состояния для state-unior.ecat.
#
# Запускается руками, а не набором тестов: снимок - это двоичный эталон,
# который обновляют осознанно. Из каталога deploy/:
#
#   eCat3-headless --no-sound --script ../tests/files/make-state-unior.ecat
#
# Юниор взят из-за того, что у него в снимок должно попасть больше, чем у
# других машин: ПЗУ палитры (без него архив не загрузится обратно и экран
# потеряет цвет), полмегабайта дополнительной памяти и кассета - носитель
# этой машины живет в самом устройстве, а не в файле на диске.

MACHINE "unior/Unior.cfg"
WAIT 1500

# Кассета: в архив уходит ее содержимое, а не путь к файлу
COMMAND tape.load("unior-test.bt")

# Метки в основной памяти и в блоке расширения
COMMAND ram.set($0300,$DE,$AD,$BE,$EF)
COMMAND extram.set($1234,$5A,$A5,$11,$22)

SAVESTATE "state-unior.ecats.zip"
# Снимок экрана рядом с архивом - чтобы глазами сверить, что снималось
SCREEN "state-unior-made.png"
EXIT
