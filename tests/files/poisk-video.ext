// Поиск-1 без BIOS: видео 320x200 и такты ожидания ОЗУ платы
// Вместо ПЗУ BIOS (его в репозитории нет) стоит маленькая программа по FFF00.
// Она программирует второй ВВ55, ставит режим 320x200 (палитра 1, фон
// синий, ловушка выключена), заливает видеопамять через окно B8000 полосами
// (четные строки - 1Bh, точки 0-1-2-3; нечетные - E4h, точки 3-2-1-0),
// копирует цикл INC [100h] / JMP в ОЗУ платы (0050:0000) и в ОЗУ картриджа
// (2000:0000) и ждет в ячейке 0000:0400 номер варианта.
// Цикл в ОЗУ платы ждет слотов видео, в картридже - нет: за одно и то же
// время его счетчик уходит дальше
@extends poisk/Poisk-1-128k.ext
@version Поиск-1, тест видео

-bios
-mapper:@memory[$FE000-$FFFFF]

//   FFF00  программа, см. выше; FFFF0  JMP FFF0:0000
testrom : rom {
	data = {$FA,$31,$C0,$8E,$D0,$BC,$00,$04,$B0,$89,$E6,$63,$B0,$29,$E6,$68,$B8,$00,$B8,$8E,$C0,$31,$FF,$FC,$B8,$1B,$1B,$B9,$00,$10,$F3,$AB,$B8,$E4,$E4,$B9,$00,$10,$F3,$AB,$0E,$1F,$31,$C0,$8E,$C0,$BF,$00,$05,$BE,$61,$00,$B9,$08,$00,$F3,$A4,$B8,$00,$20,$8E,$C0,$31,$FF,$BE,$61,$00,$B9,$08,$00,$F3,$A4,$31,$C0,$8E,$D8,$A0,$00,$04,$08,$C0,$74,$F9,$3C,$01,$74,$05,$EA,$00,$00,$00,$20,$EA,$00,$00,$50,$00,$0E,$1F,$FF,$06,$00,$01,$EB,$FA}
}
resetrom : rom {
	data = {$EA,$00,$00,$F0,$FF}
}
cart : ram {
	size = 64k
}
mapper:@memory[$FFF00-$FFF68] = testrom {mode = r}
mapper:@memory[$FFFF0-$FFFF4] = resetrom {mode = r}
mapper:@memory[$20000-$2FFFF] = cart

