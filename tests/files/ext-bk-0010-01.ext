// Вариант БК0010-01 для теста ext-bk-edits: правки поверх базовой конфигурации
@extends bk/BK-0010-01.cfg
@version БК0010-01 (тест .ext)

// Замена свойства: черно-белый экран вместо цветного
display:mode = mono

// Удаление одной из трех строк с одним ключом: приставка AY отключена от шины,
// порт джойстика и регистр УП остаются
-mapper:@memory[177714-177715] = ay

// Замена свойства, которого нет в базе, - добавление
sound:mix = covox

// Диапазон - элемент списка: новый добавляется в конец карты
mapper:@memory[177600-177601] = port-177700
