# Сборка эталонного снимка состояния для state-uknc-latch.ecat.
#
# Запускается руками, а не набором тестов: снимок - это двоичный эталон,
# который обновляют осознанно. Из каталога deploy/:
#
#   eCat3-headless --no-sound --script ../tests/files/make-state-uknc-latch.ecat
#
# Машина доводится до меню ЗАГРУЗКА, оба процессора останавливаются, и в
# снимок уходят две вещи, которые не выводятся из памяти:
#   - защелка регистра данных планов (cpu-indirect): в память за ней пишется
#     123456, адрес ставится, а потом память обнуляется - регистр обязан
#     отдавать защелкнутое, а не то, что лежит в памяти сейчас;
#   - очередь приема сетевого адаптера (sa): пять байтов "hello", которые
#     машина еще не приняла.

MACHINE "uknc/UKNC.cfg"
WAIT _8000

# Дисководы освобождаются: снимок несет в себе содержимое каждого вставленного
# образа, а здесь они не нужны
COMMAND fdd0.eject()
COMMAND fdd1.eject()

COMMAND cpu.stop()
COMMAND ppu.stop()
COMMAND planes12.set16(400, 123456)
COMMAND cpu-indirect.set16(0, 200)
COMMAND planes12.set16(400, 0)
COMMAND sa.send("hello")

SAVESTATE "state-uknc-latch.ecats.zip"
EXIT
