// Поиск-1 без BIOS: ловушка CGA через NMI и прерывание таймера через ВН59
// Программа по FFF00 ставит вектор NMI (2) и IRQ0 (8), программирует ВН59
// (ICW1 13h, ICW2 08h, ICW4 09h, открыт только IR0) и канал 0 таймера
// (режим 3, 65536 - около 19 Гц), включает 640x200 с ловушкой и пишет 41h
// в B800:0005, затем 09h в порт 3D8h. Обработчик NMI складывает порты 28h,
// 29h, 2Ah в 0000:0420 + 4n, n - в 0000:0413; обработчик таймера считает
// тики в слове 0000:0414. Ожидается: запись в видеопамять - 05 80 41,
// порт - D8 C3 09, тиков около 19 в секунду
@extends poisk/Poisk-1.cfg
@version Поиск-1, тест ловушки

-bios
-mapper:@memory[$FE000-$FFFFF]

testrom : rom {
	data = {$FA,$31,$C0,$8E,$D8,$8E,$D0,$BC,$00,$04,$C7,$06,$08,$00,$59,$00,$C7,$06,$0A,$00,$F0,$FF,$C7,$06,$20,$00,$7E,$00,$C7,$06,$22,$00,$F0,$FF,$B0,$89,$E6,$63,$B0,$13,$E6,$20,$B0,$08,$E6,$21,$B0,$09,$E6,$21,$B0,$FE,$E6,$21,$B0,$36,$E6,$43,$30,$C0,$E6,$40,$E6,$40,$B0,$80,$E6,$68,$FB,$B8,$00,$B8,$8E,$C0,$26,$C6,$06,$05,$00,$41,$BA,$D8,$03,$B0,$09,$EE,$F4,$EB,$FD,$50,$53,$8A,$1E,$13,$04,$B7,$00,$D1,$E3,$D1,$E3,$E4,$29,$88,$87,$21,$04,$E4,$2A,$88,$87,$22,$04,$E4,$28,$88,$87,$20,$04,$FE,$06,$13,$04,$5B,$58,$CF,$50,$FF,$06,$14,$04,$B0,$20,$E6,$20,$58,$CF}
}
resetrom : rom {
	data = {$EA,$00,$00,$F0,$FF}
}
mapper:@memory[$FFF00-$FFF88] = testrom {mode = r}
mapper:@memory[$FFFF0-$FFFF4] = resetrom {mode = r}

