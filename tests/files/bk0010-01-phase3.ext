// БК0010-01 пользователя prcoder-1/bk0010-emulator в фазе включения, где
// MOV (R0),R1 идет 24 такта (его фаза 1): точки окна 037 на 3/12 такта позже,
// а чтение-модификация-запись не дороже записи. Для теста, сверенного с фото
// 45com-lo с этой машины
@extends bk/BK-0010-01.cfg
@version БК0010-01, фаза 3 (тест)

vp037:phase = 3
vp037:setup_rmw = _400
