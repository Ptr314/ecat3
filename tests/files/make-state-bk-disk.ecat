# Сборка эталонного снимка для state-bk-0011m-disk.ecat.
#
# Запускается руками, из каталога deploy/:
#
#   eCat3-headless --no-sound --script ../tests/files/make-state-bk-disk.ecat
#
# Машина доводится до ANDOS, в ОЗУ кладется та же программа, что в
# disk-bk-0011m-write.ecat, но разрезанная пополам: сначала она пишет блок
# 1500 (дорожка 75) образцом из 20000 и останавливается на 024110, а вторая
# половина - перечитывание - остается в памяти и запускается уже из
# сохраненного состояния.
#
# В момент съемки записанного сектора нет ни в одном файле на диске: он лежит
# в буфере дорожки контроллера и в буфере дисковода. Снимок обязан унести их
# с собой, иначе запись пропадет.
# @timeout 60

MACHINE "bk/BK-0011M-fdd.cfg"
WAIT _12000
COMMAND cpu.stop

LOGDEFS _16,_8
COMMAND ram0.set16(024000, 106427, 000340)           # MTPS #340            ; запретить прерывания
COMMAND ram0.set16(024004, 012706, 027400)           # MOV #27400,SP
COMMAND ram0.set16(024010, 012703, 030000)           # MOV #30000,R3
COMMAND ram0.set16(024014, 004737, 160010)           # JSR PC,@#160010      ; инициализация рабочей области
COMMAND ram0.set16(024020, 012703, 030000)           # MOV #30000,R3
COMMAND ram0.set16(024024, 012700, 000000)           # MOV #0,R0
COMMAND ram0.set16(024030, 012701, 000400)           # MOV #400,R1
COMMAND ram0.set16(024034, 012702, 021000)           # MOV #21000,R2
COMMAND ram0.set16(024040, 004737, 160004)           # JSR PC,@#160004      ; чтение блока 0
COMMAND ram0.set16(024044, 005037, 022000)           # CLR @#22000
COMMAND ram0.set16(024050, 005537, 022000)           # ADC @#22000
COMMAND ram0.set16(024054, 012703, 030000)           # MOV #30000,R3
COMMAND ram0.set16(024060, 012700, 002734)           # MOV #2734,R0
COMMAND ram0.set16(024064, 012701, 177400)           # MOV #177400,R1       ; <0 - запись
COMMAND ram0.set16(024070, 012702, 020000)           # MOV #20000,R2
COMMAND ram0.set16(024074, 004737, 160004)           # JSR PC,@#160004      ; ЗАПИСЬ блока 1500
COMMAND ram0.set16(024100, 005037, 022002)           # CLR @#22002
COMMAND ram0.set16(024104, 005537, 022002)           # ADC @#22002
COMMAND ram0.set16(024110, 000777)                   # BR .                 ; здесь снимается состояние

# Вторая половина, запускается уже из состояния
COMMAND ram0.set16(024112, 012703, 030000)           # MOV #30000,R3
COMMAND ram0.set16(024116, 012700, 000000)           # MOV #0,R0
COMMAND ram0.set16(024122, 012701, 000400)           # MOV #400,R1
COMMAND ram0.set16(024126, 012702, 021000)           # MOV #21000,R2
COMMAND ram0.set16(024132, 004737, 160004)           # JSR PC,@#160004      ; чтение блока 0: уводит головку
COMMAND ram0.set16(024136, 005037, 022004)           # CLR @#22004
COMMAND ram0.set16(024142, 005537, 022004)           # ADC @#22004
COMMAND ram0.set16(024146, 012703, 030000)           # MOV #30000,R3
COMMAND ram0.set16(024152, 012700, 002734)           # MOV #2734,R0
COMMAND ram0.set16(024156, 012701, 000400)           # MOV #400,R1
COMMAND ram0.set16(024162, 012702, 021000)           # MOV #21000,R2
COMMAND ram0.set16(024166, 004737, 160004)           # JSR PC,@#160004      ; чтение блока 1500 обратно
COMMAND ram0.set16(024172, 005037, 022006)           # CLR @#22006
COMMAND ram0.set16(024176, 005537, 022006)           # ADC @#22006
COMMAND ram0.set16(024202, 000777)                   # BR .

COMMAND ram0.fill(020000, 020777, $A5)
COMMAND ram0.set(020000, $45, $43, $41, $54, $33, $42, $4B, $21)
COMMAND ram0.set(020776, $12, $34)
COMMAND ram0.fill(021000, 022007, $00)
COMMAND ram0.fill(030000, 030101, $00)
COMMAND ram0.set(000052, $00)

COMMAND cpu.setreg(PC, 024000)
COMMAND cpu.run
WAITFOR cpu.pc == 024110, _30000

PRINT "=== Флаг C чтения и записи: 0 - успех ==="
LOG ram0.value(022000, 022003)
SAVESTATE "state-bk-disk.ecats.zip"
EXIT
